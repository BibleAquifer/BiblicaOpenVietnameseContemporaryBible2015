  <para style="h">Thi Thiên</para>
  <para style="toc1">Thi Thiên</para>
  <para style="toc2">Thi Thiên</para>
  <para style="toc3">Thi</para>
  <para style="mt1">Thi Thiên</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms1">Quyển Thứ Nhất</para>
  <para style="mr">(<ref loc="PSA 1-41">Thi Thiên 1–41</ref>)</para>
  <para style="cl">Thi Thiên 1</para>
  <para style="s1">Hai Hạng Người: Thiện và Ác</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Phước cho những người</para>
  <para style="q2" vid="PSA 1:1">không theo mưu ác của kẻ dữ,</para>
  <para style="q1" vid="PSA 1:1">không đứng trong đường của tội nhân,</para>
  <para style="q2" vid="PSA 1:1">không ngồi với phường phỉ báng.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Nhưng ưa thích luật pháp của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 1:2">ngày và đêm suy nghiệm luật pháp Ngài.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Những người như thể ấy như cây bên dòng suối,</para>
  <para style="q2" vid="PSA 1:3">sinh hoa trái thơm lành.</para>
  <para style="q1" vid="PSA 1:3">Lá xanh mãi không tàn,</para>
  <para style="q2" vid="PSA 1:3">và mọi việc người làm đều hưng thịnh.<verse eid="PSA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Còn người ác thì ngược lại!</para>
  <para style="q2" vid="PSA 1:4">Chúng như rơm rác theo làn gió cuốn đi.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Vì vậy, người ác không đứng nổi trong ngày phán xét.</para>
  <para style="q2" vid="PSA 1:5">Tội nhân cũng chẳng ngồi trong hội người tin kính.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Vì Chúa Hằng Hữu biết đường người tin kính,</para>
  <para style="q2" vid="PSA 1:6">còn đường người ác dẫn đến hư vong.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="cl">Thi Thiên 2</para>
  <para style="s1">Triều Đại của Đấng Được Xức Dầu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Sao muôn dân cuồng loạn?</para>
  <para style="q2" vid="PSA 2:1">Sao các nước toan tính chuyện hão huyền?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Vua trần gian cùng nhau cấu kết;</para>
  <para style="q2" vid="PSA 2:2">âm mưu chống nghịch Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 2:2">và Đấng được Ngài xức dầu.<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Chúng nói: “Chúng ta hãy bứt đứt dây họ trói buộc,</para>
  <para style="q2" vid="PSA 2:3">quăng xa mọi xích xiềng.”<verse eid="PSA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Đấng ngự trên trời sẽ cười,</para>
  <para style="q2" vid="PSA 2:4">Chúa nhạo báng khinh thường chúng nó.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Cơn giận Chúa làm chúng kinh hoàng,</para>
  <para style="q2" vid="PSA 2:5">Ngài khiển trách trong cơn thịnh nộ.<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />Vì Chúa công bố: “Ta<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Nt Jahweh</char></note> đã chọn và lập Vua Ta,</para>
  <para style="q2" vid="PSA 2:6">trên ngai Si-ôn, núi thánh Ta.”<verse eid="PSA 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7" />Vua công bố sắc lệnh của Chúa Hằng Hữu:</para>
  <para style="q1" vid="PSA 2:7">“Chúa Hằng Hữu phán bảo ta: ‘Ngươi thật là Con Ta.</para>
  <para style="q2" vid="PSA 2:7">Ngày nay Ta đã trở nên Cha của ngươi.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Hãy cầu xin, Ta sẽ cho con các dân tộc làm sản nghiệp,</para>
  <para style="q2" vid="PSA 2:8">toàn thế gian thuộc quyền sở hữu của con.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Con sẽ cai trị với cây gậy sắt</para>
  <para style="q2" vid="PSA 2:9">và đập chúng nát tan như chiếc bình gốm.’”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Vì vậy các vua hãy khôn ngoan!</para>
  <para style="q2" vid="PSA 2:10">Các lãnh tụ khá nên cẩn trọng!<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Phục vụ Chúa Hằng Hữu với lòng kính sợ,</para>
  <para style="q2" vid="PSA 2:11">và hân hoan trong run rẩy.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />Hãy khuất phục Con Trời, trước khi Ngài nổi giận,</para>
  <para style="q2" vid="PSA 2:12">và kẻo các ngươi bị diệt vong,</para>
  <para style="q1" vid="PSA 2:12">vì cơn giận Ngài sẽ bùng lên trong chốc lát.</para>
  <para style="q2" vid="PSA 2:12">Nhưng phước thay cho ai nương náu nơi Ngài!<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="cl">Thi Thiên 3</para>
  <para style="s1">Lời Cầu Nguyện Buổi Sáng</para>
  <para style="d">(Thơ của Đa-vít khi đi trốn Áp-sa-lôm, con trai mình)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />Ôi Chúa Hằng Hữu, sao kẻ thù con vô số;</para>
  <para style="q2" vid="PSA 3:1">biết bao người nổi dậy chống con.<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Họ cầu mong rằng:</para>
  <para style="q2" vid="PSA 3:2">“Đức Chúa Trời sẽ không bao giờ giải cứu nó!”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Nhưng, lạy Chúa Hằng Hữu, Ngài là khiên thuẫn chở che con,</para>
  <para style="q2" vid="PSA 3:3">Ngài là vinh quang con, Đấng cho con ngước đầu lên.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Tôi lớn tiếng kêu cầu cùng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 3:4">Ngài đáp lời tôi từ núi thánh Ngài.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Tôi nằm xuống và ngủ yên giấc,</para>
  <para style="q2" vid="PSA 3:5">rồi thức giấc trong an toàn,</para>
  <para style="q2" vid="PSA 3:5">vì Chúa Hằng Hữu đỡ nâng tôi.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Tôi chẳng sợ sệt, kinh hoàng,</para>
  <para style="q2" vid="PSA 3:6">dù vạn người vây hãm chung quanh.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Chúa Hằng Hữu ôi, xin xuất hiện!</para>
  <para style="q2" vid="PSA 3:7">Xin giải cứu tôi, lạy Đức Chúa Trời tôi!</para>
  <para style="q1" vid="PSA 3:7">Xin vả mặt đoàn quân thù nghịch!</para>
  <para style="q2" vid="PSA 3:7">Xin bẻ nanh vuốt phường ác gian!<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Chiến thắng đến từ Ngài, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 3:8">Xin ban phước trên con dân Ngài.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="cl">Thi Thiên 4</para>
  <para style="s1">Lời Cầu Nguyện Buổi Tối</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Xin lắng nghe tiếng con kêu cầu,</para>
  <para style="q2" vid="PSA 4:1">lạy Đức Chúa Trời, Đấng xem con là vô tội.</para>
  <para style="q1" vid="PSA 4:1">Con lâm nguy, Chúa từng cứu giúp.</para>
  <para style="q2" vid="PSA 4:1">Xin thương xót và nghe lời cầu nguyện của con.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Loài người các ngươi sỉ nhục thanh danh ta cho đến bao giờ?</para>
  <para style="q2" vid="PSA 4:2">Đến khi nào các ngươi thôi kết tội vẫn vơ?</para>
  <para style="q2" vid="PSA 4:2">Và ngưng đuổi theo những điều dối trá?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Các ngươi nên chắc chắn điều này:</para>
  <para style="q2" vid="PSA 4:3">Chúa Hằng Hữu biệt riêng người tin kính cho Ngài.</para>
  <para style="q2" vid="PSA 4:3">Chúa Hằng Hữu đáp lời khi ta kêu cầu Ngài.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Trong cơn giận tránh đừng phạm tội.</para>
  <para style="q2" vid="PSA 4:4">Suy nghĩ kỹ càng và yên lặng suy tư.<verse eid="PSA 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Hãy dâng sinh tế xứng đáng,</para>
  <para style="q2" vid="PSA 4:5">và tin cậy nơi Chúa Hằng Hữu.<verse eid="PSA 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Nhiều người hỏi: “Ai sẽ cho chúng ta thấy phước?”</para>
  <para style="q2" vid="PSA 4:6">Xin mặt Ngài rạng rỡ trên chúng con, lạy Chúa Hằng Hữu.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Chúa cho lòng con đầy hân hoan</para>
  <para style="q2" vid="PSA 4:7">hơn những người có đầy tràn lúa mùa và rượu mới.<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Con sẽ được nằm yên ngon giấc,</para>
  <para style="q2" vid="PSA 4:8">vì chỉ trong Ngài, con mới tìm được sự bình an.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="cl">Thi Thiên 5</para>
  <para style="s1">Xin Chúa Bảo Vệ</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, dùng ống sáo)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Lạy Chúa, xin nghiêng tai nghe tiếng con,</para>
  <para style="q2" vid="PSA 5:1">lưu ý đến điều con thầm nguyện.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Xin nghe con kêu xin cứu giúp, lạy Vua của con và Đức Chúa Trời của con,</para>
  <para style="q2" vid="PSA 5:2">vì con chỉ cầu khẩn với Ngài.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Xin nghe tiếng con vào buổi sáng, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 5:3">Mỗi sáng con kêu cầu Ngài cứu giúp và tin chắc Ngài sẽ nhậm lời.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Ôi Đức Chúa Trời, Chúa không ưa việc gian ác;</para>
  <para style="q2" vid="PSA 5:4">kẻ dữ làm sao sống với Ngài.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Người kiêu ngạo chẳng đứng nổi trước mặt Chúa,</para>
  <para style="q2" vid="PSA 5:5">vì Chúa ghét mọi người làm điều ác.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Chúa diệt trừ người điêu ngoa dối trá.</para>
  <para style="q2" vid="PSA 5:6">Chúa Hằng Hữu kinh tởm bọn sát nhân và lừa đảo.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Về phần con, nhờ thiên ân vô hạn, sẽ được vào nhà Chúa;</para>
  <para style="q2" vid="PSA 5:7">cung kính thờ phượng tại Đền Thờ Ngài.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Xin dẫn con theo đường công chính, lạy Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 5:8">vì kẻ thù con lấn lướt con.</para>
  <para style="q2" vid="PSA 5:8">Xin san bằng đường lối trước mặt con.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Lời nói họ không thể nào tin được.</para>
  <para style="q2" vid="PSA 5:9">Vì lòng họ chứa đầy mưu ác.</para>
  <para style="q1" vid="PSA 5:9">Cổ họng mở ra như cửa mộ.</para>
  <para style="q2" vid="PSA 5:9">Miệng lưỡi chúng chỉ chuyên dua nịnh.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Ôi Đức Chúa Trời, xin tuyên án họ có tội.</para>
  <para style="q2" vid="PSA 5:10">Cho họ sa vào mưu chước họ gài.</para>
  <para style="q1" vid="PSA 5:10">Loại trừ họ vì tội họ nhiều vô kể,</para>
  <para style="q2" vid="PSA 5:10">vì họ phạm tội phản loạn chống lại Ngài.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Nhưng những ai nương mình trong Chúa;</para>
  <para style="q2" vid="PSA 5:11">thì được an vui, mãi mãi hát mừng.</para>
  <para style="q1" vid="PSA 5:11">Xin trải sự che chở Ngài trên họ,</para>
  <para style="q2" vid="PSA 5:11">để những người yêu Danh Chúa mừng rỡ hân hoan.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Vì Chúa ban phước cho người tin kính, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 5:12">ân huệ Ngài như khiên thuẫn chở che.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="cl">Thi Thiên 6</para>
  <para style="s1">Lời Cầu Nguyện trong Cơn Hoạn Nạn</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây, theo điệu Sê-mi-ni)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />Chúa Hằng Hữu ôi, xin đừng quở trách con khi Chúa giận,</para>
  <para style="q2" vid="PSA 6:1">hay phạt con trong cơn giận của Ngài.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Xin xót thương con, lạy Chúa Hằng Hữu, vì con kiệt sức.</para>
  <para style="q2" vid="PSA 6:2">Xin chữa lành con, lạy Chúa Hằng Hữu, vì xương cốt tiêu hao.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Linh hồn con vô cùng bối rối.</para>
  <para style="q2" vid="PSA 6:3">Lạy Chúa Hằng Hữu, đến bao giờ Ngài chữa lành con?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Xin trở lại, lạy Chúa Hằng Hữu, và đưa tay giải thoát con.</para>
  <para style="q2" vid="PSA 6:4">Cứu vớt con vì tình thương không dời đổi của Ngài.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Người đã chết làm sao nhớ Chúa.</para>
  <para style="q2" vid="PSA 6:5">Dưới âm ty, ai ca tụng Ngài?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Con mòn mỏi vì than thở.</para>
  <para style="q1" vid="PSA 6:6">Suốt đêm trường dòng lệ đầm đìa,</para>
  <para style="q2" vid="PSA 6:6">cả gối giường ướp đầy nước mắt.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Mắt mờ lòa vì sầu muộn khôn nguôi;</para>
  <para style="q2" vid="PSA 6:7">và hao mòn vì bao người thù nghịch.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Hãy lìa xa, hỡi người gian ác,</para>
  <para style="q2" vid="PSA 6:8">vì Chúa Hằng Hữu đã nghe tiếng ta khóc than.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Ta kêu xin, Chúa Hằng Hữu nhậm lời,</para>
  <para style="q2" vid="PSA 6:9">Chúa Hằng Hữu trả lời khi ta cầu khẩn.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Nguyện kẻ thù tôi bị sỉ nhục và ruồng bỏ.</para>
  <para style="q2" vid="PSA 6:10">Nguyện chúng thình lình phải bỏ chạy nhục nhã.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="cl">Thi Thiên 7</para>
  <para style="s1">Lời Cầu Xin Được Bênh Vực Trước Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít, ca ngợi Chúa về Cút, người Bên-gia-min, theo điệu Sít-gai-on)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />Con ẩn trú nơi Chúa, lạy Chúa Hằng Hữu, Đức Chúa Trời con.</para>
  <para style="q2" vid="PSA 7:1">Xin cứu con khỏi những người đuổi bắt con—xin giải cứu con!<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Kẻo chúng nó vồ con như sư tử,</para>
  <para style="q2" vid="PSA 7:2">xé nát con, không ai giải thoát cho.<verse eid="PSA 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />Lạy Chúa Hằng Hữu, Đức Chúa Trời con, nếu con làm việc dữ</para>
  <para style="q2" vid="PSA 7:3">hay nếu tay con làm điều tội ác,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />nếu con xử tệ với người sống thuận hòa,</para>
  <para style="q2" vid="PSA 7:4">hoặc vô cớ cướp bóc kẻ thù,<verse eid="PSA 7:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 7:5" />thì con đáng bị kẻ thù rượt bắt.</para>
  <para style="q1" vid="PSA 7:5">Chà đạp mạng sống con dưới chân,</para>
  <para style="q2" vid="PSA 7:5">và khiến con vùi thây trong đất bụi.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Lạy Chúa Hằng Hữu, xin nổi cơn thịnh nộ!</para>
  <para style="q2" vid="PSA 7:6">Đối với cơn giận của những kẻ hại con!</para>
  <para style="q2" vid="PSA 7:6">Xin thức dậy, lạy Đức Chúa Trời con, Xin Ngài thi hành công lý!<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Các dân tộc sẽ tụ họp quanh Chúa.</para>
  <para style="q2" vid="PSA 7:7">Trên ngôi cao Ngài phán xét loài người.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Chúa Hằng Hữu sẽ xét xử muôn dân.</para>
  <para style="q2" vid="PSA 7:8">Xin đem con ra phán xét, ôi Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 7:8">theo lòng con thẳng ngay và liêm khiết, ôi Đấng Chí Cao!<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Xin chấm dứt việc hung tàn người ác,</para>
  <para style="q2" vid="PSA 7:9">và che chở người ngay lành.</para>
  <para style="q1" vid="PSA 7:9">Vì Ngài dò xét sâu xa tâm trí loài người,</para>
  <para style="q2" vid="PSA 7:9">lạy Đức Chúa Trời công minh.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Đức Chúa Trời là khiên thuẫn chở che tôi,</para>
  <para style="q2" vid="PSA 7:10">giải cứu người có lòng chính trực.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Đức Chúa Trời là Thẩm Phán công minh.<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">Nt Chúa sẽ xét đoán công minh cả thế giới</char></note></para>
  <para style="q2" vid="PSA 7:11">Hằng ngày Ngài nổi giận về tội ác.<verse eid="PSA 7:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Nếu không hối cải ăn năn,</para>
  <para style="q2" vid="PSA 7:12">Đức Chúa Trời đành mài kiếm;</para>
  <para style="q2" vid="PSA 7:12">và Ngài giương cung sẵn sàng.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Bày ra khí giới hủy diệt,</para>
  <para style="q2" vid="PSA 7:13">lắp tên lửa cháy phừng phừng bắn ra.<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Người gian ác cưu mang độc kế;</para>
  <para style="q2" vid="PSA 7:14">nên bày ra đủ thế gạt lường.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Họ đào hầm toan để hại người,</para>
  <para style="q2" vid="PSA 7:15">nhưng chính họ lại rơi vào đấy.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Điều tàn hại họ gây ra lại giáng trên họ.</para>
  <para style="q2" vid="PSA 7:16">Mưu gian ác lại đổ lên đầu họ.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Nt việc tàn bạo của nó giáng trên đầu nó</char></note><verse eid="PSA 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Tôi sẽ cảm tạ Chúa Hằng Hữu vì Ngài công chính;</para>
  <para style="q2" vid="PSA 7:17">Tôi sẽ hát tôn thờ Danh Chúa Hằng Hữu Chí Cao.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="cl">Thi Thiên 8</para>
  <para style="s1">Vinh Quang của Chúa và Giá Trị của Con Người</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu Gít-ti)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />Lạy Chúa Hằng Hữu, Chúa của chúng con, uy danh Chúa vang lừng khắp đất!</para>
  <para style="q2" vid="PSA 8:1">Vinh quang Ngài chiếu rạng trời cao.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Từ môi miệng trẻ thơ và hài nhi,</para>
  <para style="q2" vid="PSA 8:2">Chúa đã đặt vào lời ca ngợi,</para>
  <para style="q2" vid="PSA 8:2">khiến quân thù câm nín.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Khi con nhìn bầu trời lúc đêm và thấy các công trình của ngón tay Chúa—</para>
  <para style="q2" vid="PSA 8:3">mặt trăng và các tinh tú mà Chúa sáng tạo—<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />con không thể nào hiểu thấu,</para>
  <para style="q2" vid="PSA 8:4">con loài người là chi mà Chúa phải nhọc lòng?<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Chúa tạo người chỉ kém Đức Chúa Trời một chút,</para>
  <para style="q2" vid="PSA 8:5">đội lên đầu danh dự và vinh quang.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Cho người cai quản toàn vũ trụ,</para>
  <para style="q2" vid="PSA 8:6">khiến muôn loài đều phải phục tùng—<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />gia súc và bầy vật</para>
  <para style="q2" vid="PSA 8:7">cùng tất cả thú rừng,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />đến các loại chim trên trời, cá dưới biển,</para>
  <para style="q2" vid="PSA 8:8">và mọi sinh vật dưới đại dương.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Lạy Chúa Hằng Hữu, Chúa chúng con, uy danh Chúa vang lừng khắp đất!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="cl">Thi Thiên 9</para>
  <para style="s1">Chúc Tạ Chúa Công Minh</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu Mút-la-ben)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Lạy Chúa Hằng Hữu, con sẽ hết lòng tôn vinh Chúa</para>
  <para style="q2" vid="PSA 9:1">và kể ra các việc huyền diệu của Ngài.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Trong Chúa, con rạng rỡ vui mừng.</para>
  <para style="q2" vid="PSA 9:2">Ca ngợi chúc tôn Thánh Danh, lạy Đấng Chí Cao.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Khi kẻ thù con quay lại</para>
  <para style="q2" vid="PSA 9:3">trước mặt Ngài, chúng vấp ngã và bị diệt vong.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Vì Chúa đã bênh vực quyền lợi chính đáng của con;</para>
  <para style="q2" vid="PSA 9:4">từ trên ngai Chúa phán xét công bình.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Chúa khiển trách các dân tộc và hủy diệt người ác;</para>
  <para style="q2" vid="PSA 9:5">tên tuổi chúng vĩnh viễn bị xóa bôi.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Kẻ thù con mãi mãi điêu linh;</para>
  <para style="q2" vid="PSA 9:6">thị thành hoang phế, ký ức về chúng cũng phôi pha.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Nhưng Chúa Hằng Hữu cai trị muôn đời,</para>
  <para style="q2" vid="PSA 9:7">Ngài đã lập ngôi để ngồi phán xét,<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Chúa phân xử cả thế gian cách công minh,</para>
  <para style="q2" vid="PSA 9:8">và quản trị các dân tộc cách ngay thẳng.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />Chúa Hằng Hữu là nơi nương cho người bị áp bức,</para>
  <para style="q2" vid="PSA 9:9">là nơi ẩn náu lúc gian nan.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Ai biết Danh Chúa sẽ tin cậy Ngài,</para>
  <para style="q2" vid="PSA 9:10">vì Ngài, Chúa Hằng Hữu, không từ bỏ một ai tìm kiếm Chúa.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Hãy ca ngợi Chúa Hằng Hữu, Đấng trị vì tại Si-ôn.</para>
  <para style="q2" vid="PSA 9:11">Truyền ra công việc Ngài khắp các dân.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Vì Đấng báo thù huyết chăm sóc người đau thương.</para>
  <para style="q2" vid="PSA 9:12">Chúa không quên tiếng kêu của người cùng khốn.<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Lạy Chúa Hằng Hữu, xin thương xót con.</para>
  <para style="q2" vid="PSA 9:13">Xin hãy xem con bị kẻ thù hành hạ.</para>
  <para style="q2" vid="PSA 9:13">Và kéo con khỏi các cửa tử vong.<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />Để tại các cổng thành<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">Nt cổng con gái Si-ôn</char></note> của dân Chúa,</para>
  <para style="q2" vid="PSA 9:14">con ca ngợi Chúa và rao mừng ân cứu chuộc.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Các dân rơi ngay vào hầm hố họ đã đào.</para>
  <para style="q2" vid="PSA 9:15">Chân họ sa vào lưới họ đã giăng.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Công lý Chúa làm Danh Ngài sáng tỏ.</para>
  <para style="q2" vid="PSA 9:16">Ác nhân sa vào cạm bẫy tay họ gài.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Người tội ác sẽ bị lùa vào âm phủ.</para>
  <para style="q2" vid="PSA 9:17">Cùng với các dân tộc từ khước Đức Chúa Trời.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Nhưng người khốn khó sẽ chẳng mãi bị bỏ quên;</para>
  <para style="q2" vid="PSA 9:18">người nghèo cũng không tiêu tan hy vọng.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Xin trỗi dậy, lạy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 9:19">Xin đừng để con người thắng thế!</para>
  <para style="q2" vid="PSA 9:19">Trước Thiên nhan, xin phán xét các dân!<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Xin khiến họ khiếp sợ, ôi Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 9:20">Xin cho họ biết rằng họ chỉ là người phàm.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="cl">Thi Thiên 10</para>
  <para style="s1">Chúa Là Nơi Nương Náu</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Chúa Hằng Hữu, Ngài ở tận nơi đâu?</para>
  <para style="q2" vid="PSA 10:1">Khi nguy khốn sao Ngài đành giấu mặt?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Vì kiêu ngạo, người ác hăm hở đuổi theo người bị hại.</para>
  <para style="q2" vid="PSA 10:2">Nhưng xin cho họ sa vào mưu chước họ đã bày ra.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Bọn người ác khoe khoang về dục vọng;</para>
  <para style="q2" vid="PSA 10:3">theo kẻ tham lam, nguyền rủa, khinh Chúa Hằng Hữu.<verse eid="PSA 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Người ác kiêu ngạo không tìm kiếm Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 10:4">Dường như họ nghĩ Đức Chúa Trời không hiện hữu.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Vì đường lối họ thành công luôn.</para>
  <para style="q2" vid="PSA 10:5">Họ tự cao và luật lệ Chúa quá xa xôi với họ.</para>
  <para style="q2" vid="PSA 10:5">Họ nhạo cười tất cả kẻ thù.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Họ tự nhủ: “Chẳng bao giờ ta bị chao đảo!</para>
  <para style="q2" vid="PSA 10:6">Hạnh phúc luôn luôn và chẳng gặp tai ương!”<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Miệng đầy lời chửi rủa, dối trá, và đe dọa.</para>
  <para style="q2" vid="PSA 10:7">Lưỡi họ toàn lời gây rối và độc ác.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Họ rình rập nơi thôn làng,</para>
  <para style="q2" vid="PSA 10:8">mai phục ám sát người vô tội.</para>
  <para style="q2" vid="PSA 10:8">Bí mật rình mò chờ nạn nhân.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />Họ nằm yên như sư tử ngụy trang,</para>
  <para style="q2" vid="PSA 10:9">để bắt người khốn cùng.</para>
  <para style="q2" vid="PSA 10:9">Họ bắt được người ấy và gỡ ra khỏi lưới.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Các nạn nhân cô thế bị chà nát;</para>
  <para style="q2" vid="PSA 10:10">trước sức mạnh đành phải chịu đầu hàng.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Người ác nhủ thầm: “Chúa chẳng xem việc chúng ta đâu!</para>
  <para style="q2" vid="PSA 10:11">Ngài che mặt, chẳng bao giờ trông thấy!”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Chúa Hằng Hữu, xin trỗi dậy!</para>
  <para style="q2" vid="PSA 10:12">Xin trừng phạt người ác, lạy Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 10:12">Xin đừng quên cứu giúp người khốn cùng!<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Sao để cho ác nhân phỉ báng Đức Chúa Trời?</para>
  <para style="q2" vid="PSA 10:13">Rồi thầm nghĩ: “Chúa không bao giờ tra hỏi.”<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Nhưng lạy Chúa, Chúa thấy rõ những khó khăn sầu khổ.</para>
  <para style="q2" vid="PSA 10:14">Xin Chúa ghi vào và hình phạt ác nhân.</para>
  <para style="q1" vid="PSA 10:14">Nạn nhân chỉ trông chờ nơi Chúa.</para>
  <para style="q2" vid="PSA 10:14">Vì Chúa là Đấng bênh vực người mồ côi.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Xin bẻ gãy cánh tay người độc hại và gian ác!</para>
  <para style="q2" vid="PSA 10:15">Và bắt chúng khai hết những hành vi bạo tàn.<verse eid="PSA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />Chúa Hằng Hữu là Vua muôn đời!</para>
  <para style="q2" vid="PSA 10:16">Các dân sẽ bị diệt khỏi nước Ngài.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Chúa Hằng Hữu đã nghe ước nguyện người khốn khổ.</para>
  <para style="q2" vid="PSA 10:17">Ngài lắng nghe và an ủi tâm hồn.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Ngài bênh vực người bị áp bức và mồ côi,</para>
  <para style="q2" vid="PSA 10:18">để những người sinh ra từ đất không còn gây sợ hãi.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="cl">Thi Thiên 11</para>
  <para style="s1">Chúa Là Nơi Nương Náu</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />Tôi đã ẩn mình trong Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 11:1">Sao các anh cứ nói:</para>
  <para style="q2" vid="PSA 11:1">“Hãy như chim bay về núi để an toàn!<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Vì người ác đang giương cung</para>
  <para style="q2" vid="PSA 11:2">trong bóng tối, sẵn sàng tra tên vào cung,</para>
  <para style="q2" vid="PSA 11:2">để bắn giết người tâm hồn ngay thẳng.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Nếu các nền tảng của luật pháp và trật tự bị phá hủy.</para>
  <para style="q2" vid="PSA 11:3">Người công chính biết phải làm gì?”<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Chúa Hằng Hữu ngự trong Đền Thánh;</para>
  <para style="q2" vid="PSA 11:4">Chúa Hằng Hữu cai trị từ ngôi cao.</para>
  <para style="q1" vid="PSA 11:4">Chúa quan sát con người,</para>
  <para style="q2" vid="PSA 11:4">mắt Chúa tra xét chúng.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />Chúa Hằng Hữu thử nghiệm người công chính.</para>
  <para style="q2" vid="PSA 11:5">Ngài gớm ghê phường gian ác, bạo tàn.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Giáng trên họ mưa lửa với lưu huỳnh,</para>
  <para style="q2" vid="PSA 11:6">thiêu đốt họ trong cơn gió cháy.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Vì Chúa công chính yêu điều ngay thẳng.</para>
  <para style="q2" vid="PSA 11:7">Người lành ngay sẽ nhìn thấy Thiên nhan.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="cl">Thi Thiên 12</para>
  <para style="s1">Xin Cứu Khỏi Người Gian Tà</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu Sê-mi-ni)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Chúa Hằng Hữu ôi, xin cứu giúp,</para>
  <para style="q2" vid="PSA 12:1">vì người yêu mến Ngài không còn nữa!</para>
  <para style="q2" vid="PSA 12:1">Kẻ trung tín cũng biến mất giữa loài người!<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Thiên hạ chỉ nói lời dối gạt,</para>
  <para style="q2" vid="PSA 12:2">miệng tuôn ra câu tán tỉnh lọc lừa.<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Nguyện Chúa cắt các môi nào nịnh hót</para>
  <para style="q2" vid="PSA 12:3">và làm câm những cái lưỡi khoe khoang.<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Là những người từng bảo: “Ta sẽ thắng nhờ ba tấc lưỡi.</para>
  <para style="q2" vid="PSA 12:4">Ta làm chủ môi ta, ta còn khiếp sợ ai!”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Nhưng Chúa Hằng Hữu phán: “Vì người cô thế bị áp bức,</para>
  <para style="q2" vid="PSA 12:5">và người đói khổ rên la,</para>
  <para style="q2" vid="PSA 12:5">Ta sẽ trỗi dậy bảo vệ chúng khỏi những người tác hại.”<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Lời Chúa Hằng Hữu là lời tinh khiết,</para>
  <para style="q2" vid="PSA 12:6">như bạc luyện trong lò gốm,</para>
  <para style="q2" vid="PSA 12:6">được thanh tẩy bảy lần.<verse eid="PSA 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Chúa Hằng Hữu ôi, xin bảo vệ gìn giữ,</para>
  <para style="q2" vid="PSA 12:7">chở che chúng con khỏi những người như vậy mãi mãi,<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />dù người ác chỉ tự do thao túng,</para>
  <para style="q2" vid="PSA 12:8">và việc đê hèn được loài người ca tụng.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="cl">Thi Thiên 13</para>
  <para style="s1">Xin Cứu Giúp trong Hoạn Nạn</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Chúa quên con mãi mãi sao?</para>
  <para style="q2" vid="PSA 13:1">Ngài lánh mặt con đến khi nào?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Bao lâu con còn lo lắng buồn phiền,</para>
  <para style="q2" vid="PSA 13:2">và sao hằng ngày lòng con buồn thảm?</para>
  <para style="q2" vid="PSA 13:2">Đến bao giờ kẻ thù thôi lấn lướt?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Lạy Chúa Hằng Hữu, Đức Chúa Trời con, xin đoái thương và trả lời con!</para>
  <para style="q2" vid="PSA 13:3">Xin cho mắt con được luôn sáng, nếu không, con sẽ chết.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />Kẻo kẻ thù con nói: “Ta đã thắng rồi!”</para>
  <para style="q2" vid="PSA 13:4">Cũng xin đừng để chúng vui mừng khi con ngã.<verse eid="PSA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Con vững tin nơi tình thương cao cả.</para>
  <para style="q2" vid="PSA 13:5">Tim hân hoan trong ân đức cứu sinh.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Con sẽ luôn ca hát tôn vinh</para>
  <para style="q2" vid="PSA 13:6">vì Chúa Hằng Hữu cho con dồi dào ân phước.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="cl">Thi Thiên 14</para>
  <para style="s1">Ngu Dại và Gian Ác của Loài Người</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Người ngu dại tự nhủ:</para>
  <para style="q2" vid="PSA 14:1">“Không có Đức Chúa Trời.”</para>
  <para style="q1" vid="PSA 14:1">Chúng đều hư hoại, hành vi của chúng đáng ghê tởm;</para>
  <para style="q2" vid="PSA 14:1">chẳng một ai làm điều thiện lành!<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Chúa Hằng Hữu từ trời nhìn xuống loài người</para>
  <para style="q2" vid="PSA 14:2">xem có ai sáng suốt khôn ngoan,</para>
  <para style="q2" vid="PSA 14:2">quyết tâm tìm kiếm Đức Chúa Trời.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Nhưng tất cả đều từ chối Chúa;</para>
  <para style="q2" vid="PSA 14:3">cùng nhau trở nên băng hoại.</para>
  <para style="q1" vid="PSA 14:3">Chẳng ai trong số chúng làm điều thiện lành,</para>
  <para style="q2" vid="PSA 14:3">dù một người cũng không.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Người gian ác không bao giờ học hỏi sao?</para>
  <para style="q2" vid="PSA 14:4">Chúng vồ xé dân Ta như ăn bánh,</para>
  <para style="q2" vid="PSA 14:4">và chẳng kêu cầu Chúa Hằng Hữu.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Chúng sẽ chìm trong khiếp sợ, kinh hoàng,</para>
  <para style="q2" vid="PSA 14:5">vì Chúa có mặt giữa người công chính.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Người làm ác phá hỏng dự tính của người nghèo,</para>
  <para style="q2" vid="PSA 14:6">nhưng Chúa là nơi nương thân của người khốn khó.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Ôi ước gì sự cứu rỗi cho Ít-ra-ên sẽ từ Si-ôn đến.</para>
  <para style="q2" vid="PSA 14:7">Khi Chúa khôi phục sự hưng thịnh của dân Ngài,</para>
  <para style="q2" vid="PSA 14:7">con cháu Gia-cốp sẽ reo vui mừng rỡ.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="cl">Thi Thiên 15</para>
  <para style="s1">Điều Kiện Để Làm Công Dân Si-ôn</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Lạy Chúa Hằng Hữu, ai có thể thờ phượng trong đền thánh Chúa?</para>
  <para style="q2" vid="PSA 15:1">Ai có thể bước vào sự hiện diện trên núi thánh Ngài?<verse eid="PSA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Đó là người bước đi ngay thẳng,</para>
  <para style="q2" vid="PSA 15:2">sống thiện lành, suy niệm chân lý trong lòng.<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />Người không hại bạn, không vu oan,</para>
  <para style="q2" vid="PSA 15:3">không đối xử sai trái với hàng xóm, láng giềng,</para>
  <para style="q2" vid="PSA 15:3">không nói lời phỉ báng.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Người ấy coi khinh người xấu xa tội ác,</para>
  <para style="q2" vid="PSA 15:4">nhưng tôn quý người kính thờ Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 15:4">Người giữ lời hứa, dù bị tổn hại.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Người không cho vay tiền lấy lãi,</para>
  <para style="q2" vid="PSA 15:5">không ăn hối lộ hại dân lành.</para>
  <para style="q2" vid="PSA 15:5">Người như thế sẽ đứng vững vàng mãi mãi.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="cl">Thi Thiên 16</para>
  <para style="s1">Tin Cậy và An Ninh trong Chúa</para>
  <para style="d">(Thơ của Đa-vít, theo điệu Mít-tam)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Lạy Chúa, xin phù hộ con,</para>
  <para style="q2" vid="PSA 16:1">vì con trú ẩn trong Ngài.<verse eid="PSA 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Con từng thưa với Chúa Hằng Hữu:</para>
  <para style="q2" vid="PSA 16:2">“Ngài là Chủ của con!</para>
  <para style="q2" vid="PSA 16:2">Bên ngoài Ngài con chẳng tìm được phước nơi nào khác.”<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Còn các người thánh trên đất,</para>
  <para style="q2" vid="PSA 16:3">họ là những bậc cao trọng mà tôi rất quý mến.<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Còn những người thờ phượng tà thần,</para>
  <para style="q2" vid="PSA 16:4">chỉ thấy phiền muộn gia tăng.</para>
  <para style="q1" vid="PSA 16:4">Con quyết không dâng lễ bằng máu cho tà thần</para>
  <para style="q2" vid="PSA 16:4">cũng không đọc tên chúng trên môi.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Chúa Hằng Hữu là phần thưởng<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">Nt cái chén</char></note> và cơ nghiệp của con.</para>
  <para style="q2" vid="PSA 16:5">Ngài bảo vệ phần thuộc về con.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Phần đất Ngài ban cho con là nơi tốt đẹp.</para>
  <para style="q2" vid="PSA 16:6">Phải, cơ nghiệp con thật tuyệt vời.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Con ca ngợi Chúa Hằng Hữu, Đấng khuyên bảo con;</para>
  <para style="q2" vid="PSA 16:7">Đêm đêm, lòng con hằng nhắc nhở.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Con hằng để Chúa Hằng Hữu trước mặt con.</para>
  <para style="q2" vid="PSA 16:8">Con không nao sờn vì Ngài ở bên cạnh con.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Vì thế lòng vui vẻ, hồn mừng rỡ.</para>
  <para style="q2" vid="PSA 16:9">Thân xác con nghỉ ngơi trong bình an.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Vì Chúa không bỏ linh hồn con trong âm phủ</para>
  <para style="q2" vid="PSA 16:10">không để người thánh Ngài rữa nát.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Chúa sẽ chỉ cho con, con đường sự sống,</para>
  <para style="q2" vid="PSA 16:11">trong sự hiện diện của Chúa, con tràn đầy niềm vui,</para>
  <para style="q2" vid="PSA 16:11">bên phải Ngài là sự hoan hỉ muôn đời.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="cl">Thi Thiên 17</para>
  <para style="s1">Lời Cầu Nguyện của Đa-vít Cầu Chúa Phù Hộ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Chúa ôi, xin nghe lời cầu nguyện chân thành.<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">Nt xin nghe sự công chính</char></note></para>
  <para style="q2" vid="PSA 17:1">Lắng tai nghe tiếng kêu cứu của con.</para>
  <para style="q1" vid="PSA 17:1">Xin chú ý những lời con cầu khẩn,</para>
  <para style="q2" vid="PSA 17:1">vì chúng xuất phát từ môi miệng chẳng dối gian.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Xin chính Chúa minh oan cho con,</para>
  <para style="q2" vid="PSA 17:2">vì Ngài luôn xét xử công minh.<verse eid="PSA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Dù Chúa dò xét lòng con</para>
  <para style="q2" vid="PSA 17:3">khảo hạch con lúc đêm tối,</para>
  <para style="q2" vid="PSA 17:3">hay thử nghiệm con, Chúa sẽ không tìm thấy gì.</para>
  <para style="q2" vid="PSA 17:3">Vì con đã quyết định miệng con không phạm tội.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Còn hành động của loài người,</para>
  <para style="q2" vid="PSA 17:4">con nhờ lời Chúa giữ mình</para>
  <para style="q2" vid="PSA 17:4">không theo đường lối bạo tàn.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Bước chân con bám chặt trên đường Chúa;</para>
  <para style="q2" vid="PSA 17:5">Con không hề trượt bước.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 17:6">Con cầu khẩn vì biết Ngài sẽ đáp.</para>
  <para style="q2" vid="PSA 17:6">Xin nghiêng tai nghe tiếng con kêu van.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Xin tỏ rõ tình yêu thương cao cả.</para>
  <para style="q2" vid="PSA 17:7">Lạy Chúa, là Đấng luôn đưa tay hữu che chở</para>
  <para style="q2" vid="PSA 17:7">cho những người nương náu nơi Ngài thoát khỏi quân thù.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Xin bảo vệ con như con ngươi của mắt.</para>
  <para style="q2" vid="PSA 17:8">Giấu con dưới bóng cánh quyền năng.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Cho khỏi tay ác nhân đang đuổi theo,</para>
  <para style="q2" vid="PSA 17:9">và khỏi tử thù vây quanh.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Chúng đã đóng chặt lòng chai đá.</para>
  <para style="q2" vid="PSA 17:10">Miệng nói lời khoác lác kiêu căng!<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Con đi đâu cũng gặp bọn hung tàn,</para>
  <para style="q2" vid="PSA 17:11">mắt sẵn sàng chờ xem con sa ngã.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Thật chẳng khác sư tử đói mồi,</para>
  <para style="q2" vid="PSA 17:12">sư tử tơ phục nơi kín rình mồi.<verse eid="PSA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Chúa ôi, xin trỗi dậy, đón và đánh hạ chúng!</para>
  <para style="q2" vid="PSA 17:13">Dùng gươm giải cứu con khỏi người ác!<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Lạy Chúa,</para>
  <para style="q2" vid="PSA 17:14">bằng quyền năng của tay Ngài,</para>
  <para style="q2" vid="PSA 17:14">hủy diệt những ai mong đợi thế gian này làm phần thưởng họ.</para>
  <para style="q1" vid="PSA 17:14">Nhưng cho những ai đói trông của cải Ngài được thỏa mãn.</para>
  <para style="q2" vid="PSA 17:14">Nguyện con cái họ được sung túc,</para>
  <para style="q2" vid="PSA 17:14">thừa hưởng gia tài của tổ tiên.<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Về phần con, nhờ công chính, sẽ nhìn thấy Thiên nhan.</para>
  <para style="q2" vid="PSA 17:15">Khi thức giấc, con sẽ đối mặt với Ngài và được thỏa lòng.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="cl">Thi Thiên 18</para>
  <para style="s1">Cảm Tạ Chúa Vì Thắng Được Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít, đầy tớ Chúa viết khi được cứu khỏi tay kẻ thù và tay Sau-lơ, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Chúa Hằng Hữu là nguồn năng lực,</para>
  <para style="q2" vid="PSA 18:1">con kính yêu Ngài.<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />Chúa Hằng Hữu là vầng đá và đồn lũy tôi, Đấng giải cứu tôi;</para>
  <para style="q1" vid="PSA 18:2">Chúa Hằng Hữu là vầng đá tôi, nơi tôi được bảo vệ.</para>
  <para style="q1" vid="PSA 18:2">Ngài là tấm khiên, là nguồn cứu rỗi của con</para>
  <para style="q2" vid="PSA 18:2">và nơi con được che chở.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Con kêu cầu Chúa Hằng Hữu, Đấng đáng ca ngợi,</para>
  <para style="q2" vid="PSA 18:3">và được Ngài giải cứu khỏi quân thù.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Dây tử vong đã quấn lấy con;</para>
  <para style="q2" vid="PSA 18:4">những dòng thác hủy diệt tràn ngập con,<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Âm phủ thắt chặt dây oan nghiệt;</para>
  <para style="q2" vid="PSA 18:5">lưới tử thần chằng chịt dưới chân.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Trong lúc hiểm nguy, con kêu cầu Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 18:6">khóc xin Đức Chúa Trời cứu con.</para>
  <para style="q1" vid="PSA 18:6">Từ đền thánh Ngài nghe tiếng con;</para>
  <para style="q2" vid="PSA 18:6">tiếng con kêu đã thấu đến tai Ngài.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Bỗng nhiên đất động và rung chuyển.</para>
  <para style="q2" vid="PSA 18:7">Nền các núi cũng rúng động;</para>
  <para style="q2" vid="PSA 18:7">vì Chúa nổi giận.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Từ mũi Chúa, khói bay;</para>
  <para style="q2" vid="PSA 18:8">miệng Ngài phun ngọn lửa.</para>
  <para style="q2" vid="PSA 18:8">Làm than cháy đỏ hực.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Chúa rẽ trời ngự giá;</para>
  <para style="q2" vid="PSA 18:9">mây đen kịt phủ chân Ngài.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Ngài cỡi chê-ru-bim và bay,</para>
  <para style="q2" vid="PSA 18:10">Ngài bay lượn trên cánh gió.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Ngài lấy bóng tối làm màn bao quanh,</para>
  <para style="q2" vid="PSA 18:11">trướng phủ Ngài là những đám mây đen chứa nước mưa trên trời.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Bỗng nhiên, mặt Chúa chiếu hào quang rực rỡ</para>
  <para style="q2" vid="PSA 18:12">xuyên qua mây như tên lửa sáng ngời.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Chúa Hằng Hữu cho sấm sét rền trời;</para>
  <para style="q2" vid="PSA 18:13">tiếng của Đấng Chí Cao vang dội</para>
  <para style="q2" vid="PSA 18:13">tạo mưa đá, lửa hừng, gió thổi.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Chúa bắn tên, quân thù tán loạn;</para>
  <para style="q2" vid="PSA 18:14">hàng ngũ vỡ tan vì chớp nhoáng.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Đáy biển lộ ra,</para>
  <para style="q2" vid="PSA 18:15">các nền của trái đất trần trụi,</para>
  <para style="q2" vid="PSA 18:15">vì lời Chúa Hằng Hữu quở mắng và hơi thở từ mũi Ngài toát ra.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Chúa xuống từ trời cao;</para>
  <para style="q2" vid="PSA 18:16">kéo con khỏi nước sâu.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Giải thoát con khỏi kẻ thù cường bạo,</para>
  <para style="q2" vid="PSA 18:17">kẻ ghét con mạnh sức hơn con.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Chúng tấn công con trong ngày gian truân,</para>
  <para style="q2" vid="PSA 18:18">nhưng Chúa Hằng Hữu đã đưa tay phù hộ.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Chúa đem con vào chỗ khoảng khoát;</para>
  <para style="q2" vid="PSA 18:19">giải cứu con vì Ngài ưa thích con.<verse eid="PSA 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Chúa Hằng Hữu đối đãi với con theo đức công chính,</para>
  <para style="q2" vid="PSA 18:20">thưởng cho con vì tay con trong sạch.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Con tuân hành hết cả điều răn,</para>
  <para style="q2" vid="PSA 18:21">không dám phạm tội, từ bỏ Đức Chúa Trời.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Luật lệ Chúa hằng ở trước mặt con,</para>
  <para style="q2" vid="PSA 18:22">mệnh lệnh Ngài con không sơ suất.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Trước mặt Đức Chúa Trời, con chẳng gì đáng trách;</para>
  <para style="q2" vid="PSA 18:23">con đã giữ con khỏi tội lỗi trong đời.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Chúa Hằng Hữu đối đãi với con theo đức công chính,</para>
  <para style="q2" vid="PSA 18:24">thưởng cho con vì tay con trong sạch.<verse eid="PSA 18:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Chúa thành tín đối với ai trung tín,</para>
  <para style="q2" vid="PSA 18:25">trọn vẹn đối với ai thanh liêm.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Chúa thánh sạch đối với ai trong trắng,</para>
  <para style="q2" vid="PSA 18:26">nhưng nghiêm minh đối với kẻ gian ngoa.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Chúa cứu vớt những người khiêm tốn,</para>
  <para style="q2" vid="PSA 18:27">nhưng hạ thấp người có mắt tự cao.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Xin cho đèn con sáng mãi,</para>
  <para style="q2" vid="PSA 18:28">lạy Chúa Hằng Hữu, Đức Chúa Trời con, chiếu rọi nơi tối tăm của con.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Nhờ sức Chúa, con dẹp tan quân địch;</para>
  <para style="q2" vid="PSA 18:29">cùng với Đức Chúa Trời con vượt tường thành.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Đức Chúa Trời thật muôn phần hoàn hảo.</para>
  <para style="q2" vid="PSA 18:30">Lời Ngài toàn chân lý tinh thuần.</para>
  <para style="q1" vid="PSA 18:30">Chúa vẫn là tấm khiên che chở,</para>
  <para style="q2" vid="PSA 18:30">cho những ai nương náu nơi Ngài.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Ngoài Chúa Hằng Hữu, ai là Đức Chúa Trời?</para>
  <para style="q2" vid="PSA 18:31">Ngoài Chúa ra, ai là Vầng Đá muôn đời?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Đức Chúa Trời trang bị cho con năng lực,</para>
  <para style="q2" vid="PSA 18:32">làm cho đường lối con trọn vẹn.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />Chân con nhanh nhẹn như chân nai,</para>
  <para style="q2" vid="PSA 18:33">đứng trên đỉnh núi cao an toàn.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Chúa luyện tay con chinh chiến,</para>
  <para style="q2" vid="PSA 18:34">cánh tay con giương nổi cung đồng.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Chúa trao con tấm khiên cứu rỗi,</para>
  <para style="q2" vid="PSA 18:35">tay phải Ngài bảo vệ ẵm bồng con,</para>
  <para style="q2" vid="PSA 18:35">Chúa hạ mình<note caller="+" style="f"><char style="fr" closed="false">18:35 </char><char style="ft" closed="false">Nt sự nhân từ Chúa</char></note> cho con được tôn cao.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Trước chân con, Chúa mở con đường,</para>
  <para style="q2" vid="PSA 18:36">nên con chẳng bao giờ vấp ngã.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Con đuổi theo bắt kịp quân thù;</para>
  <para style="q2" vid="PSA 18:37">chỉ trở về sau khi tận diệt.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Con đánh chúng đến khi ngưng đứng dậy;</para>
  <para style="q2" vid="PSA 18:38">chúng ngã dài bên dưới chân con.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Chúa trang bị con sức mạnh cho chiến trận,</para>
  <para style="q2" vid="PSA 18:39">khiến quân thù phục dưới chân con.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Chúa khiến địch quay lưng trốn chạy,</para>
  <para style="q2" vid="PSA 18:40">bọn ghét con bị đánh tan hoang.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Họ van xin, không ai tiếp cứu,</para>
  <para style="q2" vid="PSA 18:41">họ kêu cầu, Chúa chẳng trả lời.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Con nghiền nát chúng ra như bụi,</para>
  <para style="q2" vid="PSA 18:42">ném họ như bùn đất ngoài đường.<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Chúa cứu con khỏi sự công kích của con người,</para>
  <para style="q2" vid="PSA 18:43">nâng con lên làm đầu các nước,</para>
  <para style="q2" vid="PSA 18:43">cho những dân tộc xa lạ thần phục con.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Vừa nghe tiếng con họ vội vàng quy phục,</para>
  <para style="q2" vid="PSA 18:44">người nước ngoài, gọi dạ, bảo vâng.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Chúng mất hết tinh thần, sức lực</para>
  <para style="q2" vid="PSA 18:45">bỏ thành trì kiên cố quy hàng.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />Chúa Hằng Hữu hằng sống! Ngợi tôn Vầng Đá của con!</para>
  <para style="q2" vid="PSA 18:46">Nguyện Đức Chúa Trời, Đấng Cứu Rỗi của con được tôn cao!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Ngài là Đấng công minh báo oán cho con.</para>
  <para style="q2" vid="PSA 18:47">Khiến các dân tộc quy phục con.<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />Cứu thoát con khỏi tay quân địch,</para>
  <para style="q2" vid="PSA 18:48">nâng con lên cao hơn mọi kẻ thù,</para>
  <para style="q2" vid="PSA 18:48">cứu con khỏi người tàn bạo.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Chính vì thế, con hằng ca ngợi,</para>
  <para style="q2" vid="PSA 18:49">tôn vinh Chúa Hằng Hữu giữa muôn dân.</para>
  <para style="q2" vid="PSA 18:49">Chúc tụng Thánh Danh Ngài khắp chốn.<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Chúa ban cho vua chiến thắng lớn lao</para>
  <para style="q2" vid="PSA 18:50">và làm ơn cho người được xức dầu,</para>
  <para style="q2" vid="PSA 18:50">cho Đa-vít và dòng dõi người mãi mãi.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="cl">Thi Thiên 19</para>
  <para style="s1">Công Việc và Lời của Chúa</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Bầu trời phản ánh vinh quang của Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 19:1">không gian chứng tỏ quyền năng của Ngài.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Ngày ngày rao giảng về vinh quang Chúa,</para>
  <para style="q2" vid="PSA 19:2">đêm đêm truyền thông chân lý của Ngài,<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />không lên tiếng nói, không dùng thanh âm,</para>
  <para style="q2" vid="PSA 19:3">không gian như thinh lặng.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Thế nhưng ý tưởng của vạn vật được loan đi mọi miền,</para>
  <para style="q2" vid="PSA 19:4">loan xa đến cuối khung trời.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">Trên từng cao Đức Chúa Trời đã căn lều cho mặt trời.<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Mặt trời trông như tân lang</para>
  <para style="q2" vid="PSA 19:5">ra khỏi loan phòng.</para>
  <para style="q1" vid="PSA 19:5">Như chàng lực sĩ hân hoan</para>
  <para style="q2" vid="PSA 19:5">trong ngày tranh tài.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Mặt trời mọc lên từ chân trời này</para>
  <para style="q2" vid="PSA 19:6">chạy vòng đến tận chân trời kia</para>
  <para style="q2" vid="PSA 19:6">không gì tránh khỏi sức nóng mặt trời.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Luật Chúa Hằng Hữu trọn vẹn, phục hưng tâm linh,<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Nt luật pháp Jahweh là trọn vẹn, cải hoán linh hồn</char></note></para>
  <para style="q2" vid="PSA 19:7">chứng cớ Chúa Hằng Hữu là chắc chắn,</para>
  <para style="q2" vid="PSA 19:7">khiến cho người dại nên người khôn ngoan.<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Nt chứng cớ Jahweh là trong sạch, khiến người đơn sơ nên khôn ngoan</char></note><verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Thánh chỉ Chúa Hằng Hữu ngay thẳng làm tâm hồn hoan hỉ,</para>
  <para style="q2" vid="PSA 19:8">điều răn Chúa Hằng Hữu trong sạch, làm sáng mắt,<note caller="+" style="f"><char style="fr" closed="false">19:8 </char><char style="ft" closed="false">Nt cương lĩnh Jahweh là đúng, làm cho lòng vui; mệnh lệnh Jahweh rõ ràng, rọi ánh sáng cho mắt </char></note> sáng lòng.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Sự kính sợ Chúa Hằng Hữu là tinh khiết muôn đời,</para>
  <para style="q2" vid="PSA 19:9">mệnh lệnh Chúa Hằng Hữu vững bền và công chính.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Vàng ròng đâu quý bằng,</para>
  <para style="q2" vid="PSA 19:10">mật ong nào sánh được.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Những lời răn giới giãi bày khôn ngoan</para>
  <para style="q2" vid="PSA 19:11">ai tuân giữ được, Ngài ban thưởng.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Người khôn nhanh chóng nhìn nhận lỗi lầm<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">Nt Ai có thể biện biệt tất cả những sai lầm của mình</char></note></para>
  <para style="q2" vid="PSA 19:12">xin tha những lỗi mình không biết.<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">Nt bí mật</char></note><verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Xin Chúa giữ con khỏi tội “cố tình làm sai.”</para>
  <para style="q2" vid="PSA 19:13">Không đam mê tái phạm,</para>
  <para style="q1" vid="PSA 19:13">tránh xa cạm bẫy quanh con.</para>
  <para style="q2" vid="PSA 19:13">Cho con thoát khỏi lưới tròng</para>
  <para style="q2" vid="PSA 19:13">và con được Chúa kể là toàn hảo.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Kính lạy Chúa Hằng Hữu, Vầng Đá của con, Đấng cứu vớt con,</para>
  <para style="q2" vid="PSA 19:14">nguyện lời nói của miệng con, và suy ngẫm của lòng con đẹp ý Ngài.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="cl">Thi Thiên 20</para>
  <para style="s1">Xin Thắng Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Nguyện Chúa Hằng Hữu đáp lời người lúc khó khăn.</para>
  <para style="q2" vid="PSA 20:1">Cầu Đức Chúa Trời của Gia-cốp phù hộ.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Từ đền thánh, xin Chúa đưa tay vùa giúp,</para>
  <para style="q2" vid="PSA 20:2">từ Si-ôn, người được đỡ nâng.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Xin Chúa nhớ mọi lễ vật người dâng,</para>
  <para style="q2" vid="PSA 20:3">hài lòng về những tế lễ thiêu của người.<verse eid="PSA 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Nguyện Ngài cho người những điều mong ước</para>
  <para style="q2" vid="PSA 20:4">và hoàn thành kế hoạch người dự trù.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Chúng con reo mừng nghe người được cứu,</para>
  <para style="q2" vid="PSA 20:5">nhân danh Đức Chúa Trời, giương cao ngọn cờ.</para>
  <para style="q2" vid="PSA 20:5">Xin Ngài đáp ứng mọi lời người cầu nguyện.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Giờ con biết Chúa Hằng Hữu cứu người được chọn.<note caller="+" style="f"><char style="fr" closed="false">20:6 </char><char style="ft" closed="false">Nt người được xức dầu</char></note></para>
  <para style="q2" vid="PSA 20:6">Từ trời cao, Ngài đáp lời người cầu xin</para>
  <para style="q2" vid="PSA 20:6">người đắc thắng nhờ tay Chúa nâng đỡ.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Người ta cậy binh xa, chiến mã</para>
  <para style="q2" vid="PSA 20:7">chúng con nhờ Danh Chúa Hằng Hữu, Đức Chúa Trời chúng con.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Thế nên, họ thất bại và tử trận</para>
  <para style="q2" vid="PSA 20:8">còn chúng con, vùng dậy, đứng vững vàng.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Xin cứu vua chúng con, ôi Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 20:9">Xin đáp lời khi chúng con khẩn cầu.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="cl">Thi Thiên 21</para>
  <para style="s1">Ca Ngợi Vì Được Cứu</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Lạy Chúa Hằng Hữu, vua vui mừng nhờ năng lực Chúa,</para>
  <para style="q2" vid="PSA 21:1">được đắc thắng, người hân hoan biết bao.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Chúa ban điều lòng người mơ ước,</para>
  <para style="q2" vid="PSA 21:2">không từ chối lời môi miệng cầu xin.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Chúa đãi người thật dồi dào hạnh phước,</para>
  <para style="q2" vid="PSA 21:3">đưa lên ngôi, đội cho vương miện vàng.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Người cầu xin được sống dài lâu,</para>
  <para style="q2" vid="PSA 21:4">Chúa cho đời người dài đến vô tận.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Nhờ chiến thắng Chúa ban,</para>
  <para style="q2" vid="PSA 21:5">người quang vinh tuyệt đỉnh,</para>
  <para style="q2" vid="PSA 21:5">được bao phủ trong vinh dự, và uy nghiêm.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Ngài tặng người những ơn phước vĩnh hằng,</para>
  <para style="q2" vid="PSA 21:6">cho người hân hoan bởi Ngài hiện diện.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Vì vua đặt niềm tin nơi Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 21:7">nơi Đấng Chí Cao đầy dẫy nhân từ,</para>
  <para style="q2" vid="PSA 21:7">vua sẽ không lay chuyển, không suy vong.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Chúa sẽ ra tay tìm bắt kẻ thù.</para>
  <para style="q2" vid="PSA 21:8">Tay hữu Chúa sẽ nắm lấy họ.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Chúa xuất hiện, sẽ khiến họ như lò lửa,</para>
  <para style="q2" vid="PSA 21:9">trong cơn giận họ bị Ngài nuốt,</para>
  <para style="q2" vid="PSA 21:9">ngọn lửa hừng sẽ đốt họ tiêu tan.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Con cháu họ tuyệt diệt khỏi mặt đất,</para>
  <para style="q2" vid="PSA 21:10">không còn ai sống sót giữa cõi đời.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Chống đối Chúa, họ mưu toan ác kế,</para>
  <para style="q2" vid="PSA 21:11">chẳng bao giờ hy vọng được thành công.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Chúa sẽ khiến họ quay lưng chạy trốn,</para>
  <para style="q2" vid="PSA 21:12">khi thấy tay Chúa giương cung.<verse eid="PSA 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Nguyện Chúa Hằng Hữu được tán dương về năng lực của Ngài.</para>
  <para style="q2" vid="PSA 21:13">Chúng con xin ca tụng Chúa quyền oai.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="cl">Thi Thiên 22</para>
  <para style="s1">Tiếng Than Vãn và Bài Ca Ngợi</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu “Con nai buổi bình minh”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Đức Chúa Trời ôi, Đức Chúa Trời ôi, sao Ngài đành bỏ con?</para>
  <para style="q2" vid="PSA 22:1">Đứng xa không cứu, không nghe tiếng con kêu nài?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Đức Chúa Trời con ôi, con kêu cứu mỗi ngày Ngài không đáp.</para>
  <para style="q2" vid="PSA 22:2">Con nài xin mỗi đêm, nào được yên nghỉ.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Chúa vẫn ở trên ngôi,</para>
  <para style="q2" vid="PSA 22:3">Ngài là đối tượng ngợi tôn của Ít-ra-ên.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Các tổ phụ ngày xưa tin tưởng Chúa.</para>
  <para style="q2" vid="PSA 22:4">Ngài đưa tay giải thoát lúc nguy nan.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Họ kêu xin liền được Ngài cứu giúp.</para>
  <para style="q2" vid="PSA 22:5">Tin cậy Chúa chẳng thất vọng bao giờ.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Nhưng con đây chỉ là sâu bọ, chẳng phải người,</para>
  <para style="q2" vid="PSA 22:6">là ô nhục của con người và bị thế nhân khinh bỉ.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Ai thấy con cũng buông lời chế giễu.</para>
  <para style="q2" vid="PSA 22:7">Người này trề môi, người khác lắc đầu:<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />“Có phải nó giao thác đời mình cho Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 22:8">Hãy để Chúa Hằng Hữu cứu giúp cho!</para>
  <para style="q1" vid="PSA 22:8">Nếu Chúa Hằng Hữu yêu quý vui lòng về nó,</para>
  <para style="q2" vid="PSA 22:8">hãy để Chúa Hằng Hữu đến giải thoát cho!”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Chúa đã đem con ra khỏi lòng mẹ</para>
  <para style="q2" vid="PSA 22:9">khiến con tin cậy Chúa khi còn bú mẹ.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Từ lòng mẹ, con được giao cho Chúa.</para>
  <para style="q2" vid="PSA 22:10">Ngài là Đức Chúa Trời con trước lúc con ra đời.<verse eid="PSA 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Tai ương cận kề không ai cứu giúp,</para>
  <para style="q2" vid="PSA 22:11">Chúa ôi, xin đừng lìa bỏ con.<verse eid="PSA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Kẻ thù địch đang vây quanh hung hãn;</para>
  <para style="q2" vid="PSA 22:12">dữ dằn như bò đực Ba-san!<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Há rộng miệng muốn ăn tươi nuốt sống,</para>
  <para style="q2" vid="PSA 22:13">như sư tử gầm thét xông vào mồi.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Thân con bủn rủn,</para>
  <para style="q2" vid="PSA 22:14">xương cốt con rã rời.</para>
  <para style="q1" vid="PSA 22:14">Trái tim con như sáp,</para>
  <para style="q2" vid="PSA 22:14">tan chảy trong con.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Năng lực con cằn cỗi như mảnh sành.</para>
  <para style="q2" vid="PSA 22:15">Lưỡi dán chặt, khô trong cổ họng.</para>
  <para style="q2" vid="PSA 22:15">Chúa đặt con trong cát bụi tử vong.<verse eid="PSA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Bầy chó săn lố nhố vây bọc con;</para>
  <para style="q2" vid="PSA 22:16">lũ hung ác tiến lại đứng vây quanh.</para>
  <para style="q2" vid="PSA 22:16">Tay chân con đều bị họ đâm thủng.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Con có thể đếm xương, từng chiếc.</para>
  <para style="q2" vid="PSA 22:17">Mắt long sòng sọc, họ nhìn chăm con,<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Y phục con, họ lấy chia làm phần,</para>
  <para style="q2" vid="PSA 22:18">bắt thăm để lấy chiếc áo choàng của con.<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">Ctd rút thăm định phần</char></note><verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Chúa Hằng Hữu ơi, xin đừng lìa xa con!</para>
  <para style="q2" vid="PSA 22:19">Ngài là nguồn năng lực của con, xin cứu giúp con!<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Xin cứu thân con thoát khỏi lưỡi gươm;</para>
  <para style="q2" vid="PSA 22:20">mạng sống con khỏi sư sài lang nanh vuốt của những con chó.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Cho con thoát sư tử mồm đang há,</para>
  <para style="q2" vid="PSA 22:21">hẳn Ngài cứu con thoát khỏi sừng bò rừng.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Con sẽ truyền Danh Chúa cho anh chị em con.</para>
  <para style="q2" vid="PSA 22:22">Giữa hội chúng dâng lời ca ngợi Chúa.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Hãy ngợi tôn Chúa Hằng Hữu, hỡi những người kính sợ Chúa!</para>
  <para style="q2" vid="PSA 22:23">Hãy tôn vinh Ngài, hỡi con cháu Gia-cốp!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Vì Chúa không khinh ghét người cùng khốn.<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="ft" closed="false">Nt ghét hoạn nạn của người bị hoạn nạn</char></note></para>
  <para style="q2" vid="PSA 22:24">Ngài không xây mặt khỏi họ,</para>
  <para style="q2" vid="PSA 22:24">nhưng nghe tiếng họ nài xin.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Tôi sẽ ca tụng Chúa giữa kỳ đại hội.</para>
  <para style="q2" vid="PSA 22:25">Và làm trọn lời thề trước tín dân.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Người khốn khổ sẽ ăn uống thỏa thuê.</para>
  <para style="q2" vid="PSA 22:26">Người tìm kiếm Chúa Hằng Hữu sẽ tôn ngợi Ngài.</para>
  <para style="q2" vid="PSA 22:26">Lòng họ tràn ngập niềm vui bất tận.<verse eid="PSA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Cả địa cầu sẽ nhớ Chúa Hằng Hữu và quay về với Ngài.</para>
  <para style="q2" vid="PSA 22:27">Dân các nước sẽ cúi đầu thờ lạy Chúa.<verse eid="PSA 22:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Vì việc thống trị là quyền Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 22:28">Ngài làm vua cai quản hết muôn dân.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Tất cả người giàu trên thế gian ăn uống và thờ phượng.</para>
  <para style="q2" vid="PSA 22:29">Mọi người có đời sống ngắn ngủi,</para>
  <para style="q1" vid="PSA 22:29">thân xác sẽ chôn vào cát bụi,</para>
  <para style="q2" vid="PSA 22:29">tất cả đều phải quỳ lạy Ngài.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Con cháu chúng ta cũng sẽ phục vụ Ngài.</para>
  <para style="q2" vid="PSA 22:30">Các thế hệ tương lai sẽ được nghe về những việc diệu kỳ của Chúa.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Thế hệ tương lai sẽ rao truyền sự công chính của Chúa.</para>
  <para style="q2" vid="PSA 22:31">Rằng chính Chúa đã làm mọi điều đó.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="cl">Thi Thiên 23</para>
  <para style="s1">Người Chăn và Con Chiên</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Chúa Hằng Hữu là Đấng dắt chăn con;</para>
  <para style="q2" vid="PSA 23:1">nên con chẳng thấy thiếu thốn.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />Chúa cho an nghỉ giữa đồng cỏ xanh tươi;</para>
  <para style="q2" vid="PSA 23:2">Ngài dẫn đưa đến bờ suối trong lành.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Ngài phục hồi linh hồn con.</para>
  <para style="q2" vid="PSA 23:3">Dìu dắt con vào đường ngay thẳng,</para>
  <para style="q2" vid="PSA 23:3">vì Danh Thánh Chúa.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Dù khi con bước đi</para>
  <para style="q2" vid="PSA 23:4">trong thung lũng của bóng sự chết,</para>
  <para style="q1" vid="PSA 23:4">con sẽ chẳng sợ điều nào ác hại,</para>
  <para style="q2" vid="PSA 23:4">vì Chúa ở bên con.</para>
  <para style="q1" vid="PSA 23:4">Cây trượng và cây gậy của Chúa</para>
  <para style="q2" vid="PSA 23:4">bảo vệ và an ủi con.<verse eid="PSA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Chúa dọn tiệc đãi con</para>
  <para style="q2" vid="PSA 23:5">trước mặt những người thù nghịch con.</para>
  <para style="q1" vid="PSA 23:5">Ngài xức dầu cho đầu con.</para>
  <para style="q2" vid="PSA 23:5">Cho ly con tràn đầy.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Chắc chắn phước hạnh và tình thương sẽ theo con trọn đời,</para>
  <para style="q2" vid="PSA 23:6">con sẽ sống trong nhà Chúa Hằng Hữu mãi mãi.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="cl">Thi Thiên 24</para>
  <para style="s1">Vua Vinh Quang vào Si-ôn</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Địa cầu của Chúa và vạn vật trong đó.</para>
  <para style="q2" vid="PSA 24:1">Thế gian và mọi người trên đất đều thuộc về Ngài.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Chúa đã tạo đất khô gần đại dương</para>
  <para style="q2" vid="PSA 24:2">và bên cạnh sông ngòi, lập đồng bằng.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Ai sẽ được lên núi của Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 24:3">Ai có thể đứng nơi thánh địa Ngài?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Chỉ những người tay sạch lòng ngay,</para>
  <para style="q2" vid="PSA 24:4">không thờ phượng các thần tượng</para>
  <para style="q2" vid="PSA 24:4">và không thề nguyền gian dối.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Họ sẽ nhận phước từ Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 24:5">và có mối tương giao mật thiết với Đức Chúa Trời, Đấng cứu rỗi mình.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Đó là dòng dõi của người tìm kiếm Chúa,</para>
  <para style="q2" vid="PSA 24:6">chiêm ngưỡng Thiên nhan, lạy Đức Chúa Trời của Gia-cốp.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Hỡi các cửa hãy ngước đầu lên!</para>
  <para style="q2" vid="PSA 24:7">Hỡi các cánh cổng xưa hãy tung mở,</para>
  <para style="q2" vid="PSA 24:7">để Vua Vinh Quang vào.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Vua Vinh Quang là ai?</para>
  <para style="q2" vid="PSA 24:8">Là Chúa Hằng Hữu đầy sức mạnh và quyền năng;</para>
  <para style="q2" vid="PSA 24:8">Chúa Hằng Hữu vô địch trong chiến trận.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Hỡi các cửa hãy ngước đầu lên!</para>
  <para style="q2" vid="PSA 24:9">Hỡi các cánh cổng xưa hãy tung mở,</para>
  <para style="q2" vid="PSA 24:9">để Vua Vinh Quang vào.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Vua Vinh Quang là ai?</para>
  <para style="q2" vid="PSA 24:10">Là Chúa Hằng Hữu Vạn Quân—</para>
  <para style="q2" vid="PSA 24:10">Ngài là Vua Vinh Quang.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="cl">Thi Thiên 25</para>
  <para style="s1">Xin Phù Hộ và Xóa Tội</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Lạy Chúa Hằng Hữu, linh hồn con hướng về Chúa.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Đức Chúa Trời ôi, con tin cậy Ngài luôn!</para>
  <para style="q2" vid="PSA 25:2">Xin đừng để con hổ thẹn,</para>
  <para style="q2" vid="PSA 25:2">đừng cho kẻ thù thắng con.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Không ai hy vọng nơi Chúa mà bị hổ thẹn,</para>
  <para style="q2" vid="PSA 25:3">chỉ những kẻ phản trắc phải tủi nhục đau buồn.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Xin chỉ cho con đường lối, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 25:4">và dạy con nẻo đường Ngài.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Xin dẫn con đi vào chân lý và khuyên bảo con,</para>
  <para style="q2" vid="PSA 25:5">vì Ngài là Đức Chúa Trời, Đấng cứu rỗi con.</para>
  <para style="q2" vid="PSA 25:5">Suốt ngày con hy vọng trong Ngài.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Xin nhớ lại, ôi Chúa Hằng Hữu, đức nhân từ thương xót của Ngài,</para>
  <para style="q2" vid="PSA 25:6">như nghìn xưa Chúa vẫn làm.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Xin đừng nhớ hành vi nổi loạn của con thời tuổi trẻ.</para>
  <para style="q2" vid="PSA 25:7">Xin nhớ đến con tùy theo lòng nhân từ</para>
  <para style="q2" vid="PSA 25:7">và thương xót của Ngài, lạy Chúa Hằng Hữu.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Chúa Hằng Hữu thiện lành và chính trực;</para>
  <para style="q2" vid="PSA 25:8">Ngài giáo huấn những người lạc đường.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Dẫn người khiêm cung theo chân lý,</para>
  <para style="q2" vid="PSA 25:9">dạy họ thánh luật kỷ cương.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Đường lối Chúa Hằng Hữu là nhân từ chân thật</para>
  <para style="q2" vid="PSA 25:10">cho người nào vâng giữ mệnh lệnh Ngài.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Ôi Chúa Hằng Hữu, vì Danh Ngài,</para>
  <para style="q2" vid="PSA 25:11">xin tha thứ tội con, dù rất nặng.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Ai là người kính sợ Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 25:12">Ngài sẽ giúp con chọn đường đúng.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Người sẽ sống đời mình trong hưng thịnh.</para>
  <para style="q2" vid="PSA 25:13">Con cháu người sẽ thừa hưởng đất đai.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />Chúa Hằng Hữu là bạn của người tin kính.</para>
  <para style="q2" vid="PSA 25:14">Giao ước Ngài, Chúa hé lộ cho hay.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Mắt con mòn mỏi trông Chúa Hằng Hữu đến,</para>
  <para style="q2" vid="PSA 25:15">gỡ chân con ra khỏi lưới gài.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Xin xót thương, trở lại với con,</para>
  <para style="q2" vid="PSA 25:16">vì con quá nguy khốn cô đơn.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Nỗi đau thương sao gia tăng mãi.</para>
  <para style="q2" vid="PSA 25:17">Xin cứu con khỏi mọi cảnh khổ đau!<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Xin Chúa xem cảnh lầm than, khốn khó.</para>
  <para style="q2" vid="PSA 25:18">Xin tha thứ tội ác của con.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Quân thù nghịch gia tăng gấp bội</para>
  <para style="q2" vid="PSA 25:19">chúng căm thù, cay đắng, ghét con.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Xin bảo vệ con! Xin gìn giữ linh hồn con!</para>
  <para style="q2" vid="PSA 25:20">Nương cậy Chúa, con không hổ thẹn.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Xin Ngài bảo vệ con trong nếp sống,</para>
  <para style="q2" vid="PSA 25:21">với tấm lòng thanh khiết, ngay thẳng,</para>
  <para style="q2" vid="PSA 25:21">vì con luôn ngưỡng vọng Chân Thần.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Lạy Đức Chúa Trời, xin cứu chuộc Ít-ra-ên,</para>
  <para style="q2" vid="PSA 25:22">cho thoát khỏi mọi gian truân hoạn nạn.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="cl">Thi Thiên 26</para>
  <para style="s1">Tự Xưng Thanh Liêm và Xin Phù Hộ</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Chúa Hằng Hữu ôi, bào chữa cho con,</para>
  <para style="q2" vid="PSA 26:1">vì con sống thanh liêm;</para>
  <para style="q2" vid="PSA 26:1">và con tin cậy Ngài, không nao núng.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Chúa Hằng Hữu ôi, xin tra xét và thử thách con,</para>
  <para style="q2" vid="PSA 26:2">Xin dò xét lòng dạ và tâm trí con.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Vì con ngưỡng mộ đức nhân từ Chúa,</para>
  <para style="q2" vid="PSA 26:3">và sống theo chân lý Ngài.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Con không hòa mình với người dối trá,</para>
  <para style="q2" vid="PSA 26:4">cũng chẳng kết giao cùng bọn đạo đức giả.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Con thù ghét phường ác nhân,</para>
  <para style="q2" vid="PSA 26:5">cũng chẳng giao du với người tội lỗi.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Con sẽ rửa tay, tỏ lòng trong sạch.</para>
  <para style="q2" vid="PSA 26:6">Con bước đến bàn thờ, Chúa Hằng Hữu ôi,<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />và lớn tiếng cảm tạ Ngài,</para>
  <para style="q2" vid="PSA 26:7">cùng kể lại công việc kỳ diệu của Ngài.<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Chúa Hằng Hữu ôi, con yêu mến đền thánh Chúa,</para>
  <para style="q2" vid="PSA 26:8">nơi Ngài hiện diện, rạng rỡ vinh quang.<verse eid="PSA 26:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Xin đừng cất mạng con cùng với bọn người ác.</para>
  <para style="q2" vid="PSA 26:9">Đừng giết con chung với lũ sát nhân.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Bàn tay họ bẩn thỉu nhuốc nhơ,</para>
  <para style="q2" vid="PSA 26:10">tay phải họ vơ đầy của hối lộ.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Còn con sẽ sống liêm khiết trong sạch.</para>
  <para style="q2" vid="PSA 26:11">Xin cứu con và ban ân huệ cho con.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Nơi đất bằng, chân con đứng vững vàng,</para>
  <para style="q2" vid="PSA 26:12">giữa hội chúng, con luôn ca tụng Chúa Hằng Hữu.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="cl">Thi Thiên 27</para>
  <para style="s1">Vững Tâm Vì Chúa Bảo Vệ</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />Chúa Hằng Hữu là ánh sáng và cứu tinh của tôi—</para>
  <para style="q2" vid="PSA 27:1">vậy tôi sẽ sợ ai?</para>
  <para style="q1" vid="PSA 27:1">Chúa Hằng Hữu là thành lũy của sinh mạng tôi,</para>
  <para style="q2" vid="PSA 27:1">tôi còn kinh khiếp ai?<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Khi người ác xông vào tôi, hòng ăn nuốt tôi,</para>
  <para style="q2" vid="PSA 27:2">khi quân thù và người cừu địch tấn công tôi,</para>
  <para style="q2" vid="PSA 27:2">họ sẽ đều vấp chân và té ngã.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Dù cả đạo quân vây quanh tôi,</para>
  <para style="q2" vid="PSA 27:3">lòng tôi cũng không sợ hãi.</para>
  <para style="q1" vid="PSA 27:3">Dù bị chiến tranh uy hiếp,</para>
  <para style="q2" vid="PSA 27:3">tôi vẫn vững tâm tin cậy Ngài.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Tôi xin Chúa Hằng Hữu một điều—</para>
  <para style="q2" vid="PSA 27:4">điều lòng tôi hằng mong ước—</para>
  <para style="q1" vid="PSA 27:4">là được sống trong nhà Chúa trọn đời tôi</para>
  <para style="q2" vid="PSA 27:4">để chiêm ngưỡng sự hoàn hảo của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 27:4">và suy ngẫm trong Đền Thờ Ngài.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Trong ngày hoạn nạn, Chúa sẽ che chở tôi,</para>
  <para style="q2" vid="PSA 27:5">Ngài giấu tôi nơi kín đáo trong đền thánh Ngài,</para>
  <para style="q2" vid="PSA 27:5">nâng tôi lên, đặt trên tảng đá.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Đầu tôi được nâng cao hơn kẻ thù,</para>
  <para style="q2" vid="PSA 27:6">trong nơi thánh Ngài, tôi sẽ dâng lễ vật tạ ơn,</para>
  <para style="q2" vid="PSA 27:6">và vui mừng ca hát tôn vinh Chúa.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Lạy Chúa Hằng Hữu ôi, xin nghe con kêu cầu.</para>
  <para style="q2" vid="PSA 27:7">Xin thương xót đáp lời khẩn nguyện!<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Con đã nghe Chúa phán: “Hãy đến và trò chuyện cùng Ta.”</para>
  <para style="q2" vid="PSA 27:8">Và lòng con thưa rằng: “Lạy Chúa Hằng Hữu, con đang đến.”<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Lạy Chúa, Đấng cứu rỗi của con!</para>
  <para style="q2" vid="PSA 27:9">Cầu xin Ngài đừng lánh mặt.</para>
  <para style="q2" vid="PSA 27:9">Đừng nổi giận xua đuổi người tôi trung.</para>
  <para style="q1" vid="PSA 27:9">Đã bao lần Chúa hằng cứu giúp.</para>
  <para style="q2" vid="PSA 27:9">Đừng lìa xa, đừng từ bỏ con.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Cho dù cha mẹ con giận bỏ, từ khước con,</para>
  <para style="q2" vid="PSA 27:10">Chúa vẫn thương yêu, vẫn tiếp nhận con.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Chúa Hằng Hữu ôi, xin dạy con đường lối Chúa,</para>
  <para style="q2" vid="PSA 27:11">xin dẫn con vào lối an lành,</para>
  <para style="q2" vid="PSA 27:11">vì kẻ thù vây quanh chờ đợi con.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Xin đừng giao con cho họ.</para>
  <para style="q2" vid="PSA 27:12">Vì họ hung hăng bạo tàn,</para>
  <para style="q2" vid="PSA 27:12">định vu cáo buộc tội con.<verse eid="PSA 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Con tin chắc sẽ thấy ân lành của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 27:13">ngay trong đất người sống.<verse eid="PSA 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Cứ trông đợi Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 27:14">Hãy vững tâm và can đảm.</para>
  <para style="q2" vid="PSA 27:14">Phải, kiên nhẫn đợi trông Chúa Hằng Hữu.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="cl">Thi Thiên 28</para>
  <para style="s1">Cầu Xin Cứu Giúp và Cảm Tạ Vì Được Nhậm Lời</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Con kêu cầu Ngài, lạy Chúa Hằng Hữu, Vầng Đá của con.</para>
  <para style="q2" vid="PSA 28:1">Xin đừng bịt tai cùng con.</para>
  <para style="q1" vid="PSA 28:1">Vì nếu Chúa vẫn lặng thinh im tiếng,</para>
  <para style="q2" vid="PSA 28:1">con sẽ giống như người đi vào mồ mả.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Xin vì lòng thương xót nghe lời cầu nguyện con,</para>
  <para style="q2" vid="PSA 28:2">khi con kêu khóc xin Ngài cứu giúp,</para>
  <para style="q2" vid="PSA 28:2">khi con đưa tay lên đền thánh của Ngài.<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Xin đừng phạt con chung với kẻ dữ—</para>
  <para style="q2" vid="PSA 28:3">là những người làm điều gian ác—</para>
  <para style="q1" vid="PSA 28:3">miệng nói hòa bình với xóm giềng</para>
  <para style="q2" vid="PSA 28:3">nhưng trong lòng đầy dẫy gian tà.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Xin Chúa phạt họ theo hành vi của họ!</para>
  <para style="q2" vid="PSA 28:4">Theo cách cư xử gian ác của họ.</para>
  <para style="q1" vid="PSA 28:4">Phạt họ theo việc làm,</para>
  <para style="q2" vid="PSA 28:4">báo trả xứng đáng điều họ đã gây ra.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Vì họ chẳng quan tâm đến công việc Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 28:5">chẳng chú ý đến công trình Ngài.</para>
  <para style="q1" vid="PSA 28:5">Vậy họ sẽ bị Ngài tiêu diệt,</para>
  <para style="q2" vid="PSA 28:5">chẳng bao giờ cho xây dựng lại.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Ngợi ca Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 28:6">Vì Ngài đã nghe lời con nguyện cầu.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Chúa Hằng Hữu là năng lực và tấm khiên của con.</para>
  <para style="q2" vid="PSA 28:7">Con tin cậy Ngài trọn cả tấm lòng,</para>
  <para style="q2" vid="PSA 28:7">Ngài cứu giúp con, lòng con hoan hỉ.</para>
  <para style="q2" vid="PSA 28:7">Con sẽ dâng lời hát cảm tạ Ngài.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Chúa Hằng Hữu là năng lực của dân Ngài.</para>
  <para style="q2" vid="PSA 28:8">Ngài là đồn lũy cho người Chúa xức dầu.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Xin Chúa cứu dân Ngài!</para>
  <para style="q2" vid="PSA 28:9">Ban phước lành cho cơ nghiệp của Ngài,</para>
  <para style="q1" vid="PSA 28:9">Xin chăn dắt</para>
  <para style="q2" vid="PSA 28:9">và bồng bế họ mãi mãi.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="cl">Thi Thiên 29</para>
  <para style="s1">Tiếng Chúa trong Bão Tố</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />Ngợi tôn Chúa Hằng Hữu, hỡi các con của Đức Chúa Trời;</para>
  <para style="q2" vid="PSA 29:1">hãy ngợi tôn Chúa Hằng Hữu vì vinh quang và quyền năng Ngài.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Ngợi tôn Chúa Hằng Hữu vì vinh quang của Danh Ngài.</para>
  <para style="q2" vid="PSA 29:2">Hãy thờ phượng Chúa Hằng Hữu trong hào quang của thánh khiết Ngài.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Tiếng Chúa Hằng Hữu vang dội trên các dòng nước.</para>
  <para style="q2" vid="PSA 29:3">Đức Chúa Trời của vinh quang vang rền như sấm.</para>
  <para style="q2" vid="PSA 29:3">Chúa Hằng Hữu nổi sấm sét trên nước lũ.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Tiếng Chúa Hằng Hữu đầy quyền năng;</para>
  <para style="q2" vid="PSA 29:4">tiếng Chúa Hằng Hữu quá oai nghiêm.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Tiếng Chúa Hằng Hữu bẻ gãy cây hương nam;</para>
  <para style="q2" vid="PSA 29:5">phải, tiếng Chúa Hằng Hữu làm gãy nát cây bá hương Li-ban.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Ngài khiến núi Li-ban nhảy như bò con;</para>
  <para style="q2" vid="PSA 29:6">Ngài khiến núi Si-ri-ôn nhảy như bê rừng.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Tiếng Chúa Hằng Hữu phát chớp nhoáng.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Tiếng Chúa Hằng Hữu khiến chấn động vùng hoang mạc;</para>
  <para style="q2" vid="PSA 29:8">Chúa Hằng Hữu chấn động hoang mạc Ca-đe.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Tiếng Chúa Hằng Hữu vặn đổ cây sồi,</para>
  <para style="q2" vid="PSA 29:9">làm cho cây rừng trụi lá.</para>
  <para style="q2" vid="PSA 29:9">Trong Đền Thờ Ngài, tất cả tung hô: “Vinh quang!”<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />Chúa Hằng Hữu ngự trên nước lụt,</para>
  <para style="q2" vid="PSA 29:10">Chúa Hằng Hữu cai trị trên ngôi vua muôn đời.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Chúa Hằng Hữu ban sức mạnh cho dân Ngài.</para>
  <para style="q2" vid="PSA 29:11">Chúa Hằng Hữu ban phước bình an cho họ.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="cl">Thi Thiên 30</para>
  <para style="s1">Cảm Tạ Chúa Cứu Khỏi Chết</para>
  <para style="d">(Thơ của Đa-vít, hát vào dịp khánh thành Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Con tôn vinh Chúa Hằng Hữu, vì Ngài nâng con lên.</para>
  <para style="q2" vid="PSA 30:1">Chúa Không để kẻ thù vui mừng đắc chí.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Lạy Chúa Hằng Hữu, Đức Chúa Trời con, con kêu cầu Chúa,</para>
  <para style="q2" vid="PSA 30:2">và Ngài chữa lành con.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Chúa đã đem con lên khỏi âm phủ, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 30:3">Ngài cho con sống, khỏi nằm dưới huyệt sâu.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Các thánh ơi, hãy ngợi ca Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 30:4">Ngợi tôn Danh Thánh Ngài.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Chúa chỉ giận con trong giây phút,</para>
  <para style="q2" vid="PSA 30:5">nhưng ban ân huệ suốt cuộc đời!</para>
  <para style="q1" vid="PSA 30:5">Khóc than chỉ trọ qua đêm ngắn,</para>
  <para style="q2" vid="PSA 30:5">nhưng bình minh rộn rã reo vui.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Lúc hưng thịnh, tâm con tự nhủ:</para>
  <para style="q2" vid="PSA 30:6">“Ta sẽ tồn tại, không ai lay chuyển nổi!”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Nhưng, nhờ ơn Chúa, núi con mới vững bền,</para>
  <para style="q2" vid="PSA 30:7">Ngài lánh mặt, con liền bối rối.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Con kêu xin Chúa, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 30:8">Con khẩn nài Chúa thương xót con:<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />“Để con chết, ích gì cho Chúa,</para>
  <para style="q2" vid="PSA 30:9">dưới mộ sâu, làm sao phục vụ Ngài?</para>
  <para style="q1" vid="PSA 30:9">Cát bụi nào đâu biết ngợi tôn Chúa?</para>
  <para style="q2" vid="PSA 30:9">Làm sao biết rao truyền đức thành tính của Ngài?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Xin nghe con, lạy Chúa Hằng Hữu, thương xót con.</para>
  <para style="q2" vid="PSA 30:10">Xin cứu giúp con, lạy Chúa Hằng Hữu.”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Từ sầu muộn, Chúa cho con nhảy nhót.</para>
  <para style="q2" vid="PSA 30:11">Cởi áo tang, mặc áo hân hoan,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />nên con ngợi tôn Ngài, không thể câm nín.</para>
  <para style="q2" vid="PSA 30:12">Lạy Chúa Hằng Hữu, Đức Chúa Trời con, con tạ ơn Ngài mãi mãi!<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="cl">Thi Thiên 31</para>
  <para style="s1">Nhờ Chúa Tiếp Cứu</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Chúa Hằng Hữu ôi, con nương tựa nơi Ngài;</para>
  <para style="q2" vid="PSA 31:1">xin đừng để con bị nhục nhã.</para>
  <para style="q2" vid="PSA 31:1">Xin giải thoát con, vì Ngài rất công minh.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Xin lắng tai nghe con cầu nguyện;</para>
  <para style="q2" vid="PSA 31:2">xin sớm đến cứu giúp con.</para>
  <para style="q1" vid="PSA 31:2">Xin làm vầng đá cho con nương tựa,</para>
  <para style="q2" vid="PSA 31:2">làm đồn lũy cứu mạng sống con.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Vì Chúa là vầng đá và đồn lũy con.</para>
  <para style="q2" vid="PSA 31:3">Xin dẫn dắt con để Danh Ngài rạng rỡ.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Xin gỡ con khỏi lưới chúng giăng,</para>
  <para style="q2" vid="PSA 31:4">vì Ngài là nơi con ẩn núp.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Con xin giao thác linh hồn trong tay Chúa.</para>
  <para style="q2" vid="PSA 31:5">Xin cứu con, lạy Chúa Hằng Hữu, vì Ngài là Đức Chúa Trời thành tín.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Con ghét người thờ thần tượng hư ảo,</para>
  <para style="q2" vid="PSA 31:6">nhưng con tin cậy nơi Chúa Vĩnh Hằng.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Con sẽ hân hoan vui mừng trong tình yêu của Chúa,</para>
  <para style="q2" vid="PSA 31:7">vì Chúa đã thấy sự đau đớn của con,</para>
  <para style="q2" vid="PSA 31:7">và biết nỗi thống khổ của linh hồn con.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Chúa không giao nạp con vào tay kẻ địch,</para>
  <para style="q2" vid="PSA 31:8">nhưng đặt chân con lên chốn an toàn.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Xin thương xót, lạy Chúa Hằng Hữu, vì con khốn đốn.</para>
  <para style="q2" vid="PSA 31:9">Mắt yếu mờ dâng lệ buồn đau.</para>
  <para style="q2" vid="PSA 31:9">Linh hồn con cùng thân xác mỏi mòn.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Đời con tiêu hao trong thống khổ,</para>
  <para style="q2" vid="PSA 31:10">tháng ngày qua đầy tiếng thở than.</para>
  <para style="q1" vid="PSA 31:10">Sức suy tàn vì tội lỗi bủa vây;</para>
  <para style="q2" vid="PSA 31:10">xương cốt con rồi cũng hao mòn.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Với kẻ thù, con chỉ là sỉ nhục,</para>
  <para style="q2" vid="PSA 31:11">láng giềng bạn hữu đều kinh khiếp—</para>
  <para style="q2" vid="PSA 31:11">ai thấy con đi cũng tránh xa.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Con bị quên như người đã chết,</para>
  <para style="q2" vid="PSA 31:12">như chiếc bình khi đã vỡ tan.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Con nghe nhiều kẻ thù phỉ báng,</para>
  <para style="q2" vid="PSA 31:13">chung quanh con vây phủ nỗi kinh hoàng.</para>
  <para style="q1" vid="PSA 31:13">Kẻ thù con họp nhau hội ý</para>
  <para style="q2" vid="PSA 31:13">tìm âm mưu kế hoạch thủ tiêu con.<verse eid="PSA 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Chúa Hằng Hữu ôi, lòng con tin cậy Chúa.</para>
  <para style="q2" vid="PSA 31:14">Con trình thưa: “Ngài là Đức Chúa Trời của con!”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Tương lai con ở trong tay Chúa.</para>
  <para style="q2" vid="PSA 31:15">Xin giải thoát con khỏi những người săn đuổi tính mạng con.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Xin Thiên nhan sáng soi đầy tớ Chúa.</para>
  <para style="q2" vid="PSA 31:16">Giải cứu con tùy lượng xót thương.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Lạy Chúa Hằng Hữu, xin đừng để con bị hổ thẹn,</para>
  <para style="q2" vid="PSA 31:17">vì con đã kêu cầu đến Ngài.</para>
  <para style="q1" vid="PSA 31:17">Xin cho người ác ê chề nhục nhã;</para>
  <para style="q2" vid="PSA 31:17">lặng lẽ nằm yên dưới âm ty.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Cho câm nín đôi môi dối trá—</para>
  <para style="q2" vid="PSA 31:18">theo thói quen láo xược kiêu căng xúc phạm người công chính.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Thật lớn thay tình thương của Chúa,</para>
  <para style="q2" vid="PSA 31:19">dành cho ai kính sợ phục tùng.</para>
  <para style="q1" vid="PSA 31:19">Ngài ban ơn cho người tựa nương,</para>
  <para style="q2" vid="PSA 31:19">tỏ công khai trước mặt mọi người.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Chúa giấu họ vào nơi kín đáo,</para>
  <para style="q2" vid="PSA 31:20">khỏi âm mưu hãm hại của loài người.</para>
  <para style="q1" vid="PSA 31:20">Trong lều trại Ngài che phủ họ</para>
  <para style="q2" vid="PSA 31:20">khỏi tiếng thị phi của thế gian.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Đáng chúc tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 31:21">vì Ngài tỏ lòng thương xót diệu kỳ.</para>
  <para style="q2" vid="PSA 31:21">Ngài che chở con an toàn khi tường thành con bị bao vây.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Lúc thiếu suy xét, con đã nói:</para>
  <para style="q2" vid="PSA 31:22">“Con bị truất khỏi Chúa Hằng Hữu!”</para>
  <para style="q1" vid="PSA 31:22">Nhưng Chúa đã nghe lời con cầu nguyện</para>
  <para style="q2" vid="PSA 31:22">con kêu cầu Ngài cứu giúp con.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Các người thánh, hãy yêu mến Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 31:23">Vì Chúa Hằng Hữu bảo vệ người trung tín với Ngài,</para>
  <para style="q2" vid="PSA 31:23">nhưng phạt nặng người tự kiêu cao ngạo.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Hỡi tất cả những người trông cậy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 31:24">Hãy anh dũng, can đảm, và bền lòng.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="cl">Thi Thiên 32</para>
  <para style="s1">Phước Hạnh của Người Được Tha Tội</para>
  <para style="d">(Giáo huấn ca của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Phước cho người có tội được tha thứ,</para>
  <para style="q2" vid="PSA 32:1">vi phạm được khỏa lấp.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Phước cho người không bị Chúa kể tội,</para>
  <para style="q2" vid="PSA 32:2">hồn sạch trong, không chút gian trá.<verse eid="PSA 32:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Khi con không chịu xưng nhận tội</para>
  <para style="q2" vid="PSA 32:3">xương cốt hao mòn,</para>
  <para style="q2" vid="PSA 32:3">suốt ngày rên rỉ.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Ngày và đêm tay Chúa đè trên con nặng nề.</para>
  <para style="q2" vid="PSA 32:4">Sức lực con tan như sáp dưới nắng hạ.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Cho đến lúc con nhận tội với Chúa,</para>
  <para style="q2" vid="PSA 32:5">không che giấu gian ác con.</para>
  <para style="q1" vid="PSA 32:5">Con tự bảo: “Ta sẽ xưng tội với Chúa Hằng Hữu.”</para>
  <para style="q2" vid="PSA 32:5">Và Chúa đã tha thứ con! Mọi tội ác đã qua.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Vì thế, mọi người tin kính Chúa hãy cầu nguyện với Chúa khi còn gặp được,</para>
  <para style="q2" vid="PSA 32:6">để họ không bị chìm trong nước lũ của ngày phán xét.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Vì Chúa là nơi con ẩn náu;</para>
  <para style="q2" vid="PSA 32:7">Chúa bảo vệ con lúc gian nan.</para>
  <para style="q2" vid="PSA 32:7">Ngài bao bọc con trong tiếng ca giải thoát.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Chúa Hằng Hữu phán: “Ta sẽ dạy con, chỉ cho con đường lối phải theo.</para>
  <para style="q2" vid="PSA 32:8">Mắt Ta sẽ dõi theo và hướng dẫn.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Đừng dại dột cứng cổ<note caller="+" style="f"><char style="fr" closed="false">32:9 </char><char style="ft" closed="false">Nt không hiểu biết</char></note> như la, như ngựa,</para>
  <para style="q2" vid="PSA 32:9">phải dùng hàm thiếc, dây cương mới chịu vâng phục.”<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Người ác chịu nhiều khổ đau,</para>
  <para style="q2" vid="PSA 32:10">nhưng ai tin cậy Chúa Hằng Hữu sẽ được tràn đầy ân huệ.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Những người công chính, hãy vui vẻ và mừng rỡ trong Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 32:11">Những người có lòng ngay thẳng, hãy reo vui!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="cl">Thi Thiên 33</para>
  <para style="s1">Đấng Tạo Hóa Phù Hộ Bảo Vệ Muôn Vật</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Người công chính, hãy hân hoan trong Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 33:1">xứng hợp thay, người ngay thẳng ca tụng Ngài.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Hãy ca ngợi Chúa bằng đàn hạc;</para>
  <para style="q2" vid="PSA 33:2">hãy tấu nhạc cho Ngài bằng đàn thập huyền.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Hãy hát cho Chúa một bài ca mới;</para>
  <para style="q2" vid="PSA 33:3">hòa tấu tuyệt diệu và reo mừng.<verse eid="PSA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Vì lời Chúa Hằng Hữu là chân lý,<note caller="+" style="f"><char style="fr" closed="false">33:4 </char><char style="ft" closed="false">Nt đúng</char></note></para>
  <para style="q2" vid="PSA 33:4">Chúa thành tín trong mọi việc Ngài làm.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Chúa ưa điều công minh chính đáng;</para>
  <para style="q2" vid="PSA 33:5">khắp đất tràn ngập tình thương không phai tàn của Ngài.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Lời Chúa Hằng Hữu sáng lập vũ trụ,</para>
  <para style="q2" vid="PSA 33:6">hơi thở Ngài tạo muôn triệu tinh tú.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Ngài góp nước thành đại dương,</para>
  <para style="q2" vid="PSA 33:7">chứa đầy các bể sâu.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Cả thế giới hãy kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 33:8">mọi người trần gian phải khiếp kinh.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Chúa phán, vũ trụ liền xuất hiện!</para>
  <para style="q2" vid="PSA 33:9">Vạn vật tồn tại theo lệnh Ngài.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Chúa Hằng Hữu phá hỏng kế hoạch các nước,</para>
  <para style="q2" vid="PSA 33:10">Ngài tiêu diệt dự định muôn dân.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Nhưng kế hoạch Chúa Hằng Hữu tồn tại mãi mãi;</para>
  <para style="q2" vid="PSA 33:11">ý định Ngài bất diệt muôn đời.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Phước cho nước nào tôn Đức Chúa Trời là Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 33:12">và dân tộc được Ngài chọn làm cơ nghiệp Ngài.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Chúa Hằng Hữu từ trời nhìn xuống</para>
  <para style="q2" vid="PSA 33:13">thấy tất cả loài người.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />Từ ngai Chúa ngự Ngài quan sát</para>
  <para style="q2" vid="PSA 33:14">tất cả dân trên thế gian.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Chúa tạo linh hồn nhân loại,</para>
  <para style="q2" vid="PSA 33:15">vậy Ngài biết mọi việc họ làm.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Không vua nào nhờ binh hùng tướng mạnh mà thắng trận;</para>
  <para style="q2" vid="PSA 33:16">sức mạnh nào cứu được anh hùng.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Lúc lâm nguy chiến mã thành vô dụng—</para>
  <para style="q2" vid="PSA 33:17">dù mạnh đến đâu cũng chẳng giải thoát được ai.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Nhưng mắt Chúa Hằng Hữu nhìn người tin kính</para>
  <para style="q2" vid="PSA 33:18">và người trông mong đức nhân từ không phai tàn của Ngài.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Chúa giải thoát họ khỏi chết</para>
  <para style="q2" vid="PSA 33:19">và cho họ sống sót qua cơn đói kém.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Chúng con trông đợi Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 33:20">Đấng cứu hộ, khiên thuẫn chở che.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Lòng chúng con hân hoan trong Chúa,</para>
  <para style="q2" vid="PSA 33:21">vì chúng con tin cậy Danh Thánh Ngài.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Nguyện tình thương Chúa Hằng Hữu bao phủ chúng con,</para>
  <para style="q2" vid="PSA 33:22">như chúng con hằng hy vọng nơi Ngài.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="cl">Thi Thiên 34</para>
  <para style="s1">Chúa Dự Bị Nhu Cầu và Giải Cứu</para>
  <para style="d">(Thơ của Đa-vít, lúc người giả điên trước mặt Vua A-bi-mê-léc và bị đuổi đi)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Tôi luôn luôn chúc tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 34:1">miệng tôi chỉ biết ca ngợi Ngài.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Tôi sẽ khoe mọi ân lành của Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 34:2">cho người khốn khó nghe và vui mừng.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Hãy cùng tôi tôn vinh Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 34:3">chúng ta hãy suy tôn Danh Ngài.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Tôi tìm kiếm Chúa Hằng Hữu và Ngài đáp ứng.</para>
  <para style="q2" vid="PSA 34:4">Ngài giải thoát tôi khỏi cảnh hãi hùng.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Ai ngửa trông nơi Chúa được Ngài chiếu sáng,</para>
  <para style="q2" vid="PSA 34:5">mặt tươi vui, không hổ thẹn cúi đầu.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Người cùng khổ này kêu xin, và Chúa Hằng Hữu lắng nghe,</para>
  <para style="q2" vid="PSA 34:6">Ngài giải cứu người khỏi hoạn nạn.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Vì thiên sứ của Chúa Hằng Hữu là người canh giữ;</para>
  <para style="q2" vid="PSA 34:7">đóng trại chung quanh và giải cứu người kính thờ Chúa.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Hãy nếm thử cho biết Chúa Hằng Hữu là thiện lành.</para>
  <para style="q2" vid="PSA 34:8">Phước cho người ẩn náu nơi Ngài!<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Các người thánh, hãy kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 34:9">vì người kính sợ Chúa chẳng thiếu thốn bao giờ.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Dù sư tử tơ có khi thiếu thốn và đói,</para>
  <para style="q2" vid="PSA 34:10">nhưng người tìm kiếm Chúa Hằng Hữu chẳng thiếu điều lành nào.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Các con, hãy đến nghe ta,</para>
  <para style="q2" vid="PSA 34:11">ta sẽ dạy các con sự kính sợ Chúa Hằng Hữu.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Có ai là người yêu thích cuộc đời,</para>
  <para style="q2" vid="PSA 34:12">muốn sống lâu dài, hạnh phúc?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Phải giữ miệng lưỡi mình,</para>
  <para style="q2" vid="PSA 34:13">đừng nói lời độc hại, dối gian!<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Phải tránh xa điều ác và làm việc lành.</para>
  <para style="q2" vid="PSA 34:14">Hãy tìm kiếm hòa bình, và theo đuổi nó.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Vì mắt Chúa Hằng Hữu nhìn người công chính;</para>
  <para style="q2" vid="PSA 34:15">tai Ngài nghe tiếng họ kêu cầu.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Chúa Hằng Hữu đối nghịch người ác;</para>
  <para style="q2" vid="PSA 34:16">xóa kỷ niệm họ trên thế gian.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Người công chính kêu xin, Chúa lắng nghe.</para>
  <para style="q2" vid="PSA 34:17">Ngài giải thoát họ khỏi mọi gian khổ.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Chúa Hằng Hữu ở gần người có lòng tan vỡ;</para>
  <para style="q2" vid="PSA 34:18">Ngài cứu người biết hối hận ăn năn.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Người công chính gặp nhiều tai nạn,</para>
  <para style="q2" vid="PSA 34:19">nhưng Chúa Hằng Hữu cho tai qua nạn khỏi.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />Chúa Hằng Hữu giữ gìn xương cốt người công chính;</para>
  <para style="q2" vid="PSA 34:20">không để cho một cái nào phải gãy!<verse eid="PSA 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Tai ương đến tiêu diệt người ác,</para>
  <para style="q2" vid="PSA 34:21">ai ghét người ngay bị Chúa phạt.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Nhưng Chúa Hằng Hữu chuộc người phục vụ Chúa.</para>
  <para style="q2" vid="PSA 34:22">Người nào ẩn núp nơi Chúa không bị lên án.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="cl">Thi Thiên 35</para>
  <para style="s1">Xin Cứu Khỏi Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Chúa Hằng Hữu ôi, xin tranh cãi cùng người tranh cãi lại con.</para>
  <para style="q2" vid="PSA 35:1">Ra tay chiến đấu chống người chiến đấu hại con.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Xin cầm khiên mộc,</para>
  <para style="q2" vid="PSA 35:2">đứng lên đến cứu giúp con.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Xin lấy giáo và lao cản đường người đuổi con.</para>
  <para style="q2" vid="PSA 35:3">Xin nói với tâm hồn con:</para>
  <para style="q2" vid="PSA 35:3">“Ta sẽ cho con chiến thắng!”<verse eid="PSA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Cho người tìm giết con ê chề nhục nhã;</para>
  <para style="q2" vid="PSA 35:4">người mưu hại con lui bước và hổ thẹn.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Xin thiên sứ của Chúa Hằng Hữu đuổi xua họ—</para>
  <para style="q2" vid="PSA 35:5">như trấu rơm trong gió tơi bời<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Cho đường họ tối tăm, trơn trợt,</para>
  <para style="q2" vid="PSA 35:6">khi thiên thần của Chúa Hằng Hữu đuổi theo họ.<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Họ giăng lưới hại con vô cớ</para>
  <para style="q2" vid="PSA 35:7">không lý do, đào hố săn người.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Nguyện họ gặp tai ương khủng khiếp!</para>
  <para style="q2" vid="PSA 35:8">Bị diệt vong trong bẫy họ gài!</para>
  <para style="q2" vid="PSA 35:8">Và sa vào hố họ đào cho con.<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Con hân hoan trong Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 35:9">mừng rỡ vì Ngài giải cứu con.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Mỗi xương cốt trong thân thể con ngợi tôn Chúa:</para>
  <para style="q2" vid="PSA 35:10">“Chúa Hằng Hữu ôi, ai sánh được với Ngài?”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Bọn chứng gian tiến lên cật vấn,</para>
  <para style="q2" vid="PSA 35:11">những việc con không biết không làm.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Họ lấy ác báo trả việc lành.</para>
  <para style="q2" vid="PSA 35:12">Tâm hồn con đơn côi, bất hạnh.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Thế mà khi chúng bệnh hoạn, con mặc áo gai,</para>
  <para style="q2" vid="PSA 35:13">khắc khổ, nhịn ăn vì họ,</para>
  <para style="q2" vid="PSA 35:13">nhưng lời cầu thay chưa được đáp ứng.<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />Con khóc chúng như anh em, bạn thiết,</para>
  <para style="q2" vid="PSA 35:14">cúi đầu buồn bã như than khóc mẹ.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Thế mà khi con khốn đốn, họ liên hoan</para>
  <para style="q2" vid="PSA 35:15">cáo gian lúc con vắng mặt.</para>
  <para style="q2" vid="PSA 35:15">Bêu riếu con không ngừng.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Như bọn vô đạo, họ chế nhạo con;</para>
  <para style="q2" vid="PSA 35:16">họ nghiến răng giận dữ chống lại con.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Chúa Hằng Hữu ôi, Chúa cứ lặng nhìn đến bao giờ?</para>
  <para style="q2" vid="PSA 35:17">Xin cứu con khỏi bị diệt vong.</para>
  <para style="q2" vid="PSA 35:17">Rút mạng sống con khỏi nanh vuốt sư tử.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Con sẽ cảm tạ Chúa giữa đại hội.</para>
  <para style="q2" vid="PSA 35:18">Ca tụng Chúa trước tất cả chúng dân.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Xin chớ để kẻ thù reo vui,</para>
  <para style="q2" vid="PSA 35:19">người vô cớ thù ghét con, nheo mắt trêu chọc.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Vì họ không nói lời hòa hảo,</para>
  <para style="q2" vid="PSA 35:20">nhưng âm mưu lừa gạt lương dân.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Họ la to: “Ha! Ha!</para>
  <para style="q2" vid="PSA 35:21">Chính chúng ta đã thấy tận mắt!”<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Chúa Hằng Hữu ôi, Ngài biết mọi việc.</para>
  <para style="q2" vid="PSA 35:22">Xin đừng yên lặng.</para>
  <para style="q2" vid="PSA 35:22">Xin đừng rời bỏ con, lạy Chúa.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Xin thức giấc! Xin trỗi dậy bênh vực con!</para>
  <para style="q2" vid="PSA 35:23">Xin tranh cãi cho con, Đức Chúa Trời con và Chúa con.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Xin Chúa Công Chính xét xử công minh,</para>
  <para style="q2" vid="PSA 35:24">đừng để họ reo mừng đắc thắng.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Đừng để họ nói rằng: “Hay quá, việc xảy ra như ta ao ước!</para>
  <para style="q2" vid="PSA 35:25">Bây giờ ta đã nuốt gọn nó rồi!”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Nguyện những ai vui mừng khi con khốn đốn</para>
  <para style="q2" vid="PSA 35:26">bị hổ thẹn và bối rối.</para>
  <para style="q1" vid="PSA 35:26">Nguyện những ai khoác lác kiêu căng</para>
  <para style="q2" vid="PSA 35:26">sẽ mặc lấy nhục nhã và thẹn thùng.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Những ai mong con được minh oan,</para>
  <para style="q2" vid="PSA 35:27">xin cho họ reo vui không dứt tiếng:</para>
  <para style="q1" vid="PSA 35:27">“Chúa Hằng Hữu thật vĩ đại,</para>
  <para style="q2" vid="PSA 35:27">Ngài vui lòng ban sự thịnh vượng cho đầy tớ Ngài.”<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Lưỡi con sẽ nói về đức công chính của Chúa,</para>
  <para style="q2" vid="PSA 35:28">và suốt ngày ca tụng Thánh Danh.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="cl">Thi Thiên 36</para>
  <para style="s1">Lòng Ác của Loài Người và Đức Nhân Từ của Chúa</para>
  <para style="d">(Thơ của Đa-vít, đầy tớ Chúa, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Một lời nói trong lòng tôi về tội lỗi của người ác rằng:</para>
  <para style="q2" vid="PSA 36:1">Nó không để tâm đến việc kính sợ Đức Chúa Trời.<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Nó chỉ lo tâng bốc bản thân,</para>
  <para style="q2" vid="PSA 36:2">đến nỗi không thấy tội cũng không ghét tội.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Miệng lưỡi nó đầy lời xảo trá,</para>
  <para style="q2" vid="PSA 36:3">không chút khôn ngoan, chẳng tốt lành.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Nằm trên giường tính toan điều ác,</para>
  <para style="q2" vid="PSA 36:4">quyết tâm theo con đường gian trá,</para>
  <para style="q2" vid="PSA 36:4">không từ bỏ hành vi sai trái.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Chúa Hằng Hữu ôi, lượng nhân từ bao la trời biển;</para>
  <para style="q2" vid="PSA 36:5">lòng thành tín vượt quá mây ngàn.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Đức công chính sừng sững non cao,</para>
  <para style="q2" vid="PSA 36:6">sự xét đoán sâu hơn vực thẳm.</para>
  <para style="q2" vid="PSA 36:6">Ngài bảo tồn loài người, loài vật, lạy Chúa Hằng Hữu.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Lòng nhân từ Chúa quý biết bao, ôi Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 36:7">Con cái loài người nương tựa mình</para>
  <para style="q2" vid="PSA 36:7">dưới bóng cánh của Ngài.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Được thỏa mãn thức ăn dư dật trong nhà Chúa,</para>
  <para style="q2" vid="PSA 36:8">uống nước sông phước lạc từ trời.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Vì Chúa chính là nguồn sống</para>
  <para style="q2" vid="PSA 36:9">và ánh sáng soi chiếu chúng con.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Xin cứ thương yêu người biết Chúa;</para>
  <para style="q2" vid="PSA 36:10">xử công minh với người ngay thật.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Xin đừng cho người kiêu ngạo giẫm chân con</para>
  <para style="q2" vid="PSA 36:11">hay người ác xô đùa con xuống hố.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Kìa! Người làm ác ngã rạp!</para>
  <para style="q2" vid="PSA 36:12">Họ bị xô ngã không trở dậy nổi.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="cl">Thi Thiên 37</para>
  <para style="s1">An Ninh cho Ai Tin Chúa và Bất An cho Người Ác</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Đừng bực tức vì người bất lương</para>
  <para style="q2" vid="PSA 37:1">hay ghen tị người làm điều phi pháp.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Vì họ sẽ như cỏ héo úa.</para>
  <para style="q2" vid="PSA 37:2">Và tàn tạ như cỏ xanh bị cắt.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Hãy tin cậy Chúa Hằng Hữu và làm điều thiện.</para>
  <para style="q2" vid="PSA 37:3">Hãy ở trong xứ và vui hưởng cỏ xanh yên lành.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Hãy vui thỏa trong Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 37:4">Ngài sẽ cho ngươi điều ước mơ.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Hãy giao phó mọi việc cho Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 37:5">Hết lòng tin cậy Ngài, Ngài sẽ giúp đỡ ngươi.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Ngài sẽ khiến sự công chính ngươi tỏa sáng như rạng đông,</para>
  <para style="q2" vid="PSA 37:6">và công lý ngươi chiếu sáng như ban trưa.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Hãy yên lặng trước Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 37:7">và bền lòng chờ đợi Ngài.</para>
  <para style="q1" vid="PSA 37:7">Đừng bực bội vì người ác thành công,</para>
  <para style="q2" vid="PSA 37:7">khi họ thực hiện mưu sâu kế độc.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Hãy kìm hãm cơn nóng nảy!</para>
  <para style="q2" vid="PSA 37:8">Hãy xoay khỏi cơn giận cuồng!</para>
  <para style="q1" vid="PSA 37:8">Đừng để mất sự bình tĩnh—</para>
  <para style="q2" vid="PSA 37:8">vì nó dẫn con vào điều ác!<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Vì người ác rồi sẽ bị diệt vong,</para>
  <para style="q2" vid="PSA 37:9">còn ai trông chờ Chúa Hằng Hữu sẽ hưởng được đất.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Chẳng bao lâu, người ác sẽ biến mất.</para>
  <para style="q2" vid="PSA 37:10">Dù muốn tìm, cũng chẳng bao giờ thấy.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Nhưng người khiêm nhu sẽ thừa hưởng đất đai</para>
  <para style="q2" vid="PSA 37:11">và sẽ sống trong cảnh thái bình.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Người ác âm mưu hại người tin kính;</para>
  <para style="q2" vid="PSA 37:12">họ giận dữ nghiến răng với người.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Nhưng Chúa cười nhạo chúng,</para>
  <para style="q2" vid="PSA 37:13">vì Ngài biết ngày tàn chúng đã gần.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Người ác tuốt gươm và giương cung</para>
  <para style="q2" vid="PSA 37:14">để hại người nghèo thiếu và cùng khốn,</para>
  <para style="q2" vid="PSA 37:14">và giết người làm điều ngay thẳng.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Nhưng gươm sẽ đâm ngược vào tim họ,</para>
  <para style="q2" vid="PSA 37:15">và cung tên họ cũng sẽ gãy tan.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Chút đỉnh tài vật của người tin kính,</para>
  <para style="q2" vid="PSA 37:16">còn quý hơn của cải dư dật của nhiều người ác.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Vì tay người ác sẽ gãy nát,</para>
  <para style="q2" vid="PSA 37:17">nhưng Chúa Hằng Hữu nâng đỡ người hiền lương.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Chúa Hằng Hữu biết số ngày người thiện lành,</para>
  <para style="q2" vid="PSA 37:18">Ngài cho họ cơ nghiệp vĩnh cửu.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Trong ngày tai họa họ không héo hắt;</para>
  <para style="q2" vid="PSA 37:19">giữa nạn đói kém vẫn no đủ.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Nhưng người ác sẽ hư mất.</para>
  <para style="q2" vid="PSA 37:20">Những kẻ thù của Chúa Hằng Hữu sẽ như hoa ngoài đồng—</para>
  <para style="q2" vid="PSA 37:20">chúng sẽ tàn rụi và tan như mây khói.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Người ác mượn mà không bao giờ trả,</para>
  <para style="q2" vid="PSA 37:21">nhưng người tin kính rộng lòng cho không.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Ai được Chúa Hằng Hữu ban phước sẽ thừa hưởng đất đai;</para>
  <para style="q2" vid="PSA 37:22">Còn Ngài nguyền rủa ai thì nấy họ sẽ bị tiêu diệt.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Chúa Hằng Hữu xếp đặt bước đi của người tin kính,</para>
  <para style="q2" vid="PSA 37:23">Ngài ưa thích đường lối người.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Dù vấp chân, họ cũng không té ngã,</para>
  <para style="q2" vid="PSA 37:24">vì có Chúa Hằng Hữu giữ họ trong tay.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Trước kia tôi còn trẻ, nay đến tuổi già.</para>
  <para style="q2" vid="PSA 37:25">Tôi chưa thấy Chúa bỏ rơi người công chính</para>
  <para style="q2" vid="PSA 37:25">hoặc để con cháu họ đi ăn mày.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Họ luôn luôn rộng rãi cho vay,</para>
  <para style="q2" vid="PSA 37:26">dòng dõi họ hưởng đầy ơn phước.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Người bỏ điều ác và làm điều lành,</para>
  <para style="q2" vid="PSA 37:27">thì sẽ sống trên đất mãi mãi.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Vì Chúa Hằng Hữu yêu công lý,</para>
  <para style="q2" vid="PSA 37:28">nên sẽ không từ bỏ người thánh của Ngài.</para>
  <para style="b" vid="PSA 37:28" />
  <para style="q1" vid="PSA 37:28">Chúa sẽ bảo vệ họ luôn luôn,</para>
  <para style="q2" vid="PSA 37:28">còn dòng dõi người ác bị diệt vong.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Người tin kính sẽ thừa hưởng đất đai,</para>
  <para style="q2" vid="PSA 37:29">và sống tại đó mãi mãi.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Người tin kính nói lời khôn ngoan;</para>
  <para style="q2" vid="PSA 37:30">miệng lưỡi luôn thật thà đoan chính,<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Người gìn giữ luật pháp Đức Chúa Trời trong lòng,</para>
  <para style="q2" vid="PSA 37:31">sẽ bước đi vững vàng.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Những người ác rình rập đợi chờ,</para>
  <para style="q2" vid="PSA 37:32">tìm phương giết người công chính,<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Nhưng Chúa Hằng Hữu không để họ được thành công,</para>
  <para style="q2" vid="PSA 37:33">cũng không để người bị kết tội khi bị đem ra xét xử.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Hãy chờ đợi Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 37:34">Vâng giữ đường lối Ngài,</para>
  <para style="q1" vid="PSA 37:34">Ngài sẽ nhắc ngươi lên, cho ngươi thừa hưởng đất đai,</para>
  <para style="q2" vid="PSA 37:34">ngươi sẽ thấy người ác bị hủy diệt.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Ta đã chứng kiến người độc ác, bạo tàn</para>
  <para style="q2" vid="PSA 37:35">thịnh vượng như cây xanh tươi trong đất tốt<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Nhưng chẳng bao lâu qua đi, không còn nữa!</para>
  <para style="q2" vid="PSA 37:36">Ta tìm kiếm, nhưng chẳng thấy họ đâu!<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Hãy nhìn người thiện hảo và ngay lành,</para>
  <para style="q2" vid="PSA 37:37">cuộc đời họ kết thúc trong bình an.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Còn người phạm tội ác cùng nhau bị diệt;</para>
  <para style="q2" vid="PSA 37:38">họ đâu còn con cháu, tương lai.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Chúa Hằng Hữu cứu người tin kính;</para>
  <para style="q2" vid="PSA 37:39">Ngài là nơi ẩn trú lúc gian nan.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Chúa Hằng Hữu đưa tay cứu giúp,</para>
  <para style="q2" vid="PSA 37:40">giải thoát họ khỏi phường ác gian.</para>
  <para style="q1" vid="PSA 37:40">Chúa cứu họ,</para>
  <para style="q2" vid="PSA 37:40">vì họ nương náu nơi Ngài.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="cl">Thi Thiên 38</para>
  <para style="s1">Lời Thống Hối</para>
  <para style="d">(Thơ của Đa-vít, để tưởng nhớ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Lạy Chúa Hằng Hữu, xin đừng quở trách con trong cơn giận,</para>
  <para style="q2" vid="PSA 38:1">lúc Ngài thịnh nộ, xin chớ sửa phạt con.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Mũi tên Chúa bắn sâu vào thịt,</para>
  <para style="q2" vid="PSA 38:2">bàn tay Ngài đè nặng trên con.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Vì Chúa giận, thân con yếu ớt;</para>
  <para style="q2" vid="PSA 38:3">do tội con, xương cốt mỏi mòn.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Tội ác con ngập đầu—</para>
  <para style="q2" vid="PSA 38:4">nặng nề đè bẹp cả tâm thân,<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Vết thương lòng lở loét thối tha,</para>
  <para style="q2" vid="PSA 38:5">vì khờ dại đòn roi con chịu.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Con cúi mặt khom mình trong tủi nhục.</para>
  <para style="q2" vid="PSA 38:6">Phiền muộn ngày đêm rục cõi lòng.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Đòn vọt, lưng con đau như bỏng,</para>
  <para style="q2" vid="PSA 38:7">những lằn roi cày nát thịt da.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Con gập người, kiệt lực, nhược suy.</para>
  <para style="q2" vid="PSA 38:8">Vì đau đớn nát lòng, con rên rỉ.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Chúa Hằng Hữu ôi, Chúa biết mọi điều con ao ước;</para>
  <para style="q2" vid="PSA 38:9">tiếng thở than chẳng giấu được Ngài.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Tim đập dồn, sức tàn lực kiệt,</para>
  <para style="q2" vid="PSA 38:10">đôi mắt lòa, bóng tối tràn lan.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Bạn hữu, thân sơ đều lảng tránh.</para>
  <para style="q2" vid="PSA 38:11">Gia đình thân thích cũng dang xa.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Người săn mạng lo chăng bẫy lưới.</para>
  <para style="q2" vid="PSA 38:12">Bọn ác nhân mưu kế hại người.</para>
  <para style="q2" vid="PSA 38:12">Suốt ngày lo tính chuyện dối gian.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Con như người điếc, chẳng nghe, chẳng biết,</para>
  <para style="q2" vid="PSA 38:13">như người câm, không mở miệng.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Phải, con như người điếc chẳng nghe,</para>
  <para style="q2" vid="PSA 38:14">miệng không có lời đối đáp.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Lạy Chúa Hằng Hữu, con đang trông đợi.</para>
  <para style="q2" vid="PSA 38:15">Xin đáp lời, lạy Chúa, Đức Chúa Trời con.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Con cầu nguyện: “Xin đừng để kẻ thù con hả hê</para>
  <para style="q2" vid="PSA 38:16">hay vui mừng vì chân con trượt ngã.”<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Con kiệt lực, chân không đứng vững,</para>
  <para style="q2" vid="PSA 38:17">nỗi đau thương đeo đẳng không rời.<note caller="+" style="f"><char style="fr" closed="false">38:17 </char><char style="ft" closed="false">Nt luôn ở trước con</char></note><verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Con xưng ra tội lỗi con;</para>
  <para style="q2" vid="PSA 38:18">con ăn năn thống hối về những việc con đã làm.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Quân thù đông vây bọc trong ngoài,</para>
  <para style="q2" vid="PSA 38:19">người vô cớ ghét con chẳng hiếm.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Họ lấy điều dữ trả điều lành cho con,</para>
  <para style="q2" vid="PSA 38:20">chỉ vì con làm theo ý Chúa.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Lạy Chúa Hằng Hữu, xin chớ bỏ rơi con.</para>
  <para style="q2" vid="PSA 38:21">Đức Chúa Trời của con, xin đừng ngoảnh mặt.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Xin mau cứu giúp con,</para>
  <para style="q2" vid="PSA 38:22">Lạy Chúa Hằng Hữu, Đấng Cứu Rỗi con.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="cl">Thi Thiên 39</para>
  <para style="s1">Hư Không của Trần Gian</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng Giê-đu-thun)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Tôi tự nhủ: “Tôi sẽ cố giữ gìn nếp sống,</para>
  <para style="q2" vid="PSA 39:1">giữ cho miệng lưỡi không sai phạm,</para>
  <para style="q1" vid="PSA 39:1">và khi người ác xuất hiện,</para>
  <para style="q2" vid="PSA 39:1">tôi bịt chặt miệng như phải ngậm tăm.”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Nhưng khi tôi âm thầm, câm nín—</para>
  <para style="q2" vid="PSA 39:2">việc phải cũng chẳng nói ra—</para>
  <para style="q2" vid="PSA 39:2">thì nỗi đau xót trào dâng.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Lòng bồn chồn nóng nảy,</para>
  <para style="q2" vid="PSA 39:3">như lửa đốt cháy thiêu</para>
  <para style="q2" vid="PSA 39:3">lúc trầm mặc đăm chiêu.</para>
  <para style="q2" vid="PSA 39:3">Tôi liền mở miệng:<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“Chúa Hằng Hữu ôi, xin cho con biết hồi chung kết.</para>
  <para style="q2" vid="PSA 39:4">Đời con thắm thoắt được bao lâu—</para>
  <para style="q2" vid="PSA 39:4">thân phận mong manh đến bực nào.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Đời con dài lắm độ gang tay,</para>
  <para style="q2" vid="PSA 39:5">khác chi hư không trước mặt Chúa;</para>
  <para style="q2" vid="PSA 39:5">đời người đều ví như hơi thở.”<verse eid="PSA 39:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Chúng con chập chờn như chiếc bóng,</para>
  <para style="q2" vid="PSA 39:6">chen chúc lợi danh trò ảo mộng,</para>
  <para style="q2" vid="PSA 39:6">tiền tài tích trữ để cho ai.<verse eid="PSA 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Lạy Chúa, có ai đáng cho con hy vọng?</para>
  <para style="q2" vid="PSA 39:7">Hy vọng con chỉ đặt nơi Ngài.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Xin cứu con khỏi mọi điều vi phạm.</para>
  <para style="q2" vid="PSA 39:8">Đừng để người ngu si sỉ nhục.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Miệng con vẫn khép chặt, lặng yên.</para>
  <para style="q2" vid="PSA 39:9">Vì Chúa đã khiến nên như vậy.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Xin Chúa thương, ngừng tay đánh phạt!</para>
  <para style="q2" vid="PSA 39:10">Vì con kiệt sức và mỏi mòn.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Khi Chúa quở trách trừng phạt ai vì tội lỗi,</para>
  <para style="q2" vid="PSA 39:11">Ngài làm cho ước vọng họ phai tàn.</para>
  <para style="q2" vid="PSA 39:11">Thật đời người chỉ là hơi thở.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />Chúa Hằng Hữu ôi, xin nghe lời con khẩn nguyện!</para>
  <para style="q2" vid="PSA 39:12">Xin lắng tai nghe tiếng kêu van!</para>
  <para style="q2" vid="PSA 39:12">Đừng thờ ơ khi lệ con tuôn tràn.</para>
  <para style="q1" vid="PSA 39:12">Vì con chỉ là kiều dân—</para>
  <para style="q2" vid="PSA 39:12">phiêu bạt khắp mọi miền,</para>
  <para style="q2" vid="PSA 39:12">là lữ hành như tổ phụ con.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Xin Chúa tha tội để con phấn khởi, vui tươi</para>
  <para style="q2" vid="PSA 39:13">trước khi con qua đời và không còn nữa!<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="cl">Thi Thiên 40</para>
  <para style="s1">Mong Chúa Cứu Khỏi Khổ Nạn</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Tôi kiên nhẫn đợi chờ Chúa Hằng Hữu cứu giúp,</para>
  <para style="q2" vid="PSA 40:1">Ngài cúi xuống nghe tiếng tôi kêu xin.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Ngài cứu tôi từ lòng hố diệt vong,</para>
  <para style="q2" vid="PSA 40:2">đem tôi lên khỏi vũng bùn lầy.</para>
  <para style="q1" vid="PSA 40:2">Ngài đặt chân tôi trên vầng đá</para>
  <para style="q2" vid="PSA 40:2">và cho bước tôi vững vàng.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Ngài cho tôi một bài hát mới,</para>
  <para style="q2" vid="PSA 40:3">để tôi ca ngợi Đức Chúa Trời chúng ta.</para>
  <para style="q1" vid="PSA 40:3">Nhiều người sẽ thấy và kinh sợ.</para>
  <para style="q2" vid="PSA 40:3">Họ sẽ đặt lòng tin cậy trong Chúa Hằng Hữu.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Phước cho người tin cậy Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 40:4">không khuất phục trước người kiêu căng,</para>
  <para style="q2" vid="PSA 40:4">không về phe với bọn thờ thần tượng.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Lạy Chúa Hằng Hữu, Đức Chúa Trời con, công ơn kỳ diệu vẫn trường tồn.</para>
  <para style="q2" vid="PSA 40:5">Lòng ưu ái Ngài còn muôn thuở.</para>
  <para style="q1" vid="PSA 40:5">Chẳng thần nào sánh được với Ngài.</para>
  <para style="q2" vid="PSA 40:5">Nếu con muốn nhắc ân huệ,</para>
  <para style="q2" vid="PSA 40:5">thật quá nhiều, không sao đếm xuể.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Chúa chẳng thích lễ vật, sinh tế.</para>
  <para style="q2" vid="PSA 40:6">Ngài chỉ muốn con nhất mực vâng lời,<note caller="+" style="f"><char style="fr" closed="false">40:6 </char><char style="ft" closed="false">Nt Chúa mở tai con</char></note></para>
  <para style="q2" vid="PSA 40:6">Chúa không đòi lễ thiêu chuộc tội.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Con xin xác nhận: “Này, con đến.</para>
  <para style="q2" vid="PSA 40:7">Trong Kinh Sách đã chép về con.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Lạy Đức Chúa Trời, con hoan hỉ làm theo ý Chúa,</para>
  <para style="q2" vid="PSA 40:8">luật pháp Ngài ghi khắc tận tâm can.”<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Con đã rao truyền cho dân Chúa về công chính của Ngài.</para>
  <para style="q2" vid="PSA 40:9">Thật con không thể nào nín lặng âm thầm,</para>
  <para style="q2" vid="PSA 40:9">như Ngài đã biết, lạy Chúa Hằng Hữu.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Con không giấu tin mừng của Chúa trong lòng con;<note caller="+" style="f"><char style="fr" closed="false">40:10 </char><char style="ft" closed="false">Phúc Âm thiên thượng</char></note></para>
  <para style="q2" vid="PSA 40:10">nhưng công bố đức thành tín và sự cứu rỗi của Ngài.</para>
  <para style="b" vid="PSA 40:10" />
  <para style="q1" vid="PSA 40:10">Con đã nói với mọi người giữa hội chúng</para>
  <para style="q2" vid="PSA 40:10">về tình thương và thành tính của Ngài.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Chúa Hằng Hữu, xin tiếp tục thương xót, khoan nhân.</para>
  <para style="q2" vid="PSA 40:11">Xin bảo vệ con trong chân lý của Ngài.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Tai họa chung quanh con—</para>
  <para style="q2" vid="PSA 40:12">nhiều vô kể!</para>
  <para style="q1" vid="PSA 40:12">Tội con ngập đầu,</para>
  <para style="q2" vid="PSA 40:12">đâu dám ngước nhìn lên.</para>
  <para style="q1" vid="PSA 40:12">Chúng nhiều hơn tóc trên đầu con.</para>
  <para style="q2" vid="PSA 40:12">Khiến con mất hết lòng can đảm.<verse eid="PSA 40:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Chúa Hằng Hữu ôi, xin giải thoát con!</para>
  <para style="q2" vid="PSA 40:13">Xin mau mau đến cứu giúp con.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Xin cho người săn mạng con</para>
  <para style="q2" vid="PSA 40:14">phải bối rối và hổ thẹn.</para>
  <para style="q1" vid="PSA 40:14">Xin cho kẻ vui về hoạn nạn của con</para>
  <para style="q2" vid="PSA 40:14">phải cúi đầu trơ trẽn.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Xin cho họ khiếp đảm vì tủi thẹn,</para>
  <para style="q2" vid="PSA 40:15">vì họ nói: “Ha! Chúng ta đã bắt được hắn!”<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Nguyện những người tìm kiếm Chúa</para>
  <para style="q2" vid="PSA 40:16">tràn ngập hân hoan và mừng rỡ trong Ngài.</para>
  <para style="q1" vid="PSA 40:16">Nguyện những ai yêu mến sự cứu rỗi của Chúa</para>
  <para style="q2" vid="PSA 40:16">luôn nói rằng: “Chúa Hằng Hữu thật vĩ đại!”<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Thân phận con nghèo hèn, thiếu thốn,</para>
  <para style="q2" vid="PSA 40:17">nhưng Chúa vẫn hết lòng ưu ái, thương yêu.</para>
  <para style="q1" vid="PSA 40:17">Ngài là Đấng giúp đỡ và giải cứu con.</para>
  <para style="q2" vid="PSA 40:17">Lạy Đức Chúa Trời con, xin đừng trì hoãn.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="cl">Thi Thiên 41</para>
  <para style="s1">Lời Than trong Cơn Bệnh Vì Kẻ Thù và Bạn Giả Dối</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Phước cho ai giúp người khốn khó!</para>
  <para style="q2" vid="PSA 41:1">Chúa Hằng Hữu sẽ giải cứu lúc lâm nguy.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Chúa Hằng Hữu bảo vệ họ</para>
  <para style="q2" vid="PSA 41:2">và che chở mạng sống họ.</para>
  <para style="q1" vid="PSA 41:2">Ngài cho họ được phước trên đất</para>
  <para style="q2" vid="PSA 41:2">và không để rơi vào bẫy kẻ thù.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Lúc ốm đau có Chúa Hằng Hữu giữ gìn,</para>
  <para style="q2" vid="PSA 41:3">giường bệnh thành nơi Chúa viếng thăm.<note caller="+" style="f"><char style="fr" closed="false">41:3 </char><char style="ft" closed="false">Ctd Chúa biến đổi giường người trong khi ốm đau</char></note><verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Tôi kêu xin: “Lạy Chúa Hằng Hữu, xin thương xót.</para>
  <para style="q2" vid="PSA 41:4">Xin chữa lành con, vì con đã phạm tội chống nghịch Chúa.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Kẻ thù tôi nói những lời độc địa về tôi.</para>
  <para style="q2" vid="PSA 41:5">Họ hỏi: “Chừng nào hắn qua đời, bao giờ tên tuổi hắn mai một?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Người thăm hỏi dùng lời dịu ngọt,</para>
  <para style="q2" vid="PSA 41:6">bao ý gian chứa chất trong lòng,</para>
  <para style="q2" vid="PSA 41:6">chờ lúc ra ngoài mới rêu rao.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Bọn ghét tôi xì xào bàn tán,</para>
  <para style="q2" vid="PSA 41:7">mong cho điều bất hạnh đến cùng tôi.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Họ nói: “Nó nhiễm ác tật rồi;</para>
  <para style="q2" vid="PSA 41:8">sẽ nằm luôn không dậy nữa đâu!”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Bạn chí thân, từng chia mẩu bánh,</para>
  <para style="q2" vid="PSA 41:9">cũng trở lòng, quay gót nghịch tôi.<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Chúa Hằng Hữu ôi, xin thương xót.</para>
  <para style="q2" vid="PSA 41:10">Xin nâng con dậy, cho con được báo trả!<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Thấy kẻ địch không thắng hơn con,</para>
  <para style="q2" vid="PSA 41:11">con biết mình được Chúa hài lòng.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Chúa hộ trì con vì con vô tội,</para>
  <para style="q2" vid="PSA 41:12">cho con đứng trước mặt Ngài luôn.<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Chúc tụng Chúa Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,</para>
  <para style="q2" vid="PSA 41:13">từ muôn đời trước đến muôn đời sau.</para>
  <para style="q2" vid="PSA 41:13">A-men! A-men!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms1">Quyển Thứ Hai</para>
  <para style="mr">(<ref loc="PSA 42-72">Thi Thiên 42–72</ref>)</para>
  <para style="cl">Thi Thiên 42</para>
  <para style="s1">Lòng Khát Khao Chúa trong Cảnh Lưu Đày</para>
  <para style="d">(Giáo huấn ca của con cháu Cô-ra, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Như nai khát khao tìm suối nước,</para>
  <para style="q2" vid="PSA 42:1">linh hồn con mơ ước Đức Chúa Trời.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Hồn linh con khao khát Đấng Vĩnh Sinh,</para>
  <para style="q2" vid="PSA 42:2">bao giờ con được đi gặp Chúa?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Thức ăn của con ngày đêm là dòng lệ,</para>
  <para style="q2" vid="PSA 42:3">khi kẻ thù suốt ngày mỉa mai:</para>
  <para style="q2" vid="PSA 42:3">“Đức Chúa Trời của ngươi ở đâu?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Nhớ xưa con cùng cả đoàn người</para>
  <para style="q2" vid="PSA 42:4">hành hương đến nhà Đức Chúa Trời,</para>
  <para style="q1" vid="PSA 42:4">giữa những tiếng hoan ca cảm tạ,</para>
  <para style="q2" vid="PSA 42:4">người dự lễ đông vui!</para>
  <para style="q1" vid="PSA 42:4">Giờ nhớ lại những điều ấy</para>
  <para style="q2" vid="PSA 42:4">lòng con tan nát xót xa.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Hồn ta hỡi, sao còn buồn bã?</para>
  <para style="q2" vid="PSA 42:5">Sao còn bối rối trong ta?</para>
  <para style="q1" vid="PSA 42:5">Cứ hy vọng nơi Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 42:5">Ta sẽ còn ngợi tôn Chúa—</para>
  <para style="q2" vid="PSA 42:5">Đấng Cứu Rỗi và Đức Chúa Trời của ta!<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Khi hồn con thất vọng,</para>
  <para style="q2" vid="PSA 42:6">con nhớ Chúa,</para>
  <para style="q1" vid="PSA 42:6">dù ở Giô-đan, Núi Hẹt-môn,</para>
  <para style="q2" vid="PSA 42:6">hay Núi Mi-sa, con vẫn nhớ Ngài.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Vực thẳm gọi nhau trong thác lũ ầm ầm,</para>
  <para style="q2" vid="PSA 42:7">sóng thần lớp lớp phủ tràn thân xác.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Tình thương Chúa Hằng Hữu vẫn phủ con khi ngày đến,</para>
  <para style="q2" vid="PSA 42:8">và ban đêm, con dâng tiếng ngợi ca Ngài,</para>
  <para style="q2" vid="PSA 42:8">như lời nguyện cầu Đức Chúa Trời của đời con.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Con kêu khóc: “Lạy Đức Chúa Trời, Vầng Đá của con.</para>
  <para style="q2" vid="PSA 42:9">Sao Ngài nỡ quên con?</para>
  <para style="q1" vid="PSA 42:9">Sao con phải đau buồn</para>
  <para style="q2" vid="PSA 42:9">vì kẻ thù áp đảo?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Xương cốt con như gãy vụn.</para>
  <para style="q2" vid="PSA 42:10">Họ suốt ngày mỉa mai: “Đức Chúa Trời ngươi ở đâu?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Hồn ta hỡi, sao còn buồn bã?</para>
  <para style="q2" vid="PSA 42:11">Sao mãi bối rối trong ta?</para>
  <para style="q1" vid="PSA 42:11">Ta sẽ đặt hy vọng nơi Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 42:11">Ta sẽ còn ngợi tôn Chúa—</para>
  <para style="q2" vid="PSA 42:11">Đấng Cứu Rỗi và Đức Chúa Trời của ta!<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="cl">Thi Thiên 43</para>
  <para style="s1">Cầu Xin Chúa Giải Cứu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Lạy Đức Chúa Trời! Xin xét xử cho con.</para>
  <para style="q2" vid="PSA 43:1">Xin biện hộ cho con chống lại dân vô đạo.</para>
  <para style="q2" vid="PSA 43:1">Xin giải cứu con khỏi người lừa đảo xấu xa.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Vì Ngài là Đức Chúa Trời, là đồn lũy kiên cố của con.</para>
  <para style="q2" vid="PSA 43:2">Sao nỡ khước từ con?</para>
  <para style="q1" vid="PSA 43:2">Sao con phải đau buồn</para>
  <para style="q2" vid="PSA 43:2">vì kẻ thù áp bức?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Xin chiếu rọi thần quang chân lý;</para>
  <para style="q2" vid="PSA 43:3">để soi đường dẫn lối cho con.</para>
  <para style="q1" vid="PSA 43:3">Xin dìu dắt con lên núi thánh,</para>
  <para style="q2" vid="PSA 43:3">đến nơi Ngài ngự.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Con sẽ vào trước bàn thờ Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 43:4">đến với Đức Chúa Trời—là niềm vui và hạnh phúc của con.</para>
  <para style="q1" vid="PSA 43:4">Con sẽ ca ngợi Chúa bằng tiếng hạc cầm.</para>
  <para style="q2" vid="PSA 43:4">Ôi lạy Đức Chúa Trời, Đức Chúa Trời của con!<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Hồn ta hỡi, sao còn buồn bã?</para>
  <para style="q2" vid="PSA 43:5">Sao vẫn còn bối rối trong ta?</para>
  <para style="q1" vid="PSA 43:5">Ta sẽ đặt hy vọng nơi Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 43:5">Ta sẽ còn ngợi tôn Chúa—</para>
  <para style="q2" vid="PSA 43:5">Đấng Cứu Rỗi và Đức Chúa Trời của ta.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="cl">Thi Thiên 44</para>
  <para style="s1">Nhắc Lại Ơn Xưa, Trình Bày Tai Ương Hiện Tại</para>
  <para style="d">(Giáo huấn ca của con cháu Cô-ra, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Lạy Chúa, tai chúng con đã nghe lời tổ phụ kể,</para>
  <para style="q2" vid="PSA 44:1">những việc vĩ đại Chúa làm ngày xưa.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Tay Chúa đánh đuổi nhiều dân tộc,</para>
  <para style="q2" vid="PSA 44:2">nhưng định cư ông cha chúng con;</para>
  <para style="q1" vid="PSA 44:2">hủy diệt nhiều nước,</para>
  <para style="q2" vid="PSA 44:2">nhưng cho tổ tiên chúng con phát triển.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Họ không nhờ gươm chiếm đất,</para>
  <para style="q2" vid="PSA 44:3">thắng trận không do sức mạnh của bàn tay.</para>
  <para style="q1" vid="PSA 44:3">Nhưng họ chỉ nhờ tay<note caller="+" style="f"><char style="fr" closed="false">44:3 </char><char style="ft" closed="false">Nt bàn tay mặt</char></note> Chúa,</para>
  <para style="q2" vid="PSA 44:3">nhờ cánh tay và Thiên nhan rạng ngời của Ngài;</para>
  <para style="q2" vid="PSA 44:3">chỉ vì Chúa rủ lòng thương họ.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Lạy Chúa là Vua Cao Cả,</para>
  <para style="q2" vid="PSA 44:4">xin ban chiến thắng cho nhà Gia-cốp.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Nhờ sức Chúa chúng con đẩy lui quân địch xâm lăng.</para>
  <para style="q2" vid="PSA 44:5">Nhân danh Chúa, chúng con chà đạp người chống nghịch.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Con không ỷ lại nơi cung đồng, tên sắt,</para>
  <para style="q2" vid="PSA 44:6">lưỡi gươm con cũng không chiến thắng được ai.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Nhưng Chúa giúp chúng con đánh bại kẻ thù,</para>
  <para style="q2" vid="PSA 44:7">bọn ghét con phải cúi đầu nhục nhã.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Chúng con mãi mãi tự hào về Chúa,</para>
  <para style="q2" vid="PSA 44:8">và ca tụng thánh Danh suốt đời.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Nhưng ngày nay Chúa khước từ, và hạ nhục chúng con,</para>
  <para style="q2" vid="PSA 44:9">không còn ra trận với quân đội chúng con.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Để chúng con lùi bước trước quân thù,</para>
  <para style="q2" vid="PSA 44:10">cho chúng cướp sạch của chúng con.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Chúa bỏ mặc chúng con cho bị vồ xé như chiên,</para>
  <para style="q2" vid="PSA 44:11">để chúng con lưu tán trong các nước.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Chúa bán dân Ngài rẻ như bèo bọt,</para>
  <para style="q2" vid="PSA 44:12">bán mà chẳng lợi lộc gì.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Chúa khiến lân bang có cớ phỉ nhổ chúng con,</para>
  <para style="q2" vid="PSA 44:13">khiến người láng giềng có đề tài nhạo báng chúng con.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Chúa khiến chúng con bị châm biếm giữa các nước,</para>
  <para style="q2" vid="PSA 44:14">chúng lắc đầu khi thấy chúng con.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Suốt ngày dài con mang tủi hổ,</para>
  <para style="q2" vid="PSA 44:15">nhục nhã ghi sâu những vết hằn.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />Vẳng bên tai, lời sỉ nhục, mắng la,</para>
  <para style="q2" vid="PSA 44:16">vì kẻ thù địch quyết tâm báo oán.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Dù chúng con tín trung cùng giao ước,</para>
  <para style="q2" vid="PSA 44:17">không phút nào quên Chúa Toàn Năng,</para>
  <para style="q2" vid="PSA 44:17">nhưng hoạn nạn sao vẫn đến gần.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Lòng chúng con không hề dời đổi,</para>
  <para style="q2" vid="PSA 44:18">chân chẳng hề tẻ tách đường Ngài.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Dù bị Ngài đánh tan nơi tử địa,<note caller="+" style="f"><char style="fr" closed="false">44:19 </char><char style="ft" closed="false">Nt nơi ở của loài quái vật, hoặc hang chó rừng</char></note></para>
  <para style="q2" vid="PSA 44:19">cho lạc vào<note caller="+" style="f"><char style="fr" closed="false">44:19 </char><char style="ft" closed="false">Nt phủ trên chúng con</char></note> bóng tối tử vong.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Nếu chúng con quên Danh Thánh Chúa,</para>
  <para style="q2" vid="PSA 44:20">hoặc đưa tay cầu cứu tà thần,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />hẳn Đức Chúa Trời đã khám phá ra lập tức,</para>
  <para style="q2" vid="PSA 44:21">vì Ngài biết rõ lòng thế nhân.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Vì Chúa, mạng sống chúng tôi bị đe dọa suốt ngày; chúng tôi chẳng khác gì bầy chiên tại lò thịt.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Lạy Chúa, lẽ nào Ngài ngủ?</para>
  <para style="q2" vid="PSA 44:23">Xin thức tỉnh! Xin đừng bỏ chúng con mãi mãi.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Sao Chúa đành che mặt giấu tay,</para>
  <para style="q2" vid="PSA 44:24">Chúa đâu quên hoạn nạn người cùng bần?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Chúng con bị hạ xuống hàng cát bụi,</para>
  <para style="q2" vid="PSA 44:25">xác thân này dính sát dưới bùn đen.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Xin Chúa vùng dậy, ra tay tiếp cứu,</para>
  <para style="q2" vid="PSA 44:26">giải thoát chúng con vì tình yêu bất biến của Ngài.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="cl">Thi Thiên 45</para>
  <para style="s1">Bài Hát Mừng Hôn Lễ Vua</para>
  <para style="d">(Giáo huấn ca của con cháu Cô-ra, theo điệu “Hoa huệ”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Tâm hồn ta xúc động với lời hay ý đẹp,</para>
  <para style="q2" vid="PSA 45:1">cảm tác bài thơ ca tụng đức vua,</para>
  <para style="q2" vid="PSA 45:1">lưỡi tôi thanh thoát như ngọn bút của một văn tài.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Vua là người cao quý nhất,</para>
  <para style="q2" vid="PSA 45:2">môi miệng đầy ân huệ đượm nhuần;<note caller="+" style="f"><char style="fr" closed="false">45:2 </char><char style="ft" closed="false">Ctd đôi môi duyên dáng</char></note></para>
  <para style="q2" vid="PSA 45:2">Đức Chúa Trời ban phước cho người mãi mãi.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Ôi đấng anh hùng! Xin đeo gươm báu,</para>
  <para style="q2" vid="PSA 45:3">mặc uy nghiêm, vinh quang rạng ngời.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Trong uy nghi chiến thắng, cưỡi xe lướt tới,</para>
  <para style="q2" vid="PSA 45:4">vì chân lý, khiêm nhường, và thánh thiện,</para>
  <para style="q2" vid="PSA 45:4">tay phải vua thực hiện những công tác phi thường.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Mũi tên vua nhọn bén, hãy xuyên vào tim các vua quân nghịch,<note caller="+" style="f"><char style="fr" closed="false">45:5 </char><char style="ft" closed="false">Nt kẻ thù của vua</char></note></para>
  <para style="q2" vid="PSA 45:5">các dân tộc nghịch thù hãy ngã rạp dưới chân.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Lạy Chúa, ngôi nước vua bền vững đời đời,</para>
  <para style="q2" vid="PSA 45:6">công chính là quyền trượng nước vua.<note caller="+" style="f"><char style="fr" closed="false">45:6 </char><char style="ft" closed="false">Nt cây phủ việt</char></note><verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Vua yêu chuộng công bằng, ghét gian ác.</para>
  <para style="q2" vid="PSA 45:7">Vì thế Đức Chúa Trời, là Đức Chúa Trời của vua đã cất nhắc vua,</para>
  <para style="q2" vid="PSA 45:7">xức dầu hân hoan cho vua nhiều hơn các vua khác.<note caller="+" style="f"><char style="fr" closed="false">45:7 </char><char style="ft" closed="false">Ctd đồng bạn</char></note><verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Áo vua ngào ngạt một dược, lô hội, và nhục quế.<note caller="+" style="f"><char style="fr" closed="false">45:8 </char><char style="ft" closed="false">Nt thêm: một dược, lô hội và nhục quế</char></note></para>
  <para style="q2" vid="PSA 45:8">Từ cung điện ngà ngọc, đàn dây chúc tụng vua.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Các công chúa đứng trong hàng tôn quý.<note caller="+" style="f"><char style="fr" closed="false">45:9 </char><char style="ft" closed="false">Ctd danh dự</char></note></para>
  <para style="q2" vid="PSA 45:9">Hoàng hậu đứng bên phải vua,</para>
  <para style="q2" vid="PSA 45:9">trang sức bằng vàng từ vùng Ô-phia!<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Hỡi quý nương, hãy nghe lời thỉnh giáo.</para>
  <para style="q2" vid="PSA 45:10">Hãy quên đi dân tộc, và nhà cha nàng.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Vua ái mộ nhan sắc nàng;</para>
  <para style="q2" vid="PSA 45:11">hãy tôn kính người, vì là chúa của nàng.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Quý nương Ty-rơ sẽ cung hiến lễ vật cho con.</para>
  <para style="q2" vid="PSA 45:12">Người quyền quý sẽ đến cầu cạnh ân huệ nơi con.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Công nương vinh hạnh tuyệt vời trong cung điện,</para>
  <para style="q2" vid="PSA 45:13">vương bào nàng có dệt sợi vàng.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Trong y phục gấm vóc triều kiến vua,</para>
  <para style="q2" vid="PSA 45:14">theo sau có các trinh nữ cùng ra mắt vua.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Đoàn mỹ nữ vào cung điện</para>
  <para style="q2" vid="PSA 45:15">hân hoan và khoái lạc!<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Các hoàng nam thay thế các tổ phụ.</para>
  <para style="q2" vid="PSA 45:16">Được phong vương cai trị khắp đất nước.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Tôi sẽ làm cho hậu thế ghi nhớ danh tiếng vua.</para>
  <para style="q2" vid="PSA 45:17">Nên các dân tộc sẽ chúc tụng vua mãi mãi.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="cl">Thi Thiên 46</para>
  <para style="s1">Chúa Là Nơi Trú Ẩn</para>
  <para style="d">(Thơ của con cháu Cô-ra, theo điệu A-la-mo, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Chúa là nơi ẩn náu, và năng lực tôi,</para>
  <para style="q2" vid="PSA 46:1">Ngài sẵn sàng phù hộ lúc gian nan.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Vì thế, tôi sẽ chẳng sợ hãi, lo âu,</para>
  <para style="q2" vid="PSA 46:2">cho dù đất sụt, núi chìm vào lòng biển,<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Dù biển gầm và sôi bọt,<note caller="+" style="f"><char style="fr" closed="false">46:3 </char><char style="ft" closed="false">Ctd sóng đánh sôi bọt</char></note></para>
  <para style="q2" vid="PSA 46:3">làm núi lay động vì nước dâng lên.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Có một dòng sông mang vui vẻ cho thành của Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 46:4">là nơi thánh của Đấng Chí Cao.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Đức Chúa Trời ngự giữa thành ấy; không thể bị hủy diệt.</para>
  <para style="q2" vid="PSA 46:5">Vì từ rạng đông, Đức Chúa Trời sẽ bảo vệ.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Các dân tộc náo loạn,</para>
  <para style="q2" vid="PSA 46:6">các vương quốc suy vi!</para>
  <para style="q1" vid="PSA 46:6">Đức Chúa Trời lên tiếng,</para>
  <para style="q2" vid="PSA 46:6">và đất tan chảy ra!<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Chúa Hằng Hữu Vạn Quân<note caller="+" style="f"><char style="fr" closed="false">46:7 </char><char style="ft" closed="false">Nt Chúa tể các quân đội</char></note> ở với chúng ta,</para>
  <para style="q2" vid="PSA 46:7">Đức Chúa Trời của Gia-cốp là thành lũy kiên cố.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Hãy đến, ngắm nhìn công tác Chúa Hằng Hữu:</para>
  <para style="q2" vid="PSA 46:8">Mặt đất tan nát vì tay Chúa đoán phạt.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Chúa chấm dứt chiến tranh khắp hoàn vũ,</para>
  <para style="q2" vid="PSA 46:9">Ngài bẻ cung, đập tan gươm giáo,</para>
  <para style="q2" vid="PSA 46:9">Chúa đốt rụi các chiến xa.<verse eid="PSA 46:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />“Hãy yên lặng, và nhìn biết Ta là Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 46:10">Ta sẽ được tôn vinh giữa các dân.</para>
  <para style="q2" vid="PSA 46:10">Ta sẽ được tôn cao trên đất.”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Chúa Hằng Hữu Vạn Quân ở với chúng ta;</para>
  <para style="q2" vid="PSA 46:11">Đức Chúa Trời của Gia-cốp là tường thành kiên cố.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="cl">Thi Thiên 47</para>
  <para style="s1">Chúa Là Vua Khắp Đất</para>
  <para style="d">(Thơ của con cháu Cô-ra, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Hỡi muôn dân, hãy vỗ tay!</para>
  <para style="q2" vid="PSA 47:1">Hãy reo mừng ca ngợi Chúa.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Vì Chúa Hằng Hữu Chí Cao thật đáng kinh sợ.</para>
  <para style="q2" vid="PSA 47:2">Ngài là Vua lớn của cả hoàn vũ.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Ngài khắc phục các dân tộc,</para>
  <para style="q2" vid="PSA 47:3">đặt các quốc gia dưới chân chúng ta.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Ngài chọn Đất Hứa cho cơ nghiệp đời đời của chúng ta,</para>
  <para style="q2" vid="PSA 47:4">con cháu Gia-cốp hãnh diện vì được Ngài yêu mến.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Đức Chúa Trời ngự lên giữa tiếng reo mừng rộn rã.</para>
  <para style="q2" vid="PSA 47:5">Chúa Hằng Hữu ngự lên trong tiếng kèn vang dội.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Hãy ca ngợi Đức Chúa Trời, hãy hát lên;</para>
  <para style="q2" vid="PSA 47:6">hãy ca ngợi Vua chúng ta, hãy hát lên!<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Vì Đức Chúa Trời là Vua trị vì khắp đất.</para>
  <para style="q2" vid="PSA 47:7">Hãy hát thi thiên ngợi tôn Ngài!<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Đức Chúa Trời cai trị trên các dân tộc,</para>
  <para style="q2" vid="PSA 47:8">Ngài ngự trên ngai chí thánh.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Người cao quý trong các nước họp nhau</para>
  <para style="q2" vid="PSA 47:9">như con dân Đức Chúa Trời của Áp-ra-ham.</para>
  <para style="q1" vid="PSA 47:9">Vì các vua trên đất thuộc quyền Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 47:9">Ngài được tôn cao vô cùng khắp mọi nơi.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="cl">Thi Thiên 48</para>
  <para style="s1">Vinh Quang của Si-ôn</para>
  <para style="d">(Thơ của con cháu Cô-ra)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />Chúa Hằng Hữu thật vĩ đại,</para>
  <para style="q2" vid="PSA 48:1">đáng tôn đáng kính,</para>
  <para style="q1" vid="PSA 48:1">trong thành của Đức Chúa Trời chúng ta,</para>
  <para style="q2" vid="PSA 48:1">là nơi trên đỉnh núi thánh!<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Núi thánh cao ngất, đẹp đẽ;</para>
  <para style="q2" vid="PSA 48:2">là niềm vui của toàn trái đất!</para>
  <para style="q1" vid="PSA 48:2">Núi Si-ôn nổi bật trên đỉnh Sa-phan,</para>
  <para style="q2" vid="PSA 48:2">là thành của Vua Vĩ Đại!<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Chính Đức Chúa Trời ngự trong các thành lũy,</para>
  <para style="q2" vid="PSA 48:3">Ngài chính là tường thành kiên cố.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Kìa, các vua liên minh họp lại,</para>
  <para style="q2" vid="PSA 48:4">cùng kéo quân tiến đánh.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Nhưng họ sửng sốt, đứng nhìn,</para>
  <para style="q2" vid="PSA 48:5">rồi khiếp sợ bỏ chạy,<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Tại đó, chúng run rẩy rụng rời,</para>
  <para style="q2" vid="PSA 48:6">đau đớn như đàn bà sắp sinh nở.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Chúa đánh tan họ, như các chiến thuyền Ta-rê-si</para>
  <para style="q2" vid="PSA 48:7">bị gió đông đánh vỡ tan tành.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Những điều chúng tôi nghe về vinh quang của thành,</para>
  <para style="q2" vid="PSA 48:8">nhưng nay chúng tôi được thấy—</para>
  <para style="q2" vid="PSA 48:8">thành Chúa Hằng Hữu Vạn Quân.</para>
  <para style="q1" vid="PSA 48:8">Đó là thành của Đức Chúa Trời chúng tôi;</para>
  <para style="q2" vid="PSA 48:8">Ngài bảo vệ thành thánh muôn đời.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Lạy Đức Chúa Trời, trong Đền Thờ Ngài,</para>
  <para style="q2" vid="PSA 48:9">chúng con suy niệm về tình thương không dời đổi của Chúa.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Lạy Đức Chúa Trời, như Danh Ngài,</para>
  <para style="q2" vid="PSA 48:10">tiếng ca ngợi Chúa vang đến tận cùng trái đất.</para>
  <para style="q2" vid="PSA 48:10">Tay phải Ngài tràn đầy vinh quang.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Núi Si-ôn, hãy hớn hở.</para>
  <para style="q2" vid="PSA 48:11">Thôn làng Giu-đa, hãy vui mừng</para>
  <para style="q2" vid="PSA 48:11">vì sự công bằng của Chúa.<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Hãy đi đến và dạo quanh Si-ôn.</para>
  <para style="q2" vid="PSA 48:12">Hãy đếm các ngọn tháp.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />Hãy nhìn kỹ các thành lũy phòng vệ,</para>
  <para style="q2" vid="PSA 48:13">ngắm xem các lâu đài, cung điện</para>
  <para style="q2" vid="PSA 48:13">để mai sau thuật lại cho hậu thế.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Chúa là Đức Chúa Trời của chúng tôi mãi mãi,</para>
  <para style="q2" vid="PSA 48:14">Ngài lãnh đạo chúng tôi cho đến cuối cùng.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="cl">Thi Thiên 49</para>
  <para style="s1">Nương Nhờ Của Cải Là Dại Dột</para>
  <para style="d">(Thơ của con cháu Cô-ra, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Hãy nghe đây, tất cả các dân tộc!</para>
  <para style="q2" vid="PSA 49:1">Hỡi những ai sống trên đất hãy chú ý!<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Người sang hay hèn,</para>
  <para style="q2" vid="PSA 49:2">Người giàu hay nghèo—hãy lắng nghe!<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Miệng tôi sẽ nói lời khôn ngoan,<note caller="+" style="f"><char style="fr" closed="false">49:3 </char><char style="ft" closed="false">Nt tri thức</char></note></para>
  <para style="q2" vid="PSA 49:3">từ tâm hồn tôi sẽ ban tri thức.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Tôi sẽ lắng tai nghe nhiều châm ngôn,</para>
  <para style="q2" vid="PSA 49:4">và giải câu đố bí hiểm qua tiếng đàn hạc.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Tại sao ta còn sợ ngày tai nạn</para>
  <para style="q2" vid="PSA 49:5">khi kẻ thù lừa đảo vây quanh?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Họ là người đặt lòng tin nơi của cải mình</para>
  <para style="q2" vid="PSA 49:6">và khoe khoang về sự giàu có dư tràn.<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Không ai chuộc được sinh mạng của người khác,</para>
  <para style="q2" vid="PSA 49:7">hay trả tiền chuộc mạng người cho Đức Chúa Trời.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Tiền chuộc mạng quá đắt,</para>
  <para style="q2" vid="PSA 49:8">biết giá nào trả đủ<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />để người ấy được sống mãi mãi,</para>
  <para style="q2" vid="PSA 49:9">và không thấy cái chết.<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Con người sẽ nhận thấy người khôn chết,</para>
  <para style="q2" vid="PSA 49:10">người ngu dại và khờ khạo cũng chết như nhau,</para>
  <para style="q2" vid="PSA 49:10">để tài sản lại cho người khác.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Mồ mả sẽ là nhà ở của họ mãi mãi,</para>
  <para style="q2" vid="PSA 49:11">nơi cư trú cho nhiều thế hệ.</para>
  <para style="q2" vid="PSA 49:11">Dù đã lấy tên mình đặt cho tài sản ruộng đất,<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />nhưng con người, dù vinh hoa cũng chẳng lâu dài.</para>
  <para style="q2" vid="PSA 49:12">Họ sẽ đi mất chẳng khác gì loài dã thú.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Đó là số phận của những người tự phụ,</para>
  <para style="q2" vid="PSA 49:13">và những ai theo họ, vì chấp nhận lý thuyết của họ.<verse eid="PSA 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Họ như đàn chiên bị định xuống âm phủ,<note caller="+" style="f"><char style="fr" closed="false">49:14 </char><char style="ft" closed="false">Nt thêm: và ngu ngốc</char></note></para>
  <para style="q2" vid="PSA 49:14">sự chết sẽ chăn giữ họ.</para>
  <para style="q1" vid="PSA 49:14">Buổi sáng, người công chính sẽ quản trị họ.</para>
  <para style="q2" vid="PSA 49:14">Thân xác họ sẽ rữa nát trong nấm mồ,<note caller="+" style="f"><char style="fr" closed="false">49:14 </char><char style="ft" closed="false">Nt Sheol</char></note></para>
  <para style="q2" vid="PSA 49:14">xa khỏi những cung đền lộng lẫy.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Nhưng, Đức Chúa Trời sẽ chuộc linh hồn tôi khỏi âm phủ.</para>
  <para style="q2" vid="PSA 49:15">Và đem tôi lên với Ngài.<note caller="+" style="f"><char style="fr" closed="false">49:15 </char><char style="ft" closed="false">Nt vì Ngài tiếp tôi về</char></note><verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Đừng kinh sợ khi một người trở nên giàu có</para>
  <para style="q2" vid="PSA 49:16">khi vinh hoa phú quý hắn cứ gia tăng<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />Vì khi người ấy xuôi tay nhắm mắt, chẳng đem theo được gì.</para>
  <para style="q2" vid="PSA 49:17">Vinh hoa cũng chẳng theo người xuống mồ;<note caller="+" style="f"><char style="fr" closed="false">49:17 </char><char style="ft" closed="false">Nt vinh quang không theo người xuống đó</char></note><verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Dù khi còn sống tự coi mình là hạnh phúc,</para>
  <para style="q2" vid="PSA 49:18">vì hưng thịnh, nên được đời ca tụng.<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Nhưng người sẽ về với các thế hệ đi trước</para>
  <para style="q2" vid="PSA 49:19">và mãi mãi không thấy được ánh sáng.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Người được vinh hoa, lại thiếu hiểu biết;</para>
  <para style="q2" vid="PSA 49:20">người cũng sẽ chết như loài cầm thú.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="cl">Thi Thiên 50</para>
  <para style="s1">Chúa Phán Xét Người Ác và Người Lành</para>
  <para style="d">(Thơ của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Chúa Hằng Hữu, Đấng Toàn Năng, là Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 50:1">và Ngài đã phán;</para>
  <para style="q1" vid="PSA 50:1">Ngài kêu gọi cả toàn cầu,</para>
  <para style="q2" vid="PSA 50:1">từ khắp cõi đông, tây.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Từ Núi Si-ôn, kinh thành đẹp đẽ tuyệt vời,</para>
  <para style="q2" vid="PSA 50:2">Đức Chúa Trời chiếu rực hào quang.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Đức Chúa Trời chúng ta quang lâm,</para>
  <para style="q2" vid="PSA 50:3">không lặng lẽ, âm thầm.</para>
  <para style="q1" vid="PSA 50:3">Lửa ăn nuốt mọi thứ trong đường Ngài,</para>
  <para style="q2" vid="PSA 50:3">và bão tố gầm chung quanh Chúa.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Ngài bảo trời đất làm nhân chứng</para>
  <para style="q2" vid="PSA 50:4">khi Chúa phán xét dân Ngài.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />Ngài ra lệnh triệu tập đoàn dân thánh,</para>
  <para style="q2" vid="PSA 50:5">đã từng tế lễ, lập ước với Ngài.<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Trời xanh thẳm tuyên rao Ngài công chính,</para>
  <para style="q2" vid="PSA 50:6">Đức Chúa Trời sẽ xét xử thế gian.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />“Hỡi dân Ta, lắng nghe lời Ta nói.</para>
  <para style="q2" vid="PSA 50:7">Đây là chứng cớ Ta buộc tội ngươi, hỡi Ít-ra-ên:</para>
  <para style="q2" vid="PSA 50:7">Ta là Đức Chúa Trời, Đức Chúa Trời của ngươi.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Ta không trách các ngươi vì tế lễ,</para>
  <para style="q2" vid="PSA 50:8">hoặc sinh tế thiêu dâng hiến trên bàn thờ.<note caller="+" style="f"><char style="fr" closed="false">50:8 </char><char style="ft" closed="false">Nt hằng ở trước mặt Ta</char></note><verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Nhưng Ta không cần bò giữa trại,</para>
  <para style="q2" vid="PSA 50:9">cũng chẳng đòi dê trong chuồng.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Vì tất cả thú rừng thuộc về Ta,</para>
  <para style="q2" vid="PSA 50:10">cũng như muông thú trên nghìn đồi cao.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Ta quen biết từng con chim trên các núi,</para>
  <para style="q2" vid="PSA 50:11">và các loài thú nơi đồng xanh thuộc về Ta.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Nếu Ta đói, cũng không cần cho ngươi biết,</para>
  <para style="q2" vid="PSA 50:12">vì Ta làm chủ vũ trụ muôn loài.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Ta há ăn thịt bò tế lễ chăng?</para>
  <para style="q2" vid="PSA 50:13">Ta có uống máu dê non rồi sao?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Hãy dâng lời tạ ơn làm tế lễ lên Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 50:14">trả điều khấn nguyện cho Đấng Chí Cao.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Hãy kêu cầu Ta trong lúc gian truân,</para>
  <para style="q2" vid="PSA 50:15">Ta sẽ giải cứu con,</para>
  <para style="q2" vid="PSA 50:15">và con sẽ tôn vinh Ta.”<verse eid="PSA 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16" />Nhưng Đức Chúa Trời trách những người gian ác:</para>
  <para style="q1" vid="PSA 50:16">“Sao ngươi được trích dẫn các điều răn</para>
  <para style="q2" vid="PSA 50:16">và miệng ngươi luôn nhắc lời giao ước?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Ngươi vốn ghét thi hành mệnh lệnh,</para>
  <para style="q2" vid="PSA 50:17">bỏ sau lưng các huấn thị Ta.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Thấy kẻ trộm, ngươi tán thành hành động của chúng,</para>
  <para style="q2" vid="PSA 50:18">ngươi đồng mưu với người ngoại tình.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Miệng ngươi tuôn những lời ác độc,</para>
  <para style="q2" vid="PSA 50:19">lưỡi ngươi thêu dệt chuyện dối lừa,<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Đặt chuyện cáo gian em ruột,</para>
  <para style="q2" vid="PSA 50:20">ngồi lê đôi mách hại anh mình.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Ngươi tác hại người khi Ta thinh lặng;<note caller="+" style="f"><char style="fr" closed="false">50:21 </char><char style="ft" closed="false">Nt đấy là những công việc ngươi làm</char></note></para>
  <para style="q2" vid="PSA 50:21">ngươi tưởng Ta bỏ mặc làm ngơ.<note caller="+" style="f"><char style="fr" closed="false">50:21 </char><char style="ft" closed="false">Nt ngươi tưởng Ta cũng giống như ngươi</char></note></para>
  <para style="q1" vid="PSA 50:21">Nhưng đến ngày Ta sẽ quở phạt,</para>
  <para style="q2" vid="PSA 50:21">đặt cáo trạng ngay trước mặt ngươi.<verse eid="PSA 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />Bọn người quên Chúa nên lưu ý,</para>
  <para style="q2" vid="PSA 50:22">kẻo Ta xé nát ngươi từng mảnh,</para>
  <para style="q2" vid="PSA 50:22">không ai giải cứu được.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Ai dâng lời cảm tạ làm tế lễ là tôn kính Ta.</para>
  <para style="q2" vid="PSA 50:23">Người nào theo đường ngay thẳng,</para>
  <para style="q2" vid="PSA 50:23">Ta sẽ cho thấy sự cứu chuộc của Đức Chúa Trời.”<note caller="+" style="f"><char style="fr" closed="false">50:23 </char><char style="ft" closed="false">Ctd Ta sẽ tỏ ra sự cứu rỗi cho người nào nói chuyện cách đúng đắn</char></note><verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="cl">Thi Thiên 51</para>
  <para style="s1">Lời Cầu Nguyện Sám Hối</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng khi Tiên tri Na-than cảnh cáo Đa-vít về tội gian dâm với Bát-sê-ba)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Lạy Đức Chúa Trời, xin xót thương con,</para>
  <para style="q2" vid="PSA 51:1">vì Chúa nhân từ.</para>
  <para style="q1" vid="PSA 51:1">Xin xóa tội con,</para>
  <para style="q2" vid="PSA 51:1">vì Chúa độ lượng từ bi.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Xin rửa sạch tì vít gian tà.</para>
  <para style="q2" vid="PSA 51:2">Cho con thanh khiết khỏi tội lỗi.<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Con xưng nhận những điều vi phạm,</para>
  <para style="q2" vid="PSA 51:3">tội ác con trước mắt nào quên.<note caller="+" style="f"><char style="fr" closed="false">51:3 </char><char style="ft" closed="false">Nt luôn ở trước mặt con</char></note><verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Con đã phạm tội chống lại một mình Chúa;</para>
  <para style="q2" vid="PSA 51:4">và làm điều ác đức ngay trước mắt Ngài.</para>
  <para style="q1" vid="PSA 51:4">Vì thế Chúa lên án là hoàn toàn đúng,</para>
  <para style="q2" vid="PSA 51:4">và Chúa phán xét rất công minh.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Con sinh ra vốn người tội lỗi—</para>
  <para style="q2" vid="PSA 51:5">mang tội từ khi mẹ mang thai.<note caller="+" style="f"><char style="fr" closed="false">51:5 </char><char style="ft" closed="false">Nt mẹ hoài thai</char></note><verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Chúa muốn tâm hồn con chân thật,</para>
  <para style="q2" vid="PSA 51:6">Ngài sẽ dạy con khôn ngoan trong sâu kín cõi lòng.<note caller="+" style="f"><char style="fr" closed="false">51:6 </char><char style="ft" closed="false">Nt Chúa sẽ làm cho con biết sự khôn ngoan trong nơi bí mật của lòng con</char></note><verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Xin tẩy con với chùm kinh giới,</para>
  <para style="q2" vid="PSA 51:7">rửa lòng con trắng trong như tuyết.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Xin cho con nghe lại tiếng hân hoan;</para>
  <para style="q2" vid="PSA 51:8">xương cốt con Chúa đã bẻ gãy—</para>
  <para style="q2" vid="PSA 51:8">nay được hoan lạc.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Xin Chúa ngoảnh mặt khỏi tội con đã phạm.</para>
  <para style="q2" vid="PSA 51:9">Xóa ác gian sạch khỏi lòng con.<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Lạy Đức Chúa Trời, xin dựng trong con tấm lòng trong sạch.</para>
  <para style="q2" vid="PSA 51:10">Xin khôi phục trong con một tâm linh ngay thẳng.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Xin đừng loại con khỏi sự hiện diện Chúa,<note caller="+" style="f"><char style="fr" closed="false">51:11 </char><char style="ft" closed="false">Nt đừng bỏ con khỏi mặt Ngài</char></note></para>
  <para style="q2" vid="PSA 51:11">cũng đừng cất Thánh Linh Chúa khỏi lòng con.<verse eid="PSA 51:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Xin phục hồi niềm vui cứu chuộc cho con,</para>
  <para style="q2" vid="PSA 51:12">cho con tinh thần sẵn sàng,<note caller="+" style="f"><char style="fr" closed="false">51:12 </char><char style="ft" closed="false">Nt tâm linh sẵn sàng</char></note> giúp con đứng vững.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Khi ấy, con sẽ chỉ đường cho người phản loạn,</para>
  <para style="q2" vid="PSA 51:13">và họ sẽ quay về với Chúa.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Xin tha con tội làm đổ máu, lạy Đức Chúa Trời, Đấng cứu rỗi;</para>
  <para style="q2" vid="PSA 51:14">để lưỡi con ca ngợi đức công bằng của Chúa.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Lạy Chúa, xin mở môi con,</para>
  <para style="q2" vid="PSA 51:15">cho miệng con rao truyền lời ca tụng.<verse eid="PSA 51:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Tế lễ có nghĩa gì với Chúa, dù con dâng hiến mãi.</para>
  <para style="q2" vid="PSA 51:16">Sinh tế thiêu Chúa có nhậm đâu.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Sinh tế Chúa ưa thích là tâm hồn tan vỡ.</para>
  <para style="q2" vid="PSA 51:17">Lạy Đức Chúa Trời, lòng con tan vỡ thống hối ăn năn.<verse eid="PSA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Xin vui lòng cho Si-ôn phước hạnh;</para>
  <para style="q2" vid="PSA 51:18">xin trùng tu tường lũy Giê-ru-sa-lem;<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Khi ấy, Chúa mới nhậm tế lễ công chính,</para>
  <para style="q2" vid="PSA 51:19">cùng sinh tế thiêu và các sinh tế.</para>
  <para style="q2" vid="PSA 51:19">Rồi người ta sẽ dâng bò đực trên bàn thờ của Chúa.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="cl">Thi Thiên 52</para>
  <para style="s1">Luận Điệu Khoe Khoang của Người Ác</para>
  <para style="d">(Giáo huấn ca của Đa-vít, soạn cho nhạc trưởng khi Đô-e người Ê-đôm đến báo Sau-lơ: “Đa-vít vào nhà A-hi-mê-léc”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Này, người mạnh sức, sao cả ngày cứ khoe khoang việc ác?</para>
  <para style="q2" vid="PSA 52:1">Người không nhớ sự nhân từ của Đức Chúa Trời còn mãi sao?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Cả ngày người âm mưu hủy diệt.</para>
  <para style="q2" vid="PSA 52:2">Lưỡi ngươi không khác gì dao cạo bén,</para>
  <para style="q2" vid="PSA 52:2">làm điều tội ác và lừa dối.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Ngươi thích làm ác hơn làm lành,</para>
  <para style="q2" vid="PSA 52:3">chuộng dối trá hơn thành thật.<verse eid="PSA 52:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Ngươi thích dùng lời độc hại, ngươi dối trá!<verse eid="PSA 52:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Nhưng Đức Chúa Trời sẽ khiến ngươi tàn bại.</para>
  <para style="q2" vid="PSA 52:5">Ngài sẽ kéo bật ngươi khỏi nhà,<note caller="+" style="f"><char style="fr" closed="false">52:5 </char><char style="ft" closed="false">Nt lều trại</char></note></para>
  <para style="q2" vid="PSA 52:5">và nhổ ngươi khỏi chốn nhân gian.<verse eid="PSA 52:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Người công chính sẽ nhìn và run sợ.</para>
  <para style="q2" vid="PSA 52:6">Họ sẽ cười và nói rằng:<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“Hãy nhìn việc xảy ra cho người mạnh mẽ,</para>
  <para style="q2" vid="PSA 52:7">là người không nương cậy Đức Chúa Trời.</para>
  <para style="q1" vid="PSA 52:7">Chỉ cậy trông nơi tiền bạc của mình,</para>
  <para style="q2" vid="PSA 52:7">và giàu mạnh nhờ tiêu diệt người khác.”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Nhưng, tôi như cây ô-liu, tươi tốt trong nhà Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 52:8">Tôi luôn nương nhờ lòng nhân từ Ngài.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Tôi sẽ ca ngợi Chúa mãi, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 52:9">về những gì Chúa đã làm.</para>
  <para style="q1" vid="PSA 52:9">Tôi sẽ đặt hy vọng nơi Danh Chúa vì thật tốt lành,</para>
  <para style="q2" vid="PSA 52:9">tôi ca ngợi Chúa giữa những người thánh.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="cl">Thi Thiên 53</para>
  <para style="s1">Ngu Dại và Tội Ác của Loài Người</para>
  <para style="d">(Giáo huấn ca của Đa-vít, soạn cho nhạc trưởng, theo điệu Ma-ha-la)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Người ngu dại thầm nhủ:</para>
  <para style="q2" vid="PSA 53:1">“Không làm gì có Đức Chúa Trời.”</para>
  <para style="q1" vid="PSA 53:1">Chúng đều hư hỏng và hành động gian ác,</para>
  <para style="q2" vid="PSA 53:1">chẳng một ai làm điều thiện lành!<note caller="+" style="f"><char style="fr" closed="false">53:1 </char><char style="ft" closed="false">Nt làm những việc ghen ghét</char></note><verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Đức Chúa Trời từ trời cao,</para>
  <para style="q2" vid="PSA 53:2">nhìn xuống loài người;</para>
  <para style="q1" vid="PSA 53:2">Ngài xem có ai khôn ngoan,</para>
  <para style="q2" vid="PSA 53:2">hướng lòng tìm kiếm Đức Chúa Trời.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Nhưng tất cả đều từ chối Chúa;</para>
  <para style="q2" vid="PSA 53:3">cùng nhau trở nên hư hỏng.</para>
  <para style="q1" vid="PSA 53:3">Chẳng ai làm điều thiện lành,</para>
  <para style="q2" vid="PSA 53:3">dù một người cũng không!<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Người gian ác không bao giờ học hỏi sao?</para>
  <para style="q2" vid="PSA 53:4">Chúng vồ xé dân Ta như ăn bánh,</para>
  <para style="q2" vid="PSA 53:4">và chẳng kêu cầu Đức Chúa Trời bao giờ.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Chúng sẽ chìm trong khiếp sợ, kinh hoàng,</para>
  <para style="q2" vid="PSA 53:5">nơi chẳng có gì phải sợ.</para>
  <para style="q1" vid="PSA 53:5">Đức Chúa Trời sẽ rãi rắc xương cốt của những người hại con.</para>
  <para style="q2" vid="PSA 53:5">Con làm chúng hổ nhục, vì Đức Chúa Trời khinh bỏ chúng.<note caller="+" style="f"><char style="fr" closed="false">53:5 </char><char style="ft" closed="false">Nt thế hệ công chính</char></note><verse eid="PSA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Ai sẽ giải cứu cho Ít-ra-ên từ Núi Si-ôn?</para>
  <para style="q2" vid="PSA 53:6">Khi Đức Chúa Trời khôi phục dân Ngài,</para>
  <para style="q2" vid="PSA 53:6">Gia-cốp sẽ reo vui, và Ít-ra-ên sẽ mừng rỡ.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="cl">Thi Thiên 54</para>
  <para style="s1">Xin Chúa Bênh Vực</para>
  <para style="d">(Giáo huấn ca của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây, khi người Xíp đến báo Sau-lơ: “Đa-vít đang trốn trong xứ chúng tôi”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Lạy Đức Chúa Trời, xin cứu con vì Danh Chúa!</para>
  <para style="q2" vid="PSA 54:1">Xin bảo vệ<note caller="+" style="f"><char style="fr" closed="false">54:1 </char><char style="ft" closed="false">Nt xét xử</char></note> con với sức mạnh toàn năng.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Lạy Đức Chúa Trời, xin nghe lời con khẩn nguyện.</para>
  <para style="q2" vid="PSA 54:2">Xin lắng tai nghe lời kêu cầu của con.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Người xa lạ nổi lên chống đối;</para>
  <para style="q2" vid="PSA 54:3">bọn bạo tàn tìm hại sinh mạng con.</para>
  <para style="q2" vid="PSA 54:3">Họ chẳng lưu tâm đến Đức Chúa Trời.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Nhưng Đức Chúa Trời là Đấng cứu giúp con.</para>
  <para style="q2" vid="PSA 54:4">Chúa nâng đỡ nuôi dưỡng hồn con!<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Theo đức thành tín, xin Ngài tiêu diệt.</para>
  <para style="q2" vid="PSA 54:5">Báo trả công minh những kẻ ác thù.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Con tự nguyện dâng lên Ngài tế lễ;</para>
  <para style="q2" vid="PSA 54:6">con sẽ luôn ca tụng Danh Ngài, lạy Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 54:6">vì Danh Chúa thật tốt lành, đẹp đẽ.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Chúa giải cứu con khỏi hết gian truân,</para>
  <para style="q2" vid="PSA 54:7">trong khi con chứng kiến kẻ thù thất bại.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="cl">Thi Thiên 55</para>
  <para style="s1">Xin Chúa Diệt Người Gian Ác</para>
  <para style="d">(Giáo huấn ca của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Lạy Đức Chúa Trời, xin lắng nghe con cầu nguyện.</para>
  <para style="q2" vid="PSA 55:1">Xin đừng làm ngơ lời khẩn nài của con!<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Xin Chúa nghe và đáp lời con,</para>
  <para style="q2" vid="PSA 55:2">con bối rối, bồn chồn, và quẫn trí.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Khi nghe tiếng quân thù,</para>
  <para style="q2" vid="PSA 55:3">khi đối diện cái nhìn của bọn gian ác.</para>
  <para style="q1" vid="PSA 55:3">Họ tuôn đổ đau thương trên con,</para>
  <para style="q2" vid="PSA 55:3">vì họ bắt bớ con trong cơn giận dữ.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Lòng con đau xót, hoang mang,</para>
  <para style="q2" vid="PSA 55:4">như lạc bước sa chân vào chỗ chết.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Con khiếp sợ và run rẩy,</para>
  <para style="q2" vid="PSA 55:5">nỗi kinh hoàng tràn ngập trên con.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Ước gì con có đôi cánh như bồ câu;</para>
  <para style="q2" vid="PSA 55:6">cao bay xa chạy tìm đường an thân!<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Để chạy thoát đi xa,</para>
  <para style="q2" vid="PSA 55:7">ở tận vùng hoang mạc.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Con vội vàng tìm nơi ẩn náu—</para>
  <para style="q2" vid="PSA 55:8">để lánh xa bão tố căm thù.<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Lạy Chúa, xin khiến chúng hoang mang, cho ngôn ngữ bất đồng,</para>
  <para style="q2" vid="PSA 55:9">vì thành phố đầy bạo động và tội ác.<verse eid="PSA 55:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Ngày đêm, họ lảng vảng quanh thành,<note caller="+" style="f"><char style="fr" closed="false">55:10 </char><char style="ft" closed="false">Nt trên tường thành</char></note></para>
  <para style="q2" vid="PSA 55:10">dân cư bị loạn ly, gian khổ,<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Tai ương, áp bức, hủy hoại khắp nơi,</para>
  <para style="q2" vid="PSA 55:11">đường phố đầy hăm dọa và gian dối.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Giá tôi bị quân thù thách đố—</para>
  <para style="q2" vid="PSA 55:12">thì tôi cũng ráng chịu.</para>
  <para style="q1" vid="PSA 55:12">Hoặc địch thủ ra mặt tranh giành—</para>
  <para style="q2" vid="PSA 55:12">tôi đã biết tìm đường lẩn tránh.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Nhưng người hại tôi chính là bạn thân,</para>
  <para style="q2" vid="PSA 55:13">người gần gũi, ngang hàng với tôi.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Họ đã cùng tôi thân mật chuyện trò,</para>
  <para style="q2" vid="PSA 55:14">chúng tôi cùng dự lễ nơi nhà Đức Chúa Trời.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Xin sự chết thình lình đến trên họ;</para>
  <para style="q2" vid="PSA 55:15">khiến họ phải vào âm phủ,<note caller="+" style="f"><char style="fr" closed="false">55:15 </char><char style="ft" closed="false">Nt còn sống mà xuống âm phủ</char></note></para>
  <para style="q2" vid="PSA 55:15">vì cưu mang gian ác trong lòng.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Nhưng con kêu cứu Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 55:16">và được Chúa Hằng Hữu giải thoát.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Cả sáng, tối, lẫn trưa,</para>
  <para style="q2" vid="PSA 55:17">lòng con luôn khẩn nguyện,</para>
  <para style="q2" vid="PSA 55:17">và Chúa Hằng Hữu nghe tiếng con thở than.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Chúa giải cứu con và giữ con an toàn</para>
  <para style="q2" vid="PSA 55:18">khi quân thù gây chiến với con.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Đức Chúa Trời, Đấng cai trị vĩnh viễn,</para>
  <para style="q2" vid="PSA 55:19">sẽ lắng nghe và báo trả công minh.</para>
  <para style="q1" vid="PSA 55:19">Kẻ thù con không thay đổi đường mình,</para>
  <para style="q2" vid="PSA 55:19">cũng không biết kính sợ Đức Chúa Trời.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Bạn thân con phản bội bạn bè;</para>
  <para style="q2" vid="PSA 55:20">họ bội ước điều mình đã hứa.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Ngoài miệng nói toàn lời êm ái,<note caller="+" style="f"><char style="fr" closed="false">55:21 </char><char style="ft" closed="false">Nt miệng trơn hơn bơ</char></note></para>
  <para style="q2" vid="PSA 55:21">mà trong lòng thì chuẩn bị chiến tranh.</para>
  <para style="q1" vid="PSA 55:21">Lưỡi đẩy đưa lời hứa hẹn hòa bình,<note caller="+" style="f"><char style="fr" closed="false">55:21 </char><char style="ft" closed="false">Nt lời nói dịu dàng hơn dầu</char></note></para>
  <para style="q2" vid="PSA 55:21">nhưng thâm tâm lưỡi gươm trần giấu sẵn.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Hãy trao gánh nặng mình cho Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 55:22">và Ngài sẽ đỡ nâng,</para>
  <para style="q2" vid="PSA 55:22">Ngài không để người tin kính bị vấp ngã.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Nhưng lạy Đức Chúa Trời, xin cho bọn người gian ác rơi xuống hố hủy diệt.</para>
  <para style="q1" vid="PSA 55:23">Kẻ sát nhân và bọn dối trá sẽ chết yểu;</para>
  <para style="q2" vid="PSA 55:23">còn riêng con, suốt đời tin cậy Ngài.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="cl">Thi Thiên 56</para>
  <para style="s1">Xin Giải Cứu và Dâng Lời Cảm Tạ</para>
  <para style="d">(Thơ của Đa-vít viết khi bị người Phi-li-tin bắt giữ tại thành Gát)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Lạy Đức Chúa Trời, xin thương xót con,</para>
  <para style="q2" vid="PSA 56:1">vì kẻ thù đang đuổi gắt sau con.</para>
  <para style="q2" vid="PSA 56:1">Hằng ngày họ theo sát tấn công con.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Ngày nào họ cũng săn đuổi,</para>
  <para style="q2" vid="PSA 56:2">hung hãn xua quân tấn công con.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Những khi con sợ hãi,</para>
  <para style="q2" vid="PSA 56:3">con sẽ nương cậy nơi Ngài.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Con ngợi tôn Đức Chúa Trời vì lời Ngài đã hứa.</para>
  <para style="q2" vid="PSA 56:4">Con tin cậy Đức Chúa Trời, vậy tại sao con phải sợ lo?</para>
  <para style="q2" vid="PSA 56:4">Có thể nào con người hại được con?<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Suốt ngày họ bắt bẻ từng lời,</para>
  <para style="q2" vid="PSA 56:5">vắt óc tìm phương kế giết hại con.<verse eid="PSA 56:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Họ luôn họp nhau, rình rập,</para>
  <para style="q2" vid="PSA 56:6">theo con từng bước, nóng lòng giết hại con.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Xin đừng để họ thoát bất cứ vì lý do nào,</para>
  <para style="q2" vid="PSA 56:7">lạy Đức Chúa Trời xin nổi giận tiêu diệt họ.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Xin Chúa ghi nhận tiếng con than thở,</para>
  <para style="q2" vid="PSA 56:8">giữ nước mắt con trong chai của Ngài.</para>
  <para style="q2" vid="PSA 56:8">Những giọt lệ này lẽ nào Ngài không ghi nhớ?<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Kẻ thù con lập tức bị đẩy lui khi con kêu cầu Chúa.</para>
  <para style="q2" vid="PSA 56:9">Con biết rõ rằng: Đức Chúa Trời ở bên cạnh con!<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Con ngợi tôn Đức Chúa Trời vì lời Ngài đã hứa;</para>
  <para style="q2" vid="PSA 56:10">Phải, con ngợi tôn Chúa Hằng Hữu vì lời Ngài phán hứa.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Con tin cậy Đức Chúa Trời, vậy tại sao con phải sợ lo?</para>
  <para style="q2" vid="PSA 56:11">Có thể nào con người hại được con?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Lạy Đức Chúa Trời, con không quên những lời hứa nguyện,</para>
  <para style="q2" vid="PSA 56:12">và dâng lên Ngài tế lễ tạ ơn.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Vì Chúa giải thoát con khỏi tay thần chết;</para>
  <para style="q2" vid="PSA 56:13">giữ chân con khỏi ngã, nằm dài.</para>
  <para style="q1" vid="PSA 56:13">Trước mặt Ngài cho con vững bước, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 56:13">ánh sáng Ngài là sự sống của con.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="cl">Thi Thiên 57</para>
  <para style="s1">Cầu Xin Chúa Cứu Thoát Khỏi Tay Giặc</para>
  <para style="d">(Thơ Đa-vít viết trong hang đá khi bị Sau-lơ tầm nã, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Xin thương xót con, lạy Đức Chúa Trời, xin Ngài thương xót!</para>
  <para style="q2" vid="PSA 57:1">Con tin cậy Chúa, con nương náu nơi Ngài</para>
  <para style="q2" vid="PSA 57:1">cho đến ngày tai qua nạn khỏi.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Con kêu van Đức Chúa Trời Chí Cao,</para>
  <para style="q2" vid="PSA 57:2">Đức Chúa Trời, Đấng thực hiện mục đích của Ngài cho con.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Từ trời Ngài gửi đến sự cứu chuộc,</para>
  <para style="q2" vid="PSA 57:3">khiến bọn áp bức con đều hổ thẹn.</para>
  <para style="q2" vid="PSA 57:3">Đức Chúa Trời con tỏ<note caller="+" style="f"><char style="fr" closed="false">57:3 </char><char style="ft" closed="false">Nt sai đi</char></note> lòng thành tín, yêu thương.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Linh hồn con lạc vào hang sư tử,</para>
  <para style="q2" vid="PSA 57:4">giữa những con người giống như thú dữ,<note caller="+" style="f"><char style="fr" closed="false">57:4 </char><char style="ft" closed="false">Nt thở ra lửa</char></note></para>
  <para style="q1" vid="PSA 57:4">nhe nanh vuốt như tên, như giáo,</para>
  <para style="q2" vid="PSA 57:4">ngọn lưỡi sắc bén tựa gươm dao.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Lạy Đức Chúa Trời, nguyện Ngài được tôn cao hơn các tầng trời!</para>
  <para style="q2" vid="PSA 57:5">Nguyện vinh quang Chúa bao trùm trái đất.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Họ giăng lưới rình rập vây bắt.<note caller="+" style="f"><char style="fr" closed="false">57:6 </char><char style="ft" closed="false">Nt chăng lưới cho bước chân con</char></note></para>
  <para style="q2" vid="PSA 57:6">Con hoang mang cúi mặt âu sầu.</para>
  <para style="q1" vid="PSA 57:6">Họ đào hầm hố mưu hại con,</para>
  <para style="q2" vid="PSA 57:6">nhưng chính họ lại sa vào đó.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Lạy Đức Chúa Trời, lòng con kiên định;</para>
  <para style="q2" vid="PSA 57:7">lòng con kiên định.</para>
  <para style="q2" vid="PSA 57:7">Con cất giọng chúc tạ, hoan ca.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Vùng dậy, hồn ta hỡi!</para>
  <para style="q2" vid="PSA 57:8">Đàn hạc ơi,<note caller="+" style="f"><char style="fr" closed="false">57:8 </char><char style="ft" closed="false">Nt thụ cầm và huyền cầm</char></note> trổi nhạc lên đi.</para>
  <para style="q2" vid="PSA 57:8">Để kêu gọi bình minh thức giấc.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Lạy Chúa, con sẽ cảm tạ Chúa giữa toàn dân,</para>
  <para style="q2" vid="PSA 57:9">chúc tụng Danh Ngài giữa các nước.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Vì lòng thương Ngài cao như các tầng trời;</para>
  <para style="q2" vid="PSA 57:10">Đức thành tín vượt trên các tầng mây.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Lạy Đức Chúa Trời, nguyện Ngài được tôn cao trên các tầng trời.</para>
  <para style="q2" vid="PSA 57:11">Nguyện vinh quang Ngài tỏa lan khắp đất.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="cl">Thi Thiên 58</para>
  <para style="s1">Xin Chúa Trừng Phạt Người Ác</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Các giới cầm quyền cũng nói chuyện công lý sao?</para>
  <para style="q2" vid="PSA 58:1">Các ông<note caller="+" style="f"><char style="fr" closed="false">58:1 </char><char style="ft" closed="false">Nt xét xử con loài người</char></note> có xét xử chính trực chăng?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Không! Lòng các ông chỉ tính chuyện bất công.</para>
  <para style="q2" vid="PSA 58:2">Còn tay cân nhắc hành động bạo tàn trong xứ.<note caller="+" style="f"><char style="fr" closed="false">58:2 </char><char style="ft" closed="false">Nt trên đất</char></note><verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Người ác vừa sinh ra đã lầm lạc,</para>
  <para style="q2" vid="PSA 58:3">từ trong lòng mẹ đã sai quấy và gian dối.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Họ phun nọc độc như rắn,</para>
  <para style="q2" vid="PSA 58:4">họ như rắn hổ mang không chịu lắng nghe,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />phớt lờ tiếng người dụ rắn,</para>
  <para style="q2" vid="PSA 58:5">dù tiếng sáo huyền hoặc<note caller="+" style="f"><char style="fr" closed="false">58:5 </char><char style="ft" closed="false">Nt người mê hoặc tài giỏi</char></note> đến đâu.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Xin bẻ răng loài rắn độc, lạy Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 58:6">Xin nhổ nanh vuốt sư tử tơ, lạy Chúa Hằng Hữu!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Xin cho họ tan ra như nước chảy.</para>
  <para style="q2" vid="PSA 58:7">Xin khiến vũ khí của họ vô dụng trong tay mình.<note caller="+" style="f"><char style="fr" closed="false">58:7 </char><char style="ft" closed="false">Ctd như cỏ khô bị đạp nát</char></note><verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Như con sên rỉ nước tan dần,</para>
  <para style="q2" vid="PSA 58:8">như thai sinh non, không thấy ánh dương.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Đức Chúa Trời sẽ quét sạch họ đi, cả già lẫn trẻ,</para>
  <para style="q2" vid="PSA 58:9">nhanh hơn nồi nước nóng trên đống lửa gai.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Người công chính vui mừng khi được báo thù.</para>
  <para style="q2" vid="PSA 58:10">Họ sẽ chùi chân trong máu người ác.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Khi ấy người ta sẽ nói:<note caller="+" style="f"><char style="fr" closed="false">58:11 </char><char style="ft" closed="false">Nt sẽ nói lên</char></note></para>
  <para style="q2" vid="PSA 58:11">“Thật có phần thưởng cho người công chính sống vì Đức Chúa Trời;</para>
  <para style="q2" vid="PSA 58:11">thật có Đức Chúa Trời là quan tòa công bằng trên đất.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="cl">Thi Thiên 59</para>
  <para style="s1">Xin Chúa Cứu Khỏi Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng khi Sau-lơ sai người vây nhà để giết Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Lạy Đức Chúa Trời, xin giải thoát con khỏi tay quân thù nghịch.</para>
  <para style="q2" vid="PSA 59:1">Bảo vệ con giữa bọn người chống nghịch con.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Xin cứu con khỏi phường gian ngoa;</para>
  <para style="q2" vid="PSA 59:2">và bọn người khát máu bạo tàn.<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Lạy Chúa Hằng Hữu, họ phục kích, rình rập,</para>
  <para style="q2" vid="PSA 59:3">tụ tập những người hung dữ để giết hại con,</para>
  <para style="q2" vid="PSA 59:3">dù con không làm điều gì phạm pháp.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Con không làm gì sai trái,</para>
  <para style="q2" vid="PSA 59:4">họ vẫn chuẩn bị tấn công.</para>
  <para style="q2" vid="PSA 59:4">Xin Chúa tỉnh thức! Sẵn sàng phù hộ và tra xét.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, Đức Chúa Trời của Ít-ra-ên,</para>
  <para style="q2" vid="PSA 59:5">xin trỗi dậy trừng phạt các dân.</para>
  <para style="q2" vid="PSA 59:5">Xin đừng thương xót bọn vô đạo bạo tàn.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Đến tối, họ quay lại,</para>
  <para style="q2" vid="PSA 59:6">gầm gừ như chó,</para>
  <para style="q2" vid="PSA 59:6">hùng hổ kéo quanh thành.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Miệng chửi rủa như gươm giáo;</para>
  <para style="q2" vid="PSA 59:7">lời họ như những thanh gươm.</para>
  <para style="q2" vid="PSA 59:7">Họ châm chọc: Có ai nghe đâu nào!<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Nhưng Chúa Hằng Hữu nhạo cười chúng.</para>
  <para style="q2" vid="PSA 59:8">Ngài chế giễu các dân tộc.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Chúa là sức mạnh con; con trông đợi Ngài giải cứu,</para>
  <para style="q2" vid="PSA 59:9">vì Ngài, lạy Đức Chúa Trời, là pháo đài kiên cố.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Đức Chúa Trời đón con vào vòng tay từ ái,</para>
  <para style="q2" vid="PSA 59:10">cho con vui mừng thấy số phận người hại<note caller="+" style="f"><char style="fr" closed="false">59:10 </char><char style="ft" closed="false">Nt rình rập</char></note> con.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Xin đừng giết họ vội, e dân con quên bài học;</para>
  <para style="q2" vid="PSA 59:11">nhưng xin dùng quyền năng phân tán, đánh đổ họ.</para>
  <para style="q2" vid="PSA 59:11">Lạy Chúa, là cái thuẫn phù hộ của chúng con,<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Tội của môi miệng chúng nó,</para>
  <para style="q2" vid="PSA 59:12">tội của miệng họ là cái lưỡi xảo quyệt,</para>
  <para style="q1" vid="PSA 59:12">xin cho họ mắc bẫy kiêu căng,</para>
  <para style="q2" vid="PSA 59:12">vì lời nguyền rủa và dối gạt.<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />Xin hủy phá trong cơn thịnh nộ!</para>
  <para style="q2" vid="PSA 59:13">Xóa bôi họ trên mặt địa cầu!</para>
  <para style="q1" vid="PSA 59:13">Rồi cho cả thế giới biết rằng</para>
  <para style="q2" vid="PSA 59:13">Đức Chúa Trời trị vì Gia-cốp.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Đến tối, họ quay lại,</para>
  <para style="q2" vid="PSA 59:14">gầm gừ như chó,</para>
  <para style="q2" vid="PSA 59:14">hùng hổ kéo quanh thành.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Chúng sục sạo tìm mồi đây đó,</para>
  <para style="q2" vid="PSA 59:15">rình<note caller="+" style="f"><char style="fr" closed="false">59:15 </char><char style="ft" closed="false">Nt ở lại</char></note> suốt đêm vì bụng chưa no.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Nhưng con sẽ ca ngợi sức mạnh Chúa.</para>
  <para style="q2" vid="PSA 59:16">Mỗi buổi sáng, con sẽ hát vang về lòng thương xót của Ngài.</para>
  <para style="q1" vid="PSA 59:16">Vì Chúa là chiến lũy kiên cố,</para>
  <para style="q2" vid="PSA 59:16">là nơi bảo vệ con trong ngày hoạn nạn.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Lạy Đấng Sức Mạnh của con, con ca ngợi Ngài,</para>
  <para style="q2" vid="PSA 59:17">vì Ngài, lạy Đức Chúa Trời, là nơi ẩn náu.</para>
  <para style="q2" vid="PSA 59:17">Đức Chúa Trời đầy lòng thương xót.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="cl">Thi Thiên 60</para>
  <para style="s1">Than Thở Vì Thua Trận Xin Cứu Giúp</para>
  <para style="d">(Giáo huấn ca của Đa-vít, khi quân Ít-ra-ên đánh quân của hai Tướng A-ram Na-ha-ra-im và A-ram Xô-ba; và trong trận phản công của Tướng Giô-áp tại Thung lũng Muối, đánh bại 12.000 quân Ê-đôm)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Lạy Đức Chúa Trời, Ngài lìa bỏ chúng con.</para>
  <para style="q2" vid="PSA 60:1">Trong cơn giận, Chúa đuổi chúng con tản lạc,</para>
  <para style="q2" vid="PSA 60:1">nay xin cho chúng con quay về.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Chúa làm đất chấn động, mặt đất nứt ra.</para>
  <para style="q2" vid="PSA 60:2">Xin hàn gắn lại vì đất đổ vỡ.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Chúa khiến dân<note caller="+" style="f"><char style="fr" closed="false">60:3 </char><char style="ft" closed="false">Nt dân Chúa</char></note> chịu nhiều gian khổ,</para>
  <para style="q2" vid="PSA 60:3">xây xẩm quay cuồng như say rượu mạnh.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Nhưng những ai kính sợ Chúa, được ban một ngọn cờ,</para>
  <para style="q2" vid="PSA 60:4">để xổ tung ra chống lại cung tên.<verse eid="PSA 60:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Để giải cứu dân Chúa yêu.</para>
  <para style="q2" vid="PSA 60:5">Xin đáp lời và đưa tay<note caller="+" style="f"><char style="fr" closed="false">60:5 </char><char style="ft" closed="false">Nt tay phải</char></note> giúp họ chiến thắng.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Giữa nơi thánh Đức Chúa Trời từng phán:</para>
  <para style="q2" vid="PSA 60:6">“Lúc hân hoan, Ta chia đất Si-chem,</para>
  <para style="q2" vid="PSA 60:6">Ta sẽ đo đạc thung lũng Su-cốt.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Ga-la-át là của Ta,</para>
  <para style="q2" vid="PSA 60:7">và Ma-na-se cũng vậy.</para>
  <para style="q1" vid="PSA 60:7">Ép-ra-im, mão trụ Ta, sẽ cho ra những dũng sĩ.</para>
  <para style="q2" vid="PSA 60:7">Giu-đa, quyền trượng Ta, sẽ lập nên vua chúa.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Nhưng Mô-áp, bệ rửa chân Ta, sẽ là đầy tớ Ta,</para>
  <para style="q2" vid="PSA 60:8">Ta sẽ chùi chân Ta trên đất Ê-đôm,</para>
  <para style="q2" vid="PSA 60:8">và tại Phi-li-tin, Ta thổi kèn chiến thắng.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Ai sẽ dẫn con vào thành lũy?</para>
  <para style="q2" vid="PSA 60:9">Ai cho con chiến thắng Ê-đôm?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Lạy Đức Chúa Trời, chẳng phải Ngài đã từ bỏ chúng con sao?</para>
  <para style="q2" vid="PSA 60:10">Lẽ nào Ngài không ra trận với đạo quân của chúng con nữa?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Xin giúp chúng con chống lại quân thù,</para>
  <para style="q2" vid="PSA 60:11">vì loài người vô dụng, làm sao giúp đỡ.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Nhưng nhờ Đức Chúa Trời, chúng con sẽ chiến đấu anh dũng,</para>
  <para style="q2" vid="PSA 60:12">vì dưới chân Chúa, quân thù chúng con bị chà đạp.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="cl">Thi Thiên 61</para>
  <para style="s1">Tin Cậy Chúa Phù Hộ</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Lạy Đức Chúa Trời, xin nghe con cầu khẩn!</para>
  <para style="q2" vid="PSA 61:1">Xin lắng nghe tiếng con kêu nài!<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Từ tận cùng trái đất,</para>
  <para style="q2" vid="PSA 61:2">con van xin, khẩn nguyện,</para>
  <para style="q2" vid="PSA 61:2">khi con khốn cùng tan nát cõi lòng.<note caller="+" style="f"><char style="fr" closed="false">61:2 </char><char style="ft" closed="false">Nt lòng con yếu đuối</char></note></para>
  <para style="q2" vid="PSA 61:2">Xin cho con tựa vầng đá muôn đời.<note caller="+" style="f"><char style="fr" closed="false">61:2 </char><char style="ft" closed="false">Ctd xin đưa con đến tảng đá cao hơn con</char></note><verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Chúa vốn là nơi con trú ẩn,</para>
  <para style="q2" vid="PSA 61:3">là tháp kiên cố náu nương, khỏi quân thù.<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Xin cho con được sống mãi trong nơi thánh Ngài,</para>
  <para style="q2" vid="PSA 61:4">đời đời nương náu dưới cánh Ngài!<verse eid="PSA 61:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Vì Ngài nghe con cầu khẩn, lạy Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 61:5">Chúa cho con chung cơ nghiệp với người kính sợ Danh Chúa.<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Chúa cho vua được trường thọ!</para>
  <para style="q2" vid="PSA 61:6">Nguyện vua mãi trị vì đời nọ đời kia!<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Trước mặt Đức Chúa Trời, người được sống mãi.</para>
  <para style="q2" vid="PSA 61:7">Xin chân lý, nhân từ bảo vệ vua.<verse eid="PSA 61:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Mãi mãi con sẽ ca ngợi Danh Ngài,</para>
  <para style="q2" vid="PSA 61:8">giữ trọn lời khấn hứa ngày đêm.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="cl">Thi Thiên 62</para>
  <para style="s1">Nhờ Chúa Không Sợ Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Linh hồn tôi chỉ an nghỉ trong Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 62:1">Ngài là cội nguồn sự cứu rỗi tôi.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Chỉ có Chúa là tảng đá và sự giải cứu tôi.</para>
  <para style="q2" vid="PSA 62:2">Ngài là thành lũy tôi, tôi sẽ không bao giờ rúng động.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Các anh trấn áp một người bao lâu nữa—</para>
  <para style="q2" vid="PSA 62:3">hợp với nhau để đánh đổ người,</para>
  <para style="q2" vid="PSA 62:3">ngay cả khi người như tường xiêu, giậu đổ sao?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Từ nơi cao họ hiệp nhau lật đổ người.</para>
  <para style="q2" vid="PSA 62:4">Họ chỉ thích dối trá.</para>
  <para style="q1" vid="PSA 62:4">Ngoài miệng chúc phước,</para>
  <para style="q2" vid="PSA 62:4">nhưng trong lòng lại nguyền rủa.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Hồn ta hỡi, chỉ an nghỉ trong Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 62:5">hy vọng ta chỉ phát khởi từ Ngài.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Chỉ Ngài là vầng đá và sự cứu rỗi của ta,</para>
  <para style="q2" vid="PSA 62:6">là thành lũy vững bền ta nương dựa,</para>
  <para style="q2" vid="PSA 62:6">ta sẽ chẳng bao giờ nao núng.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Việc giải cứu và danh dự của ta đều do Chúa.</para>
  <para style="q2" vid="PSA 62:7">Ngài là vầng đá của sức mạnh, là nơi trú ẩn an toàn của ta.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Hỡi chúng dân, hãy tin cậy Chúa mãi mãi.</para>
  <para style="q2" vid="PSA 62:8">Hãy dốc đổ lòng ra với Ngài,</para>
  <para style="q2" vid="PSA 62:8">vì Đức Chúa Trời là nơi trú ẩn của chúng ta.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Người hạ lưu khác nào hư không,</para>
  <para style="q2" vid="PSA 62:9">người thượng lưu cũng chỉ dối lừa.</para>
  <para style="q1" vid="PSA 62:9">Nếu đem họ đặt lên cân,</para>
  <para style="q2" vid="PSA 62:9">họ nhẹ như hơi thở.<verse eid="PSA 62:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Đừng trông nhờ vào tham nhũng,</para>
  <para style="q2" vid="PSA 62:10">hay kiêu hãnh vì trộm cắp.</para>
  <para style="q1" vid="PSA 62:10">Dù giàu sang gia tăng nhanh,</para>
  <para style="q2" vid="PSA 62:10">cũng đừng để hết tâm hồn vào đó.<note caller="+" style="f"><char style="fr" closed="false">62:10 </char><char style="ft" closed="false">Nt đừng đặt lòng vào đó</char></note><verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Một lần Đức Chúa Trời đã phán dạy,</para>
  <para style="q2" vid="PSA 62:11">nhiều lần tôi nghe được tận tai:</para>
  <para style="q2" vid="PSA 62:11">Tình thương và uy quyền thuộc về Chúa;<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />Chúa là Đấng Nhân Từ,</para>
  <para style="q2" vid="PSA 62:12">thưởng phạt mọi người thật công minh.<note caller="+" style="f"><char style="fr" closed="false">62:12 </char><char style="ft" closed="false">Nt báo trả mỗi người tùy theo công việc của họ</char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="cl">Thi Thiên 63</para>
  <para style="s1">Linh Hồn Khát Khao Được Thỏa Nguyện</para>
  <para style="d">(Thơ của Đa-vít, khi đi lánh nạn vùng hoang mạc Giu-đa)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Lạy Đức Chúa Trời, là Đức Chúa Trời của con;</para>
  <para style="q2" vid="PSA 63:1">vừa sáng con tìm kiếm Chúa.</para>
  <para style="q1" vid="PSA 63:1">Linh hồn con khát khao Ngài;</para>
  <para style="q2" vid="PSA 63:1">toàn thân con mơ ước Chúa</para>
  <para style="q1" vid="PSA 63:1">giữa vùng đất khô khan,</para>
  <para style="q2" vid="PSA 63:1">nứt nẻ, không nước.<note caller="+" style="f"><char style="fr" closed="false">63:1 </char><char style="ft" closed="false">Nt trong đất khô và tiêu điều không có nước</char></note><verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Nên con nhìn lên nơi thánh Ngài,</para>
  <para style="q2" vid="PSA 63:2">chiêm ngưỡng thần quyền và vinh quang.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Vì lòng nhân từ Chúa quý hơn mạng sống;</para>
  <para style="q2" vid="PSA 63:3">con sẽ mở miệng ngợi tôn Ngài.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Con sẽ chúc tụng Chúa suốt đời con,</para>
  <para style="q2" vid="PSA 63:4">đưa tay hướng về Ngài, cầu nguyện.<note caller="+" style="f"><char style="fr" closed="false">63:4 </char><char style="ft" closed="false">Nt đưa tay lên trong Danh Chúa</char></note><verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Linh hồn con thỏa mãn như ăn miếng ngon.<note caller="+" style="f"><char style="fr" closed="false">63:5 </char><char style="ft" closed="false">Nt tủy và mỡ</char></note></para>
  <para style="q2" vid="PSA 63:5">Miệng lưỡi con vui mừng ca ngợi.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Nằm trên giường, con nhớ đến Chúa,</para>
  <para style="q2" vid="PSA 63:6">liền suy tư về Chúa suốt đêm thâu.<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Vì Chúa phù hộ con,</para>
  <para style="q2" vid="PSA 63:7">con vui mừng ẩn nấp dưới cánh che chở của Ngài.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Linh hồn con bấu víu Chúa;</para>
  <para style="q2" vid="PSA 63:8">tay phải Chúa nâng đỡ con.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Những người tìm kế tiêu diệt con sẽ tiêu tan.</para>
  <para style="q2" vid="PSA 63:9">Họ sẽ sa vào hố thẳm diệt vong.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Họ sẽ bị giáo đâm gươm chém,</para>
  <para style="q2" vid="PSA 63:10">bị sài lang cấu xé làm mồi.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Nhưng vua sẽ vui mừng trong Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 63:11">Ai nhân danh Chúa mà thề, sẽ ngợi khen Ngài,</para>
  <para style="q2" vid="PSA 63:11">còn bọn dối trá sẽ câm miệng lại.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="cl">Thi Thiên 64</para>
  <para style="s1">Xin Cứu Khỏi Âm Mưu Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Lạy Đức Chúa Trời, xin lắng tai nghe tiếng con than thở.</para>
  <para style="q2" vid="PSA 64:1">Bảo vệ mạng sống con khỏi quân thù đe dọa.<note caller="+" style="f"><char style="fr" closed="false">64:1 </char><char style="ft" closed="false">Ctd giữ mạng sống con khỏi sự sợ hãi quân thù</char></note><verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Xin che giấu con khi người ác mật bàn,</para>
  <para style="q2" vid="PSA 64:2">khi bọn gian tà nổi loạn trong cuồng nộ.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Họ mài lưỡi sắc như gươm,</para>
  <para style="q2" vid="PSA 64:3">tung lời nói như bắn cung tên.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Bắn lén người vô tội,<note caller="+" style="f"><char style="fr" closed="false">64:4 </char><char style="ft" closed="false">Ctd người trọn vẹn</char></note></para>
  <para style="q2" vid="PSA 64:4">không ngại ngùng, bất chợt nhả tên.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Chúng ngoan cố theo đuổi điều ác độc,</para>
  <para style="q2" vid="PSA 64:5">bàn mưu đặt bẫy cách âm thầm.</para>
  <para style="q2" vid="PSA 64:5">Tưởng rằng: “Chẳng ai biết được.<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Ai dò được tội ác ta làm.</para>
  <para style="q2" vid="PSA 64:6">Ta hoạch định mưu kế thần sầu.”</para>
  <para style="q2" vid="PSA 64:6">Tâm trí con người thật hiểm sâu.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Nhưng Chúa sẽ giương cung bắn trúng,</para>
  <para style="q2" vid="PSA 64:7">họ bị thương, ngã xuống bất ngờ.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Lưỡi họ gây họa cho họ,</para>
  <para style="q2" vid="PSA 64:8">ai thấy họ cũng đều lắc đầu chạy trốn.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Mọi người sẽ kinh hoàng, thuật lại,</para>
  <para style="q2" vid="PSA 64:9">các công tác Đức Chúa Trời vừa thực hiện,</para>
  <para style="q2" vid="PSA 64:9">suy tư, tìm hiểu việc Ngài làm.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Người công chính sẽ vui mừng trong Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 64:10">và ẩn náu trong Ngài.</para>
  <para style="q1" vid="PSA 64:10">Người có lòng ngay thẳng</para>
  <para style="q2" vid="PSA 64:10">sẽ ca ngợi Ngài.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="cl">Thi Thiên 65</para>
  <para style="s1">Chúa Ban Ơn cho Đất Đai và Loài Người</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Lạy Đức Chúa Trời, ở Si-ôn người ta mong đợi,</para>
  <para style="q2" vid="PSA 65:1">sẵn sàng ca ngợi và thực hiện lời thề,<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />vì Chúa nghe lời cầu nguyện.</para>
  <para style="q2" vid="PSA 65:2">Nhân loại<note caller="+" style="f"><char style="fr" closed="false">65:2 </char><char style="ft" closed="false">Nt mọi loài xác thịt</char></note> sẽ đến với Ngài.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Khi con bị tội ác chi phối đè bẹp,</para>
  <para style="q2" vid="PSA 65:3">nhưng Chúa tẩy sạch mọi lỗi lầm.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Phước cho người được Chúa chọn, cho đến gần,</para>
  <para style="q2" vid="PSA 65:4">và cư trú trong tiền đình nhà Chúa.</para>
  <para style="q1" vid="PSA 65:4">Chúng con sẽ thỏa mãn trong nơi tốt đẹp,</para>
  <para style="q2" vid="PSA 65:4">tức là Đền Thờ Thánh của Ngài.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Chúa nhậm lời, giải cứu chúng con bằng những công việc đáng sợ,</para>
  <para style="q2" vid="PSA 65:5">lạy Đức Chúa Trời, Đấng Giải Cứu chúng con.</para>
  <para style="q1" vid="PSA 65:5">Ngài là hy vọng của các dân khắp địa cầu,</para>
  <para style="q2" vid="PSA 65:5">và của các dân ở miền biển xa xăm.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Sức mạnh<note caller="+" style="f"><char style="fr" closed="false">65:6 </char><char style="ft" closed="false">Nt sức mạnh Ngài, khi Ngài thắt lưng bằng sức mạnh</char></note> Chúa lập các núi cao,</para>
  <para style="q2" vid="PSA 65:6">và Ngài lấy uy dũng mà thắt ngang lưng.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Làm im tiếng gào của biển cả</para>
  <para style="q2" vid="PSA 65:7">và tiếng sóng ồn ào.</para>
  <para style="q2" vid="PSA 65:7">Cũng như rối loạn của các dân.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Các dân ở những vùng đất xa xôi,</para>
  <para style="q2" vid="PSA 65:8">đều kinh sợ thấy dấu lạ lớn lao.</para>
  <para style="q1" vid="PSA 65:8">Khi rạng đông đến và hoàng hôn biến,</para>
  <para style="q2" vid="PSA 65:8">đều thúc giục reo vui.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Chúa viếng thăm, tưới nước địa cầu,</para>
  <para style="q2" vid="PSA 65:9">làm cho đất phì nhiêu màu mỡ.</para>
  <para style="q1" vid="PSA 65:9">Các sông suối tràn nước,</para>
  <para style="q2" vid="PSA 65:9">cho đất màu mỡ, lúa thóc dồi dào.<note caller="+" style="f"><char style="fr" closed="false">65:9 </char><char style="ft" closed="false">Nt Chúa đã chuẩn bị nó như thế nào</char></note><verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Nhuần gội luống cày, cho đất nhuyễn,</para>
  <para style="q2" vid="PSA 65:10">ban phước lành cho hoa thắm, quả tươi.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Đức nhân từ Ngài như vương miện</para>
  <para style="q2" vid="PSA 65:11">đội trên đầu năm tháng thời gian,</para>
  <para style="q2" vid="PSA 65:11">cho xe chở đầy dư dật.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Sương móc nhỏ giọt trên đồng nội,</para>
  <para style="q2" vid="PSA 65:12">núi đồi nịt lưng thắt bằng hân hoan.</para>
  <para style="q2" vid="PSA 65:12">Dấu chân Chúa in hằn màu mỡ,<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Bò, chiên phủ khắp trên đồng cỏ,</para>
  <para style="q2" vid="PSA 65:13">thung lũng tràn đầy ngũ cốc.</para>
  <para style="q2" vid="PSA 65:13">Khắp nơi dậy tiếng reo mừng.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="cl">Thi Thiên 66</para>
  <para style="s1">Tạ Ơn Vì Chúa Nhậm Lời</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Khắp đất hãy ca mừng chúc tụng Đức Chúa Trời!<note caller="+" style="f"><char style="fr" closed="false">66:1 </char><char style="ft" closed="false">Nt làm ồn ào cách vui mừng</char></note><verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />Hãy tôn vinh Danh Chúa!</para>
  <para style="q2" vid="PSA 66:2">Hãy hát cho thế giới biết vinh quang của Ngài.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Hãy thưa với Đức Chúa Trời: “Việc Chúa làm vô cùng vĩ đại!</para>
  <para style="q2" vid="PSA 66:3">Bọn thù nghịch phải suy phục trước quyền năng vĩ đại của Ngài.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Mọi tạo vật trên đất sẽ thờ phượng Chúa;</para>
  <para style="q2" vid="PSA 66:4">họ sẽ hát ca chúc tụng Chúa,</para>
  <para style="q2" vid="PSA 66:4">họ dâng khúc chúc tôn Danh Ngài.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Hãy đến xem việc Đức Chúa Trời làm,</para>
  <para style="q2" vid="PSA 66:5">vì loài người, Ngài làm những việc lạ đáng kinh.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Chúa biến Biển Đỏ ra đất khô</para>
  <para style="q2" vid="PSA 66:6">cho con người đi bộ qua lòng sông.</para>
  <para style="q2" vid="PSA 66:6">Vì thế chúng ta hãy hân hoan trong Ngài.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Chúa dùng quyền năng cai trị đời đời.</para>
  <para style="q2" vid="PSA 66:7">Mắt Chúa quan sát các dân tộc;</para>
  <para style="q2" vid="PSA 66:7">bọn phản nghịch đừng tự tôn tự đại.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Hỡi cả trái đất, hãy chúc tụng Đức Chúa Trời</para>
  <para style="q2" vid="PSA 66:8">và reo hò vang dội tung hô Ngài.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />Mạng sống chúng con trong tay Ngài</para>
  <para style="q2" vid="PSA 66:9">và Ngài giữ chân chúng con không trợt ngã.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Lạy Đức Chúa Trời, Ngài từng thử nghiệm chúng con;</para>
  <para style="q2" vid="PSA 66:10">luyện chúng con như luyện bạc.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Chúa để chúng con sa lưới,</para>
  <para style="q2" vid="PSA 66:11">và chất hoạn nạn trên lưng.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Rồi Ngài khiến người ta cỡi trên đầu chúng con.</para>
  <para style="q2" vid="PSA 66:12">Chúng con gặp cảnh dầu sôi, lửa bỏng,</para>
  <para style="q2" vid="PSA 66:12">nhưng Chúa đưa chúng con vào chỗ an ninh.<note caller="+" style="f"><char style="fr" closed="false">66:12 </char><char style="ft" closed="false">Nt rộng rãi</char></note><verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Con sẽ đem tế lễ thiêu lên Đền Thờ Chúa,</para>
  <para style="q2" vid="PSA 66:13">con sẽ làm trọn các con lời hứa nguyện—<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />phải, là những điều con hứa nguyện</para>
  <para style="q2" vid="PSA 66:14">trong những giờ con gặp gian truân.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Đó là tại sao con dâng lên Chúa tế lễ thiêu—</para>
  <para style="q2" vid="PSA 66:15">nào chiên đực béo tốt,</para>
  <para style="q2" vid="PSA 66:15">và những bò và dê đưc.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Hãy đến và nghe, hỡi những người kính sợ Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 66:16">tôi sẽ thuật lại những việc Chúa thực hiện.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Miệng tôi kêu cầu và tôn cao Chúa,</para>
  <para style="q2" vid="PSA 66:17">lưỡi tôi chúc tụng và ca ngợi Ngài.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Nếu lòng tôi xu hướng về tội ác,</para>
  <para style="q2" vid="PSA 66:18">Chúa hẳn đã không nhậm lời tôi.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Nhưng Đức Chúa Trời đã lắng nghe!</para>
  <para style="q2" vid="PSA 66:19">Ngài nhậm lời tôi cầu nguyện.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Ngợi tôn Đức Chúa Trời, Đấng không khước từ lời cầu nguyện,</para>
  <para style="q2" vid="PSA 66:20">và tiếp tục thương xót tôi không ngừng.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="cl">Thi Thiên 67</para>
  <para style="s1">Kêu Gọi Các Dân Tộc Ca Ngợi Chúa</para>
  <para style="d">(Thơ soạn cho nhạc trưởng, dùng đàn dây)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Nguyện Đức Chúa Trời thương xót và ban phước.</para>
  <para style="q2" vid="PSA 67:1">Xin Thiên nhan rạng rỡ trên chúng con.<verse eid="PSA 67:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />Nguyện đường lối Chúa được khai mở trên đất,</para>
  <para style="q2" vid="PSA 67:2">và ơn cứu rỗi nhiều người biết đến.<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Nguyện các dân tộc ca ngợi Chúa, lạy Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 67:3">Toàn thể nhân loại tôn vinh Ngài.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Nguyện các nước mừng vui ca hát,</para>
  <para style="q2" vid="PSA 67:4">vì Chúa xét xử công bằng cho dân,</para>
  <para style="q2" vid="PSA 67:4">và chỉ đạo mọi dân tộc trên đất.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Nguyện các dân tộc ca ngợi Chúa, lạy Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 67:5">Phải, toàn thể nhân loại tôn vinh Ngài.<verse eid="PSA 67:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Khi ấy, đất sẽ gia tăng hoa lợi,</para>
  <para style="q2" vid="PSA 67:6">và Đức Chúa Trời là Đức Chúa Trời chúng con, sẽ ban phước lành.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Phải, Đức Chúa Trời sẽ ban phước cho chúng con,</para>
  <para style="q2" vid="PSA 67:7">và khắp đất loài người sẽ kính sợ Chúa.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="cl">Thi Thiên 68</para>
  <para style="s1">Chúa của Si-nai và Nơi Thánh</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Xin Đức Chúa Trời vùng dậy, đánh tan thù nghịch.</para>
  <para style="q2" vid="PSA 68:1">Để bọn người ghét Đức Chúa Trời phải tán loạn.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Xin thổi họ lan như làn khói.</para>
  <para style="q2" vid="PSA 68:2">Khiến họ tan như sáp chảy trong lửa.</para>
  <para style="q2" vid="PSA 68:2">Để bọn gian ác tàn lụi khi Đức Chúa Trời hiện diện.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Nhưng xin cho người công chính vui mừng.</para>
  <para style="q2" vid="PSA 68:3">Xin cho họ hân hoan trước mặt Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 68:3">Xin cho họ trào dâng niềm hoan lạc.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Hãy ngợi tôn Đức Chúa Trời và chúc tụng Danh Chúa,</para>
  <para style="q2" vid="PSA 68:4">Hãy tôn cao Chúa, Đấng trên các tầng mây.</para>
  <para style="q1" vid="PSA 68:4">Danh Ngài là Chúa Hằng Hữu—</para>
  <para style="q2" vid="PSA 68:4">hãy hoan hỉ trước mặt Ngài.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Đức Chúa Trời ngự trong nơi thánh,</para>
  <para style="q2" vid="PSA 68:5">Ngài là Cha trẻ mồ côi, Đấng bênh vực người quả phụ,<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Đức Chúa Trời là nơi cho người cô đơn có tổ ấm gia đình;</para>
  <para style="q2" vid="PSA 68:6">Ngài giải cứu người bị gông cùm xiềng xích</para>
  <para style="q2" vid="PSA 68:6">và lưu đày bọn phản nghịch tới nơi đồng khô cỏ cháy.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Lạy Đức Chúa Trời, khi Chúa dắt dân Ngài ra khỏi Ai Cập,</para>
  <para style="q2" vid="PSA 68:7">và vào vùng hoang mạc,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />thì đất động, mưa to như thác đổ</para>
  <para style="q2" vid="PSA 68:8">trước mặt Ngài, Đức Chúa Trời của Si-nai,</para>
  <para style="q2" vid="PSA 68:8">trước Đức Chúa Trời, là Đức Chúa Trời của Ít-ra-ên.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Chúa đã cho mưa dồi dào, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 68:9">đem tươi mát cho cơ nghiệp cằn cỗi.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Dân Chúa tìm được nơi an định,</para>
  <para style="q2" vid="PSA 68:10">và hưởng nhiều vụ mùa phong phú, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 68:10">Ngài cung ứng đủ nhu cầu cho người nghèo khổ.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Chúa ra lệnh, vô số người tuân phục,</para>
  <para style="q2" vid="PSA 68:11">loan tin mừng như đạo quân đông đảo.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Các vua chúa và tướng lãnh đều bỏ chạy,</para>
  <para style="q2" vid="PSA 68:12">các phụ nữ Ít-ra-ên chia nhau chiến lợi phẩm.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Khi họ an nghỉ giữa chuồng chiên,</para>
  <para style="q2" vid="PSA 68:13">sẽ như bồ câu cánh dát bạc,</para>
  <para style="q2" vid="PSA 68:13">bộ lông nạm vàng ròng.<note caller="+" style="f"><char style="fr" closed="false">68:13 </char><char style="ft" closed="false">Nt vàng nguyên chất</char></note><verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Khi Đấng Toàn Năng đánh tan các vua,</para>
  <para style="q2" vid="PSA 68:14">thì tuyết sa phủ trắng Núi Sanh-môn.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Hỡi các dãy núi Ba-san hùng vĩ,</para>
  <para style="q2" vid="PSA 68:15">với nhiều ngọn lởm chởm trong không trung.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Sao ngươi nổi cơn ghen tị, hỡi các núi ghồ ghề,</para>
  <para style="q2" vid="PSA 68:16">tại Núi Si-ôn, nơi Đức Chúa Trời chọn để ngự,</para>
  <para style="q2" vid="PSA 68:16">phải, Chúa Hằng Hữu sẽ ở tại đó đời đời?<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Số chiến xa của Chúa nhiều hằng nghìn, hằng vạn,</para>
  <para style="q2" vid="PSA 68:17">nghênh giá Chúa từ Núi Si-nai vào nơi thánh.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Chúa đã lên nơi cao,</para>
  <para style="q2" vid="PSA 68:18">dẫn đầu những người bị tù.</para>
  <para style="q1" vid="PSA 68:18">Chúa đã nhận tặng vật của loài người,</para>
  <para style="q2" vid="PSA 68:18">kể cả của bọn nổi loạn.</para>
  <para style="q2" vid="PSA 68:18">Bây giờ, Chúa Hằng Hữu là Đức Chúa Trời sẽ ngự giữa họ.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Ngợi tôn Chúa; chúc tụng Đức Chúa Trời, Đấng Cứu Độ chúng con!</para>
  <para style="q2" vid="PSA 68:19">Vì mỗi ngày Chúa mang gánh nặng của chúng con.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Đức Chúa Trời chúng con là Đức Chúa Trời Cứu Rỗi!</para>
  <para style="q2" vid="PSA 68:20">Chúa Hằng Hữu Chí Cao giải cứu chúng con khỏi nanh vuốt tử thần.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Đức Chúa Trời giẫm nát đầu kẻ thù,</para>
  <para style="q2" vid="PSA 68:21">nghiền nát sọ của người tiếp tục vi phạm.<note caller="+" style="f"><char style="fr" closed="false">68:21 </char><char style="ft" closed="false">Ctd người cứ đi con đường tội lỗi</char></note><verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Chúa phán: “Ta sẽ đem dân Ta trở về</para>
  <para style="q2" vid="PSA 68:22">từ núi Ba-san, từ đáy biển sâu.<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />Các con, dân Ta, sẽ rửa chân mình trong máu quân thù,</para>
  <para style="q2" vid="PSA 68:23">và ngay cả đàn chó cũng được chia phần thắng lợi!”<note caller="+" style="f"><char style="fr" closed="false">68:23 </char><char style="ft" closed="false">Ctd dự phần trong đó</char></note><verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Họ đã thấy Chúa uy nghi diễu hành, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 68:24">Cuộc diễu hành của Đức Chúa Trời và Vua con đi vào nơi thánh.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Ban hợp ca đi trước, theo sau là các dàn nhạc;</para>
  <para style="q2" vid="PSA 68:25">giữa là các thiếu nữ đánh trống cơm.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Hãy chúc tụng Đức Chúa Trời, hỡi toàn dân Ít-ra-ên;</para>
  <para style="q2" vid="PSA 68:26">hãy ngợi tôn Chúa Hằng Hữu của Ít-ra-ên.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Kìa, đại tộc nhỏ nhất Bên-gia-min đi trước.</para>
  <para style="q2" vid="PSA 68:27">Rồi với tất cả các hoàng tử <note caller="+" style="f"><char style="fr" closed="false">68:27 </char><char style="ft" closed="false">Ctd hội đồng</char></note> Giu-đa,</para>
  <para style="q2" vid="PSA 68:27">và các vương tử Sa-bu-luân và Nép-ta-li.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Lạy Đức Chúa Trời, xin triệu tập lực lượng.</para>
  <para style="q2" vid="PSA 68:28">Xin biểu dương sức mạnh, ôi Đức Chúa Trời, như Ngài đã từng thi thố.<note caller="+" style="f"><char style="fr" closed="false">68:28 </char><char style="ft" closed="false">Nt cho </char></note><verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Vì Đền Thờ của Chúa đặt tại Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 68:29">các vua sẽ đem phẩm vật dâng hiến lên Ngài.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Xin quở trách đội quân các nước—</para>
  <para style="q2" vid="PSA 68:30">là những thú dữ trong lau sậy,</para>
  <para style="q2" vid="PSA 68:30">và đàn bò rừng giữa bò con của các dân tộc.</para>
  <para style="q1" vid="PSA 68:30">Xin hạ nhục bọn người dâng bạc.</para>
  <para style="q2" vid="PSA 68:30">Xin đánh tan các đoàn dân hiếu chiến.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Những phái đoàn sẽ đến từ Ai Cập;</para>
  <para style="q2" vid="PSA 68:31">và Ê-thi-ô-pi để thần phục Ngài.<verse eid="PSA 68:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Hãy ngợi tôn Đức Chúa Trời, hỡi các vương triều trên đất.</para>
  <para style="q2" vid="PSA 68:32">Hãy hát mừng ca tụng Chúa không thôi.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Ngài cưỡi trên các tầng trời từ vạn cổ,</para>
  <para style="q2" vid="PSA 68:33">tiếng phán Ngài vang động khắp nơi.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Hãy rao ra quyền năng của Đức Chúa Trời.</para>
  <para style="q2" vid="PSA 68:34">Oai nghi Ngài tỏa sáng trên Ít-ra-ên;</para>
  <para style="q2" vid="PSA 68:34">sức mạnh Chúa uy nghi trên các tầng trời.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Đức Chúa Trời thật đáng kính sợ trong nơi thánh.</para>
  <para style="q2" vid="PSA 68:35">Chính Đức Chúa Trời của Ít-ra-ên ban quyền năng và sức mạnh cho dân Ngài.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Chúc tụng Đức Chúa Trời!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="cl">Thi Thiên 69</para>
  <para style="s1">Lời Cầu Nguyện trong Cơn Hoạn Nạn</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu “Hoa huệ”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Lạy Đức Chúa Trời, xin ra tay cứu vớt,</para>
  <para style="q2" vid="PSA 69:1">các dòng nước đã ngập đến cổ con.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Con bị lún trong bùn sâu;</para>
  <para style="q2" vid="PSA 69:2">con không thể tìm được chỗ bám.</para>
  <para style="q1" vid="PSA 69:2">Con rơi xuống nước sâu,</para>
  <para style="q2" vid="PSA 69:2">và nước phủ ngập con.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Con khản tiếng vì kêu van,</para>
  <para style="q2" vid="PSA 69:3">cổ họng con khô cháy.</para>
  <para style="q1" vid="PSA 69:3">Mắt con hao mòn sầu khổ</para>
  <para style="q2" vid="PSA 69:3">vì mãi trông chờ Đức Chúa Trời con.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Người ghét con vô lý</para>
  <para style="q2" vid="PSA 69:4">nhiều hơn tóc trên đầu con.</para>
  <para style="q1" vid="PSA 69:4">Nhiều kẻ thù vô cớ tìm hại con,</para>
  <para style="q2" vid="PSA 69:4">bắt con đền bù những gì con chẳng lấy.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Lạy Đức Chúa Trời, Chúa biết con khờ dại;</para>
  <para style="q2" vid="PSA 69:5">tội lỗi con đâu che giấu được Ngài.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Xin đừng để người trông đợi Chúa phải xấu hổ vì con,</para>
  <para style="q2" vid="PSA 69:6">lạy Đấng Chí Cao, Chúa Hằng Hữu Vạn Quân.</para>
  <para style="q1" vid="PSA 69:6">Xin đừng để người tìm kiếm Chúa phải thẹn thùng vì con,</para>
  <para style="q2" vid="PSA 69:6">lạy Đức Chúa Trời của Ít-ra-ên.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Vì Chúa, con bị người đời khinh bỉ;</para>
  <para style="q2" vid="PSA 69:7">nỗi nhục nhã bao trùm cả mặt con.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Ngay cả anh em ruột cũng giả bộ không biết con,</para>
  <para style="q2" vid="PSA 69:8">họ đối xử với con như người xa lạ.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />Lòng sốt sắng về nhà Chúa nung nấu con,</para>
  <para style="q2" vid="PSA 69:9">và lời sỉ nhục của những người sỉ nhục Chúa đổ trên con.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Khi con khóc lóc nhịn ăn,</para>
  <para style="q2" vid="PSA 69:10">con bị người đời khinh khi coi rẻ.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Khi con mặc áo gai với lòng thống hối,</para>
  <para style="q2" vid="PSA 69:11">con bị người ta nhạo báng cười chê.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Bọn ngồi ở cửa thành đem con ra giễu cợt,</para>
  <para style="q2" vid="PSA 69:12">con là câu hát chế nhạo của bọn say sưa.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Nhưng con chỉ biết cầu xin Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 69:13">con tin đây là thời điểm Chúa ban ơn.</para>
  <para style="q1" vid="PSA 69:13">Trong tình thương bao la cao cả, ôi Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 69:13">xin đáp lời con và giải cứu con.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Xin vớt con khỏi vũng lầy;</para>
  <para style="q2" vid="PSA 69:14">xin đừng để con lún sâu trong chốn nhuốc nhơ!</para>
  <para style="q1" vid="PSA 69:14">Xin cứu con thoát khỏi người ghen ghét,</para>
  <para style="q2" vid="PSA 69:14">và kéo con khỏi dòng nước thẳm hố sâu.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Xin đừng để nước lũ phủ lấp con,</para>
  <para style="q2" vid="PSA 69:15">cũng đừng cho vực sâu nhận chìm con,</para>
  <para style="q2" vid="PSA 69:15">và miệng hầm kia đóng lại.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Lạy Chúa Hằng Hữu, xin đáp lời con</para>
  <para style="q2" vid="PSA 69:16">vì tình yêu bao la Ngài là thiện hảo.</para>
  <para style="q1" vid="PSA 69:16">Xin quay lại đoái hoài đến con,</para>
  <para style="q2" vid="PSA 69:16">vì lòng thương xót Ngài thật dào dạt.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Xin đừng ngoảnh mặt khỏi đầy tớ Chúa;</para>
  <para style="q2" vid="PSA 69:17">xin mau đáp lời, vì con đang chìm sâu trong khốn khổ!<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Xin lại gần và đưa tay giải cứu,</para>
  <para style="q2" vid="PSA 69:18">chuộc hồn con khỏi bọn ác nhân.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Chúa biết con phải hổ thẹn, bị khinh khi, và nhục nhã.</para>
  <para style="q2" vid="PSA 69:19">Ngài biết kẻ thù nghịch đang làm hại con.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Họ khinh miệt đập lòng con tan nát,</para>
  <para style="q2" vid="PSA 69:20">và con đầy nỗi tuyệt vọng</para>
  <para style="q1" vid="PSA 69:20">Chẳng có ai thông cảm cho con,</para>
  <para style="q2" vid="PSA 69:20">chẳng có ai an ủi con.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Họ trộn mật độc cho con ăn<note caller="+" style="f"><char style="fr" closed="false">69:21 </char><char style="ft" closed="false">Nt thức ăn của con</char></note></para>
  <para style="q2" vid="PSA 69:21">đưa dấm chua, khi con kêu khát.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Nguyện bàn tiệc trước mặt họ thành cái bẫy,</para>
  <para style="q2" vid="PSA 69:22">và sự bình an của họ là giả dối.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Nguyện mắt họ tối đen không thấy được,</para>
  <para style="q2" vid="PSA 69:23">lưng họ cúi khom cho đến đời đời.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Xin Chúa trút trên họ cơn giận,</para>
  <para style="q2" vid="PSA 69:24">dù trốn tránh thế nào cũng chẳng thoát.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Nguyện nơi họ ở trở thành hoang địa,</para>
  <para style="q2" vid="PSA 69:25">không còn ai lai vãng nhà<note caller="+" style="f"><char style="fr" closed="false">69:25 </char><char style="ft" closed="false">Nt trại</char></note> họ nữa.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Vì họ bức hại người bị Chúa trừng trị;<note caller="+" style="f"><char style="fr" closed="false">69:26 </char><char style="ft" closed="false">Nt người bị Chúa gây thương tích</char></note></para>
  <para style="q2" vid="PSA 69:26">thuật lại đau thương người bị Chúa gây đau thương.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Xin buộc cho họ tội này đến tội khác,</para>
  <para style="q2" vid="PSA 69:27">đừng cho họ hưởng ơn cứu rỗi Ngài.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Trong Sách Sự Sống, tên họ bị bôi xóa,</para>
  <para style="q2" vid="PSA 69:28">trong danh sách người công chính, họ chẳng có tên.<verse eid="PSA 69:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Con đang đau ê ẩm và kiệt sức,</para>
  <para style="q2" vid="PSA 69:29">Đức Chúa Trời con ôi, xin đem ân cứu rỗi Ngài bảo vệ con.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Lấy lời thánh ca, con ngợi khen Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 69:30">với lòng cảm tạ, con tôn vinh Ngài.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Hành động ấy vui lòng Chúa Hằng Hữu, hơn tế lễ bằng bò,</para>
  <para style="q2" vid="PSA 69:31">hơn cả bò có sừng với móng rẽ ra.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Người khiêm tốn sẽ thấy công việc của Đức Chúa Trời và vui mừng.</para>
  <para style="q2" vid="PSA 69:32">Ai là người tìm kiếm Đức Chúa Trời sẽ thấy lòng đầy sức sống.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Vì Chúa Hằng Hữu nhậm lời người thiếu thốn;</para>
  <para style="q2" vid="PSA 69:33">không khinh dể khi bị dân Chúa lưu đày.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Hỡi trời và đất, hãy ca tụng Chúa,</para>
  <para style="q2" vid="PSA 69:34">cùng với biển và muôn loài đang sống dưới đại dương.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Vì Đức Chúa Trời sẽ giải cứu Si-ôn,</para>
  <para style="q2" vid="PSA 69:35">sẽ tái thiết các thành của Giu-đa.</para>
  <para style="q1" vid="PSA 69:35">Dân Chúa sẽ sinh sống tại đó</para>
  <para style="q2" vid="PSA 69:35">và chiếm hữu làm đất của mình.<note caller="+" style="f"><char style="fr" closed="false">69:35 </char><char style="ft" closed="false">Nt cư trú và làm sản nghiệp</char></note><verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Dòng dõi của những ai vâng phục Chúa sẽ hưởng được đất,</para>
  <para style="q2" vid="PSA 69:36">và những ai yêu mến Ngài sẽ được an cư lạc nghiệp.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="cl">Thi Thiên 70</para>
  <para style="s1">Xin Cứu Giúp Khỏi Bị Hà Hiếp và Sỉ Nhục</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng, lời cầu nguyện trong dịp Tế Lễ Kỷ Niệm)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Lạy Đức Chúa Trời, xin giải cứu con!</para>
  <para style="q2" vid="PSA 70:1">Lạy Chúa Hằng Hữu, xin nhanh chóng phù hộ.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Nguyện những người tìm hại mạng sống con</para>
  <para style="q2" vid="PSA 70:2">đều bị hổ nhục.</para>
  <para style="q1" vid="PSA 70:2">Nguyện những người muốn thấy con bị tàn hại,</para>
  <para style="q2" vid="PSA 70:2">phải rút lui và nhục nhã.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Nguyện những người cười nhạo con phải hổ thẹn,</para>
  <para style="q2" vid="PSA 70:3">vì họ đã nói: “A ha! Chúng ta đã bắt được hắn rồi!”<note caller="+" style="f"><char style="fr" closed="false">70:3 </char><char style="ft" closed="false">Ctd bị đẩy lùi</char></note><verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Nguyện tất cả những ai tìm Chúa,</para>
  <para style="q2" vid="PSA 70:4">đều hân hoan sung sướng trong Ngài.</para>
  <para style="q1" vid="PSA 70:4">Nguyện những ai yêu mến ân cứu độ,</para>
  <para style="q2" vid="PSA 70:4">mãi mãi tụng ca: “Đức Chúa Trời thật vĩ đại!”<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Nhưng con cùng túng, nghèo khổ,</para>
  <para style="q2" vid="PSA 70:5">xin nhanh chóng đưa tay giải cứu, lạy Đức Chúa Trời.</para>
  <para style="q1" vid="PSA 70:5">Ngài là Đấng giúp đỡ và Đấng giải cứu con;</para>
  <para style="q2" vid="PSA 70:5">lạy Chúa Hằng Hữu, xin Ngài đừng chậm trễ.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="cl">Thi Thiên 71</para>
  <para style="s1">Lời Cầu Nguyện Xin Chúa Bảo Vệ và Giúp Đỡ Trọn Đời</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Lạy Chúa Hằng Hữu, con hoàn toàn nương cậy Chúa;</para>
  <para style="q2" vid="PSA 71:1">xin đừng để con cúi đầu nhục nhã.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Xin cứu con và giải thoát con</para>
  <para style="q2" vid="PSA 71:2">vì Ngài là công chính.</para>
  <para style="q1" vid="PSA 71:2">Xin lắng tai nghe tiếng con</para>
  <para style="q2" vid="PSA 71:2">và cho con được tự do.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Nguyện Chúa làm vầng đá che chở</para>
  <para style="q2" vid="PSA 71:3">để con có thể ẩn náu luôn luôn.</para>
  <para style="q1" vid="PSA 71:3">Xin hãy ra lệnh cứu vớt con,</para>
  <para style="q2" vid="PSA 71:3">vì Chúa là vầng đá và thành lũy.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Lạy Đức Chúa Trời, xin giải thoát con</para>
  <para style="q2" vid="PSA 71:4">khỏi bàn tay người hung ác.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Lạy Chúa, chỉ có Ngài là nguồn hy vọng của con.</para>
  <para style="q2" vid="PSA 71:5">Là niềm tin của con từ tuổi ấu thơ.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Con nương cậy Ngài từ giờ phút lọt lòng;</para>
  <para style="q2" vid="PSA 71:6">Chúa đỡ con ra khỏi lòng mẹ.</para>
  <para style="q2" vid="PSA 71:6">Con sẽ ca ngợi Ngài mãi mãi.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Nhiều người kinh ngạc khi nhìn vào đời sống phước hạnh của con,</para>
  <para style="q2" vid="PSA 71:7">vì Chúa là Đấng bảo vệ<note caller="+" style="f"><char style="fr" closed="false">71:7 </char><char style="ft" closed="false">Nt chỗ trú ẩn vững vàng</char></note> con.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Suốt ngày, miệng con ca ngợi,</para>
  <para style="q2" vid="PSA 71:8">và hân hoan chúc tụng Ngài.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Xin Chúa đừng bỏ con trong tuổi già.</para>
  <para style="q2" vid="PSA 71:9">Đừng lìa con khi tóc bạc răng long.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Vì kẻ thù rỉ tai nói xấu.</para>
  <para style="q2" vid="PSA 71:10">Họ lập mưu hãm hại linh hồn con.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Họ bảo nhau: “Đức Chúa Trời bỏ hắn rồi.</para>
  <para style="q2" vid="PSA 71:11">Cứ săn bắt nó,</para>
  <para style="q2" vid="PSA 71:11">vì không còn ai giải cứu.”<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Lạy Đức Chúa Trời, xin đừng xa con,</para>
  <para style="q2" vid="PSA 71:12">Đức Chúa Trời con ơi, xin nhanh chóng giúp con.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Kẻ thù con hổ thẹn, tiêu tan,</para>
  <para style="q2" vid="PSA 71:13">người hãm hại cúi đầu, nhục nhã.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Hy vọng con lại càng tươi sáng</para>
  <para style="q2" vid="PSA 71:14">ca tụng Chúa ngày càng gia tăng.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Hằng ngày thuật<note caller="+" style="f"><char style="fr" closed="false">71:15 </char><char style="ft" closed="false">Miệng tôi thuật</char></note> những điều công chính</para>
  <para style="q2" vid="PSA 71:15">và vô số công ơn cứu chuộc.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Con sẽ loan báo việc quyền năng, lạy Chúa Hằng Hữu Chí Cao.</para>
  <para style="q2" vid="PSA 71:16">Con sẽ quảng bá đức công chính tuyệt vời của Chúa.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Lạy Đức Chúa Trời, Ngài dạy con từ tuổi ấu thơ,</para>
  <para style="q2" vid="PSA 71:17">đến nay con vẫn rao truyền công tác diệu kỳ của Ngài.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Chúa ơi, xin đừng bỏ con khi tóc bạc,</para>
  <para style="q2" vid="PSA 71:18">xin ở với con cho đến khi</para>
  <para style="q1" vid="PSA 71:18">con truyền cho thế hệ mới biết năng lực Chúa,</para>
  <para style="q2" vid="PSA 71:18">tỏ uy quyền Ngài cho thế hệ mai sau.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Lạy Đức Chúa Trời, Đấng chí công chí thánh</para>
  <para style="q2" vid="PSA 71:19">Đấng thực hiện bao công tác vĩ đại.</para>
  <para style="q2" vid="PSA 71:19">Ai sánh được với Ngài, lạy Đức Chúa Trời!<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Chúa đã đưa chúng con qua nhiều gian khổ,</para>
  <para style="q2" vid="PSA 71:20">cũng sẽ phục hồi chúng con trong tương lai,</para>
  <para style="q2" vid="PSA 71:20">cứu chúng con ra khỏi huyệt mộ thẳm sâu.<note caller="+" style="f"><char style="fr" closed="false">71:20 </char><char style="ft" closed="false">Nt đáy vực thẳm của đất</char></note><verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Chúa sẽ cho con thêm vinh dự,</para>
  <para style="q2" vid="PSA 71:21">an ủi vỗ về con sau nỗi đắng cay.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Lạy Chúa, con sẽ gảy đàn hạc ca ngợi Chúa,</para>
  <para style="q2" vid="PSA 71:22">tụng ca đức thành tín của Ngài, Đức Chúa Trời con ơi.</para>
  <para style="q2" vid="PSA 71:22">Con sẽ đánh đàn lia tán tụng Đấng Thánh của Ít-ra-ên.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Linh hồn được cứu chuộc sẽ mở môi</para>
  <para style="q2" vid="PSA 71:23">hoan hỉ ngợi ca chúc tụng Ngài.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Suốt ngày, con thuật việc công minh</para>
  <para style="q2" vid="PSA 71:24">Chúa đã thực hiện cho con bao lần.</para>
  <para style="q2" vid="PSA 71:24">Bọn người mưu hại con cúi đầu, hổ thẹn.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="cl">Thi Thiên 72</para>
  <para style="s1">Cuộc Trị Vì của Vua Công Chính</para>
  <para style="d">(Thơ của Sa-lô-môn)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Lạy Đức Chúa Trời, xin ban cho vua công lý của Chúa,</para>
  <para style="q2" vid="PSA 72:1">và cho hoàng tử sự công chính của Ngài.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Để vua xét dân cách công bằng,</para>
  <para style="q2" vid="PSA 72:2">và liêm chính đối với người cùng khổ.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Nguyện núi đồi cũng phải thắm tươi,</para>
  <para style="q2" vid="PSA 72:3">khi dân cư an lạc, trị vì công minh.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Vua minh oan cho những ai khốn cùng,</para>
  <para style="q2" vid="PSA 72:4">giải thoát con cái của những người nghèo khổ,</para>
  <para style="q2" vid="PSA 72:4">dày xéo bọn bạo hành áp bức.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Nguyện khi nào còn mặt trời, mặt trăng,</para>
  <para style="q2" vid="PSA 72:5">thì người nghèo khổ vẫn còn thờ kính Chúa.</para>
  <para style="q2" vid="PSA 72:5">Phải, cho đến muôn đời!<verse eid="PSA 72:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Nguyện ơn mưa móc của nhà vua,</para>
  <para style="q2" vid="PSA 72:6">như trận mưa xuân<note caller="+" style="f"><char style="fr" closed="false">72:6 </char><char style="ft" closed="false">Ctd mưa trên cỏ mới cắt</char></note> trên đồng cỏ,</para>
  <para style="q2" vid="PSA 72:6">nhuần tưới đất đai hoa mầu.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Nguyện dưới triều vua, người công chính hưng thịnh</para>
  <para style="q2" vid="PSA 72:7">và hòa bình trường cửu như trăng sao.<verse eid="PSA 72:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Vua cai trị từ biển đông đến biển tây,</para>
  <para style="q2" vid="PSA 72:8">từ Sông Ơ-phơ-rát đến tận cùng trái đất.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Dân du mục sẽ vái chào trong hoang mạc</para>
  <para style="q2" vid="PSA 72:9">và quân thù sẽ liếm bụi dưới chân vua.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Vua Ta-rê-si và các hải đảo sẽ cống hiến lễ vật cho vua,</para>
  <para style="q2" vid="PSA 72:10">các vua phương đông từ Sê-ba và Sa-ba</para>
  <para style="q2" vid="PSA 72:10">cũng sẽ dâng lễ vật của mình.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Tất cả vua chúa sẽ quỳ lạy,</para>
  <para style="q2" vid="PSA 72:11">các dân tộc sẽ phục vụ vua.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Vì vua sẽ giải cứu người cùng túng</para>
  <para style="q2" vid="PSA 72:12">và giúp đỡ người không còn nơi nương tựa.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Vua sẽ thương xót người cùng cực,</para>
  <para style="q2" vid="PSA 72:13">và giải cứu mạng sống người nghèo khó.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Vua sẽ cứu chuộc họ khỏi bạo quyền áp bức,</para>
  <para style="q2" vid="PSA 72:14">vì trước mắt vua, máu của họ thật quý giá.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Nguyện vua được trường thọ!</para>
  <para style="q2" vid="PSA 72:15">Nguyện vàng Sê-ba sẽ được dâng lên vua.</para>
  <para style="q1" vid="PSA 72:15">Nguyện chúng dân mãi cầu nguyện cho vua</para>
  <para style="q2" vid="PSA 72:15">và chúc phước cho vua suốt ngày.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Nguyện ngũ cốc tràn đầy khắp đất,</para>
  <para style="q2" vid="PSA 72:16">dồi dào thịnh vượng trên các đỉnh núi đồi.</para>
  <para style="q1" vid="PSA 72:16">Nguyện cây trái sinh hoa lợi bội phần như rừng Li-ban,</para>
  <para style="q2" vid="PSA 72:16">dân cư các thành thị đông như kiến cỏ.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Nguyện vua sẽ được lưu danh mãi mãi;</para>
  <para style="q2" vid="PSA 72:17">như mặt trời chiếu sáng muôn đời.</para>
  <para style="q1" vid="PSA 72:17">Nguyện các dân sẽ nhân danh vua để chúc lành,</para>
  <para style="q2" vid="PSA 72:17">các nước nhìn nhận người có hồng phước.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Hãy ngợi tôn Đức Chúa Trời Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,</para>
  <para style="q2" vid="PSA 72:18">chỉ có Chúa làm những việc diệu kỳ.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Hãy chúc tụng Danh vinh quang Ngài mãi!</para>
  <para style="q2" vid="PSA 72:19">Cả thế gian đầy dẫy vinh quang Ngài.</para>
  <para style="q2" vid="PSA 72:19">A-men và A-men!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />(Đến đây kết thúc lời cầu nguyện của Đa-vít, con trai Gie-sê).<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms1">Quyển Thứ Ba</para>
  <para style="mr">(<ref loc="PSA 73-89">Thi Thiên 73–89</ref>)</para>
  <para style="cl">Thi Thiên 73</para>
  <para style="s1">Chung Cuộc của Người Ác và Người Lành</para>
  <para style="d">(Thơ của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Đức Chúa Trời thật nhân từ với Ít-ra-ên,</para>
  <para style="q2" vid="PSA 73:1">với những ai có lòng trong sạch.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Nhưng riêng con, gần như đã mất niềm tin.</para>
  <para style="q2" vid="PSA 73:2">Chân con suýt trượt ngã bao lần.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Vì con ganh tị người kiêu ngạo,</para>
  <para style="q2" vid="PSA 73:3">khi thấy bọn gian ác thành công.<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Lúc chết, họ không đau đớn;</para>
  <para style="q2" vid="PSA 73:4">họ luôn luôn mạnh khỏe tráng kiện.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Họ không bị hoạn nạn như người khác;</para>
  <para style="q2" vid="PSA 73:5">lúc nào họ cũng tai qua nạn khỏi.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Vì thế họ lấy kiêu ngạo làm vòng đeo cổ,</para>
  <para style="q2" vid="PSA 73:6">lấy bạo tàn làm áo mặc.<note caller="+" style="f"><char style="fr" closed="false">73:6 </char><char style="ft" closed="false">Nt họ đeo kiêu ngạo như vòng đeo cổ, và tàn bạo bao phủ họ như chiếc áo</char></note><verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Tâm trí đầy mưu sâu kế độc,</para>
  <para style="q2" vid="PSA 73:7">lòng dạ chai lì phát sinh bao tội ác!<note caller="+" style="f"><char style="fr" closed="false">73:7 </char><char style="ft" closed="false">Nt lòng họ tuôn trào độc ác</char></note><verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Họ nhạo cười, chế giễu thâm độc;</para>
  <para style="q2" vid="PSA 73:8">kiêu căng, giăng cạm bẫy hại người.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Miệng khoác lác chống nghịch các tầng trời,</para>
  <para style="q2" vid="PSA 73:9">lưỡi xấc xược nói nghịch thế nhân.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Thậm chí dân Chúa cũng về hùa,</para>
  <para style="q2" vid="PSA 73:10">tin tất cả những lời họ nói.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Họ bảo nhau: “Đức Chúa Trời không biết đâu?</para>
  <para style="q2" vid="PSA 73:11">Làm sao Đấng Tối Cao hiểu hết mọi việc?”<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Những người ác bình an vô sự—</para>
  <para style="q2" vid="PSA 73:12">cứ hanh thông, của cải gia tăng.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Có phải con đã luyện tâm hồn tinh khiết cách vô ích?</para>
  <para style="q2" vid="PSA 73:13">Có phải con hoài công rửa tay cho trong trắng?<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Con không được gì, chỉ suốt ngày gian nan;</para>
  <para style="q2" vid="PSA 73:14">mỗi buổi sáng bị đớn đau hành hạ.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Nếu con cứ than phiền trách móc,</para>
  <para style="q2" vid="PSA 73:15">con sẽ trở nên bất trung với Ngài.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Con cúi đầu suy nghiệm sâu xa.</para>
  <para style="q2" vid="PSA 73:16">Nan đề ấy con không sao hiểu được!<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Cho đến khi con đi vào nơi thánh,</para>
  <para style="q2" vid="PSA 73:17">mới chợt hiểu ra chung cuộc của người ác.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Thật Chúa đặt họ đứng nơi trơn trợt,</para>
  <para style="q2" vid="PSA 73:18">bỏ họ vào đáy vực hư vong.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Trong khoảnh khắc, họ bị hủy diệt,</para>
  <para style="q2" vid="PSA 73:19">lao mình vào hố thẳm kinh hoàng.<note caller="+" style="f"><char style="fr" closed="false">73:19 </char><char style="ft" closed="false">Ctd bị kinh hoàng đốt tiêu</char></note><verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Lạy Chúa, Ngài khinh dể những ý tưởng khờ dại của họ<note caller="+" style="f"><char style="fr" closed="false">73:20 </char><char style="ft" closed="false">Nt khinh chê hình dạng họ</char></note></para>
  <para style="q2" vid="PSA 73:20">như một người nhạo cười giấc mơ vào ban sáng.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Khi lòng con đau buồn,</para>
  <para style="q2" vid="PSA 73:21">tinh thần con cay đắng.<note caller="+" style="f"><char style="fr" closed="false">73:21 </char><char style="ft" closed="false">Nt tôi bị đâm vào thận</char></note><verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />Con trở nên ngu si, dốt nát—</para>
  <para style="q2" vid="PSA 73:22">như thú hoang trước thánh nhan.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Nhưng con vẫn luôn thuộc về Chúa;</para>
  <para style="q2" vid="PSA 73:23">Chúa nắm lấy tay hữu con.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Chúa dạy bằng lời huấn thị,</para>
  <para style="q2" vid="PSA 73:24">để rồi đưa con vào bến vinh quang.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Trên trời, con không có ai ngoài Chúa.</para>
  <para style="q2" vid="PSA 73:25">Được ở với Chúa, con còn ước ao gì hơn trên đất này.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Thân xác và tâm hồn con tàn tạ,</para>
  <para style="q2" vid="PSA 73:26">nhưng Đức Chúa Trời là sức mạnh lòng con;</para>
  <para style="q2" vid="PSA 73:26">Ngài là phần của con mãi mãi.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Những ai cách xa Chúa sẽ hư vong,</para>
  <para style="q2" vid="PSA 73:27">Chúa hủy diệt những người chối bỏ Chúa.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Nhưng riêng con, được gần Đức Chúa Trời thật phước hạnh thay!</para>
  <para style="q2" vid="PSA 73:28">Nhờ Chúa Hằng Hữu Chí Cao làm nơi ẩn trú,</para>
  <para style="q2" vid="PSA 73:28">và con sẽ thuật lại tất cả việc kỳ diệu Ngài làm.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="cl">Thi Thiên 74</para>
  <para style="s1">Than Thở Vì Kẻ Thù Phá Hoang Xứ</para>
  <para style="d">(Thơ của A-sáp—Giáo huấn ca)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Lạy Đức Chúa Trời, tại sao Chúa ruồng rẫy chúng con?</para>
  <para style="q2" vid="PSA 74:1">Sao cơn giận Chúa vẫn âm ỉ với đàn chiên của đồng cỏ Ngài?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Xin nhớ lại dân mà Chúa đã chọn từ xưa,</para>
  <para style="q2" vid="PSA 74:2">đại tộc mà Ngài đã chuộc làm cơ nghiệp!</para>
  <para style="q2" vid="PSA 74:2">Và ngọn núi Si-ôn, nơi Ngài ngự trị trên đất.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Xin Chúa quang lâm thị sát cảnh điêu tàn;</para>
  <para style="q2" vid="PSA 74:3">quân thù đã phá tan nơi thánh Chúa.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Quân thù gào thét giữa nơi Chúa gặp gỡ chúng con;</para>
  <para style="q2" vid="PSA 74:4">họ ngạo nghễ trương cờ lên làm hiệu.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Họ tung hoành như người tiều phu triệt hạ</para>
  <para style="q2" vid="PSA 74:5">để phá hoang rừng cây rậm rạp.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Chúng phá nát những đồ chạm trổ</para>
  <para style="q2" vid="PSA 74:6">không nương tay, bằng rìu và búa.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Họ châm lửa đốt nơi thánh Chúa.</para>
  <para style="q2" vid="PSA 74:7">Biến nơi Danh Ngài ngự ra ô uế.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Họ bảo: “Bọn ta sẽ diệt phá mọi thứ!”</para>
  <para style="q2" vid="PSA 74:8">Rồi thiêu hủy những nơi thờ phượng Đức Chúa Trời.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Chúng con không còn thấy những dấu lạ.</para>
  <para style="q2" vid="PSA 74:9">Các nhà tiên tri cũng đều vắng bóng,</para>
  <para style="q2" vid="PSA 74:9">không ai biết thảm cảnh này bao giờ chấm dứt.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Lạy Đức Chúa Trời, quân thù còn chế giễu đến bao giờ?</para>
  <para style="q2" vid="PSA 74:10">Sao phe địch còn sỉ nhục Danh Chúa mãi?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Sao Chúa cầm giữ sức mạnh trong tay phải?</para>
  <para style="q2" vid="PSA 74:11">Xin vung tay ra và tiêu diệt họ đi.<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Chúa, Đức Chúa Trời, là Vua của tôi từ nghìn xưa,</para>
  <para style="q2" vid="PSA 74:12">đem ơn cứu rỗi xuống trần thế.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Dùng sức mạnh rạch biển ra,</para>
  <para style="q2" vid="PSA 74:13">và nhận đầu quái vật trong biển xuống nước sâu.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Chúa chà nát đầu thủy quái Lê-vi-a-than,</para>
  <para style="q2" vid="PSA 74:14">đem thịt nó cho muông thú trong hoang mạc.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Chúa chẻ núi, tạo dòng suối ngọt,</para>
  <para style="q2" vid="PSA 74:15">khiến các sông chảy xiết phải khô cạn.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Cả ngày lẫn đêm đều thuộc về Chúa;</para>
  <para style="q2" vid="PSA 74:16">Ngài tạo mặt trời, dựng mặt trăng.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Quy định giới hạn địa cầu,</para>
  <para style="q2" vid="PSA 74:17">Ngài ấn định mùa đông và mùa hạ.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Lạy Chúa Hằng Hữu, xin nhớ lại lời quân thù chế nhạo.</para>
  <para style="q2" vid="PSA 74:18">Đám dân ngu dại xúc phạm Danh Ngài.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Xin đừng để dã thú hủy diệt bồ câu của Ngài.</para>
  <para style="q2" vid="PSA 74:19">Xin đừng quên người khốn khổ mãi mãi.<verse eid="PSA 74:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Xin nhớ đến giao ước Ngài hứa,</para>
  <para style="q2" vid="PSA 74:20">vì các nơi tối tăm nhung nhúc lũ người bạo ngược!<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Xin đừng để người bị áp bức phải hổ nhục quay về.</para>
  <para style="q2" vid="PSA 74:21">Nguyện người khốn cùng tụng ca Danh Chúa.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Lạy Đức Chúa Trời, xin vùng dậy, bênh vực chính nghĩa Ngài.</para>
  <para style="q2" vid="PSA 74:22">Xin nhớ lời sỉ nhục hằng ngày của người vô đạo.<note caller="+" style="f"><char style="fr" closed="false">74:22 </char><char style="ft" closed="false">Ctd người ngu dại</char></note><verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Xin đừng quên tiếng la hét của quân thù,</para>
  <para style="q2" vid="PSA 74:23">tiếng la, gào thét thường xuyên chống Chúa.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="cl">Thi Thiên 75</para>
  <para style="s1">Chúa Hạ Người Kiêu Ngạo, Nâng Người Công Chính</para>
  <para style="d">(Thơ của A-sáp, soạn cho nhạc trưởng, theo điệu: “Xin đừng hủy diệt”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Chúng con cảm tạ Chúa, Đức Chúa Trời ôi!</para>
  <para style="q2" vid="PSA 75:1">Chúng con cảm tạ, vì Danh Chúa ở gần.</para>
  <para style="q2" vid="PSA 75:1">Mọi người thuật lại các công trình kỳ diệu của Chúa.<verse eid="PSA 75:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Đức Chúa Trời phán: “Ta chọn thời gian đã định,</para>
  <para style="q2" vid="PSA 75:2">Ta sẽ xét xử nghịch lại người ác.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Khi địa cầu và nhân loại rúng động,</para>
  <para style="q2" vid="PSA 75:3">Ta chính là Đấng nắm vững các cột chống nó.<verse eid="PSA 75:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Ta cảnh báo người kiêu ngạo: ‘Đừng khoe khoang nữa!’</para>
  <para style="q2" vid="PSA 75:4">Và bảo người ác: ‘Đừng giương sừng lên cao!<note caller="+" style="f"><char style="fr" closed="false">75:4 </char><char style="ft" closed="false">Nt ngước sững lên</char></note><verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Đừng dùng sừng chống lại các tầng trời,</para>
  <para style="q2" vid="PSA 75:5">hay ra sức cãi bướng.’”<note caller="+" style="f"><char style="fr" closed="false">75:5 </char><char style="ft" closed="false">Nt nói cách cứng cổ</char></note><verse eid="PSA 75:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Vì không một ai trên đất—từ đông hay tây</para>
  <para style="q2" vid="PSA 75:6">hay ngay cả từ nơi hoang mạc—</para>
  <para style="q2" vid="PSA 75:6">có thể nâng sừng lên cao.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Chỉ có Đức Chúa Trời, Đấng phán xét,<note caller="+" style="f"><char style="fr" closed="false">75:7 </char><char style="ft" closed="false">Ctd nhưng do Thượng Đế, là Đấng xét xử</char></note></para>
  <para style="q2" vid="PSA 75:7">quyết định hạ người này xuống và nâng người khác lên.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Vì Chúa Hằng Hữu cầm ly trong tay mình,</para>
  <para style="q2" vid="PSA 75:8">là ly rượu đầy bọt pha nhiều hương liệu.</para>
  <para style="q1" vid="PSA 75:8">Ngài rót rượu phán xét ra,</para>
  <para style="q2" vid="PSA 75:8">và mọi người gian ác phải uống,</para>
  <para style="q2" vid="PSA 75:8">uống cho đến khi cạn.<verse eid="PSA 75:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Nhưng riêng con, con sẽ luôn kể lại sự việc Đức Chúa Trời thực hiện;</para>
  <para style="q2" vid="PSA 75:9">con sẽ ngợi ca Đức Chúa Trời của Gia-cốp.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Vì Đức Chúa Trời phán: “Ta sẽ bẻ gãy các sừng của người ác,</para>
  <para style="q2" vid="PSA 75:10">nhưng sừng của người công chính sẽ được tôn cao.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="cl">Thi Thiên 76</para>
  <para style="s1">Quyền Oai của Chúa Thắng Cừu Địch</para>
  <para style="d">(Thơ của A-sáp, soạn cho nhạc trưởng, dùng đàn hạc)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Trong Giu-đa người dân biết Đức Chúa Trời;</para>
  <para style="q2" vid="PSA 76:1">Danh Ngài được Ít-ra-ên tôn quý.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Sa-lem là nơi Chúa ngự;</para>
  <para style="q2" vid="PSA 76:2">Núi Si-ôn là nhà Ngài.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Tại đó, Chúa bẻ gãy mũi tên quân thù,</para>
  <para style="q2" vid="PSA 76:3">phá khiên, bẻ gươm, tiêu diệt khí giới.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Chúa rực rỡ vinh quang và oai nghi</para>
  <para style="q2" vid="PSA 76:4">hơn các núi đầy của cướp.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Người dũng mãnh nhất cũng tàn sát.</para>
  <para style="q2" vid="PSA 76:5">Họ nằm la liệt trong giấc ngủ nghìn thu.</para>
  <para style="q2" vid="PSA 76:5">Không một người lính nâng nổi cánh tay.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Lạy Đức Chúa Trời của Gia-cốp, khi Ngài quở trách</para>
  <para style="q2" vid="PSA 76:6">ngựa và chiến xa đều bất động.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Chỉ mình Chúa thật đáng kính sợ!</para>
  <para style="q2" vid="PSA 76:7">Ai có thể đứng nổi trước mặt Chúa khi Ngài thịnh nộ?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Từ tầng trời xanh thẳm Chúa tuyên án;</para>
  <para style="q2" vid="PSA 76:8">khắp đất đều kinh khiếp, lặng yên như tờ.<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />Ngài đứng dậy phán xét ác nhân, ôi Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 76:9">và giải cứu những người bị đàn áp trên đất.<verse eid="PSA 76:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Cơn giận của loài người chỉ thêm chúc tụng Chúa,</para>
  <para style="q2" vid="PSA 76:10">còn cơn giận dư lại Ngài sẽ ngăn cản.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Hãy hứa nguyện và giữ lời với Chúa Hằng Hữu, Đức Chúa Trời ngươi.</para>
  <para style="q2" vid="PSA 76:11">Hỡi các dân tộc, hãy mang lễ vật dâng lên Đấng đáng kính sợ.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Vì Ngài phá vỡ khí thế của các bậc cầm quyền,</para>
  <para style="q2" vid="PSA 76:12">và các vua khắp đất phải kính sợ Ngài.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="cl">Thi Thiên 77</para>
  <para style="s1">Nhớ Lại Công Ơn Chúa</para>
  <para style="d">(Thơ của A-sáp, soạn cho nhạc trưởng, cho Giê-đu-thun)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Con kêu cầu Đức Chúa Trời; phải, con kêu la.</para>
  <para style="q2" vid="PSA 77:1">Ôi, Đức Chúa Trời xin lắng nghe con!<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Khi lâm cảnh nguy nan,</para>
  <para style="q2" vid="PSA 77:2">con tìm kiếm Chúa.</para>
  <para style="q1" vid="PSA 77:2">Suốt đêm con cầu nguyện với đôi tay hướng về Chúa,</para>
  <para style="q2" vid="PSA 77:2">nhưng linh hồn con vẫn chưa được an ủi.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Khi nghĩ đến Đức Chúa Trời, và con rên rỉ,</para>
  <para style="q2" vid="PSA 77:3">càng suy tư, con càng ngã lòng.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Chúa khiến con thức thâu đêm.</para>
  <para style="q2" vid="PSA 77:4">Con bối rối ngay cả khi cầu nguyện!<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Con nghĩ đến những ngày dĩ vãng,</para>
  <para style="q2" vid="PSA 77:5">và những năm tháng đã trôi qua,<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />suốt đêm con nhớ lại các bài hát.</para>
  <para style="q2" vid="PSA 77:6">Lòng tự vấn và hồn linh trăn trở.<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />Chúng con sẽ bị Ngài loại bỏ mãi sao?</para>
  <para style="q2" vid="PSA 77:7">Chúa không còn tỏ ân huệ nữa sao?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Phải chăng tình thương không dời đổi của Ngài đã biến mất?</para>
  <para style="q2" vid="PSA 77:8">Lời hứa Ngài không còn hiệu lực nữa sao?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Hay Đức Chúa Trời đã quên ban ân phước?</para>
  <para style="q2" vid="PSA 77:9">Thịnh nộ chặn đứng lòng xót thương của Chúa được sao?<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Rồi con nói: “Đây là số phận của con;</para>
  <para style="q2" vid="PSA 77:10">tay hữu Đấng Chí Cao đã nghịch lại con.”<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Nhưng rồi con nhắc lại các công việc Chúa, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 77:11">vâng, con nhớ lại phép lạ Chúa đã làm ngày xa xưa.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Con sẽ suy nghiệm về tất cả kỳ công.</para>
  <para style="q2" vid="PSA 77:12">Và chiêm ngưỡng những việc kinh thiên động địa.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Lạy Đức Chúa Trời, những việc Chúa làm đều thánh khiết.</para>
  <para style="q2" vid="PSA 77:13">Có thần nào vĩ đại như Chúa của con?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Chúa là Đức Chúa Trời vĩ đại diệu kỳ!</para>
  <para style="q2" vid="PSA 77:14">Chúa bày tỏ năng lực Ngài giữa các dân.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Với cánh tay mạnh mẽ, Chúa cứu chuộc dân Ngài,</para>
  <para style="q2" vid="PSA 77:15">là con cháu của Gia-cốp và Giô-sép.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Khi thấy Chúa, lạy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 77:16">các dòng nước lặng nhìn và run rẩy!</para>
  <para style="q2" vid="PSA 77:16">Biển sâu rúng động trước mặt Ngài.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Các áng mây vội vã trút cơn mưa;</para>
  <para style="q2" vid="PSA 77:17">tiếng sét nổ rung khung trời thẳm.</para>
  <para style="q2" vid="PSA 77:17">Tia chớp chiếu sáng khắp bốn phương.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Sấm nổi ầm ầm trong gió trốt;</para>
  <para style="q2" vid="PSA 77:18">ánh sáng thắp rực rỡ thế gian.</para>
  <para style="q2" vid="PSA 77:18">Đất run lên và chấn động.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Con đường Chúa ngang qua biển cả,</para>
  <para style="q2" vid="PSA 77:19">lối Chúa trong nước sâu—</para>
  <para style="q2" vid="PSA 77:19">nhưng không ai tìm được dấu chân Ngài.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Chúa dẫn dắt dân Ngài như đàn chiên,</para>
  <para style="q2" vid="PSA 77:20">qua bàn tay của Môi-se và A-rôn.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="cl">Thi Thiên 78</para>
  <para style="s1">Chúa Hướng Dẫn Dân Chúa Dù Họ Bất Trung</para>
  <para style="d">(Giáo huấn ca của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Dân ta hỡi, hãy nghe lời ta dạy.</para>
  <para style="q2" vid="PSA 78:1">Hãy mở tai lưu ý lời ta,<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />vì ta sẽ nói về các ẩn dụ.</para>
  <para style="q2" vid="PSA 78:2">Ta sẽ dạy về những điều giấu kín từ xưa—<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />những bài học dân ta đã nghe biết,</para>
  <para style="q2" vid="PSA 78:3">do tổ phụ truyền dạy chúng ta.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Chúng ta sẽ không giấu sự thật này với con cháu;</para>
  <para style="q2" vid="PSA 78:4">nhưng sẽ nói cho thế hệ sau</para>
  <para style="q1" vid="PSA 78:4">về những việc vinh quang của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 78:4">về quyền năng và những phép lạ Ngài đã làm.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Chúa ban hành luật pháp cho Gia-cốp;</para>
  <para style="q2" vid="PSA 78:5">Ngài ban truyền chỉ thị cho Ít-ra-ên.</para>
  <para style="q1" vid="PSA 78:5">Chúa ra lệnh cho tổ phụ chúng ta</para>
  <para style="q2" vid="PSA 78:5">truyền dạy mọi điều cho con cháu,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />để các thế hệ mai sau biết đến—</para>
  <para style="q2" vid="PSA 78:6">tức con cháu sẽ sinh ra—</para>
  <para style="q2" vid="PSA 78:6">sẽ học hỏi và dạy lại cho dòng dõi họ.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Theo cách ấy, mọi thế hệ sẽ tin cậy Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 78:7">ghi nhớ công tác vĩ đại Ngài làm,</para>
  <para style="q2" vid="PSA 78:7">và vâng giữ mệnh lệnh Ngài mãi mãi.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Để họ sẽ không như tổ tiên họ—</para>
  <para style="q2" vid="PSA 78:8">cứng đầu, phản nghịch, và bất trung,</para>
  <para style="q2" vid="PSA 78:8">không chịu đặt lòng tin cậy Đức Chúa Trời.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Các lính chiến Ép-ra-im trang bị cung tên,</para>
  <para style="q2" vid="PSA 78:9">đã chạy trốn trong ngày chinh chiến.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Họ không giữ giao ước với Đức Chúa Trời</para>
  <para style="q2" vid="PSA 78:10">và không chịu tuân theo luật pháp Chúa.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Họ đã quên các công việc Ngài làm—</para>
  <para style="q2" vid="PSA 78:11">là những phép lạ họ thấy Ngài thực hiện,<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />những phép lạ Ngài đã làm cho tổ phụ họ,</para>
  <para style="q2" vid="PSA 78:12">trên đồng bằng Xô-an, xứ Ai Cập.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Chúa rạch đôi biển cả, dẫn họ đi qua,</para>
  <para style="q2" vid="PSA 78:13">làm cho nước dựng lên như thành vách.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />Ban ngày, Chúa dìu dắt họ qua trụ mây,</para>
  <para style="q2" vid="PSA 78:14">suốt đêm, trụ lửa tỏa ánh sáng soi đường.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Chúa chẻ vầng đá giữa hoang mạc,</para>
  <para style="q2" vid="PSA 78:15">ban cho họ dòng nước ngọt từ vực sâu.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />Chúa cho suối phun ra từ tảng đá,</para>
  <para style="q2" vid="PSA 78:16">khiến nước chảy cuồn cuộn như dòng sông!<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Nhưng họ tiếp tục phạm tội cùng Chúa,</para>
  <para style="q2" vid="PSA 78:17">giữa hoang mạc, họ nổi loạn chống Đấng Chí Cao.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Lòng ngang bướng, họ cố tình thử Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 78:18">đòi món ăn theo dục vọng trần gian.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Họ nói nghịch, thách thức Đức Chúa Trời rằng:</para>
  <para style="q2" vid="PSA 78:19">“Đức Chúa Trời không thể ban thức ăn trong hoang mạc.<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Phải, Chúa có thể đập vầng đá cho nước trào tuôn</para>
  <para style="q2" vid="PSA 78:20">nhưng Ngài không thể ban dân Ngài bánh và thịt.”<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Chúa Hằng Hữu nghe lời ấy liền nổi giận,</para>
  <para style="q2" vid="PSA 78:21">Lửa thịnh nộ của Ngài hình phạt nhà Gia-cốp.</para>
  <para style="q2" vid="PSA 78:21">Phải, Ngài trút đổ cơn giận trên nhà Ít-ra-ên,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />vì họ không đặt niềm tin nơi Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 78:22">không tin vào quyền giải cứu của Ngài.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Nhưng Chúa ra lệnh bầu trời mở ra,</para>
  <para style="q2" vid="PSA 78:23">Ngài mở toang các cửa trên trời.<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />Chúa ban mưa ma-na xuống cho họ ăn.</para>
  <para style="q2" vid="PSA 78:24">Ngài ban bánh cho họ từ trời.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Họ được ăn thực phẩm thiên thần!</para>
  <para style="q2" vid="PSA 78:25">Đức Chúa Trời cho họ ăn no nê.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Chúa cũng cho gió đông thổi tới,</para>
  <para style="q2" vid="PSA 78:26">và dùng quyền năng khuấy động gió nam.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Đem chim cút xuống cho dân,</para>
  <para style="q2" vid="PSA 78:27">nhiều như cát trải trên bờ biển.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Đàn chim sà xuống giữa trại quân,</para>
  <para style="q2" vid="PSA 78:28">rơi rào rào quanh các lều trại.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Dân ăn uống thỏa thuê.</para>
  <para style="q2" vid="PSA 78:29">Chúa đã cho họ tùy sở thích.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Nhưng trước khi họ thỏa mãn ham mê,</para>
  <para style="q2" vid="PSA 78:30">trong khi miệng vẫn còn đầy thịt,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />thì cơn thịnh nộ Đức Chúa Trời nổi lên,</para>
  <para style="q2" vid="PSA 78:31">Ngài giết những người mập béo nhất.</para>
  <para style="q2" vid="PSA 78:31">Ngài triệt hạ các trai tráng Ít-ra-ên.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Thế mà họ vẫn cứ phạm tội.</para>
  <para style="q2" vid="PSA 78:32">Hoài nghi các phép lạ Ngài.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Nên Chúa làm ngày của họ sút giảm,</para>
  <para style="q2" vid="PSA 78:33">và trải qua những năm tháng kinh hoàng.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Cho đến khi bị Đức Chúa Trời hình phạt,</para>
  <para style="q2" vid="PSA 78:34">họ mới quay đầu tìm kiếm Chúa.</para>
  <para style="q2" vid="PSA 78:34">Họ ăn năn và bước theo Đức Chúa Trời.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Rồi họ nhớ Đức Chúa Trời là Vầng Đá,</para>
  <para style="q2" vid="PSA 78:35">là Đức Chúa Trời Chí Cao là Đấng cứu chuộc mình.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Nhưng họ mở miệng nịnh hót Chúa;</para>
  <para style="q2" vid="PSA 78:36">và uốn lưỡi dối gạt Ngài.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Lòng họ chẳng ngay thật với Chúa,</para>
  <para style="q2" vid="PSA 78:37">Họ cũng không vâng giữ giao ước với Ngài.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Nhưng Chúa vẫn thương xót và tha thứ tội họ</para>
  <para style="q2" vid="PSA 78:38">và Ngài không tuyệt diệt họ tất cả.</para>
  <para style="q1" vid="PSA 78:38">Bao lần Chúa dằn cơn thịnh nộ,</para>
  <para style="q2" vid="PSA 78:38">và đã không buông lỏng sự giận mình.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Vì Chúa nhớ rằng họ là người phàm,</para>
  <para style="q2" vid="PSA 78:39">như hơi thở thoáng qua, không bao giờ trở lại.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Ôi, bao lần họ nổi loạn trong hoang mạc,</para>
  <para style="q2" vid="PSA 78:40">và làm buồn lòng Ngài giữa đồng hoang.<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Họ dại dột thử sự nhẫn nại của Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 78:41">và trêu chọc Đấng Thánh của Ít-ra-ên.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Họ quên bàn tay quyền năng Chúa,</para>
  <para style="q2" vid="PSA 78:42">và ngày Chúa giải thoát khỏi quân thù.<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />Họ đã quên Chúa làm các phép lạ ở Ai Cập,</para>
  <para style="q2" vid="PSA 78:43">và các việc diệu kỳ ở đồng bằng Xô-an.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Ngài đã biến nước sông ra máu</para>
  <para style="q2" vid="PSA 78:44">nên các dòng nước không còn uống được.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Chúa sai vô số ruồi nhặng cắn họ,</para>
  <para style="q2" vid="PSA 78:45">và ếch nhái bò lên, phá hoại.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Chúa bỏ mùa màng họ cho sâu cắn;</para>
  <para style="q2" vid="PSA 78:46">và hoa lợi cho cào cào.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Chúa phá vườn nho bằng mưa đá</para>
  <para style="q2" vid="PSA 78:47">và cây sung bằng tuyết giá.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Ngài để mưa đá giết hại bầy súc vật,</para>
  <para style="q2" vid="PSA 78:48">sấm sét đốt chết các bầy chiên.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Chúa đổ trút trên họ cơn giận—</para>
  <para style="q2" vid="PSA 78:49">tất cả thịnh nộ, bất mãn, và hoạn nạn.</para>
  <para style="q1" vid="PSA 78:49">Chúa sai đến với họ</para>
  <para style="q2" vid="PSA 78:49">một đoàn thiên binh hủy diệt.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Chúa mở đường cho cơn giận Ngài;</para>
  <para style="q2" vid="PSA 78:50">không cho người Ai Cập được sống</para>
  <para style="q2" vid="PSA 78:50">nhưng nạp mạng họ cho dịch bệnh.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Chúa đánh hạ các trưởng nam Ai Cập,</para>
  <para style="q2" vid="PSA 78:51">là tinh hoa sức mạnh của Cham.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Nhưng Chúa hướng dẫn dân Ngài như đàn chiên,</para>
  <para style="q2" vid="PSA 78:52">dìu dắt họ an toàn giữa hoang mạc.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />Chúa phù trì, bảo vệ nên họ không sợ gì;</para>
  <para style="q2" vid="PSA 78:53">còn nước biển vùi dập quân thù nghịch.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Chúa đưa họ vào bờ cõi thánh,</para>
  <para style="q2" vid="PSA 78:54">đến vùng đồi núi Ngài dành cho họ.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />Chúa đuổi các sắc dân trong xứ;</para>
  <para style="q2" vid="PSA 78:55">bắt thăm chia đất cho đoàn dân.</para>
  <para style="q2" vid="PSA 78:55">Cho các đại tộc Ít-ra-ên vào trong trại của mình.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Nhưng họ lại nổi loạn, thử Đức Chúa Trời Chí Cao.</para>
  <para style="q2" vid="PSA 78:56">Họ không vâng giữ luật pháp Ngài.<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Họ phản bội, tráo trở như tổ phụ.</para>
  <para style="q2" vid="PSA 78:57">Gian tà như mũi tên cong.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Họ xây đền miếu, chọc giận Đức Chúa Trời;</para>
  <para style="q2" vid="PSA 78:58">và thờ thần tượng làm cho Ngài ghen tức.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Trước những việc chướng tai gai mắt,</para>
  <para style="q2" vid="PSA 78:59">Đức Chúa Trời khước từ, loại bỏ Ít-ra-ên,<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Chúa lìa bỏ nơi ngự Ngài ở Si-lô,</para>
  <para style="q2" vid="PSA 78:60">là Đền Tạm của Ngài giữa loài người.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />Chúa cho phép quân thù chiếm Hòm Giao Ước;</para>
  <para style="q2" vid="PSA 78:61">vinh quang Ngài bị giao vào tay kẻ thù.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Chúa để cho dân Ngài bị quân thù chém giết,</para>
  <para style="q2" vid="PSA 78:62">vì Ngài nổi giận với dân Ngài—là dân Ngài tuyển chọn.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Những trai trẻ của họ bị lửa thiêu đốt,</para>
  <para style="q2" vid="PSA 78:63">các thiếu nữ không còn được nghe hát mừng hôn lễ.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Các thầy tế lễ bị gươm đâm,</para>
  <para style="q2" vid="PSA 78:64">các quả phụ không được quyền than khóc.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Thế rồi như người ngủ, Chúa thức dậy,</para>
  <para style="q2" vid="PSA 78:65">và như người say tỉnh dậy.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Ngài đánh bật quân thù ra khỏi bờ cõi,</para>
  <para style="q2" vid="PSA 78:66">sỉ nhục địch quân đến đời đời.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Nhưng Chúa khước từ dòng dõi Giô-sép;</para>
  <para style="q2" vid="PSA 78:67">Ngài không chấp nhận đại tộc Ép-ra-im.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Nhưng Ngài chọn đại tộc Giu-đa</para>
  <para style="q2" vid="PSA 78:68">và Núi Si-ôn mà Ngài yêu mến.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Chúa xây cất nơi thánh Ngài trên núi cao,</para>
  <para style="q2" vid="PSA 78:69">nhà Ngài lập nền vững vàng trên đất.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Chúa chọn Đa-vít làm đầy tớ,</para>
  <para style="q2" vid="PSA 78:70">gọi ông từ các chuồng chiên,<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />Ngài đem ông ra khỏi nơi bầy chiên được chăm sóc,</para>
  <para style="q2" vid="PSA 78:71">Ngài đặt ông chăn giữ nhà Gia-cốp—</para>
  <para style="q2" vid="PSA 78:71">Ít-ra-ên là cơ nghiệp của Đức Chúa Trời.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Ông chăn giữ dân cách thanh liêm, chính trực</para>
  <para style="q2" vid="PSA 78:72">và khôn khéo lãnh đạo dân của Ngài.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="cl">Thi Thiên 79</para>
  <para style="s1">Than Thở Vì Giê-ru-sa-lem Bị Phá Hủy</para>
  <para style="d">(Thơ của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />Lạy Đức Chúa Trời, các dân ngoại đã chiếm cơ nghiệp Chúa.</para>
  <para style="q2" vid="PSA 79:1">Họ làm cho Đền Thờ Chúa ra hoen ố,</para>
  <para style="q2" vid="PSA 79:1">và biến Giê-ru-sa-lem thành nơi đổ nát điêu tàn.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Họ bỏ thây đầy tớ Chúa</para>
  <para style="q2" vid="PSA 79:2">làm thức ăn cho chim trời.</para>
  <para style="q1" vid="PSA 79:2">Xác những người tin kính Ngài</para>
  <para style="q2" vid="PSA 79:2">trở thành thức ăn cho thú rừng cắn nuốt.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Máu đổ như nước tưới Giê-ru-sa-lem;</para>
  <para style="q2" vid="PSA 79:3">không còn ai mai táng xác người.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Các nước lân bang đã nhạo cười,</para>
  <para style="q2" vid="PSA 79:4">các dân tộc mỉa mai, chế nhạo.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Lạy Chúa Hằng Hữu, đến bao giờ Chúa nguôi cơn giận? Mãi mãi sao?</para>
  <para style="q2" vid="PSA 79:5">Đến bao giờ lửa ghen tức của Chúa mới tàn?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Xin đổ thịnh nộ trên các dân khước từ tìm biết Ngài—</para>
  <para style="q2" vid="PSA 79:6">trên các vương quốc không kêu cầu Danh Chúa.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Vì họ đã cắn nuốt nhà Gia-cốp,</para>
  <para style="q2" vid="PSA 79:7">khiến đất đai trở nên hoang tàn.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Xin Chúa đừng quy tội tổ phụ cho chúng con!</para>
  <para style="q2" vid="PSA 79:8">Xin mau mau mở lòng thương xót,</para>
  <para style="q2" vid="PSA 79:8">vì chúng con đã tàn mạt tận bùn đen.<verse eid="PSA 79:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Xin ra tay phù hộ, lạy Đức Chúa Trời, Đấng cứu rỗi chúng con!</para>
  <para style="q2" vid="PSA 79:9">Xin giúp chúng con vì Danh vinh quang Chúa.</para>
  <para style="q1" vid="PSA 79:9">Vì Danh cao cả của Ngài,</para>
  <para style="q2" vid="PSA 79:9">xin giải cứu, tẩy sạch tội lỗi chúng con.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Sao Chúa để các dân kia chế nhạo:</para>
  <para style="q2" vid="PSA 79:10">“Nào Đức Chúa Trời chúng nó ở đâu?”</para>
  <para style="q1" vid="PSA 79:10">Ngay trước mắt chúng tôi, nguyện các nước được biết</para>
  <para style="q2" vid="PSA 79:10">sự báo thù máu vô tội của các đầy tớ Ngài.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Nguyện tiếng rên la của tù nhân thấu tai Chúa.</para>
  <para style="q2" vid="PSA 79:11">Xin Chúa cứu mạng những người bị án tử hình.<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Xin báo trả gấp bảy lần cho người thù nghịch<note caller="+" style="f"><char style="fr" closed="false">79:12 </char><char style="ft" closed="false">Nt người láng giềng</char></note></para>
  <para style="q2" vid="PSA 79:12">vì họ dám thách thức Ngài, lạy Chúa.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Khi ấy, dân của Chúa, bầy chiên trong đồng cỏ Ngài,</para>
  <para style="q2" vid="PSA 79:13">sẽ cảm tạ Ngài mãi mãi,</para>
  <para style="q2" vid="PSA 79:13">chúng con sẽ chúc tụng Ngài đời đời.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="cl">Thi Thiên 80</para>
  <para style="s1">Xin Chúa Cứu Dân Khỏi Hoạn Nạn</para>
  <para style="d">(Thơ của A-sáp, soạn cho nhạc trưởng, theo điệu “Hoa huệ”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />Xin lắng nghe, lạy Đấng chăn giữ Ít-ra-ên,</para>
  <para style="q2" vid="PSA 80:1">Đấng đã chăm sóc Giô-sép như bầy chiên.</para>
  <para style="q1" vid="PSA 80:1">Lạy Đức Chúa Trời, Đấng ngự trị trên chê-ru-bim,</para>
  <para style="q2" vid="PSA 80:1">xin tỏa sáng<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />trước mặt Ép-ra-im, Bên-gia-min, và Ma-na-se.</para>
  <para style="q2" vid="PSA 80:2">Xin bày tỏ quyền năng Ngài.</para>
  <para style="q2" vid="PSA 80:2">Xin đến cứu chúng con!<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Lạy Đức Chúa Trời, xin phục hưng dân Chúa.</para>
  <para style="q2" vid="PSA 80:3">Xin Thiên nhan chói sáng trên chúng con.</para>
  <para style="q2" vid="PSA 80:3">Chỉ khi ấy chúng con mới được cứu.<verse eid="PSA 80:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân,</para>
  <para style="q2" vid="PSA 80:4">Chúa còn giận lời cầu nguyện của chúng con đến bao giờ?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Chúa nuôi chúng con bằng than khóc</para>
  <para style="q2" vid="PSA 80:5">và khiến chúng con uống nước mắt quá nhiều lần.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Ngài khiến chúng con thành đề tài chế giễu cho các nước lân bang.</para>
  <para style="q2" vid="PSA 80:6">Quân thù cười nhạo chúng con.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Lạy Đức Chúa Trời Vạn Quân, xin phục hưng dân Chúa.</para>
  <para style="q2" vid="PSA 80:7">Xin Thiên nhan chói sáng trên chúng con.</para>
  <para style="q2" vid="PSA 80:7">Chỉ khi ấy chúng con mới được cứu.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Chúa đã mang chúng con ra từ Ai Cập như cây nho;</para>
  <para style="q2" vid="PSA 80:8">Chúa đã đuổi các dân khác đi và trồng cây nho ấy thay vào.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Chúa đào đất, khai quang rừng núi,</para>
  <para style="q2" vid="PSA 80:9">cho rễ nó đâm sâu tràn khắp đất.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Các núi cao được tàng nho che phủ;</para>
  <para style="q2" vid="PSA 80:10">và cành nho như cành bá hương của Chúa.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Cành nó vươn ra đến phía tây của biển,</para>
  <para style="q2" vid="PSA 80:11">chồi nó lan rộng tận phía đông của sông.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Nhưng bây giờ, tại sao Chúa phá vỡ tường rào,</para>
  <para style="q2" vid="PSA 80:12">đến nỗi khách qua đường hái trái tự do?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Heo rừng phá phách vườn nho</para>
  <para style="q2" vid="PSA 80:13">và thú đồng mặc sức ăn nuốt.<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Lạy Đức Chúa Trời Vạn Quân, xin quay lại.</para>
  <para style="q2" vid="PSA 80:14">Từ trời cao, xin đoái nhìn chúng con.</para>
  <para style="q2" vid="PSA 80:14">Xin lưu ý đến cây nho thảm hại<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />do chính tay Chúa đã vun trồng,</para>
  <para style="q2" vid="PSA 80:15">là đứa con Chúa nuôi dưỡng lớn khôn.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Nay đã bị kẻ thù đốn chặt, rồi thiêu đốt trong lửa.</para>
  <para style="q2" vid="PSA 80:16">Nguyện họ bị tiêu diệt khi Ngài ra mặt.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Xin đặt tay lên người bên phải Chúa,</para>
  <para style="q2" vid="PSA 80:17">là người được Chúa ban cho dũng lực.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Vậy, chúng con sẽ chẳng bao giờ rời bỏ Chúa.</para>
  <para style="q2" vid="PSA 80:18">Xin cho chúng con được sống, để chúng con kêu cầu Danh Chúa.<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, xin phục hưng dân Chúa.</para>
  <para style="q2" vid="PSA 80:19">Xin Thiên nhan chói sáng trên chúng con.</para>
  <para style="q2" vid="PSA 80:19">Chỉ khi ấy chúng con mới được cứu.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="cl">Thi Thiên 81</para>
  <para style="s1">Ơn Chúa và Lầm Lỗi của Ít-ra-ên</para>
  <para style="d">(Thơ của A-sáp, soạn cho nhạc trưởng, theo điệu Ghít-tít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Hãy ca tụng Đức Chúa Trời, sức mạnh của chúng ta.</para>
  <para style="q2" vid="PSA 81:1">Hãy lớn tiếng ngợi tôn Đức Chúa Trời của Gia-cốp.<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Hãy hát! Hãy đánh trống cơm.</para>
  <para style="q2" vid="PSA 81:2">Hãy gãy đàn lia và đàn hạc.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Hãy thổi kèn trong ngày trăng mới,</para>
  <para style="q2" vid="PSA 81:3">lúc trăng rầm, và các ngày lễ hội.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Đây là một định lễ cho Ít-ra-ên;</para>
  <para style="q2" vid="PSA 81:4">là lệnh truyền từ Đức Chúa Trời của Gia-cốp.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Một luật pháp Ngài lập với Giô-sép,</para>
  <para style="q2" vid="PSA 81:5">khi Chúa ra tay chống Ai Cập, giải cứu chúng ta.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Tôi nghe một thứ tiếng tôi không biết:<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“Ta đã cất gánh nặng khỏi vai các con;</para>
  <para style="q2" vid="PSA 81:6">Bàn tay các con khỏi mang xách nặng nề.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Trong gian truân các con kêu cầu, Ta đã giải cứu;</para>
  <para style="q2" vid="PSA 81:7">Ta đáp lời từ trong mây vang tiếng sấm</para>
  <para style="q2" vid="PSA 81:7">và Ta thử các con tại suối Mê-ri-ba.<verse eid="PSA 81:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Hỡi dân Ta, hãy lắng tai nghe lời cảnh cáo.</para>
  <para style="q2" vid="PSA 81:8">Hỡi Ít-ra-ên, nếu các con chỉ nghe lời Ta!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Giữa xứ các con, đừng có tà thần;</para>
  <para style="q2" vid="PSA 81:9">đừng quỳ lạy các thần ngoại giáo.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Vì Ta là Chúa Hằng Hữu, Đức Chúa Trời của các con,</para>
  <para style="q2" vid="PSA 81:10">Đấng đã đem các con ra khỏi Ai Cập.</para>
  <para style="q2" vid="PSA 81:10">Hãy hả miệng, Ta sẽ cho no đầy.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />Nhưng không, dân Ta không chịu nghe.</para>
  <para style="q2" vid="PSA 81:11">Ít-ra-ên chẳng thuận phục lời Ta.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Vì vậy Ta bỏ mặc họ theo lòng chai lì,</para>
  <para style="q2" vid="PSA 81:12">theo mưu ý riêng của mình.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />Ôi, ước gì dân Ta nghe tiếng Ta!</para>
  <para style="q2" vid="PSA 81:13">Và Ít-ra-ên đi theo đường lối Ta!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Ta sẽ nhanh chóng đánh bại quân thù họ!</para>
  <para style="q2" vid="PSA 81:14">Và Ta sẽ trở tay nghịch cùng kẻ địch!<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Những người ghét Chúa Hằng Hữu sẽ thuận phục Ngài;</para>
  <para style="q2" vid="PSA 81:15">họ sẽ được hưởng thời thịnh trị lâu dài.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Ta sẽ nuôi các con bằng lúa thượng hạng.</para>
  <para style="q2" vid="PSA 81:16">Và Ta sẽ cho các con no nê mật ong từ vầng đá.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="cl">Thi Thiên 82</para>
  <para style="s1">Nghiêm Trách Quan Án Bất Công</para>
  <para style="d">(Thơ của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Đức Chúa Trời chủ trì trong hội đồng của Ngài;</para>
  <para style="q2" vid="PSA 82:1">Ngài tuyên phán trên thiên đàng:<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />“Các ngươi phân xử bất công</para>
  <para style="q2" vid="PSA 82:2">và thiên vị người gian tà mãi đến bao giờ?<verse eid="PSA 82:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Hãy xử công minh cho những người cô thế và trẻ mồ côi;</para>
  <para style="q2" vid="PSA 82:3">bảo vệ quyền lợi người bị áp bức và tuyệt vọng.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Giải cứu người nghèo khổ và khốn cùng;</para>
  <para style="q2" vid="PSA 82:4">đưa họ ra khỏi tay người ác.<verse eid="PSA 82:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />Nhưng bọn áp bức không biết gì,</para>
  <para style="q2" vid="PSA 82:5">cũng chẳng hiểu gì!</para>
  <para style="q1" vid="PSA 82:5">Chúng cứ mò mẫm trong bóng tối,</para>
  <para style="q2" vid="PSA 82:5">tất cả nền móng trên đất đều rúng động.<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />Ta xác nhận: ‘Các ngươi là thần;</para>
  <para style="q2" vid="PSA 82:6">Tất cả đều là con trai của Đấng Chí Cao.’<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Nhưng các ngươi sẽ chết như người phàm,</para>
  <para style="q2" vid="PSA 82:7">và ngã xuống như những người cầm quyền khác.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Lạy Đức Chúa Trời, xin vùng dậy xét xử thế gian,</para>
  <para style="q2" vid="PSA 82:8">vì tất cả các dân tộc đều thuộc về Chúa.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="cl">Thi Thiên 83</para>
  <para style="s1">Xin Chúa Khiến Quân Thù Hổ Thẹn</para>
  <para style="d">(Thơ của A-sáp)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Lạy Đức Chúa Trời, xin đừng nín lặng!</para>
  <para style="q2" vid="PSA 83:1">Xin đừng điềm nhiên!</para>
  <para style="q2" vid="PSA 83:1">Xin đừng bất động, ôi Đức Chúa Trời.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Chẳng lẽ Ngài không nghe tiếng quân thù nổi loạn?</para>
  <para style="q2" vid="PSA 83:2">Lẽ nào Ngài không thấy những dân ghét Chúa đang vùng lên sao?<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Họ âm mưu lập kế diệt dân Ngài;</para>
  <para style="q2" vid="PSA 83:3">họ đặt chương trình chống người được Ngài bảo vệ.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Họ nói: “Hãy đến tiêu diệt nước này,</para>
  <para style="q2" vid="PSA 83:4">để tên Ít-ra-ên không còn ai nhớ đến nữa.”<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Họ đồng thanh chấp thuận kế hoạch.</para>
  <para style="q2" vid="PSA 83:5">Kết liên minh quân sự chống Ngài—<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />dân tộc Ê-đôm và các sắc dân Ích-ma-ên;</para>
  <para style="q2" vid="PSA 83:6">dân tộc Mô-áp và dân tộc Ha-ga-rít;<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />người Ghê-banh, Am-môn, và A-ma-léc;</para>
  <para style="q2" vid="PSA 83:7">những người từ Phi-li-tin và Ty-rơ.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />A-sy-ri cũng gia nhập liên minh,</para>
  <para style="q2" vid="PSA 83:8">để trợ lực con cháu của Lót.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Xin Chúa phạt họ như dân tộc Ma-đi-an,</para>
  <para style="q2" vid="PSA 83:9">Si-sê-ra, và Gia-bin bên Sông Ki-sôn.<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Là đoàn quân bị tiêu diệt tại Ên-đô-rơ,</para>
  <para style="q2" vid="PSA 83:10">và trở thành như phân trên đất.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Xin đối xử với các quý tộc của họ như Ô-rép và Xê-ép.</para>
  <para style="q2" vid="PSA 83:11">Xin cho vua quan họ chết như Xê-ba và Xanh-mu-na,<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />vì họ nói: “Chúng ta hãy chiếm đất cỏ xanh của Đức Chúa Trời</para>
  <para style="q2" vid="PSA 83:12">làm tài sản của chúng ta.”<verse eid="PSA 83:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Lạy Đức Chúa Trời, xin làm họ như cỏ rác,</para>
  <para style="q2" vid="PSA 83:13">như trấu bị gió cuốn tung bay!<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Như lửa đốt trụi rừng</para>
  <para style="q2" vid="PSA 83:14">và đốt cháy núi thể nào,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />thì xin phóng bão tố đánh đuổi họ,</para>
  <para style="q2" vid="PSA 83:15">cho giông tố làm họ kinh hoàng thể ấy.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Xin Chúa cho mặt họ bị sỉ nhục,</para>
  <para style="q2" vid="PSA 83:16">cho đến khi họ biết tìm đến Danh Chúa.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Nguyện họ bị hổ thẹn và kinh hoàng mãi mãi.</para>
  <para style="q2" vid="PSA 83:17">Xin cho họ chết giữa cảnh nhục nhằn.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Xin cho họ học biết chỉ có Ngài là Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 83:18">chỉ có Ngài là Đấng Tối Cao,</para>
  <para style="q2" vid="PSA 83:18">cai trị trên khắp đất.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="cl">Thi Thiên 84</para>
  <para style="s1">Hy Vọng Được Thờ Phượng trong Đền Thờ</para>
  <para style="d">(Thơ của gia đình Cô-ra, soạn cho nhạc trưởng, theo điệu Git-tít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Lạy Chúa Hằng Hữu Vạn Quân,</para>
  <para style="q2" vid="PSA 84:1">nơi Chúa ngự đáng yêu biết bao.<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Linh hồn con mong ước héo hon</para>
  <para style="q2" vid="PSA 84:2">được vào các hành lang của Chúa Hằng Hữu.</para>
  <para style="q1" vid="PSA 84:2">Với cả tâm hồn con lẫn thể xác,</para>
  <para style="q2" vid="PSA 84:2">con sẽ cất tiếng ngợi tôn Đức Chúa Trời Hằng Sống.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Lạy Chúa Hằng Hữu Vạn Quân, Vua và Đức Chúa Trời của con!</para>
  <para style="q2" vid="PSA 84:3">Ngay cả chim sẻ còn được chỗ ấm,</para>
  <para style="q1" vid="PSA 84:3">chim yến kiếm được nơi làm tổ và đẻ trứng, nuôi con,</para>
  <para style="q2" vid="PSA 84:3">tại một nơi gần bàn thờ của Chúa.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Phước hạnh thay cho ai được ở trong nhà Chúa,</para>
  <para style="q2" vid="PSA 84:4">họ sẽ luôn ca ngợi Ngài mãi mãi.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Phước cho ai có sức mạnh từ nơi Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 84:5">và tâm trí luôn nghĩ đến hành trình về Giê-ru-sa-lem.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Khi đi qua Thung Lũng Khóc Lóc,</para>
  <para style="q2" vid="PSA 84:6">họ biến nó thành những dòng suối mát.</para>
  <para style="q2" vid="PSA 84:6">Mưa thu cũng phủ phước cho nó.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Họ càng đi sức lực càng gia tăng,</para>
  <para style="q2" vid="PSA 84:7">cho đến khi mọi người đều ra mắt Đức Chúa Trời tại Si-ôn.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, xin rủ nghe lời con cầu nguyện.</para>
  <para style="q2" vid="PSA 84:8">Xin lắng nghe, ôi Đức Chúa Trời của Gia-cốp.<verse eid="PSA 84:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Lạy Đức Chúa Trời, là tấm khiên che chở.</para>
  <para style="q2" vid="PSA 84:9">Xin cúi nhìn gương mặt người Chúa xức dầu.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Một ngày trong sân hành lang Chúa,</para>
  <para style="q2" vid="PSA 84:10">quý hơn nghìn ngày ở nơi khác!</para>
  <para style="q1" vid="PSA 84:10">Con thà làm người gác cửa cho nhà Đức Chúa Trời con,</para>
  <para style="q2" vid="PSA 84:10">còn hơn sống sung túc trong nhà của người gian ác.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Vì Chúa Hằng Hữu, Đức Chúa Trời là mặt trời và khiên thuẫn.</para>
  <para style="q2" vid="PSA 84:11">Ngài ban ân huệ và vinh quang.</para>
  <para style="q1" vid="PSA 84:11">Chúa Hằng Hữu không tiếc điều tốt lành</para>
  <para style="q2" vid="PSA 84:11">cho những ai làm điều công chính.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Lạy Chúa Hằng Hữu Vạn Quân,</para>
  <para style="q2" vid="PSA 84:12">ai nương cậy Chúa đều được phước lành.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="cl">Thi Thiên 85</para>
  <para style="s1">Cầu Xin Phước Lành cho Dân</para>
  <para style="d">(Thơ của con cháu Cô-ra, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Lạy Chúa Hằng Hữu, Chúa đã đổ phước lành cho đất nước!</para>
  <para style="q2" vid="PSA 85:1">Ngài cho người lưu đày của Gia-cốp được hồi hương.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Chúa tha thứ tội ác của dân Ngài—</para>
  <para style="q2" vid="PSA 85:2">và xóa bỏ lỗi lầm của họ.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Chúa đã rút lại cơn giận.</para>
  <para style="q2" vid="PSA 85:3">Thịnh nộ Ngài cũng đã nguôi ngoai.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Lạy Đức Chúa Trời, Đấng giải cứu chúng con, xin phục hưng chúng con.</para>
  <para style="q2" vid="PSA 85:4">Xin xóa bỏ các bất mãn đối với chúng con.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Lẽ nào Chúa giận chúng con mãi?</para>
  <para style="q2" vid="PSA 85:5">Hay thịnh nộ Chúa kéo dài từ thế hệ này sang thế hệ khác sao?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Chẳng lẽ Chúa không muốn chúng con phục hưng,</para>
  <para style="q2" vid="PSA 85:6">để dân thánh vui mừng trong Chúa?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Lạy Chúa Hằng Hữu, xin tỏ lòng thương xót không dời đổi,</para>
  <para style="q2" vid="PSA 85:7">xin ra tay cứu chuộc chúng con.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Con lắng lòng nghe Đức Chúa Trời, Chúa Hằng Hữu phán,</para>
  <para style="q2" vid="PSA 85:8">vì Chúa phán bình an với những người trung tín của Ngài.</para>
  <para style="q2" vid="PSA 85:8">Nhưng xin đừng để họ quay về lối ngu dại.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Sự cứu rỗi của Chúa chắc chăn ở gần những ai kính sợ Ngài,</para>
  <para style="q2" vid="PSA 85:9">cho đất nước này được tràn đầy vinh quang Chúa.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Thương yêu và thành tín gặp nhau.</para>
  <para style="q2" vid="PSA 85:10">Công chính và bình an đã hôn nhau!<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Chân lý mọc lên từ đất,</para>
  <para style="q2" vid="PSA 85:11">và công chính từ thiên đàng nhìn xuống.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Vâng, Chúa Hằng Hữu sẽ đổ phước lành.</para>
  <para style="q2" vid="PSA 85:12">Đất nước chúng ta sẽ gặt hái nhiều mùa lúa.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Công chính đi trước Chúa,</para>
  <para style="q2" vid="PSA 85:13">sửa soạn đường cho các bước chân của Ngài.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="cl">Thi Thiên 86</para>
  <para style="s1">Lời Cầu Nguyện của Kẻ Khốn Cùng</para>
  <para style="d">(Bài cầu nguyện của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Lạy Chúa Hằng Hữu, xin nghiêng tai nghe lời con cầu nguyện;</para>
  <para style="q2" vid="PSA 86:1">xin cứu giúp con giữa cảnh cùng khốn.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Xin bảo vệ mạng sống con, vì con được biệt riêng cho Chúa.</para>
  <para style="q2" vid="PSA 86:2">Xin Chúa giải cứu con, vì con phục vụ và tin cậy nơi Ngài.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Lạy Chúa Hằng Hữu, xin thương xót con,</para>
  <para style="q2" vid="PSA 86:3">vì suốt ngày, con kêu cầu Chúa.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Xin cho lòng con vui vẻ, lạy Chúa,</para>
  <para style="q2" vid="PSA 86:4">vì tâm hồn con vươn lên Chúa.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Lạy Chúa, Ngài là thiện hảo và sẵn sàng tha thứ,</para>
  <para style="q2" vid="PSA 86:5">chan hòa nhân ái cho người cầu xin.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Xin lắng tai, nghe con cầu nguyện, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 86:6">xin lưu ý nghe tiếng con khẩn nài.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Trong ngày gian khổ, con kêu cầu</para>
  <para style="q2" vid="PSA 86:7">và Chúa chắc chắn sẽ trả lời.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Lạy Chúa, không có thần nào giống Chúa.</para>
  <para style="q2" vid="PSA 86:8">Chẳng ai làm nổi công việc Ngài.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />Tất cả dân tộc Chúa tạo dựng</para>
  <para style="q2" vid="PSA 86:9">sẽ đến quỳ lạy trước mặt Chúa;</para>
  <para style="q2" vid="PSA 86:9">và ca tụng tôn vinh Danh Ngài.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Vì Chúa vĩ đại và làm những việc kỳ diệu.</para>
  <para style="q2" vid="PSA 86:10">Chỉ có Chúa là Đức Chúa Trời.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Lạy Chúa Hằng Hữu, xin dạy con đường lối Chúa,</para>
  <para style="q2" vid="PSA 86:11">để con đi theo chân lý của Ngài!</para>
  <para style="q1" vid="PSA 86:11">Xin cho con tấm lòng trong sạch,</para>
  <para style="q2" vid="PSA 86:11">để con một lòng tôn kính Ngài.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Lạy Chúa, Đức Chúa Trời con, con hết lòng cảm tạ Chúa.</para>
  <para style="q2" vid="PSA 86:12">Con xin tôn vinh Danh Ngài mãi mãi<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />vì lòng nhân ái Chúa dành cho quá lớn.</para>
  <para style="q2" vid="PSA 86:13">Chúa đã cứu linh hồn con khỏi vực thẳm âm ty.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Lạy Đức Chúa Trời, bọn kiêu ngạo nổi lên;</para>
  <para style="q2" vid="PSA 86:14">bọn hung bạo tìm kế giết con.</para>
  <para style="q2" vid="PSA 86:14">Họ chẳng cần đếm xỉa đến Chúa.<note caller="+" style="f"><char style="fr" closed="false">86:14 </char><char style="ft" closed="false">Nt chẳng để Chúa trước mặt họ</char></note><verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Nhưng Ngài là Chúa,</para>
  <para style="q2" vid="PSA 86:15">là Đức Chúa Trời đầy lòng thương xót và làm ơn,</para>
  <para style="q1" vid="PSA 86:15">chậm nóng giận,</para>
  <para style="q2" vid="PSA 86:15">đầy lòng yêu thương và thành tín.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Xin nhìn xuống và thương xót con.</para>
  <para style="q2" vid="PSA 86:16">Ban sức mạnh cho đầy tớ Chúa;</para>
  <para style="q2" vid="PSA 86:16">cứu giúp đứa con của tớ gái Ngài.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Xin cho con dấu hiệu phước lành.</para>
  <para style="q2" vid="PSA 86:17">Để những ai ghét con sẽ hổ thẹn,</para>
  <para style="q2" vid="PSA 86:17">vì Ngài, ôi Chúa Hằng Hữu, đã giúp đỡ và an ủi con.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="cl">Thi Thiên 87</para>
  <para style="s1">Đặc Ân của Cư Dân Si-ôn</para>
  <para style="d">(Thơ của con cháu Cô-ra)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Chúa Hằng Hữu xây nền móng Ngài</para>
  <para style="q2" vid="PSA 87:1">trên núi thánh.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />Chúa mến chuộng thành Si-ôn,</para>
  <para style="q2" vid="PSA 87:2">hơn bất cứ thành nào của Gia-cốp.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Ôi thành trì của Đức Chúa Trời</para>
  <para style="q2" vid="PSA 87:3">vinh quang thành Chúa được đề cao!<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />Ta sẽ nói đến Ra-háp và Ba-by-lôn là những nơi biết Ta—</para>
  <para style="q2" vid="PSA 87:4">Phi-li-tin, Ty-rơ, và ngay cả Ê-thi-ô-pi xa xôi.</para>
  <para style="q2" vid="PSA 87:4">Tất cả họ sẽ trở nên công dân của Giê-ru-sa-lem!<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Phải người ta sẽ nói về Si-ôn rằng:</para>
  <para style="q2" vid="PSA 87:5">“Người này người nọ sinh tại đó.”</para>
  <para style="q2" vid="PSA 87:5">Và Đấng Chí Cao sẽ ban phước cho thành này.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Khi Chúa Hằng Hữu kiểm kê dân số, sẽ ghi rõ:</para>
  <para style="q2" vid="PSA 87:6">“Tất cả họ là công dân của Giê-ru-sa-lem.”<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Người ta sẽ thổi sáo và hát mừng:</para>
  <para style="q2" vid="PSA 87:7">“Các nguồn cảm hứng của ta xuất phát từ Giê-ru-sa-lem!”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="cl">Thi Thiên 88</para>
  <para style="s1">Cầu Xin Được Thoát Chết</para>
  <para style="d">(Thơ của con cháu Cô-ra. Giáo huấn ca của Hê-man ở Ê-than, soạn cho nhạc trưởng, theo điệu “Đau thương”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />Lạy Chúa Hằng Hữu, Đức Chúa Trời của sự cứu rỗi con,</para>
  <para style="q2" vid="PSA 88:1">con kêu cầu Chúa<note caller="+" style="f"><char style="fr" closed="false">88:1 </char><char style="ft" closed="false">Nt kêu cầu trước mặt Chúa</char></note> suốt ngày.</para>
  <para style="q2" vid="PSA 88:1">Con đến với Chúa suốt đêm.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Xin nghe lời con cầu nguyện,</para>
  <para style="q2" vid="PSA 88:2">xin lắng nghe tiếng con kêu khóc.<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Vì linh hồn con tràn đầy khổ đau,</para>
  <para style="q2" vid="PSA 88:3">và mạng sống con gần kề âm phủ.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Con bị xem như người thiệt mạng,<note caller="+" style="f"><char style="fr" closed="false">88:4 </char><char style="ft" closed="false">Nt người xuống vực sâu</char></note></para>
  <para style="q2" vid="PSA 88:4">như một người sức cùng lực tận.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Họ để con giữa những người chết,</para>
  <para style="q2" vid="PSA 88:5">và con nằm như xác chết trong mồ mả.</para>
  <para style="q1" vid="PSA 88:5">Con bị lãng quên,</para>
  <para style="q2" vid="PSA 88:5">bị dứt khỏi sự chăm sóc của Ngài.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Chúa đã đặt con vào đáy mộ,</para>
  <para style="q2" vid="PSA 88:6">trong vùng sâu tăm tối tử vong.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Cơn thịnh nộ Chúa đè ép con;</para>
  <para style="q2" vid="PSA 88:7">các lượn sóng Ngài phủ con ngập lút.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Chúa khiến bạn bè con xa lánh,</para>
  <para style="q2" vid="PSA 88:8">ghê tởm con như thấy người bị phong hủi.<note caller="+" style="f"><char style="fr" closed="false">88:8 </char><char style="ft" closed="false">Nt một vật đáng ghê sợ</char></note></para>
  <para style="q2" vid="PSA 88:8">Con bị vây khốn, không lối thoát.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Mắt con mờ đi vì khổ nạn.</para>
  <para style="q2" vid="PSA 88:9">Chúa Hằng Hữu ơi, con kêu cầu Chúa mỗi ngày.</para>
  <para style="q2" vid="PSA 88:9">Tay con đưa lên hướng về Chúa.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Chúa có làm phép mầu cho người chết sao?</para>
  <para style="q2" vid="PSA 88:10">Người chết có vùng dậy ca ngợi Chúa ư?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Ai truyền bá nhân ái Chúa dưới mộ?</para>
  <para style="q2" vid="PSA 88:11">Âm phủ<note caller="+" style="f"><char style="fr" closed="false">88:11 </char><char style="ft" closed="false">Nt A-ba-đôn (chỗ tra tấn và hủy diệt)</char></note> có nghe nói đến lòng thành tín Chúa chăng?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Cõi u minh sao biết việc diệu kỳ?</para>
  <para style="q2" vid="PSA 88:12">Ai còn nhắc đức công chính Ngài trong đất quên lãng?<verse eid="PSA 88:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Lạy Chúa Hằng Hữu, con kêu xin Ngài.</para>
  <para style="q2" vid="PSA 88:13">Từ sáng sớm, tiếng nguyện cầu thấu đến Chúa.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Chúa Hằng Hữu ơi, sao Ngài từ bỏ con?</para>
  <para style="q2" vid="PSA 88:14">Sao Chúa giấu mặt không cho con thấy?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Từ tuổi thanh xuân, con đã bị hoạn nạn hiểm nghèo.</para>
  <para style="q2" vid="PSA 88:15">Chúa làm con kinh hãi nên con đành tuyệt vọng.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Thịnh nộ Chúa như sóng cồn vùi dập,</para>
  <para style="q2" vid="PSA 88:16">Nổi kinh hoàng của Chúa tiêu diệt con.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Chúng nó bao phủ con hằng ngày.</para>
  <para style="q2" vid="PSA 88:17">Chúng nó vây bọc con hàng hàng, lớp lớp.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Chúa khiến người yêu và bạn hữu tránh né con.</para>
  <para style="q2" vid="PSA 88:18">Con chỉ còn làm bạn với bóng tối.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="cl">Thi Thiên 89</para>
  <para style="s1">Giao Ước của Chúa với Đa-vít</para>
  <para style="d">(Giáo huấn ca của Ê-than, người Ếch-ra-hít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Con sẽ luôn ca ngợi tình thương của Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 89:1">Từ đời này sang đời kia con sẽ truyền rao đức thành tín của Ngài.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Con sẽ công bố tình thương muôn đời.</para>
  <para style="q2" vid="PSA 89:2">Và đức thành tín vững bền của Chúa.<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Chúa Hằng Hữu phán: “Ta đã lập giao ước với Đa-vít,</para>
  <para style="q2" vid="PSA 89:3">đầy tớ Ta đã chọn.</para>
  <para style="q2" vid="PSA 89:3">Ta đã lập lời thề này với người rằng:<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />‘Ta sẽ thiết lập dòng dõi con trên ngôi vua mãi mãi;</para>
  <para style="q2" vid="PSA 89:4">và khiến ngôi nước con vững bền qua mọi thế hệ.’”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Các tầng trời hát mừng những việc Chúa làm, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 89:5">hàng nghìn thiên sứ sẽ ngợi tôn sự thành tín Chúa.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Vì có ai trên các tầng trời có thể sánh với Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 89:6">Trong vòng các thiên sứ có ai giống như Chúa Hằng Hữu?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Đức Chúa Trời đáng được tôn kính trong hội các thánh.</para>
  <para style="q2" vid="PSA 89:7">Họ đứng quanh ngai Ngài chiêm ngưỡng và khâm phục.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân!</para>
  <para style="q2" vid="PSA 89:8">Ai có dũng lực giống như Ngài, ôi Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 89:8">Ngài bọc mình trong đức thành tín.<verse eid="PSA 89:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Chúa khiến mặt biển cuồng loạn lặng yên.</para>
  <para style="q2" vid="PSA 89:9">Ngài dẹp yên sóng gió phũ phàng.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Chúa chà nát Ra-háp như cái thây.</para>
  <para style="q2" vid="PSA 89:10">Đưa tay dũng mãnh tung quân thù tán loạn.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Các tầng trời và đất thuộc quyền của Chúa;</para>
  <para style="q2" vid="PSA 89:11">mọi vật trong thế gian là của Ngài—Chúa tạo dựng vũ trụ muôn loài.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Phương bắc, phương nam đều do Chúa tạo ra.</para>
  <para style="q2" vid="PSA 89:12">Núi Tha-bô và Núi Hẹt-môn hoan ca Danh Ngài.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Cánh tay Chúa vô cùng mạnh mẽ!</para>
  <para style="q2" vid="PSA 89:13">Bàn tay<note caller="+" style="f"><char style="fr" closed="false">89:13 </char><char style="ft" closed="false">Nt bàn tay mặt</char></note> hùng dũng Chúa đưa cao,<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Công chính và công lý là nền móng của ngôi Chúa</para>
  <para style="q2" vid="PSA 89:14">Nhân ái và chân thật đi trước mặt Ngài.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Phước cho người biết vui vẻ reo hò,</para>
  <para style="q2" vid="PSA 89:15">vì họ sẽ đi trong ánh sáng của Thiên nhan, lạy Chúa Hằng Hữu.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Suốt ngày, hân hoan trong Danh Chúa.</para>
  <para style="q2" vid="PSA 89:16">Được đề cao trong đức công chính Ngài.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Vì Chúa là vinh quang và sức mạnh của họ,</para>
  <para style="q2" vid="PSA 89:17">Nhờ ơn Chúa, uy lực<note caller="+" style="f"><char style="fr" closed="false">89:17 </char><char style="ft" closed="false">Nt sừng </char></note> họ vươn cao.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Thuẫn khiên chúng con thuộc về Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 89:18">và Ngài, Đấng Thánh của Ít-ra-ên là Vua chúng con.<verse eid="PSA 89:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Từ xưa, Chúa dạy người thành tín của Chúa qua khải tượng.</para>
  <para style="q2" vid="PSA 89:19">Ngài phán: “Ta đã dấy lên một người uy dũng.</para>
  <para style="q2" vid="PSA 89:19">Tôn cao người được Ta chọn làm vua giữa dân chúng.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Ta đã tìm thấy Đa-vít, đầy tớ Ta.</para>
  <para style="q2" vid="PSA 89:20">Ta đã lấy dầu thánh xức cho người.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Bàn tay Ta đặt trên người mãi mãi;</para>
  <para style="q2" vid="PSA 89:21">cánh tay Ta tăng cường sức mạnh người.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Quân thù sẽ không áp đảo,</para>
  <para style="q2" vid="PSA 89:22">hay bọn gian ác sẽ không làm nhục người.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Trước mặt người, Ta chà nát quân thù,</para>
  <para style="q2" vid="PSA 89:23">những ai ghét người, Ta đánh hạ.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Người hưởng trọn nhân ái và thành tín Ta mãi mãi,</para>
  <para style="q2" vid="PSA 89:24">trong Danh Ta, uy lực người vươn cao.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Ta cho tay người cai trị biển cả,</para>
  <para style="q2" vid="PSA 89:25">tay hữu người thống lãnh các dòng sông.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Người sẽ gọi Ta rằng: ‘Chúa là Cha con,</para>
  <para style="q2" vid="PSA 89:26">là Đức Chúa Trời con, và Vầng Đá cứu rỗi con.’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Ta sẽ lập người làm trưởng tử,<note caller="+" style="f"><char style="fr" closed="false">89:27 </char><char style="ft" closed="false">Nt con đầu lòng</char></note></para>
  <para style="q2" vid="PSA 89:27">làm vua tối cao giữa các vua trên đất.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Ta mãi mãi giữ lòng nhân ái với người;</para>
  <para style="q2" vid="PSA 89:28">giao ước Ta với người không bao giờ thay đổi.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Dòng dõi người sẽ được vững lập đời đời;</para>
  <para style="q2" vid="PSA 89:29">ngôi người còn mãi như tuổi các tầng trời.<verse eid="PSA 89:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />Nếu con cháu người quên lãng điều răn Ta,</para>
  <para style="q2" vid="PSA 89:30">và không thực thi điều lệ Ta,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />nếu họ vi phạm các sắc lệnh Ta,</para>
  <para style="q2" vid="PSA 89:31">không giữ các mệnh lệnh Ta,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />khi ấy Ta sẽ trừng phạt tội ác họ,</para>
  <para style="q2" vid="PSA 89:32">bằng cây gậy và cây roi.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Nhưng Ta vẫn thương xót người,</para>
  <para style="q2" vid="PSA 89:33">Ta vẫn luôn luôn giữ lòng thành tín.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Ta không bao giờ bội ước;</para>
  <para style="q2" vid="PSA 89:34">hoặc sửa đổi lời Ta hứa hẹn.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Ta đã thề với Đa-vít một lần dứt khoát,</para>
  <para style="q2" vid="PSA 89:35">và chẳng bao giờ lừa dối người.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Dòng dõi người còn đến đời đời;</para>
  <para style="q2" vid="PSA 89:36">ngôi người tồn tại như mặt trời.<note caller="+" style="f"><char style="fr" closed="false">89:36 </char><char style="ft" closed="false">Nt mặt trời trước mặt Ta</char></note><verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Như mặt trăng, xoay vần vĩnh viễn,</para>
  <para style="q2" vid="PSA 89:37">kiên lập mãi mãi như các tầng trời!”<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Nhưng Chúa lại khước từ, loại bỏ.</para>
  <para style="q2" vid="PSA 89:38">Nổi giận cùng người Chúa đã tấn phong.<note caller="+" style="f"><char style="fr" closed="false">89:38 </char><char style="ft" closed="false">Nt xức dầu</char></note><verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Phế bỏ giao ước Ngài lập với người;</para>
  <para style="q2" vid="PSA 89:39">dày xéo vương miện người dưới chân.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Chúa lật đổ các hàng rào che chở</para>
  <para style="q2" vid="PSA 89:40">và tiêu diệt các chiến lũy người xây cất.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Người qua đường tranh nhau cướp giật,</para>
  <para style="q2" vid="PSA 89:41">các lân bang sỉ nhục, chê cười.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Chúa gia tăng sức mạnh của kẻ thù người,</para>
  <para style="q2" vid="PSA 89:42">cho quân thù vui mừng hớn hở.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Chúa khiến gươm người bị đánh bật,</para>
  <para style="q2" vid="PSA 89:43">bỏ rơi người giữa chiến trận kinh hoàng.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Chúa cất quyền trượng khỏi tay người,</para>
  <para style="q2" vid="PSA 89:44">lật đổ ngai vàng xuống đất đen.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Chúa rút ngắn cuộc đời của người,</para>
  <para style="q2" vid="PSA 89:45">đắp lên thân người tấm chăn ô nhục.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Lạy Chúa Hằng Hữu, việc này xảy ra bao lâu nữa?</para>
  <para style="q2" vid="PSA 89:46">Ngài vẫn ẩn mặt mãi sao?</para>
  <para style="q2" vid="PSA 89:46">Cơn thịnh nộ Ngài còn cháy đến bao giờ?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Lạy Chúa, xin đừng quên đời con quá ngắn,</para>
  <para style="q2" vid="PSA 89:47">con người sinh vào cõi hư không!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Không ai có thể sống mãi; tất cả sẽ chết.</para>
  <para style="q2" vid="PSA 89:48">Không ai có thể thoát được quyền uy của nấm mồ.<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Lạy Chúa, lòng nhân ái Ngài ở đâu?</para>
  <para style="q2" vid="PSA 89:49">Là sự thành tín mà Ngài hứa cùng Đa-vít ngày xưa.<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Lạy Chúa, xin đừng quên đầy tớ Ngài chịu nhục!</para>
  <para style="q2" vid="PSA 89:50">Lòng con mang lời nguyền rủa của các dân.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Lạy Chúa Hằng Hữu, sỉ nhục ấy do quân thù đem lại;</para>
  <para style="q2" vid="PSA 89:51">để nhục mạ người Chúa xức dầu.<note caller="+" style="f"><char style="fr" closed="false">89:51 </char><char style="ft" closed="false">Nt để sỉ nhục các bước đi của người chịu xức dầu của Chúa </char></note><verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Ngợi tôn Chúa Hằng Hữu đời đời!</para>
  <para style="q2" vid="PSA 89:52">A-men! A-men!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms1">Quyển Thứ Tư</para>
  <para style="mr">(<ref loc="PSA 90-106">Thi Thiên 90–106</ref>)</para>
  <para style="cl">Thi Thiên 90</para>
  <para style="s1">Đời Người Phù Du Trước Mặt Chúa Hằng Hữu</para>
  <para style="d">(Bài cầu nguyện của Môi-se, người của Đức Chúa Trời)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Lạy Chúa, từ thế hệ này sang thế hệ khác,</para>
  <para style="q2" vid="PSA 90:1">Chúa là nơi chúng con cư trú!<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Trước khi núi non chưa sinh ra,</para>
  <para style="q2" vid="PSA 90:2">khi trái đất và thế gian chưa xuất hiện,<note caller="+" style="f"><char style="fr" closed="false">90:2 </char><char style="ft" closed="false">Nt được Ngài sáng tạo</char></note></para>
  <para style="q2" vid="PSA 90:2">từ đời đời cho đến đời đời, Ngài là Đức Chúa Trời.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Chúa khiến con người trở về cát bụi, và Ngài truyền:</para>
  <para style="q2" vid="PSA 90:3">“Con cái loài người hãy trở về bụi đất!”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Vì một nghìn năm đối với Chúa như một ngày vừa đi qua,</para>
  <para style="q2" vid="PSA 90:4">như hay một canh đêm ngắn ngủi.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Chúa đưa loài người trôi vào giấc ngủ tử vong.</para>
  <para style="q2" vid="PSA 90:5">Đời người như cỏ mới mọc ban mai.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Dù sáng nở hoa và tốt tươi,</para>
  <para style="q2" vid="PSA 90:6">chiều đã khô héo và tàn úa.<verse eid="PSA 90:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Chúng con tiêu hao vì cơn giận của Chúa;</para>
  <para style="q2" vid="PSA 90:7">cơn giận của Chúa làm chúng con kinh hoàng.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Chúa vạch trần tội ác chúng con ra trước mặt Chúa—</para>
  <para style="q2" vid="PSA 90:8">phơi bày tội thầm kín—ra ánh sáng của Thiên nhan.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Ngày chúng con trôi qua theo dòng thịnh nộ,</para>
  <para style="q2" vid="PSA 90:9">năm tháng tiêu tan như hơi thở.<verse eid="PSA 90:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Tuổi tác chúng con may mắn thì được bảy mươi!</para>
  <para style="q2" vid="PSA 90:10">Mạnh khỏe lắm thì tám mươi.</para>
  <para style="q1" vid="PSA 90:10">Nhưng ngay trong những năm hanh thông nhất cũng đầy những khó khăn và đau buồn;</para>
  <para style="q2" vid="PSA 90:10">vì ngày tháng qua nhanh, rồi chúng con bay mất đi.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Ai biết được cơn giận Chúa mạnh đến đâu?</para>
  <para style="q2" vid="PSA 90:11">Vì thịnh nộ của Chúa lớn như nỗi sợ hãi do Chúa tạo nên.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Xin Chúa dạy chúng con biết đếm các ngày chúng con,</para>
  <para style="q2" vid="PSA 90:12">để chúng con có được lòng khôn ngoan.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Lạy Chúa Hằng Hữu, xin vui lòng trở lại!</para>
  <para style="q2" vid="PSA 90:13">Ngài còn chậm trễ đến bao giờ?</para>
  <para style="q2" vid="PSA 90:13">Xin rủ lòng xót thương các đầy tớ của Chúa!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Vừa sáng, xin cho chúng con thỏa nguyện với lòng nhân từ Chúa,</para>
  <para style="q2" vid="PSA 90:14">để cuộc đời còn lại của chúng con mãi hoan ca.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Xin Chúa cho chúng con hưởng được số ngày vui mừng!</para>
  <para style="q2" vid="PSA 90:15">Bằng với số năm mà chúng con đã gặp khốn đốn.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Nguyện công việc Chúa được giãi bày cho các đầy tớ Chúa;</para>
  <para style="q2" vid="PSA 90:16">và con cháu họ được chiêm ngưỡng vinh quang Chúa.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Nguyện ân sủng Chúa, Đức Chúa Trời chúng con, đổ trên chúng con,</para>
  <para style="q2" vid="PSA 90:17">và cho việc của tay chúng con được vững bền.</para>
  <para style="q2" vid="PSA 90:17">Phải, xin cho việc của tay chúng con được vững bền!<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="cl">Thi Thiên 91</para>
  <para style="s1">Ai Trông Cậy Chúa Được Bình An Vô Sự</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Ai trú ẩn nơi bí mật của Đấng Chí Cao</para>
  <para style="q2" vid="PSA 91:1">sẽ được an nghỉ dưới bóng của Đấng Toàn Năng.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Đây là điều con công bố về Chúa Hằng Hữu:</para>
  <para style="q2" vid="PSA 91:2">Chỉ mình Chúa là nơi trú ẩn và chiến lũy của con,</para>
  <para style="q2" vid="PSA 91:2">Ngài là Đức Chúa Trời của con, con tin cậy Ngài.<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Vì Chúa sẽ giải thoát ngươi khỏi cạm bẫy</para>
  <para style="q2" vid="PSA 91:3">và bảo vệ ngươi khỏi dịch bệnh độc hại.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Chúa phủ lông cánh Ngài che cho ngươi.</para>
  <para style="q2" vid="PSA 91:4">Và dưới cánh Ngài là chỗ ngươi nương náu.</para>
  <para style="q2" vid="PSA 91:4">Đức thành tín Ngài làm thuẫn mộc đỡ che ngươi.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Ngươi sẽ không sợ sự khủng khiếp ban đêm,</para>
  <para style="q2" vid="PSA 91:5">cũng không lo mũi tên bay ban ngày.<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Hoặc khiếp sợ bệnh dịch lây lan trong bóng tối,</para>
  <para style="q2" vid="PSA 91:6">hay tàn phá hủy diệt giữa ban trưa.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Hàng nghìn người sẽ ngã gục bên ngươi,</para>
  <para style="q2" vid="PSA 91:7">và vạn người nằm xuống ngay bên hữu ngươi,</para>
  <para style="q2" vid="PSA 91:7">nhưng tai họa sẽ chẳng đến gần ngươi.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Ngươi chỉ cần quan sát,</para>
  <para style="q2" vid="PSA 91:8">và sẽ thấy tận mắt cảnh trừng phạt người gian ác.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Nếu ngươi đã nhờ Chúa Hằng Hữu làm nơi ẩn trú,</para>
  <para style="q2" vid="PSA 91:9">và Đấng Chí Cao làm nơi ở,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />thì tai họa chẳng đến với ngươi,</para>
  <para style="q2" vid="PSA 91:10">không có việc tàn hại nào đến gần nhà ngươi.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Vì Chúa sẽ truyền lệnh cho các thiên sứ</para>
  <para style="q2" vid="PSA 91:11">bảo vệ ngươi trên mọi nẻo đường.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Thiên sứ sẽ nâng ngươi trên bàn tay,</para>
  <para style="q2" vid="PSA 91:12">giữ chân ngươi khỏi vấp vào đá.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Ngươi sẽ đạp chân lên sư tử và rắn hổ;</para>
  <para style="q2" vid="PSA 91:13">sư tử tơ và rắn độc sẽ bị chân ngươi giày xéo.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />Chúa Hằng Hữu phán: “Ta sẽ giải cứu những ai yêu kính Ta</para>
  <para style="q2" vid="PSA 91:14">Ta sẽ bảo vệ những ai tôn trọng Danh Ta.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Khi họ kêu cầu Ta, Ta sẽ đáp lời;</para>
  <para style="q2" vid="PSA 91:15">trong cơn hoạn nạn, Ta sẽ ở cùng họ,</para>
  <para style="q2" vid="PSA 91:15">Ta sẽ giải cứu và cho họ được vinh dự.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Ta sẽ cho người mãn nguyện sống lâu,</para>
  <para style="q2" vid="PSA 91:16">và cho thấy ơn cứu độ của Ta.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Thi Thiên. Bài Ca Dùng trong Ngày Sa-bát</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Còn gì hơn cảm tạ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 92:1">có chi bằng ca ngợi Đấng Chí Cao.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Công bố lòng nhân ái Ngài khi trời vừa sáng,</para>
  <para style="q2" vid="PSA 92:2">rao truyền đức thành tín Chúa lúc đêm vừa buông,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />với đàn hạc, tiếng tơ thánh thót,</para>
  <para style="q2" vid="PSA 92:3">với đàn lia, âm điệu du dương.<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Lạy Chúa Hằng Hữu, lòng con hớn hở vì việc Chúa làm cho con!</para>
  <para style="q2" vid="PSA 92:4">Dâng hoan ca khi thấy rõ việc Ngài thực hiện.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Lạy Chúa Hằng Hữu, công việc Ngài quá vĩ đại!</para>
  <para style="q2" vid="PSA 92:5">Tư tưởng Chúa thật vô cùng sâu sắc.<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Người điên dại không sao biết được,</para>
  <para style="q2" vid="PSA 92:6">người ngu dốt không hiểu được điều này:<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />Người ác có khi tràn lan như cỏ dại,</para>
  <para style="q2" vid="PSA 92:7">người gian tham hưng thịnh một thời,</para>
  <para style="q2" vid="PSA 92:7">rốt cuộc họ cũng điêu tàn tan tác.<verse eid="PSA 92:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Nhưng chỉ Ngài, lạy Chúa Hằng Hữu, vẫn cầm quyền tối cao đời đời.<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Chúng con biết kẻ thù Ngài, Chúa Hằng Hữu, sẽ hư vong;</para>
  <para style="q2" vid="PSA 92:9">và tất cả người gian ác sẽ thất bại.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Chúa thêm sức cho con mạnh như bò rừng.</para>
  <para style="q2" vid="PSA 92:10">Ngài xức dầu cho con bằng dầu mới.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Mắt con đã chứng kiến cảnh quân thù bại trận;</para>
  <para style="q2" vid="PSA 92:11">tai con nghe tiếng rên la của bọn ác gian.<verse eid="PSA 92:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Người công chính sẽ mọc lên như cây chà là,</para>
  <para style="q2" vid="PSA 92:12">xanh tốt như cây bá hương Li-ban.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Vì người được trồng trong nhà Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 92:13">Sẽ trổ hoa trong hành lang của Đức Chúa Trời chúng ta.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Ngay cả khi đến tuổi già vẫn luôn sai trái;</para>
  <para style="q2" vid="PSA 92:14">đầy nhựa sống và mãi mãi tươi xanh.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Người sẽ công bố: “Chúa Hằng Hữu là công chính!</para>
  <para style="q2" vid="PSA 92:15">Ngài là Vầng Đá của con!</para>
  <para style="q2" vid="PSA 92:15">Trong Ngài không có điều gian ác!”<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="cl">Thi Thiên 93</para>
  <para style="s1">Oai Nghi của Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />Chúa Hằng Hữu là Vua! Ngài mặc vẻ uy nghiêm.</para>
  <para style="q2" vid="PSA 93:1">Chúa Hằng Hữu khoác áo bào, sức mạnh uy nghi.</para>
  <para style="q1" vid="PSA 93:1">Thế giới luôn bền vững,</para>
  <para style="q2" vid="PSA 93:1">và không hề lay chuyển.<verse eid="PSA 93:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Từ sáng thế, ngôi Chúa vững lập, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 93:2">Ngài hiện hữu từ trước vô cùng.<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Lạy Chúa Hằng Hữu, sóng biển dâng tràn.</para>
  <para style="q2" vid="PSA 93:3">Từ vực thẳm, đại dương gào thét như sấm;</para>
  <para style="q2" vid="PSA 93:3">tiếng sóng thần ồ ạt dâng lên.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Chúa Hằng Hữu tể trị trên các tầng trời,</para>
  <para style="q2" vid="PSA 93:4">tiếng Ngài đánh bạt tiếng sóng gầm,</para>
  <para style="q2" vid="PSA 93:4">trấn át tiếng ầm ầm đại dương.<verse eid="PSA 93:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Lạy Chúa Hằng Hữu, luật pháp Chúa không hề dời đổi.</para>
  <para style="q2" vid="PSA 93:5">Vương quyền Ngài, lạy Chúa Hằng Hữu, là thánh mãi đến đời đời.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="cl">Thi Thiên 94</para>
  <para style="s1">Xin Chúa Báo Thù</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Lạy Chúa Hằng Hữu, Đức Chúa Trời báo ứng,</para>
  <para style="q2" vid="PSA 94:1">ôi Đức Chúa Trời báo ứng, xin hiển lộ vinh quang Ngài!<note caller="+" style="f"><char style="fr" closed="false">94:1 </char><char style="ft" closed="false">Ctd xin bày tỏ chính mình Ngài</char></note><verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Xin trỗi dậy, lạy Thẩm Phán Tối Cao của thế gian.</para>
  <para style="q2" vid="PSA 94:2">Xin ra tay báo trả người kiêu căng.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Bao lâu, lạy Chúa Hằng Hữu?</para>
  <para style="q2" vid="PSA 94:3">Đến bao giờ người ác thôi đắc chí?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Họ tuôn ra những lời xấc xược đến khi nào?</para>
  <para style="q2" vid="PSA 94:4">Bao lâu những luận điệu khoe khoang mới chấm dứt?<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Lạy Chúa Hằng Hữu, họ giẫm nát dân Chúa,</para>
  <para style="q2" vid="PSA 94:5">giày đạp cơ nghiệp Chúa dưới gót chân.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Họ giết quả phụ và kiều dân,</para>
  <para style="q2" vid="PSA 94:6">tàn sát đám trẻ con côi cút.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Rồi tự nhủ: “Chúa Hằng Hữu có thấy đâu,</para>
  <para style="q2" vid="PSA 94:7">Đức Chúa Trời của Gia-cốp có bao giờ để ý?”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Kẻ hung ác, hãy nghe đây và mở trí!<note caller="+" style="f"><char style="fr" closed="false">94:8 </char><char style="ft" closed="false">Ctd hãy hiểu biết</char></note></para>
  <para style="q2" vid="PSA 94:8">Người điên rồ, hãy học điều khôn ngoan!<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Đấng sáng tạo ra tai, chẳng lẽ không nghe?</para>
  <para style="q2" vid="PSA 94:9">Đấng làm ra mắt, lẽ nào không thấy rõ?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Đấng đoán phạt muôn dân, lẽ nào không trừng trị?</para>
  <para style="q2" vid="PSA 94:10">Đấng hiểu biết mọi thứ lẽ nào không biết Ngài đang làm gì?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />Chúa Hằng Hữu biết tư tưởng thầm kín của con người;</para>
  <para style="q2" vid="PSA 94:11">Ngài biết bản chất nó chỉ là hư ảo!<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Lạy Chúa Hằng Hữu, phước cho người được Ngài sửa dạy,</para>
  <para style="q2" vid="PSA 94:12">và những ai được học luật pháp với Ngài.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Ngài cho họ nghỉ ngơi sau những ngày hoạn nạn,</para>
  <para style="q2" vid="PSA 94:13">cho đến khi huyệt người ác đã đào xong.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Chúa Hằng Hữu không hề quên dân Chúa;</para>
  <para style="q2" vid="PSA 94:14">Ngài cũng chẳng bao giờ bỏ cơ nghiệp Ngài.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Vì công lý sẽ trở lại với người công chính,</para>
  <para style="q2" vid="PSA 94:15">và tất cả người ngay sẽ theo chính đạo.<note caller="+" style="f"><char style="fr" closed="false">94:15 </char><char style="ft" closed="false">Nt sẽ theo nó</char></note><verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Ai sẽ bảo vệ tôi khỏi tay bọn gian ác?</para>
  <para style="q2" vid="PSA 94:16">Ai đứng lên vì tôi chống lại người dữ?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Nếu Chúa Hằng Hữu không giúp tôi,</para>
  <para style="q2" vid="PSA 94:17">thì linh hồn tôi đã phải câm nín.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Khi tôi kêu: “Con trượt ngã!”</para>
  <para style="q2" vid="PSA 94:18">Thì tay nhân từ Chúa nâng đỡ tôi.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Khi lòng tôi trăm mối ngổn ngang,</para>
  <para style="q2" vid="PSA 94:19">niềm an ủi Chúa là nguồn phấn khởi.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Có thể nào Chúa liên kết với các lãnh đạo bất chính—</para>
  <para style="q2" vid="PSA 94:20">ban luật lệ làm hại dân lành?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Họ liên minh ám hại người công chính,</para>
  <para style="q2" vid="PSA 94:21">và toa rập giết oan người vô tội.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Nhưng Chúa Hằng Hữu là đồn lũy tôi;</para>
  <para style="q2" vid="PSA 94:22">Đức Chúa Trời tôi là vầng đá, nơi tôi ẩn náu.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Đức Chúa Trời sẽ báo trả công việc ác họ làm.</para>
  <para style="q2" vid="PSA 94:23">Ngài sẽ tiêu diệt họ vì mưu ác họ.</para>
  <para style="q2" vid="PSA 94:23">Chúa Hằng Hữu, Đức Chúa Trời chúng ta sẽ quét sạch người gian ác.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="cl">Thi Thiên 95</para>
  <para style="s1">Kêu Gọi Đặt Niềm Tin Nơi Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Hãy đến cùng ngợi tôn Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 95:1">Hãy lớn tiếng chúc tôn Vầng Đá cứu chuộc của chúng ta.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Hãy đến trước mặt Chúa với lời cảm tạ.</para>
  <para style="q2" vid="PSA 95:2">Hãy chúc tụng Ngài với nhã nhạc và bài ca.<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Vì Chúa Hằng Hữu là Đức Chúa Trời vĩ đại,</para>
  <para style="q2" vid="PSA 95:3">là Vua cao cả trên mọi chư thần.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Các vực thẳm đều nằm trong tay Chúa,</para>
  <para style="q2" vid="PSA 95:4">và đỉnh núi cao cũng đều thuộc về Ngài.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Ngài sáng tạo và thống trị các đại dương.</para>
  <para style="q2" vid="PSA 95:5">Lục địa mênh mông<note caller="+" style="f"><char style="fr" closed="false">95:5 </char><char style="ft" closed="false">Nt đất khô</char></note> đều do Ngài làm ra cả.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Hãy cùng đến cúi đầu thờ phượng Chúa</para>
  <para style="q2" vid="PSA 95:6">Hãy phủ phục trước Chúa, Đấng đã dựng chúng ta,<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />vì Ngài là Đức Chúa Trời chúng ta.</para>
  <para style="q2" vid="PSA 95:7">Chúng ta là công dân nước Ngài,</para>
  <para style="q2" vid="PSA 95:7">là đàn chiên trong đồng cỏ Ngài chăm sóc.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Ngày nay, hãy lắng nghe tiếng Ngài!<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />Chúa Hằng Hữu phán: “Chớ cứng lòng như Ít-ra-ên tại Mê-ri-ba,</para>
  <para style="q2" vid="PSA 95:8">hoặc như điều họ đã làm tại Ma-sa trong hoang mạc.<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Vì tại đó tổ phụ ngươi thử thách và khiêu khích Ta,</para>
  <para style="q2" vid="PSA 95:9">dù họ đã thấy mọi việc Ta làm.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Suốt bốn mươi năm, Ta kinh tởm họ, và Ta đã phán:</para>
  <para style="q2" vid="PSA 95:10">‘Chúng đã xa Ta từ tư tưởng đến tấm lòng.</para>
  <para style="q2" vid="PSA 95:10">Cố tình gạt bỏ<note caller="+" style="f"><char style="fr" closed="false">95:10 </char><char style="ft" closed="false">Ctd họ đã không biết</char></note> đường lối Ta.’<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Nên Ta đã thề trong cơn thịnh nộ:</para>
  <para style="q2" vid="PSA 95:11">‘Chúng sẽ chẳng bao giờ được vào nơi an nghỉ Ta.’”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="cl">Thi Thiên 96</para>
  <para style="s1">Khuyên Dân Kính Thờ Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Hãy dâng lên Chúa Hằng Hữu một bài ca mới!</para>
  <para style="q2" vid="PSA 96:1">Hỡi cả thế gian hãy chúc tôn Chúa Hằng Hữu!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Hãy ngợi ca Chúa Hằng Hữu, chúc tụng Danh Ngài.</para>
  <para style="q2" vid="PSA 96:2">Ngày lại ngày tường thuật ân cứu độ.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Tuyên dương vinh quang Ngài giữa các nước.</para>
  <para style="q2" vid="PSA 96:3">Rao truyền việc diệu kỳ của Chúa cho các dân.<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Vĩ đại thay Chúa Hằng Hữu! Ngài là Đấng đáng ca tụng bật nhất!</para>
  <para style="q2" vid="PSA 96:4">Phải kính sợ Ngài hơn mọi thánh thần.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Thần của các dân khác chỉ là hình tượng,</para>
  <para style="q2" vid="PSA 96:5">nhưng Chúa Hằng Hữu dựng nên các tầng trời.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Vinh dự và uy nghiêm tỏa ra trước Chúa;</para>
  <para style="q2" vid="PSA 96:6">tuyệt mỹ và hùng mạnh ở nơi thánh Ngài.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Hỡi các dân trên thế giới, hãy công nhận Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 96:7">hãy công nhận vinh quang và quyền năng Chúa Hằng Hữu.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Hãy dâng lên Chúa Hằng Hữu vinh quang tuyệt đối!<note caller="+" style="f"><char style="fr" closed="false">96:8 </char><char style="ft" closed="false">Ctd xứng đáng cho Danh Ngài</char></note></para>
  <para style="q2" vid="PSA 96:8">Hãy đem tế lễ vào hành lang Ngài.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Hãy thờ phượng Chúa Hằng Hữu trong hào quang thánh.</para>
  <para style="q2" vid="PSA 96:9">Hỡi cả thế giới hãy run sợ trước mặt Ngài.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Hãy nói với các dân tộc: “Chúa Hằng Hữu tể trị!”</para>
  <para style="q2" vid="PSA 96:10">Cả thế gian vững bền và không hề lay chuyển.</para>
  <para style="q2" vid="PSA 96:10">Chúa sẽ xét xử công minh mọi dân tộc.<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Hỡi tầng trời hãy vui mừng, hỡi đất hãy hớn hở!</para>
  <para style="q2" vid="PSA 96:11">Hỡi biển và mọi sinh vật dưới nước hãy ca vang!<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Hỡi đồng xanh với các mọi vật trong đó cùng nhảy múa!</para>
  <para style="q2" vid="PSA 96:12">Hỡi cây rừng trổi giọng hát hòa thanh<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />trước mặt Chúa Hằng Hữu, vì Ngài đang đến!</para>
  <para style="q2" vid="PSA 96:13">Chúa đến để phán xét thế gian.</para>
  <para style="q1" vid="PSA 96:13">Chúa sẽ xét xử thế giới bằng công bình,</para>
  <para style="q2" vid="PSA 96:13">và các dân tộc bằng chân lý Ngài.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="cl">Thi Thiên 97</para>
  <para style="s1">Uy Quyền và Thống Trị của Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />Chúa Hằng Hữu là Vua!</para>
  <para style="q2" vid="PSA 97:1">Thế gian hãy reo mừng!</para>
  <para style="q2" vid="PSA 97:1">Muôn nghìn hải đảo khá hân hoan.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Mây đen vây quanh Chúa.</para>
  <para style="q2" vid="PSA 97:2">Công chính và công lý đặt làm nền móng ngai Ngài.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Lửa bùng cháy trước Ngài</para>
  <para style="q2" vid="PSA 97:3">và thiêu đốt thù nghịch bốn phía.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Ánh sáng Ngài chiếu rạng thế gian.</para>
  <para style="q2" vid="PSA 97:4">Khắp đất trông thấy liền run rẩy.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Núi đồi tan như sáp trước Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 97:5">trước vị Chủ Tể của trái đất.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Các tầng trời truyền rao đức công chính;</para>
  <para style="q2" vid="PSA 97:6">mọi dân tộc chiêm ngưỡng ánh vinh quang.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Những người thờ hình tượng đều bị sỉ nhục—</para>
  <para style="q2" vid="PSA 97:7">tức người khoe khoang về thần tượng vô quyền của mình—</para>
  <para style="q2" vid="PSA 97:7">vì mọi thần phải thờ lạy Chúa.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Si-ôn đã nghe và hân hoan,</para>
  <para style="q2" vid="PSA 97:8">các làng của Giu-đa mừng rỡ,</para>
  <para style="q2" vid="PSA 97:8">vì công minh Ngài, lạy Chúa Hằng Hữu!<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Vì Ngài, lạy Chúa Hằng Hữu, là Đấng Chí Tôn trên hoàn vũ;</para>
  <para style="q2" vid="PSA 97:9">Ngài vĩ đại hơn tất cả các thần.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Ai kính yêu Chúa Hằng Hữu, ghét gian tà!</para>
  <para style="q2" vid="PSA 97:10">Chúa bảo toàn sinh mạng người thánh của Ngài,</para>
  <para style="q2" vid="PSA 97:10">và giải thoát họ khỏi tay bọn hung bạo.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Ánh sáng bao bọc người công chính,</para>
  <para style="q2" vid="PSA 97:11">lòng trong sạch tràn ngập hân hoan.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Nguyện những ai tin kính hãy vui mừng trong Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 97:12">và ngợi tôn Danh Thánh của Ngài!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="cl">Thi Thiên 98</para>
  <para style="s1">Khuyên Dân Ca Tụng Chúa Công Chính</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Hãy dâng lên Chúa Hằng Hữu một bài ca mới,</para>
  <para style="q2" vid="PSA 98:1">vì Chúa đã thực hiện nhiều việc diệu kỳ.</para>
  <para style="q1" vid="PSA 98:1">Sử dụng quyền uy và năng lực thánh<note caller="+" style="f"><char style="fr" closed="false">98:1 </char><char style="ft" closed="false">Nt bàn tay và cánh tay thánh</char></note></para>
  <para style="q2" vid="PSA 98:1">chiến thắng bạo lực giải cứu dân Ngài.<note caller="+" style="f"><char style="fr" closed="false">98:1 </char><char style="ft" closed="false">Ctd để làm sự giải cứu</char></note><verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Chúa Hằng Hữu cho thấy ơn cứu rỗi,</para>
  <para style="q2" vid="PSA 98:2">bày tỏ đức công chính Ngài cho muôn dân.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Chúa nhớ lại lòng nhân từ và đức thành tín với Ít-ra-ên.</para>
  <para style="q2" vid="PSA 98:3">Khắp đất đều thấy sự cứu rỗi của Đức Chúa Trời chúng ta.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Hỡi nhân loại, hãy reo mừng cho Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 98:4">hãy hát bài ca mới chúc tụng Ngài.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Đàn hạc réo rắt mừng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 98:5">đàn lia tấu nhạc khúc du dương,<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />với kèn đồng cùng tiếng tù và trầm bổng.</para>
  <para style="q2" vid="PSA 98:6">Đồng thanh ca ngợi trước Chúa Hằng Hữu, là Vua!<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Biển và sinh vật trong biển hãy ca tụng Chúa!</para>
  <para style="q2" vid="PSA 98:7">Đất và sinh vật trên đất hãy cất tiếng vang rền.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Sông và suối hãy vỗ tay tán thưởng!</para>
  <para style="q2" vid="PSA 98:8">Núi đồi hãy trổi giọng hoan ca<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />trước mặt Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 98:9">Chúa đến để phán xét thế gian.</para>
  <para style="q1" vid="PSA 98:9">Chúa sẽ xét xử thế giới bằng đức công chính,</para>
  <para style="q2" vid="PSA 98:9">và các dân tộc theo lẽ công bằng.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="cl">Thi Thiên 99</para>
  <para style="s1">Ca Ngợi Chúa Thành Tín</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />Chúa Hằng Hữu là Vua!</para>
  <para style="q2" vid="PSA 99:1">Mọi dân tộc hãy run sợ!</para>
  <para style="q1" vid="PSA 99:1">Ngài ngự trên ngôi giữa các chê-ru-bim.</para>
  <para style="q2" vid="PSA 99:1">Hỡi đất hãy rúng động!<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Giữa Si-ôn, Chúa Hằng Hữu oai nghi,</para>
  <para style="q2" vid="PSA 99:2">trước muôn dân, Ngài cao cả vô cùng.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Hãy ngợi tôn sự vĩ đại và Danh đáng sợ của Ngài.</para>
  <para style="q2" vid="PSA 99:3">Vì Danh Ngài là thánh!<verse eid="PSA 99:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Vua rất uy dũng, Đấng yêu công lý,</para>
  <para style="q2" vid="PSA 99:4">Ngài thiết lập vững lẽ công bằng.</para>
  <para style="q1" vid="PSA 99:4">Cầm cân nẩy mực với công lý</para>
  <para style="q2" vid="PSA 99:4">và công chính giữa các đại tộc của Gia-cốp.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Hãy tán dương Chúa Hằng Hữu, Đức Chúa Trời chúng ta!</para>
  <para style="q2" vid="PSA 99:5">Dưới chân Chúa, cúi đầu thờ phượng, vì Ngài là Thánh!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Môi-se và A-rôn ở giữa các thầy tế lễ của Chúa;</para>
  <para style="q2" vid="PSA 99:6">Sa-mu-ên cũng được gọi trong Danh Ngài.</para>
  <para style="q1" vid="PSA 99:6">Họ thiết tha cầu khẩn Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 99:6">và Ngài liền đáp lời họ.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />Từ trụ mây Chúa phán với Ít-ra-ên,</para>
  <para style="q2" vid="PSA 99:7">họ tuân theo các luật pháp và mệnh lệnh Ngài.<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Chúa Hằng Hữu, Đức Chúa Trời chúng con đã đáp lời họ.</para>
  <para style="q2" vid="PSA 99:8">Chúa là Đức Chúa Trời hay thứ tha,</para>
  <para style="q2" vid="PSA 99:8">nhưng giới luật kỷ cương, Ngài không thể bỏ qua.<note caller="+" style="f"><char style="fr" closed="false">99:8 </char><char style="ft" closed="false">Ctd Chúa báo trả việc họ làm</char></note><verse eid="PSA 99:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Hãy suy tôn Chúa Hằng Hữu, Đức Chúa Trời chúng ta,</para>
  <para style="q2" vid="PSA 99:9">và tôn thờ trên núi thánh trong Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 99:9">vì Chúa Hằng Hữu, Đức Chúa Trời chúng ta là Thánh!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="cl">Thi Thiên 100</para>
  <para style="s1">Thi Thiên Cảm Tạ Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Bài ca cảm ta. Hỡi cả trái đất, hãy cất tiếng ca mừng cho Chúa Hằng Hữu!<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Phục vụ Chúa Hằng Hữu với lòng vui sướng.</para>
  <para style="q2" vid="PSA 100:2">Đến trước mặt Ngài với tiếng hoan ca.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Hãy nhận biết Chúa Hằng Hữu là Đức Chúa Trời!</para>
  <para style="q2" vid="PSA 100:3">Đấng đã tạo dựng chúng ta, chúng ta thuộc về Ngài.</para>
  <para style="q2" vid="PSA 100:3">Chúng ta là dân Ngài, là chiên của đồng cỏ Ngài.<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Hãy vào các cửa của Ngài với lời cảm tạ;</para>
  <para style="q2" vid="PSA 100:4">vào hành lang Ngài với tiếng ngợi ca.</para>
  <para style="q2" vid="PSA 100:4">Cảm tạ tôn vinh Danh Đấng Cao Cả.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Vì Chúa Hằng Hữu là Đấng toàn thiện.</para>
  <para style="q2" vid="PSA 100:5">Đức bác ái Ngài hằng còn mãi,</para>
  <para style="q2" vid="PSA 100:5">và đức thành tín Ngài còn đến đời đời.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="cl">Thi Thiên 101</para>
  <para style="s1">Quyết Tâm Theo Đường Trọn Vẹn</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Con sẽ ca ngợi sự nhân từ và đức công chính Ngài, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 101:1">Con xin dâng tiếng tụng ca Ngài.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Con sẽ sống cẩn thận theo con đường thiện hảo.</para>
  <para style="q2" vid="PSA 101:2">Khi nào Chúa sẽ đến giúp con?</para>
  <para style="q1" vid="PSA 101:2">Con sẽ cư xử trong gia đình con</para>
  <para style="q2" vid="PSA 101:2">bằng tâm hồn trọn vẹn.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Mắt con sẽ không</para>
  <para style="q2" vid="PSA 101:3">nhìn vào những cảnh hèn hạ, xấu xa.</para>
  <para style="q1" vid="PSA 101:3">Lòng con ghê tởm sự gian tà;</para>
  <para style="q2" vid="PSA 101:3">con sẽ không dính dấp vào điều ác.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Con sẽ loại trừ lòng hư hoại</para>
  <para style="q2" vid="PSA 101:4">và xa lánh loài gian ác.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Người nào nói xấu người thân cận, con sẽ làm cho họ câm lại.</para>
  <para style="q2" vid="PSA 101:5">Con không chấp nhận mắt kiêu căng và lòng tự đại.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Nhưng con để mắt tìm người thành tín trong xứ,</para>
  <para style="q2" vid="PSA 101:6">cho họ sống chung với con.</para>
  <para style="q1" vid="PSA 101:6">Chỉ những ai sống đời trong sạch</para>
  <para style="q2" vid="PSA 101:6">sẽ phục vụ con.<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Con không dung nạp người phản trắc trong nhà,</para>
  <para style="q2" vid="PSA 101:7">cũng không thứ tha miệng môi dối gạt.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Mỗi buổi sáng, con diệt trừ người ác,<note caller="+" style="f"><char style="fr" closed="false">101:8 </char><char style="ft" closed="false">Người ác trong xứ </char></note></para>
  <para style="q2" vid="PSA 101:8">thành của Chúa Hằng Hữu không còn bọn gian tà.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="cl">Thi Thiên 102</para>
  <para style="s1">Lời Cầu Xin Khi Gặp Hoạn Nạn, Sầu Khổ</para>
  <para style="d">Lời cầu nguyện của người bị hoạn nạn, dốc đổ nỗi buồn thảm của mình trước Chúa Hằng Hữu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Lạy Chúa Hằng Hữu, xin nghe con cầu nguyện!</para>
  <para style="q2" vid="PSA 102:1">Xin lắng nghe tiếng con van xin!<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Xin đừng ngoảnh mặt</para>
  <para style="q2" vid="PSA 102:2">trong ngày con khủng hoảng.</para>
  <para style="q1" vid="PSA 102:2">Xin nghiêng tai lắng nghe tiếng,</para>
  <para style="q2" vid="PSA 102:2">và đáp ứng nhanh khi con cầu khẩn.<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Ngày tháng đời con tan như khói,</para>
  <para style="q2" vid="PSA 102:3">xương cốt con cháy như củi đốt.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Lòng con đau đớn héo mòn như cỏ,</para>
  <para style="q2" vid="PSA 102:4">vì con quên cả ăn uống.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Vì con rên siết mãi,</para>
  <para style="q2" vid="PSA 102:5">con chỉ còn da bọc xương.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Con như chim cú nơi hoang mạc,</para>
  <para style="q2" vid="PSA 102:6">như chim cú mèo giữa cảnh điêu tàn.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Con mất ngủ, suốt đêm trằn trọc,</para>
  <para style="q2" vid="PSA 102:7">như chim sẻ cô đơn góc mái nhà.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Bao kẻ thù chẳng ngớt lời sỉ nhục.</para>
  <para style="q2" vid="PSA 102:8">Miệng thô tục mắng chửi ngày đêm.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Thay vì bánh, con nuốt tro tàn.</para>
  <para style="q2" vid="PSA 102:9">Nước con uống pha dòng lệ mặn<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />vì Chúa đã nổi cơn giận.</para>
  <para style="q2" vid="PSA 102:10">Ngài nâng con lên rồi ném cho xa.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Ngày tháng đời con như bóng xế chiều.</para>
  <para style="q2" vid="PSA 102:11">Thân con héo hắt như cỏ dại.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Nhưng Chúa Hằng Hữu vẫn bất diệt trường tồn.</para>
  <para style="q2" vid="PSA 102:12">Đời nọ, đời kia vẫn suy tôn ghi nhớ.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Chúa sẽ trỗi dậy, thương xót Si-ôn—</para>
  <para style="q2" vid="PSA 102:13">vì thời điểm nó được khoan hồng đã đến.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Vì người của Chúa mến yêu từng tảng đá nó,</para>
  <para style="q2" vid="PSA 102:14">cát bụi Si-ôn cũng khiến họ động lòng.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Các dân tộc trần gian sẽ sợ trước Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 102:15">Các vua trên đất khiếp đảm trước vinh quang Ngài.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Vì Chúa Hằng Hữu sẽ tái thiết Si-ôn,</para>
  <para style="q2" vid="PSA 102:16">Ngài sẽ xuất hiện trong vinh quang rực rỡ.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Chúa quay lại, nghe người khốn cùng cầu khẩn.</para>
  <para style="q2" vid="PSA 102:17">Chúa không khinh dể tiếng họ nài xin.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Sự kiện này sẽ được ghi cho hậu thế,</para>
  <para style="q2" vid="PSA 102:18">các thế hệ tương lai sẽ ngợi tôn Chúa Hằng Hữu.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />Từ nơi thánh trên trời</para>
  <para style="q2" vid="PSA 102:19">Chúa Hằng Hữu nhìn xuống.</para>
  <para style="q2" vid="PSA 102:19">Từ trời cao Ngài đoái nhìn thế gian,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />để tai nghe lời tù nhân than thở,</para>
  <para style="q2" vid="PSA 102:20">để phóng thích cả những tên tử tù.<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Như thế, người ta sẽ tuyên xưng Danh Chúa tại Si-ôn,</para>
  <para style="q2" vid="PSA 102:21">ca ngợi Ngài giữa Giê-ru-sa-lem,<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />khi muôn dân muôn nước tập họp</para>
  <para style="q2" vid="PSA 102:22">cùng đến phụng sự Chúa Hằng Hữu.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Sức lực con, Chúa giảm giữa dòng đời,</para>
  <para style="q2" vid="PSA 102:23">cắt ngắn chuỗi ngày trần thế.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Nhưng con thưa: “Lạy Đức Chúa Trời, Đấng sống đời đời,</para>
  <para style="q2" vid="PSA 102:24">xin đừng cất con đi khi con còn quá trẻ!<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Từ vạn cổ, Chúa đặt nền quả đất,</para>
  <para style="q2" vid="PSA 102:25">các tầng trời do tay Chúa tạo nên.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Trời đất sẽ tiêu tan nhưng Chúa hằng còn.</para>
  <para style="q2" vid="PSA 102:26">Vạn vật sẽ rách nát như áo cũ.</para>
  <para style="q1" vid="PSA 102:26">Chúa thay vũ trụ như người thay áo</para>
  <para style="q2" vid="PSA 102:26">và nó bị đổi thay.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Nhưng Chúa vẫn là Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 102:27">năm tháng Chúa vẫn đời đời bất tận.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Con cháu của đầy tớ Chúa</para>
  <para style="q2" vid="PSA 102:28">sẽ sống bình an.</para>
  <para style="q1" vid="PSA 102:28">Dòng dõi của họ</para>
  <para style="q2" vid="PSA 102:28">sẽ được lập vững trước mặt Ngài.”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="cl">Thi Thiên 103</para>
  <para style="s1">Ca Ngợi Chúa Vì Ân Huệ Ngài Ban</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Hồn ta hỡi, hãy dâng tiếng ngợi ca Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 103:1">hết lòng hết sức tôn vinh Thánh Danh Ngài.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Hồn ta hỡi, hãy dâng tiếng ngợi ca Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 103:2">đừng bao giờ quên các công ơn của Ngài.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Chính Chúa tha thứ các tội ác</para>
  <para style="q2" vid="PSA 103:3">và chữa lành mọi bệnh tật.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />Chúa cứu khỏi chốn diệt vong</para>
  <para style="q2" vid="PSA 103:4">và đội lên đầu mão triều <note caller="+" style="f"><char style="fr" closed="false">103:4 </char><char style="ft" closed="false">Nt đội vương miện</char></note> nhân từ và thương xót.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Ngài cho thỏa mãn điều tốt lành khao khát.</para>
  <para style="q2" vid="PSA 103:5">Đến nỗi tuổi xuân phục hồi như đại bàng!<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Chúa Hằng Hữu đem công chính</para>
  <para style="q2" vid="PSA 103:6">và công lý đến cho người bị áp bức.<verse eid="PSA 103:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Chúa hiển lộ cho Môi-se biết đường lối Chúa</para>
  <para style="q2" vid="PSA 103:7">và cho Ít-ra-ên thấy công trình vĩ đại của Ngài.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />Chúa Hằng Hữu xót thương và nhân ái,</para>
  <para style="q2" vid="PSA 103:8">khoan nhẫn, và mãi mãi yêu thương.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Ngài không buộc tội luôn luôn,</para>
  <para style="q2" vid="PSA 103:9">cũng không căm giận đến đời đời.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Chúa không phạt tương xứng với tội chúng ta phạm;</para>
  <para style="q2" vid="PSA 103:10">cũng chẳng gia hình theo lỗi chúng ta làm.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Vì nhân từ Chúa rộng lớn đối với người kính sợ Ngài,</para>
  <para style="q2" vid="PSA 103:11">khác nào trời với đất.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Vi phạm chúng ta Chúa bỏ xa ta,</para>
  <para style="q2" vid="PSA 103:12">như phương đông xa cách phương tây.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Chúa Hằng Hữu thương xót người kính sợ Ngài,</para>
  <para style="q2" vid="PSA 103:13">như cha thương con cái.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Vì Ngài biết rõ bản chất chúng ta;</para>
  <para style="q2" vid="PSA 103:14">Ngài nhớ rõ chúng ta hình thành từ cát bụi.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Ngày của chúng ta như cỏ dại;</para>
  <para style="q2" vid="PSA 103:15">như hoa dại ngoài đồng, nở rồi chết.<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />Chỉ một ngọn gió thoảng đủ làm cho úa tàn—</para>
  <para style="q2" vid="PSA 103:16">chỗ nó mọc cũng chẳng nhận ra nó nữa.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Nhưng Chúa Hằng Hữu vẫn mãi nhân từ với những ai biết kính sợ Ngài.</para>
  <para style="q2" vid="PSA 103:17">Chúa vẫn công chính với dòng dõi họ,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />với những ai vâng giữ giao ước Ngài,</para>
  <para style="q2" vid="PSA 103:18">và thực thi nghiêm chỉnh mệnh lệnh Ngài!<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Chúa Hằng Hữu vững lập ngôi trên trời;</para>
  <para style="q2" vid="PSA 103:19">vương quyền Ngài bao trùm hoàn vũ.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Các thiên sứ, hãy ca ngợi Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 103:20">các anh hùng uy dũng thi hành lệnh Ngài,</para>
  <para style="q2" vid="PSA 103:20">hãy vâng theo tiếng Ngài truyền dạy.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Hãy chúc tụng Chúa Hằng Hữu, hỡi cả thiên binh,</para>
  <para style="q2" vid="PSA 103:21">là các thiên sứ phục vụ ý muốn Chúa!<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Hãy chúc tụng Chúa Hằng Hữu, hỡi các loài được Ngài tạo dựng,</para>
  <para style="q2" vid="PSA 103:22">cùng hết thảy tạo vật trong vương quốc Ngài.</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q1" vid="PSA 103:22">Hồn ta hỡi, hãy dâng tiếng ngợi ca Chúa Hằng Hữu.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="cl">Thi Thiên 104</para>
  <para style="s1">Chúa Phù Hộ Tạo Vật của Ngài</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Hồn ta hỡi, hãy dâng tiếng ca ngợi Chúa Hằng Hữu.</para>
  <para style="b" vid="PSA 104:1" />
  <para style="q1" vid="PSA 104:1">Lạy Chúa Hằng Hữu, Đức Chúa Trời con, Ngài thật vĩ đại vô cùng!</para>
  <para style="q2" vid="PSA 104:1">Chúa mặc vinh quang và uy nghi.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Ánh sáng bọc quanh Ngài như chiếc áo.</para>
  <para style="q2" vid="PSA 104:2">Chúa giương các tầng trời như căng trại;<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />đặt các xà ngang của lâu đài Ngài trên nước,</para>
  <para style="q2" vid="PSA 104:3">dùng mây làm xa giá;</para>
  <para style="q2" vid="PSA 104:3">và cỡi trên cánh gió.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Ngài sai gió ra đi làm sứ giả<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="ft" closed="false">Ctd Đấng làm cho thiên sứ Ngài như các thiên thần</char></note></para>
  <para style="q2" vid="PSA 104:4">dùng lửa hừng làm bầy tôi.<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="ft" closed="false">Ctd làm cho đầy tớ Ngài như ngọn lửa</char></note><verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Chúa đặt vững trụ nền trái đất</para>
  <para style="q2" vid="PSA 104:5">để nó không bao giờ chuyển lay.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Chúa phủ mặt đất bằng vực thẳm,<note caller="+" style="f"><char style="fr" closed="false">104:6 </char><char style="ft" closed="false">Nt thêm: như chiếc áo</char></note></para>
  <para style="q2" vid="PSA 104:6">nước dâng ngập các ngọn núi cao.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Nghe Chúa quở nước liền chạy trốn;</para>
  <para style="q2" vid="PSA 104:7">tiếng sấm Ngài làm nước cuốn xa.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Nước phủ ngập trên núi cao, tràn vào thung lũng,</para>
  <para style="q2" vid="PSA 104:8">đến đúng nơi Chúa đã ấn định.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Chúa đặt ranh giới cho nước,</para>
  <para style="q2" vid="PSA 104:9">để nó không còn bao phủ mặt đất.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Chúa làm suối tuôn trào trong thung lũng,</para>
  <para style="q2" vid="PSA 104:10">các dòng sông lượn khúc giữa rặng đồi.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Suối, sông cung cấp nước ngọt<note caller="+" style="f"><char style="fr" closed="false">104:11 </char><char style="ft" closed="false">Ctd nước uống</char></note> cho thú đồng,</para>
  <para style="q2" vid="PSA 104:11">bầy lừa rừng giải khát bên dòng sông.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Chim chóc quần tụ quanh bờ suối</para>
  <para style="q2" vid="PSA 104:12">và ca hát líu lo giữa cành cây.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Từ lầu cao, Chúa cho mưa khắp núi,</para>
  <para style="q2" vid="PSA 104:13">đất thỏa mãn vì bông trái là thành quả của tay Chúa.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Chúa khiến cỏ mọc lên nuôi gia súc,</para>
  <para style="q2" vid="PSA 104:14">tạo nên các loại rau đậu cho loài người.</para>
  <para style="q2" vid="PSA 104:14">Chúa bảo lòng đất sản sinh thực phẩm—<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />ban rượu làm phấn chấn tâm hồn,</para>
  <para style="q2" vid="PSA 104:15">dầu ô-liu làm mặt mày rạng rỡ</para>
  <para style="q2" vid="PSA 104:15">và bánh làm cho con người mạnh mẽ.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Cây cối của Chúa Hằng Hữu được dầm thấm nước—</para>
  <para style="q2" vid="PSA 104:16">là bá hương Li-ban được Ngài trồng.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Nơi có chim làm tổ,</para>
  <para style="q2" vid="PSA 104:17">và loài cò làm nhà trên cây bách.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Các ngọn núi cao dành cho dê rừng</para>
  <para style="q2" vid="PSA 104:18">và dốc núi cheo leo cho loài chuột đồng ẩn.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Chúa dùng mặt trăng phân định bốn mùa,</para>
  <para style="q2" vid="PSA 104:19">và mặt trời biết đúng giờ phải lặn.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Tay Chúa kéo bức màn đêm xuống,</para>
  <para style="q2" vid="PSA 104:20">các thú rừng từ nơi ẩn trú kéo ra.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Sư tử tơ gầm thét đuổi theo mồi,</para>
  <para style="q2" vid="PSA 104:21">xin Đức Chúa Trời ban cho thực phẩm.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Bình minh chiếu rực, thú rừng lui,</para>
  <para style="q2" vid="PSA 104:22">kéo nhau về nằm trong hang, động.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Loài người đi ra đồng canh tác,</para>
  <para style="q2" vid="PSA 104:23">cần cù lao động đến chiều hôm.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Lạy Chúa Hằng Hữu, công việc Chúa vô biên, huyền diệu!</para>
  <para style="q2" vid="PSA 104:24">Sự khôn ngoan Ngài thực hiện lắm kỳ công.</para>
  <para style="q2" vid="PSA 104:24">Khắp đất đầy dẫy các tạo vật của Ngài.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Lòng đại dương sâu rộng mênh mông,</para>
  <para style="q2" vid="PSA 104:25">chứa vô số sinh vật,</para>
  <para style="q2" vid="PSA 104:25">nhỏ lớn đủ loại.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Tàu bè qua lại,</para>
  <para style="q2" vid="PSA 104:26">loài Lê-vi-a-than mà Ngài tạo cũng thỏa thích nô đùa.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Vạn vật sống đều do tay Chúa,</para>
  <para style="q2" vid="PSA 104:27">Ngài cấp thực phẩm đúng nhu cầu.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Chúa phân phối, chúng liền ăn uống</para>
  <para style="q2" vid="PSA 104:28">đến no nê thực phẩm Ngài ban.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Chúa ngoảnh mặt, chúng đều sợ hãi.</para>
  <para style="q2" vid="PSA 104:29">Chúa vừa rút hơi thở, chúng lăn ra chết,</para>
  <para style="q2" vid="PSA 104:29">và trở về bụi đất là cội nguồn.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Khi Chúa truyền sinh khí, sự sống được dựng nên,</para>
  <para style="q2" vid="PSA 104:30">và Chúa đem tươi mới cho muôn loài trên đất.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Vinh quang Chúa sáng rực đời đời!</para>
  <para style="q2" vid="PSA 104:31">Nguyện Chúa Hằng Hữu hài lòng về công việc Ngài!<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Chúa nhìn địa cầu, đất liền rung chuyển;</para>
  <para style="q2" vid="PSA 104:32">Ngài sờ núi, núi liền bốc khói.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Con sẽ ca ngợi Chúa suốt đời con.</para>
  <para style="q2" vid="PSA 104:33">Con sẽ chúc tụng Đức Chúa Trời con mãi mãi!<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Nguyện mọi suy nghĩ con vui lòng Chúa,</para>
  <para style="q2" vid="PSA 104:34">hẳn con sẽ hân hoan trong Ngài.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Ước gì bọn tội ác bị tiêu diệt khỏi đất;</para>
  <para style="q2" vid="PSA 104:35">và bóng bọn gian tà biến mất mãi mãi.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Hồn ta hỡi, hãy chúc tụng Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 104:35">Hãy hân hoan ngợi tôn Ngài.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="cl">Thi Thiên 105</para>
  <para style="s1">Ơn Chúa Đối Với Ít-ra-ên</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Hãy cảm tạ Chúa Hằng Hữu và công bố sự vĩ đại Ngài.</para>
  <para style="q2" vid="PSA 105:1">Hãy cho cả thế giới biết việc Ngài làm.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Hát khen Chúa; phải, hãy hát ngợi tôn Ngài.</para>
  <para style="q2" vid="PSA 105:2">Đồn ra các kỳ công vĩ đại của Chúa.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Hãy tự hào trong Danh Thánh Chúa;</para>
  <para style="q2" vid="PSA 105:3">người thờ phượng Chúa Hằng Hữu hãy hân hoan.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Hãy tìm kiếm Chúa Hằng Hữu và sức mạnh Ngài;</para>
  <para style="q2" vid="PSA 105:4">hãy tiếp tục tìm kiếm Ngài mãi mãi.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Hãy ghi nhớ công việc Ngài thực hiện,</para>
  <para style="q2" vid="PSA 105:5">những phép lạ, những phán quyết Ngài ban<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />cho dòng dõi Áp-ra-ham, đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 105:6">con cháu Gia-cốp, người Ngài đã chọn.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Ngài là Chúa Hằng Hữu, Đức Chúa Trời chúng con.</para>
  <para style="q2" vid="PSA 105:7">Vị Chánh Án tối cao của địa cầu.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Chúa ghi nhớ giao ước Ngài mãi mãi—</para>
  <para style="q2" vid="PSA 105:8">không quên các mệnh lệnh Ngài truyền.<note caller="+" style="f"><char style="fr" closed="false">105:8 </char><char style="ft" closed="false">Nt cho đến nghìn đời</char></note><verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Là giao ước Chúa lập với Áp-ra-ham</para>
  <para style="q2" vid="PSA 105:9">và lời Ngài thề hứa với Y-sác.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Rồi Chúa xác nhận với Gia-cốp như một sắc lệnh,</para>
  <para style="q2" vid="PSA 105:10">và cho người Ít-ra-ên một giao ước đời đời:<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />“Ta sẽ ban đất Ca-na-an cho con</para>
  <para style="q2" vid="PSA 105:11">làm cơ nghiệp vĩnh viễn.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Lúc ấy họ chỉ là một số ít người,</para>
  <para style="q2" vid="PSA 105:12">những khách lạ tạm cư trong xứ Ca-na-an.<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Nước này, xứ khác, họ lang thang,</para>
  <para style="q2" vid="PSA 105:13">quốc gia nọ, lãnh thổ kia, ở tạm bợ.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Nhưng Chúa không cho ai áp bức họ.</para>
  <para style="q2" vid="PSA 105:14">Vì họ, Chúa cảnh cáo các vua:<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“Người Ta xức dầu, không ai được xâm phạm,</para>
  <para style="q2" vid="PSA 105:15">tiên tri Ta chọn, chẳng ai được chạm tay vào.”<note caller="+" style="f"><char style="fr" closed="false">105:15 </char><char style="ft" closed="false">Nt chẳng ai được làm hại </char></note><verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />Chúa đem nạn đói đến xứ Ca-na-an,</para>
  <para style="q2" vid="PSA 105:16">tiêu hủy hết các kho lương thực.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />Chúa sai một người đến Ai Cập làm tiên phong—</para>
  <para style="q2" vid="PSA 105:17">là Giô-sép, người bị bán làm nô lệ.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Họ tra chân ông vào cùm</para>
  <para style="q2" vid="PSA 105:18">và xích xiềng quanh cổ.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />Đến khi điều người tiên đoán xảy ra,</para>
  <para style="q2" vid="PSA 105:19">lời Chúa Hằng Hữu chứng tỏ người ngay lành.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Pha-ra-ôn sai thả Giô-sép ra khỏi ngục;</para>
  <para style="q2" vid="PSA 105:20">người cai trị đất nước đã trả tự do cho ông.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Giô-sép được giao trách nhiệm cai quản mọi việc trong triều vua;</para>
  <para style="q2" vid="PSA 105:21">ông là người quản trị tài sản của vua.<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Ông có quyền chỉ dẫn các triều thần,</para>
  <para style="q2" vid="PSA 105:22">và dạy những điều khôn ngoan cho bậc trưởng lão.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Ít-ra-ên từng cư ngụ tại Ai Cập;</para>
  <para style="q2" vid="PSA 105:23">Gia-cốp làm kiều dân tại đất Cham.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />Chúa Hằng Hữu cho người Ít-ra-ên sinh sôi nhiều</para>
  <para style="q2" vid="PSA 105:24">cho đến khi họ mạnh hơn kẻ thù của họ.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Chúa khiến người Ai Cập ghét người Ít-ra-ên,</para>
  <para style="q2" vid="PSA 105:25">và âm mưu hãm hại các đầy tớ Ngài.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Nhưng Chúa sai Môi-se, đầy tớ Ngài,</para>
  <para style="q2" vid="PSA 105:26">và A-rôn, người được Ngài chọn.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Họ làm các phép lạ giữa Ai Cập,</para>
  <para style="q2" vid="PSA 105:27">và các việc diệu kỳ trên lãnh thổ Cham.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />Chúa Hằng Hữu bao trùm Ai Cập trong bóng tối,</para>
  <para style="q2" vid="PSA 105:28">vì họ dám chống lệnh Chúa, không cho dân Ngài đi.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Chúa biến nước thành máu,</para>
  <para style="q2" vid="PSA 105:29">làm cho cá chết sạch.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Ếch nhái sinh ra nhung nhúc,</para>
  <para style="q2" vid="PSA 105:30">nhảy cả vào phòng ngủ của vua.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Chúa Hằng Hữu phán, ruồi mòng tràn đến Ai Cập,</para>
  <para style="q2" vid="PSA 105:31">muỗi vo ve khắp cả mọi miền.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Thay vì mưa, Chúa cho mưa đá,</para>
  <para style="q2" vid="PSA 105:32">trút ào ào, sấm chớp dậy vang,<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Làm vườn nho, cây vả đều ngã rạp,</para>
  <para style="q2" vid="PSA 105:33">cây cối gãy đổ, nằm ngổn ngang.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Theo lệnh Chúa, cào cào ào ạt đến—</para>
  <para style="q2" vid="PSA 105:34">châu chấu bay đến nhiều vô vàn.<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Chúng cắn xả mọi cây xanh trong xứ,</para>
  <para style="q2" vid="PSA 105:35">ngấu nghiến ăn, chẳng để lại chút gì.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />Rồi Chúa giết mọi con trưởng của nhà Ai Cập,</para>
  <para style="q2" vid="PSA 105:36">là con sinh ra khi họ đầy sinh lực.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Chúa Hằng Hữu đem dân Ngài khỏi Ai Cập, tay đầy bạc và vàng;</para>
  <para style="q2" vid="PSA 105:37">không một ai trong các đại tộc Ít-ra-ên chùn bước.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Ai Cập vui mừng khi họ rời đi,</para>
  <para style="q2" vid="PSA 105:38">vì quá nhiều tai ương thống khổ.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Chúa Hằng Hữu giăng mây che chở họ</para>
  <para style="q2" vid="PSA 105:39">và ban đêm cho trụ lửa sáng soi.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Khi họ cầu xin, Chúa cho chim cút đến,</para>
  <para style="q2" vid="PSA 105:40">và ban ma-na từ trời cho họ no nê.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Chúa mở đá cho nước tuôn trào,</para>
  <para style="q2" vid="PSA 105:41">như dòng sông trong hoang mạc mênh mông.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Lời hứa thánh Chúa luôn ghi nhớ</para>
  <para style="q2" vid="PSA 105:42">với Áp-ra-ham, đầy tớ Ngài.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Đưa dân Ngài vui mừng rời Ai Cập,</para>
  <para style="q2" vid="PSA 105:43">tuyển dân Ngài ra đi với tiếng hát vui mừng.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />Chúa ban dân Ngài đất các nước làm sản nghiệp,</para>
  <para style="q2" vid="PSA 105:44">họ được hưởng vụ mùa của các dân tộc trồng,<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Mọi việc xảy ra để họ vâng giữ giới răn Ngài,</para>
  <para style="q2" vid="PSA 105:45">và tuân hành theo luật lệ Chúa ban.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="cl">Thi Thiên 106</para>
  <para style="s1">Ơn Chúa trong Hoạn Nạn</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 106:1" />
  <para style="q1" vid="PSA 106:1">Tạ ơn Chúa Hằng Hữu, vì Ngài là thiện!</para>
  <para style="q2" vid="PSA 106:1">Sự nhân từ Ngài còn mãi đời đời.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Ai có thể tường thuật phép lạ Chúa Hằng Hữu làm?</para>
  <para style="q2" vid="PSA 106:2">Ai có đủ lời tôn ngợi Chúa Hằng Hữu?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Phước cho người giữ theo đường ngay thẳng</para>
  <para style="q2" vid="PSA 106:3">và luôn luôn tôn trọng phép công bằng.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Lạy Chúa Hằng Hữu, xin nhớ đến con, khi Chúa làm ơn cho dân Ngài;</para>
  <para style="q2" vid="PSA 106:4">xin Chúa thăm viếng và giải cứu con.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Xin cho con thấy tuyển dân được hưng thịnh.</para>
  <para style="q2" vid="PSA 106:5">Xin cho con chia sẻ niềm vui cùng dân Chúa;</para>
  <para style="q2" vid="PSA 106:5">và cùng họ vui hưởng cơ nghiệp Ngài.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Chúng con với tổ tiên đều mang trọng tội.</para>
  <para style="q2" vid="PSA 106:6">Chúng con đã làm điều sai! Chúng con hành động quá độc ác!<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Khi tổ tiên chúng con ở Ai Cập</para>
  <para style="q2" vid="PSA 106:7">đã không quan tâm các phép lạ của Chúa Hằng Hữu.</para>
  <para style="q1" vid="PSA 106:7">Họ không ghi tạc đức nhân ái vô biên.</para>
  <para style="q2" vid="PSA 106:7">Nên sinh tâm phản loạn bên Biển Đỏ.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Dù vậy, Chúa vẫn cứu họ—</para>
  <para style="q2" vid="PSA 106:8">vì Danh Ngài</para>
  <para style="q2" vid="PSA 106:8">và cho muôn dân nhìn nhận quyền oai Ngài.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />Chúa ra lệnh, Biển Đỏ liền khai lối,</para>
  <para style="q2" vid="PSA 106:9">Ngài dẫn Ít-ra-ên qua đại dương như đất khô.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Chúa cứu họ khỏi kẻ thù của họ,</para>
  <para style="q2" vid="PSA 106:10">và chuộc tuyển dân thoát chốn oán thù.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Nước đổ xuống nhận chìm quân địch;</para>
  <para style="q2" vid="PSA 106:11">không còn ai sống sót quay về.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Khi ấy dân Chúa mới tin lời Ngài hứa.</para>
  <para style="q2" vid="PSA 106:12">Và mở miệng hát tôn vinh Ngài.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Nhưng rồi họ quên thật nhanh những việc Ngài làm!</para>
  <para style="q2" vid="PSA 106:13">Không chờ đợi lời Chúa răn dạy!<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Tại hoang mạc dân Chúa để dục vọng mình nổi dậy không kiềm chế,</para>
  <para style="q2" vid="PSA 106:14">thách thức Ngài giữa chốn đồng hoang.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Vậy, Chúa ban cho điều họ mong ước,</para>
  <para style="q2" vid="PSA 106:15">nhưng sai bệnh tật hủy phá linh hồn.<verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Trong trại quân, họ ganh ghét Môi-se</para>
  <para style="q2" vid="PSA 106:16">cùng A-rôn, thầy tế lễ thánh của Chúa Hằng Hữu;<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Vì thế, đất liền há miệng;</para>
  <para style="q2" vid="PSA 106:17">nuốt chửng Đa-than</para>
  <para style="q2" vid="PSA 106:17">và chôn vùi toàn trại A-bi-ram.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Rồi lửa thiêu luôn cả bè đảng;</para>
  <para style="q2" vid="PSA 106:18">lửa thiêng tiêu diệt bọn ác gian.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Tại Hô-rếp, dân chúng đúc tượng thần;</para>
  <para style="q2" vid="PSA 106:19">họ thờ lạy bò con vàng đó.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Từ bỏ Đức Chúa Trời vinh quang hằng sống,</para>
  <para style="q2" vid="PSA 106:20">đổi lấy hình tượng con bò, loài ăn cỏ.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Họ quên Đức Chúa Trời, Đấng giải cứu họ,</para>
  <para style="q2" vid="PSA 106:21">Đấng làm mọi việc vĩ đại tại Ai Cập—<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />những việc diệu kỳ trong đất nước Cham,</para>
  <para style="q2" vid="PSA 106:22">cùng những việc đáng kinh nơi Biển Đỏ.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Chúa tỏ ý muốn tiêu diệt hết.</para>
  <para style="q2" vid="PSA 106:23">Nhưng Môi-se, người Chúa chọn, đã đứng giữa Chúa Hằng Hữu và dân.</para>
  <para style="q2" vid="PSA 106:23">Kêu cầu Chúa xin ngưng hình phạt hủy diệt họ.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Dân coi thường việc vào đất hứa</para>
  <para style="q2" vid="PSA 106:24">vì không tin lời Chúa hứa.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Thay vào đó họ oán than trong trại,</para>
  <para style="q2" vid="PSA 106:25">không lắng tai nghe tiếng Chúa Hằng Hữu.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Vì tội ác, Chúa đã thề nguyền</para>
  <para style="q2" vid="PSA 106:26">cả thế hệ vùi thây nơi hoang mạc,<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />và làm cho dòng dõi họ tản mác khắp nơi,</para>
  <para style="q2" vid="PSA 106:27">bị lưu đày đến những xứ xa xôi.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Tổ phụ chúng con cùng thờ lạy Ba-anh tại Phê-ô;</para>
  <para style="q2" vid="PSA 106:28">họ còn ăn lễ vật dâng thần tượng!<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Họ khiêu khích Chúa Hằng Hữu qua nhiều việc,</para>
  <para style="q2" vid="PSA 106:29">nên bệnh dịch phát khởi lan tràn.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Cho đến lúc Phi-nê-a cầu xin</para>
  <para style="q2" vid="PSA 106:30">Chúa cho chứng bệnh nguy nan chấm dứt.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Việc ông làm được xem là công chính</para>
  <para style="q2" vid="PSA 106:31">nên ông được ghi nhớ muôn đời.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Tại Mê-ri-ba, họ chọc giận Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 106:32">vì họ mà Môi-se hứng chịu tai họa.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Ông quẫn trí khi dân chúng gây rối,</para>
  <para style="q2" vid="PSA 106:33">miệng thốt ra những lời nông nổi.<verse eid="PSA 106:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />Họ không tiêu diệt dân địa phương,</para>
  <para style="q2" vid="PSA 106:34">theo lệnh Chúa Hằng Hữu đã phán dạy.<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />Nhưng đồng hóa với các dân ấy,</para>
  <para style="q2" vid="PSA 106:35">và bắt chước các thói tục xấu xa của họ.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Thậm chí thờ phượng các tượng thần,</para>
  <para style="q2" vid="PSA 106:36">ngày càng lìa xa Chúa Hằng Hữu.<note caller="+" style="f"><char style="fr" closed="false">106:36 </char><char style="ft" closed="false">Nt nó là cái bẩy của họ</char></note><verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Nhẫn tâm sát hại chính con mình</para>
  <para style="q2" vid="PSA 106:37">làm lễ vật dâng cho các quỷ.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Máu vô tội tràn lan khắp đất,</para>
  <para style="q2" vid="PSA 106:38">giết con mình, cả gái lẫn trai.</para>
  <para style="q1" vid="PSA 106:38">Đem dâng cho tượng thần người Ca-na-an,</para>
  <para style="q2" vid="PSA 106:38">làm cho cả xứ bị ô uế.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Chăm điều ác nên toàn dân nhơ nhuốc,</para>
  <para style="q2" vid="PSA 106:39">lầm lạc tà dâm với tà thần.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Chúa Hằng Hữu nổi giận vô cùng,</para>
  <para style="q2" vid="PSA 106:40">và Ngài ghê tởm cơ nghiệp mình.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Ngài phó họ cho người ngoại quốc,</para>
  <para style="q2" vid="PSA 106:41">Ngài khiến kẻ thù cai trị họ.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Và kẻ thù họ áp bức họ,</para>
  <para style="q2" vid="PSA 106:42">họ cúi đầu vâng phục.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Nhiều lần Chúa ra tay giải cứu,</para>
  <para style="q2" vid="PSA 106:43">nhưng họ luôn phản nghịch cứng đầu,</para>
  <para style="q2" vid="PSA 106:43">họ ngày càng chìm sâu trong biển tội.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Dù vậy khi dân Ngài kêu la thảm thiết</para>
  <para style="q2" vid="PSA 106:44">Chúa chợt nhìn xuống cảnh lầm than.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Ngài nhớ lại những lời giao ước của Ngài,</para>
  <para style="q2" vid="PSA 106:45">Ngài động lòng thương bởi đức nhân ái.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Ngài khiến quân thù sinh lòng trắc ẩn,</para>
  <para style="q2" vid="PSA 106:46">người nắm cường quyền cũng phải xót xa.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Xin cứu chúng con, Chúa Hằng Hữu, Đức Chúa Trời chúng con ôi!</para>
  <para style="q2" vid="PSA 106:47">Tụ họp chúng con từ các dân tộc,</para>
  <para style="q1" vid="PSA 106:47">để dâng lời tạ ơn Danh Thánh Chúa</para>
  <para style="q2" vid="PSA 106:47">và vui mừng hát ngợi khen Ngài.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Chúc tụng Chúa Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,</para>
  <para style="q2" vid="PSA 106:48">Đấng đáng được tôn ngợi từ muôn đời trước đến muôn đời sau!</para>
  <para style="q2" vid="PSA 106:48">Nguyện muôn dân đồng nói: “A-men!”</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms1">Quyển Thứ Năm</para>
  <para style="mr">(<ref loc="PSA 107-150">Thi Thiên 107–150</ref>)</para>
  <para style="cl">Thi Thiên 107</para>
  <para style="s1">Chúa Cứu Dân Ngài Thoát Khỏi Nhiều Khổ Nạn</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!</para>
  <para style="q2" vid="PSA 107:1">Sự thành tín Ngài còn mãi đời đời.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Có phải Chúa Hằng Hữu đã cứu không? Hãy nói lớn!</para>
  <para style="q2" vid="PSA 107:2">Cho mọi người biết Chúa giải cứu khỏi bọn nghịch thù.<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Chúa đã hội họp dân lưu đày từ các nước,</para>
  <para style="q2" vid="PSA 107:3">từ đông sang tây,</para>
  <para style="q2" vid="PSA 107:3">từ bắc chí nam.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Họ lưu lạc giữa hoang mạc hoang vu,</para>
  <para style="q2" vid="PSA 107:4">họ lang thang, không nơi trú ẩn.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Đói và khát,</para>
  <para style="q2" vid="PSA 107:5">họ gần như chết.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Lúc gian nan, họ kêu cầu: “Lạy Chúa Hằng Hữu, xin cứu giúp!”</para>
  <para style="q2" vid="PSA 107:6">Ngài liền cứu họ khỏi cảnh đớn đau.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Chúa dẫn họ theo đường ngay thẳng,</para>
  <para style="q2" vid="PSA 107:7">đến một thành có thể định cư.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,</para>
  <para style="q2" vid="PSA 107:8">và những việc kỳ diệu Ngài đã thực hiện.<note caller="+" style="f"><char style="fr" closed="false">107:8 </char><char style="ft" closed="false">Nt Ngài làm cho con cái loài người</char></note><verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Chúa thỏa mãn tâm hồn khao khát</para>
  <para style="q2" vid="PSA 107:9">và cho lòng đói được no nê mãn nguyện.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Có người đang ngồi trong bóng tối tử vong,</para>
  <para style="q2" vid="PSA 107:10">bị xiềng xích gông cùm tuyệt vọng.<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />Họ từng nổi loạn chống đối lời Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 107:11">khinh miệt sự khuyên dạy của Đấng Chí Cao.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Nên Ngài dùng gian khổ để kỷ luật họ,</para>
  <para style="q2" vid="PSA 107:12">họ gục ngã, không người giúp đỡ.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />“Lạy Chúa Hằng Hữu, xin cứu giúp!” Họ kêu cầu trong lúc gian nan,</para>
  <para style="q2" vid="PSA 107:13">và Ngài giải cứu khỏi cơn hoạn nạn.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Đem họ thoát vùng bóng tối tử vong;</para>
  <para style="q2" vid="PSA 107:14">và đập tan xiềng xích cùm gông.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,</para>
  <para style="q2" vid="PSA 107:15">và những việc diệu kỳ Ngài thực hiện.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Vì Ngài bẻ gông, xiềng bằng đồng,</para>
  <para style="q2" vid="PSA 107:16">và cắt đứt song sắt giam cầm họ.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Người dại dột theo đường tội lỗi,</para>
  <para style="q2" vid="PSA 107:17">gặp hoạn nạn, khốn khổ vì ác gian.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Họ không thiết ăn uống,</para>
  <para style="q2" vid="PSA 107:18">đến gần cửa tử vong.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Bấy giờ trong lúc nguy khốn, họ kêu cầu Chúa,</para>
  <para style="q2" vid="PSA 107:19">Ngài liền cứu họ khỏi cảnh gian nan.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Ngài ra lệnh chữa lành bệnh tật,</para>
  <para style="q2" vid="PSA 107:20">rút khỏi vòm cửa mộ âm u.<note caller="+" style="f"><char style="fr" closed="false">107:20 </char><char style="ft" closed="false">Mộ người Ít-ra-ên ngày xưa thường là một phòng có vòm đào trong sườn núi đá</char></note><verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài</para>
  <para style="q2" vid="PSA 107:21">và những việc diệu kỳ Ngài thực hiện.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Nguyện họ dâng tế lễ tạ ơn</para>
  <para style="q2" vid="PSA 107:22">và hát ca, thuật lại công việc Ngài.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Những ai làm ăn trên biển,</para>
  <para style="q2" vid="PSA 107:23">những doanh thương xuôi ngược đại dương.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Đều nhận ra năng quyền Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 107:24">các việc diệu kỳ Ngài thực hiện tại biển sâu.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Ngài truyền lệnh nổi cơn gió bão,</para>
  <para style="q2" vid="PSA 107:25">cho biển sâu sôi động cuồng lan.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Nâng tàu lên cao tận trời xanh,</para>
  <para style="q2" vid="PSA 107:26">rồi chìm xuống đáy vực tan tành;</para>
  <para style="q2" vid="PSA 107:26">làm ai nấy hồn tan ra nước.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Như người say quay cuồng lảo đảo,</para>
  <para style="q2" vid="PSA 107:27">không còn phương cách.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Trong lúc gian nan họ kêu cầu:</para>
  <para style="q2" vid="PSA 107:28">“Lạy Chúa Hằng Hữu, xin cứu giúp!”</para>
  <para style="q2" vid="PSA 107:28">Và Ngài giải cứu khỏi cơn hoạn nạn.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Ban lệnh trên gió nước đại dương,</para>
  <para style="q2" vid="PSA 107:29">cho yên bão lớn, cho ngừng sóng to.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Họ vui mừng vì tai qua nạn khỏi,</para>
  <para style="q2" vid="PSA 107:30">Chúa dẫn họ về đến bến bờ ước mong.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,</para>
  <para style="q2" vid="PSA 107:31">và những việc diệu kỳ Ngài thực hiện.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Hãy vinh danh Chúa cùng hội chúng,</para>
  <para style="q2" vid="PSA 107:32">trước mặt các lãnh đạo các nước.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Chúa biến sông xanh thành hoang mạc,</para>
  <para style="q2" vid="PSA 107:33">suối tươi mát ra đất khô khan.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Do lòng gian dối của cư dân,</para>
  <para style="q2" vid="PSA 107:34">vườn ruộng phì nhiêu thành bãi mặn.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Nhưng, Chúa cũng biến hoang mạc thành hồ ao,</para>
  <para style="q2" vid="PSA 107:35">đất khô tuôn dòng suối ngọt ngào.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Ngài đem người đói đến cư trú tại đó</para>
  <para style="q2" vid="PSA 107:36">và xây dựng thành phố cho dân.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Họ gieo giống trong ruộng và trồng nho,</para>
  <para style="q2" vid="PSA 107:37">rồi bội thu mùa màng gặt hái.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Chúa ban phước cho họ biết bao!</para>
  <para style="q2" vid="PSA 107:38">Ngài cho dân số họ gia tăng,</para>
  <para style="q2" vid="PSA 107:38">và súc vật cũng gia tăng không kém.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Khi họ bị suy giảm dân số và sa sút,</para>
  <para style="q2" vid="PSA 107:39">vì áp bức, tai ương, và khổ não.<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />Chúa Hằng Hữu đổ sự khinh miệt trên các vua chúa,</para>
  <para style="q2" vid="PSA 107:40">vì khiến họ lang thang trong hoang mạc không lối thoát.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Nhưng Ngài giải cứu người nghèo khổ khỏi hoạn nạn</para>
  <para style="q2" vid="PSA 107:41">và cho con cháu họ thêm đông như bầy chiên.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Những người công chính sẽ thấy điều này và vui mừng,</para>
  <para style="q2" vid="PSA 107:42">còn bọn ác nhân đành im hơi nín tiếng.<verse eid="PSA 107:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Nguyện người khôn ngoan ghi nhận việc này,</para>
  <para style="q2" vid="PSA 107:43">để hiểu rõ lòng Chúa Hằng Hữu chí nhân chí ái.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="cl">Thi Thiên 108</para>
  <para style="s1">Ca Ngợi Chúa và Xin Giúp Chiến Thắng</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Lạy Đức Chúa Trời, lòng con vững chắc;<note caller="+" style="f"><char style="fr" closed="false">108:1 </char><char style="ft" closed="false">Ctd lòng con sẵn sàng</char></note></para>
  <para style="q2" vid="PSA 108:1">con sẽ hát mừng, trổi nhạc với trọn tâm hồn.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Hãy bừng tỉnh, hỡi đàn lia và đàn hạc!</para>
  <para style="q2" vid="PSA 108:2">Ta vùng dậy đánh thức hừng đông.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Con sẽ cảm tạ Chúa trong các dân tộc.</para>
  <para style="q2" vid="PSA 108:3">Ca ngợi Ngài giữa các quốc gia.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Vì đức nhân ái Chúa lớn hơn bầu trời.</para>
  <para style="q2" vid="PSA 108:4">Sự thành tín Ngài vượt quá mây xanh.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Hãy tán dương Ngài lên tận các tầng trời cao.</para>
  <para style="q2" vid="PSA 108:5">Và vinh quang Ngài khắp địa cầu.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Xin giải cứu người Chúa thương yêu.</para>
  <para style="q2" vid="PSA 108:6">Đưa tay<note caller="+" style="f"><char style="fr" closed="false">108:6 </char><char style="ft" closed="false">Nt tay phải</char></note> cứu vớt, nhận lời cầu xin.<note caller="+" style="f"><char style="fr" closed="false">108:6 </char><char style="ft" closed="false">Ctd trả lời cho con</char></note><verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Đức Chúa Trời đã phán trong nơi thánh:</para>
  <para style="q2" vid="PSA 108:7">“Ta hân hoan chia đất Si-chem.</para>
  <para style="q2" vid="PSA 108:7">Đo đạc thung lũng Su-cốt.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Ga-la-át là của Ta,</para>
  <para style="q2" vid="PSA 108:8">và Ma-na-se cũng vậy.</para>
  <para style="q1" vid="PSA 108:8">Ép-ra-im, mũ Ta, sẽ cho ra những dũng sĩ Ta,</para>
  <para style="q2" vid="PSA 108:8">và Giu-đa, vương trượng Ta, sẽ tạo nên các vua Ta.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Nhưng Mô-áp, bồn rửa Ta, sẽ trở nên đầy tớ Ta,</para>
  <para style="q2" vid="PSA 108:9">Ta sẽ chùi chân Ta trên Ê-đôm,</para>
  <para style="q2" vid="PSA 108:9">Phi-li-tin là nơi Ta hát khúc khải hoàn.”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Ai sẽ đưa con đến thành chiến đấu?</para>
  <para style="q2" vid="PSA 108:10">Ai dẫn con vào rừng núi Ê-đôm?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Lạy Đức Chúa Trời, chẳng phải Ngài đã từ bỏ chúng con sao?</para>
  <para style="q2" vid="PSA 108:11">Lẽ nào Ngài không ra trận với chúng con nữa?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Ôi, xin giúp chúng con chống lại kẻ thù của chúng con,</para>
  <para style="q2" vid="PSA 108:12">vì loài người vô năng, chẳng giúp được gì.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Nhờ sức Đức Chúa Trời, chúng con đấu tranh anh dũng,</para>
  <para style="q2" vid="PSA 108:13">vì chính Ngài chà nát quân thù chúng con.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="cl">Thi Thiên 109</para>
  <para style="s1">Cầu Chúa Báo Thù Kẻ Địch</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Lạy Đức Chúa Trời, Đấng con ca tụng,</para>
  <para style="q2" vid="PSA 109:1">xin đừng im tiếng và tránh xa<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />vì bọn ác và quân lừa đảo đang chống lại con,</para>
  <para style="q2" vid="PSA 109:2">dối gạt con bằng miệng lưỡi láo xược.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Phủ đầu con với những câu thù hận,</para>
  <para style="q2" vid="PSA 109:3">đả kích và sỉ nhục con vô cớ.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Họ vu cáo con dù con thương yêu họ</para>
  <para style="q2" vid="PSA 109:4">nên con chỉ biết cầu nguyện!<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Họ luôn luôn lấy ác báo thiện,</para>
  <para style="q2" vid="PSA 109:5">lấy hận thù đáp lại tình thương.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Xin Chúa đặt người bạo ngược xét xử họ.</para>
  <para style="q2" vid="PSA 109:6">Cử người buộc tội họ trước phiên tòa.<note caller="+" style="f"><char style="fr" closed="false">109:6 </char><char style="ft" closed="false">Nt để Sa-tan đứng bên phải nó </char></note><verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Trước vành móng ngựa, họ bị kết án,</para>
  <para style="q2" vid="PSA 109:7">lời cầu khẩn họ bị coi là lời buộc tội.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Cuộc đời họ bị rút ngắn lại;</para>
  <para style="q2" vid="PSA 109:8">tài sản họ bị người khác tước đoạt.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Con cái họ trở thành côi cút,</para>
  <para style="q2" vid="PSA 109:9">vợ họ lâm vào cảnh góa bụa.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Dòng dõi<note caller="+" style="f"><char style="fr" closed="false">109:10 </char><char style="ft" closed="false">Nt con cái</char></note> họ lang thang khất thực,</para>
  <para style="q2" vid="PSA 109:10">bị đuổi khỏi căn nhà xiêu vẹo.<note caller="+" style="f"><char style="fr" closed="false">109:10 </char><char style="ft" closed="false">Ctd để chúng từ nhà mục vách xiêu ra đi kiếm ăn</char></note><verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Bọn chủ nợ cướp mất tài sản,</para>
  <para style="q2" vid="PSA 109:11">và người lạ tước đoạt tiền công họ.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Không còn ai tỏ chút lòng thương xót;</para>
  <para style="q2" vid="PSA 109:12">không một người chạnh thương đàn con côi cút.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Con cái họ bị tuyệt tự.</para>
  <para style="q2" vid="PSA 109:13">Thế hệ tiếp, tên họ bị gạch bỏ.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Nguyện Chúa Hằng Hữu không bao giờ quên tội ác cha ông họ;</para>
  <para style="q2" vid="PSA 109:14">không xóa bôi lỗi lầm của mẹ họ.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Nguyện Chúa Hằng Hữu luôn nhớ tội lỗi họ,</para>
  <para style="q2" vid="PSA 109:15">xóa kỷ niệm của họ khỏi đất.<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Vì họ chẳng bao giờ thương xót ai,</para>
  <para style="q2" vid="PSA 109:16">chỉ bức hại người nghèo và khốn khó,</para>
  <para style="q2" vid="PSA 109:16">săn bắt người nản lòng để giết đi.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Họ thích chửi rủa người khác;</para>
  <para style="q2" vid="PSA 109:17">nên bị người đời nguyền rủa.</para>
  <para style="q1" vid="PSA 109:17">Họ chẳng bao giờ cầu phước;</para>
  <para style="q2" vid="PSA 109:17">nên phước lánh xa.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Chúng lấy nguyền rủa phủ thân mình như mặc áo,</para>
  <para style="q2" vid="PSA 109:18">lời rủa sả tràn ngập chúng như nước,</para>
  <para style="q2" vid="PSA 109:18">dầm thấm xương tủy chúng như dầu.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Nguyện lời nguyền rủa như chiếc áo bao bọc họ,</para>
  <para style="q2" vid="PSA 109:19">như giây nịt mang luôn dưới hông.<verse eid="PSA 109:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Nguyện quân thù bị Chúa Hằng Hữu báo trả xứng đáng</para>
  <para style="q2" vid="PSA 109:20">và bọn nói hành tôi bị hình phạt công bằng.<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Nhưng, Lạy Chúa Hằng Hữu Chí Cao, xin can thiệp,</para>
  <para style="q2" vid="PSA 109:21">vì con mang danh là con cái Chúa!</para>
  <para style="q1" vid="PSA 109:21">Xin giải cứu con</para>
  <para style="q2" vid="PSA 109:21">vì Ngài thật thành tín và nhân từ.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Vì con khốn khổ và nghèo thiếu,</para>
  <para style="q2" vid="PSA 109:22">tâm hồn con đang bị thương tổn.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Đời con qua nhanh như chiếc bóng chiều tà;</para>
  <para style="q2" vid="PSA 109:23">con bị giũ sạch như loài châu chấu.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Con đói khát nên đầu gối rã rời,</para>
  <para style="q2" vid="PSA 109:24">thân hình tiều tụy và gầy guộc.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Con trở thành biểu tượng con người thất bại,</para>
  <para style="q2" vid="PSA 109:25">dân chúng thấy con đều lắc đầu phỉ nhổ.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Lạy Chúa Hằng Hữu, Đức Chúa Trời con, xin ra tay cứu giúp!</para>
  <para style="q2" vid="PSA 109:26">Giải cứu con vì Chúa nhân từ.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Xin cho họ biết bàn tay Chúa,</para>
  <para style="q2" vid="PSA 109:27">chính Ngài đã can thiệp giải nguy.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Dù họ nguyền rủa thế nào con cũng chịu,</para>
  <para style="q2" vid="PSA 109:28">miễn sao con được Chúa ban phước lành!</para>
  <para style="q1" vid="PSA 109:28">Khi họ nổi lên, họ sẽ bị hổ thẹn!</para>
  <para style="q2" vid="PSA 109:28">Nhưng con, đầy tớ Chúa, sẽ hân hoan!<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Nguyện bọn người cáo gian bị ô danh;</para>
  <para style="q2" vid="PSA 109:29">sự sỉ nhục như áo choàng bao trùm người họ.<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Con sẽ reo mừng cảm tạ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 109:30">con sẽ ca tụng Ngài, giữa toàn dân,<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Vì Chúa luôn đứng bên người nghèo khổ,</para>
  <para style="q2" vid="PSA 109:31">sẵn sàng giải cứu người khỏi tay bọn sát nhân.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="cl">Thi Thiên 110</para>
  <para style="s1">Chúa Ban Quyền cho Vua</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />Chúa Hằng Hữu đã phán về Chúa của con rằng:</para>
  <para style="q2" vid="PSA 110:1">“Hãy ngồi bên phải Ta,</para>
  <para style="q2" vid="PSA 110:1">cho đến kỳ Ta cho kẻ thù Con làm bệ chân cho Con.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Từ Si-ôn Chúa Hằng Hữu sẽ đưa đến quyền trượng sức mạnh cho Chúa.</para>
  <para style="q2" vid="PSA 110:2">Chúa sẽ cai trị giữa những kẻ thù.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Đến ngày Chúa biểu dương quyền bính trên núi thánh,</para>
  <para style="q2" vid="PSA 110:3">dân Chúa sẽ sẵn lòng hiến thân.</para>
  <para style="q1" vid="PSA 110:3">Từ trong lòng rạng đông,</para>
  <para style="q2" vid="PSA 110:3">những thanh niên sẽ đến với Ngài như sương móc.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />Chúa Hằng Hữu đã thề hứa và sẽ không đổi ý rằng:</para>
  <para style="q2" vid="PSA 110:4">“Con làm thầy tế lễ đời đời</para>
  <para style="q2" vid="PSA 110:4">theo phẩm trật Mên-chi-xê-đéc.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Chúa ngồi bên phải Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 110:5">Ngài sẽ đánh tan các vua trong ngày thịnh nộ.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Chúa sẽ xét đoán các dân</para>
  <para style="q2" vid="PSA 110:6">và khắp đất sẽ chất cao xác chết;</para>
  <para style="q2" vid="PSA 110:6">Ngài sẽ đánh tan các lãnh tụ của thế gian.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Ngài sẽ uống nước nơi dòng suối bên đường.</para>
  <para style="q2" vid="PSA 110:7">Ngài sẽ chiến thắng khải hoàn.<note caller="+" style="f"><char style="fr" closed="false">110:7 </char><char style="ft" closed="false">Nt như thế Ngài sẽ ngước đầu lên</char></note><verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="cl">Thi Thiên 111</para>
  <para style="s1">Ca Ngợi Chúa vì Hay Làm Ơn</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">Con sẽ hết lòng tạ ơn Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 111:1">giữa hội chúng và cộng đồng người công chính.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Công ơn Chúa vô cùng vĩ đại!</para>
  <para style="q2" vid="PSA 111:2">Những người ham thích đáng nên học hỏi.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Công tác Chúa uy nghi trác tuyệt.</para>
  <para style="q2" vid="PSA 111:3">Công nghĩa Ngài còn mãi muôn đời.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Kỳ công Chúa đáng nên ghi nhớ.</para>
  <para style="q2" vid="PSA 111:4">Ngài đầy tràn ân lành và trắc ẩn biết bao!<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Chúa nuôi dưỡng những người tin kính;</para>
  <para style="q2" vid="PSA 111:5">và nhớ giao ước Ngài mãi mãi.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Chúa phô bày quyền năng kỳ diệu,</para>
  <para style="q2" vid="PSA 111:6">cho dân Ngài cơ nghiệp của các nước.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Tay Chúa thực thi chân thật, công bằng,</para>
  <para style="q2" vid="PSA 111:7">mệnh lệnh Ngài thật đáng tin cậy.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Được kiên lập đời đời vĩnh cửu,</para>
  <para style="q2" vid="PSA 111:8">một cách công bằng và chân thật.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Chúa đem cứu rỗi cho toàn dân.</para>
  <para style="q2" vid="PSA 111:9">Xác nhận giao ước Ngài mãi mãi.</para>
  <para style="q2" vid="PSA 111:9">Danh Chúa thật thánh và đáng sợ!<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Kính sợ Chúa Hằng Hữu là nền của sự khôn ngoan.</para>
  <para style="q2" vid="PSA 111:10">Ai vâng lời Ngài sẽ lớn lên trong khôn ngoan.</para>
  <para style="b" vid="PSA 111:10" />
  <para style="q1" vid="PSA 111:10">Tán dương Chúa đời đời vĩnh cửu!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="cl">Thi Thiên 112</para>
  <para style="s1">Người Kính Sợ Chúa Được Thành Công</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Phước hạnh cho người kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 112:1">và hết lòng vui thích tuân hành mệnh lệnh Ngài.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Hạt giống người gieo nứt mầm mạnh mẽ;</para>
  <para style="q2" vid="PSA 112:2">dòng dõi công chính được phước lành.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Nhà người tích lũy nhiều của cải,</para>
  <para style="q2" vid="PSA 112:3">đức công chính người còn mãi mãi.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Ánh sáng soi đường giữa tối tăm.</para>
  <para style="q2" vid="PSA 112:4">Cho người nhân từ, trắc ẩn và công bằng.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Có lòng hào phóng, sẵn lòng cho mượn</para>
  <para style="q2" vid="PSA 112:5">nên được minh oan trong ngày xử đoán.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Người chẳng bao giờ rúng động.</para>
  <para style="q2" vid="PSA 112:6">Cuộc đời người công chính được ghi nhớ.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Người không sợ tiếng đồn, tin dữ;</para>
  <para style="q2" vid="PSA 112:7">lòng dạ vững vàng tin cậy Chúa,<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Người kiên tâm và không sợ hãi</para>
  <para style="q2" vid="PSA 112:8">cho đến lúc quân thù tan rã.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Người phân chia của cải, cứu tế người có cần.</para>
  <para style="q2" vid="PSA 112:9">Đức công chính người còn mãi mãi.</para>
  <para style="q2" vid="PSA 112:9">Người được hãnh diện và tôn cao.<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="ft" closed="false">Nt sừng người được đưa cao lên cách vinh dự </char></note><verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Bọn gian ác thấy thế liền thất vọng.</para>
  <para style="q2" vid="PSA 112:10">Nghiến răng giận dữ rồi suy tàn;</para>
  <para style="q2" vid="PSA 112:10">ước vọng của người ác sẽ tiêu tan.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="cl">Thi Thiên 113</para>
  <para style="s1">Ca Ngợi Chúa Cất Nhắc Người Khiêm Nhượng</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">Hãy ca ngợi Chúa, các đầy tớ Chúa Hằng Hữu.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Hãy chúc tụng Danh Thánh Ngài</para>
  <para style="q2" vid="PSA 113:2">hôm nay và mãi mãi.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Khắp mọi nơi—từ đông sang tây—</para>
  <para style="q2" vid="PSA 113:3">hãy ca tụng Danh Chúa Hằng Hữu.<verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Vì Chúa Hằng Hữu cầm quyền tối cao trên các dân;</para>
  <para style="q2" vid="PSA 113:4">vinh quang Ngài rực rỡ hơn các tầng trời.<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Ai có thể sánh với Chúa Hằng Hữu, Đức Chúa Trời chúng ta,</para>
  <para style="q2" vid="PSA 113:5">Đấng ngự trên cao?<verse eid="PSA 113:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Ngài khom mình xuống</para>
  <para style="q2" vid="PSA 113:6">nhìn xem mọi vật trong bầu trời và trên đất.<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Ngài nâng người nghèo khổ từ tro bụi</para>
  <para style="q2" vid="PSA 113:7">và cứu người đói khát khỏi rác rơm.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Ngài đặt họ ngang hàng các hoàng tử,</para>
  <para style="q2" vid="PSA 113:8">chung với các hoàng tử của dân Ngài.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Chúa ban con cái cho người hiếm muộn,</para>
  <para style="q2" vid="PSA 113:9">cho họ làm người mẹ hạnh phúc.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">Chúc tôn Chúa Hằng Hữu!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="cl">Thi Thiên 114</para>
  <para style="s1">Chúa Giải Cứu Dân Ngài Khỏi Ai Cập</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Khi Ít-ra-ên rời khỏi Ai Cập—</para>
  <para style="q2" vid="PSA 114:1">nhà Gia-cốp lìa bỏ dân nói tiếng nước ngoài—<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />đất Giu-đa biến thành nơi thánh Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 114:2">và Ít-ra-ên làm vương quốc của Ngài.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Biển chợt thấy, liền chạy trốn!</para>
  <para style="q2" vid="PSA 114:3">Sông Giô-đan nước chảy ngược dòng.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Núi cao run rẩy chạy như dê,</para>
  <para style="q2" vid="PSA 114:4">đồi xanh nhảy nhót như chiên con.<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Biển Đỏ, vì sao ngươi chạy trốn</para>
  <para style="q2" vid="PSA 114:5">Giô-đan chảy xiết, sao lùi lại?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Núi lớn, vì sao mà run rẩy?</para>
  <para style="q2" vid="PSA 114:6">Đồi xanh sao lại nhảy như chiên con?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Trái đất hỡi, hãy run sợ trước thánh nhan Chúa,</para>
  <para style="q2" vid="PSA 114:7">tại nơi Đức Chúa Trời nhà Gia-cốp hiện diện.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />Ngài biến đá tảng ra ao hồ;</para>
  <para style="q2" vid="PSA 114:8">đổi đá cứng thành suối nước.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="cl">Thi Thiên 115</para>
  <para style="s1">So Sánh Thần Tượng với Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Lạy Chúa Hằng Hữu, không thuộc về chúng con,</para>
  <para style="q2" vid="PSA 115:1">nhưng nguyện vinh quang thuộc về Danh Chúa,</para>
  <para style="q2" vid="PSA 115:1">vì Chúa đầy tình thương và thành tín.<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Sao các dân tộc hỏi nhau:</para>
  <para style="q2" vid="PSA 115:2">“Đức Chúa Trời chúng nó ở đâu?”<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Đức Chúa Trời chúng con ngự trên trời,</para>
  <para style="q2" vid="PSA 115:3">Ngài muốn làm việc gì tùy thích.<note caller="+" style="f"><char style="fr" closed="false">115:3 </char><char style="ft" closed="false">Nt việc Ngài hài lòng</char></note><verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Còn thần chúng nó bằng bạc vàng,</para>
  <para style="q2" vid="PSA 115:4">chế tạo do bàn tay loài người;<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Có miệng không nói năng,</para>
  <para style="q2" vid="PSA 115:5">và mắt không thấy đường.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Có tai nhưng không nghe được,</para>
  <para style="q2" vid="PSA 115:6">có mũi nhưng không ngửi.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Tay lạnh lùng vô giác,</para>
  <para style="q2" vid="PSA 115:7">chân bất động khô cằn,</para>
  <para style="q2" vid="PSA 115:7">họng im lìm cứng ngắt.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Người tạo ra hình tượng và người thờ tà thần</para>
  <para style="q2" vid="PSA 115:8">đều giống như hình tượng.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Ít-ra-ên, khá tin cậy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 115:9">Ngài là Đấng cứu trợ và thuẫn che chở họ.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Nhà A-rôn, hãy tin cậy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 115:10">Ngài là Đấng cứu trợ và là thuẫn che chở họ.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Những ai kính sợ Chúa Hằng Hữu, hãy tin cậy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 115:11">Ngài là Đấng cứu trợ và thuẫn che chở cho người.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />Chúa Hằng Hữu ghi nhớ chúng ta và ban phước dồi dào.</para>
  <para style="q2" vid="PSA 115:12">Ngài ban phước cho người Ít-ra-ên,</para>
  <para style="q2" vid="PSA 115:12">và thầy tế lễ, dòng họ A-rôn.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />Chúa sẽ ban phước cho người kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 115:13">bất luận lớn nhỏ.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Nguyện cầu Chúa Hằng Hữu ban phước</para>
  <para style="q2" vid="PSA 115:14">cho anh chị em và cho con cháu.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Nguyện anh chị em được hưởng phước Chúa ban,</para>
  <para style="q2" vid="PSA 115:15">Đấng dựng nên trời và đất.<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Trời thuộc về Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 115:16">nhưng Ngài ban đất cho loài người.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Người đã chết làm sao ca tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 115:17">an giấc rồi, nín lặng cả thiên thu.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Nhưng chúng con luôn chúc tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 115:18">từ nay cho đến muôn đời về sau!</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Tán dương Chúa Hằng Hữu!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="cl">Thi Thiên 116</para>
  <para style="s1">Cảm Tạ Chúa vì Được Cứu Khỏi Chết</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Tôi yêu mến Chúa Hằng Hữu vì Ngài nghe tiếng tôi cầu cứu.<note caller="+" style="f"><char style="fr" closed="false">116:1 </char><char style="ft" closed="false">Ctd nghe tiếng nói và lời nài xin của tôi</char></note><verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Suốt đời, tôi sẽ kêu cầu Chúa,</para>
  <para style="q2" vid="PSA 116:2">vì Ngài lắng nghe tôi khẩn nguyện.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Tôi mắc vào cạm bẫy tử thần;</para>
  <para style="q2" vid="PSA 116:3">thống khổ âm phủ chụp đầu tôi.</para>
  <para style="q2" vid="PSA 116:3">Gieo nỗi niềm đau thương, sầu muộn.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Lúc ấy, tôi kêu cầu Danh Chúa Hằng Hữu:</para>
  <para style="q2" vid="PSA 116:4">“Chúa Hằng Hữu ôi, xin Ngài giải cứu con.”<verse eid="PSA 116:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />Chúa Hằng Hữu đầy ân sủng và công chính!</para>
  <para style="q2" vid="PSA 116:5">Đức Chúa Trời rủ lòng xót thương!<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />Chúa Hằng Hữu bảo tồn người chân chất;</para>
  <para style="q2" vid="PSA 116:6">khi tôi sụp xuống, Chúa liền đỡ nâng.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Hồn ta hỡi, hãy về nơi an nghỉ,</para>
  <para style="q2" vid="PSA 116:7">vì Chúa Hằng Hữu hậu đãi tôi.<verse eid="PSA 116:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Chúa đã cứu linh hồn tôi khỏi chết,</para>
  <para style="q2" vid="PSA 116:8">mắt tôi khỏi rơi lệ đầm đìa,</para>
  <para style="q2" vid="PSA 116:8">chân tôi không hề vấp ngã.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Trọn đời tôi sẽ tiến bước theo Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 116:9">suốt hành trình của tôi trên trần thế.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Tôi vững tin nơi Ngài, nên nói:</para>
  <para style="q2" vid="PSA 116:10">“Con đau khổ vô ngần, lạy Chúa Hằng Hữu.”<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />Trong cơn bối rối, tôi kêu khóc với Ngài:</para>
  <para style="q2" vid="PSA 116:11">“Tất cả mọi người đều nói dối!”<verse eid="PSA 116:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Giờ đây, Chúa đã ra tay cứu độ,</para>
  <para style="q2" vid="PSA 116:12">tôi làm sao báo đáp ân Ngài?<note caller="+" style="f"><char style="fr" closed="false">116:12 </char><char style="ft" closed="false">Ctd tôi sẽ lấy gì báo đáp tất cả ân lành Ngài ban cho tôi</char></note><verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Tôi sẽ nâng chén cứu rỗi lên</para>
  <para style="q2" vid="PSA 116:13">và khẩn cầu trong Danh Chúa Hằng Hữu.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Tôi sẽ trung tín giữ điều hứa nguyện với Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 116:14">trước mặt toàn dân của Ngài.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Chúa Hằng Hữu quý trọng mạng sống</para>
  <para style="q2" vid="PSA 116:15">của người trung tín với Chúa khi họ qua đời.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Lạy Chúa Hằng Hữu, con là đầy tớ Ngài;</para>
  <para style="q2" vid="PSA 116:16">phải, thân phận như con cái của nô tỳ Ngài;</para>
  <para style="q2" vid="PSA 116:16">nhưng Chúa đã giải cứu con khỏi xiềng xích.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Con sẽ hiến dâng lễ vật tạ ơn Ngài</para>
  <para style="q2" vid="PSA 116:17">và kêu cầu Danh Chúa Hằng Hữu.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Con sẽ trung tín giữ điều hứa nguyện với Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 116:18">trước mặt dân của Ngài—<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />tại hành lang của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 116:19">giữa Giê-ru-sa-lem.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Tung hô Chúa Hằng Hữu!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="cl">Thi Thiên 117</para>
  <para style="s1">Khuyên Muôn Dân Ca Ngợi Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Tất cả các nước, hãy chúc tụng Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 117:1">Tất cả các dân, hãy ca ngợi Ngài!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Vì Ngài thiết tha yêu chúng ta mãi mãi;</para>
  <para style="q2" vid="PSA 117:2">đức thành tín của Chúa Hằng Hữu vững chãi muôn đời.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Đáng chúc tụng thay Chúa Hằng Hữu!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="cl">Thi Thiên 118</para>
  <para style="s1">Đức Nhân Từ Chúa Còn Đời Đời</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!</para>
  <para style="q2" vid="PSA 118:1">Đức thành tín Ngài còn đến đời đời.<verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Hỡi nhà Ít-ra-ên hãy xưng tụng:</para>
  <para style="q2" vid="PSA 118:2">“Đức thành tín Chúa còn đến đời đời.”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Hỡi con cháu A-rôn, thầy tế lễ, hãy tung hô:</para>
  <para style="q2" vid="PSA 118:3">“Đức thành tín Chúa còn đến đời đời.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Hỡi những người kính sợ Chúa, hãy đồng thanh:</para>
  <para style="q2" vid="PSA 118:4">“Đức thành tín Chúa còn đến đời đời.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Trong tuyệt vọng, tôi kêu cầu Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 118:5">Ngài nhậm lời đặt tôi lên chỗ vững vàng.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />Chúa Hằng Hữu đứng với tôi, tôi không sợ hãi?</para>
  <para style="q2" vid="PSA 118:6">Loài người có thể làm gì tôi?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Phải, Chúa Hằng Hữu đứng bên; Ngài cứu giúp tôi.</para>
  <para style="q2" vid="PSA 118:7">Nên tôi nhìn người ghét tôi với cái nhìn chiến thắng.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Thà ẩn náu trong Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 118:8">còn hơn nương cậy loài người,<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Nương thân trong Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 118:9">còn hơn cậy vào vua chúa.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Các dân tộc bao vây tôi tràn ngập,</para>
  <para style="q2" vid="PSA 118:10">tôi nhân danh Chúa Hằng Hữu mà tiêu diệt họ.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Họ tiến quân vây chặt quanh tôi,</para>
  <para style="q2" vid="PSA 118:11">nhưng bị quét sạch bởi uy quyền Chúa Hằng Hữu.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Họ vây tôi như ong vỡ tổ;</para>
  <para style="q2" vid="PSA 118:12">nhưng họ bị tàn tắt như ngọn lửa gai.</para>
  <para style="q2" vid="PSA 118:12">Tôi tiêu diệt họ với uy quyền Chúa Hằng Hữu.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Người ta đặt cạm bẫy cho tôi vấp ngã,</para>
  <para style="q2" vid="PSA 118:13">nhưng Chúa Hằng Hữu giải cứu tôi.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />Chúa Hằng Hữu là nguồn sinh lực và bài ca của tôi;</para>
  <para style="q2" vid="PSA 118:14">Ngài đã thành sự cứu rỗi của tôi.<verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Bài hát vui mừng và chiến thắng vang dội trong trại người công chính.</para>
  <para style="q2" vid="PSA 118:15">Tay hữu Chúa Hằng Hữu làm những việc vinh quang!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Tay Chúa Hằng Hữu đưa cao làm việc lớn.</para>
  <para style="q2" vid="PSA 118:16">Tay hữu Chúa Hằng Hữu làm những vinh quang!<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Tôi không chết; nhưng còn sống mạnh,</para>
  <para style="q2" vid="PSA 118:17">để nói ra việc Chúa Hằng Hữu đã làm.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Chúa Hằng Hữu trừng phạt tôi nặng biết bao,</para>
  <para style="q2" vid="PSA 118:18">nhưng không để cho tôi phải chết.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Cửa công chính xin hãy mở ra,</para>
  <para style="q2" vid="PSA 118:19">cho tôi vào ngợi ca Chúa Hằng Hữu.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Các cửa này dẫn vào nơi Chúa Hằng Hữu ngự,</para>
  <para style="q2" vid="PSA 118:20">tất cả người tin kính sẽ vào đây.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Lạy Chúa, con cảm tạ Chúa vô cùng</para>
  <para style="q2" vid="PSA 118:21">vì Chúa nhậm lời, giải cứu con!<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Tảng Đá bị thợ nề loại bỏ,</para>
  <para style="q2" vid="PSA 118:22">đã trở thành đá móng vững vàng.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Chỉ có Chúa Hằng Hữu làm việc ấy,</para>
  <para style="q2" vid="PSA 118:23">việc diệu kỳ dưới mắt loài người.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Đây là ngày Chúa Hằng Hữu tạo nên.</para>
  <para style="q2" vid="PSA 118:24">Chúng con đều hân hoan tận hưởng.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />Lạy Chúa Hằng Hữu, con xin Ngài giải cứu.</para>
  <para style="q2" vid="PSA 118:25">Lạy Chúa Hằng Hữu, xin cho con thành công.<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Phước hạnh cho người đến trong Danh Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 118:26">Chúng con chúc mừng người từ nhà Chúa Hằng Hữu.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Chúa Hằng Hữu là Đức Chúa Trời, soi sáng chúng con.</para>
  <para style="q2" vid="PSA 118:27">Hãy lấy dây cột sinh tế vào các sừng bàn thờ.<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Ngài là Đức Chúa Trời của con, con sẽ ngợi tôn Ngài!</para>
  <para style="q2" vid="PSA 118:28">Ngài là Đức Chúa Trời của con, con sẽ tán dương Ngài!<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!</para>
  <para style="q2" vid="PSA 118:29">Đức thành tín Ngài còn đến đời đời.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="cl">Thi Thiên 119</para>
  <para style="s1">Giữ Điều Răn Luật Lệ Chúa Hằng Hữu</para>
  <para style="qa">1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Hạnh phước thay con người toàn hảo<note caller="+" style="f"><char style="fr" closed="false">119:1 </char><char style="ft" closed="false">Nt toàn hảo trong đường lối</char></note></para>
  <para style="q2" vid="PSA 119:1">thực hành thánh luật Chúa công minh.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Hạnh phước thay những người vâng lệnh<note caller="+" style="f"><char style="fr" closed="false">119:2 </char><char style="ft" closed="false">Ctd không lầm lỗi</char></note></para>
  <para style="q2" vid="PSA 119:2">và tìm cầu Chúa với tất cả tấm lòng.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Họ không làm những điều bất nghĩa</para>
  <para style="q2" vid="PSA 119:3">chỉ đi theo đường lối Ngài thôi.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Chúa đã cho ban hành thánh luật,</para>
  <para style="q2" vid="PSA 119:4">xin dạy chúng con nghiêm chỉnh<note caller="+" style="f"><char style="fr" closed="false">119:4 </char><char style="ft" closed="false">Ctd trung tín</char></note> vâng theo.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Con muốn sống một đời kiên định,</para>
  <para style="q2" vid="PSA 119:5">luôn vâng theo quy tắc của Ngài!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Nên con chẳng bao giờ hổ thẹn,</para>
  <para style="q2" vid="PSA 119:6">vì con luôn tuân hành mệnh lệnh của Chúa.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ca ngợi Chúa với lòng ngay thật,</para>
  <para style="q2" vid="PSA 119:7">khi học theo luật pháp công minh.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Con sẽ luôn vâng giữ giới luật.</para>
  <para style="q2" vid="PSA 119:8">Xin đừng bao giờ từ bỏ con!<verse eid="PSA 119:8" /></para>
  <para style="qa">2</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Người trẻ tuổi làm sao giữ lòng trong sạch?</para>
  <para style="q2" vid="PSA 119:9">Phải chuyên tâm sống theo lời Chúa.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Với nhiệt tâm, con tìm kiếm Chúa—</para>
  <para style="q2" vid="PSA 119:10">đừng để con đi sai huấn thị.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Con giấu kỹ lời Chúa trong lòng con,</para>
  <para style="q2" vid="PSA 119:11">để con không phạm tội cùng Chúa.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Chúc tụng Chúa, ôi Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 119:12">xin dạy con luật lệ của Ngài.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Con xin lấy môi miệng thuật lại</para>
  <para style="q2" vid="PSA 119:13">các phán quyết Chúa đã truyền ra.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Luôn vui mừng vì lời Chúa phán,</para>
  <para style="q2" vid="PSA 119:14">như người được trân châu bảo vật.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Con suy nghiệm nguyên tắc Chúa,</para>
  <para style="q2" vid="PSA 119:15">mắt chăm nhìn đường lối Ngài.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Luật lệ Chúa làm con vui thỏa,</para>
  <para style="q2" vid="PSA 119:16">con chẳng bao giờ dám quên lời Ngài.<verse eid="PSA 119:16" /></para>
  <para style="qa">3</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Xin ban ơn cho đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 119:17">cho con sống để giữ kim ngôn.<note caller="+" style="f"><char style="fr" closed="false">119:17 </char><char style="ft" closed="false">Chỉ về lời Chúa</char></note><verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Xin Chúa mở mắt cho con nhìn thấy,</para>
  <para style="q2" vid="PSA 119:18">những điều kỳ diệu trong luật Ngài.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Con là khách lữ hành trên đất.</para>
  <para style="q2" vid="PSA 119:19">Xin đừng giấu con mệnh lệnh Ngài!<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Tâm hồn con khao khát</para>
  <para style="q2" vid="PSA 119:20">lời tuyên huấn<note caller="+" style="f"><char style="fr" closed="false">119:20 </char><char style="ft" closed="false">Ctd phán quyết</char></note> Chúa ban.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Chúa quở trách những người kiêu ngạo;<note caller="+" style="f"><char style="fr" closed="false">119:21 </char><char style="ft" closed="false">Nt người kiêu ngạo, người đáng rủa</char></note></para>
  <para style="q2" vid="PSA 119:21">hay đi xa các mệnh lệnh của Ngài.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Xin cho sỉ nhục và khinh nhạo xa con,</para>
  <para style="q2" vid="PSA 119:22">vì con vâng giữ luật pháp Chúa.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Dù vua chúa họp nhau chống đối con,<note caller="+" style="f"><char style="fr" closed="false">119:23 </char><char style="ft" closed="false">Ctd hội họp bàn luận chống đối con</char></note></para>
  <para style="q2" vid="PSA 119:23">con vẫn chuyên tâm suy nghiệm luật Ngài.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Chứng ngôn Chúa làm con vui sướng;</para>
  <para style="q2" vid="PSA 119:24">luôn luôn là người cố vấn của con.<verse eid="PSA 119:24" /></para>
  <para style="qa">4</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Con bị chìm sâu trong bụi đất,</para>
  <para style="q2" vid="PSA 119:25">xin làm mới lại đời con theo lời Chúa.<note caller="+" style="f"><char style="fr" closed="false">119:25 </char><char style="ft" closed="false">Ctd theo lời Ngài xin làm cho con hồi sinh</char></note><verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Con kể lể bước đường lưu lạc</para>
  <para style="q2" vid="PSA 119:26">Chúa đáp lời, dạy luật Chúa cho con.<note caller="+" style="f"><char style="fr" closed="false">119:26 </char><char style="ft" closed="false">Ctd xin hãy dạy con giới luật Ngài</char></note><verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Xin cho con hiểu mệnh lệnh của Chúa,</para>
  <para style="q2" vid="PSA 119:27">để con suy nghiệm việc nhiệm mầu của Ngài.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Tâm hồn con chán nản với ưu sầu;</para>
  <para style="q2" vid="PSA 119:28">xin cho con can đảm theo lời Chúa.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Đưa con tránh xa con đường lừa dối;</para>
  <para style="q2" vid="PSA 119:29">rủ lòng thương, đặt luật thánh trong lòng.<note caller="+" style="f"><char style="fr" closed="false">119:29 </char><char style="ft" closed="false">Ctd xin cho con luật pháp Ngài</char></note><verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Con đã chọn con đường chân lý;</para>
  <para style="q2" vid="PSA 119:30">hướng lòng con về luật lệ của Ngài.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Lạy Chúa Hằng Hữu, con bám chặt mối giềng, cương lĩnh,</para>
  <para style="q2" vid="PSA 119:31">xin đừng để con phải xấu hổ!<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Một khi được Chúa khai tâm,</para>
  <para style="q2" vid="PSA 119:32">con sẽ theo đúng mệnh lệnh Chúa.<verse eid="PSA 119:32" /></para>
  <para style="qa">5</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Lạy Chúa Hằng Hữu, xin dạy con đường lối Chúa;</para>
  <para style="q2" vid="PSA 119:33">con sẽ gìn giữ đến cuối cùng.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Xin cho con tri thức để con vâng phục luật lệ Chúa;</para>
  <para style="q2" vid="PSA 119:34">con sẽ giữ luật Ngài và hết lòng vâng theo.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Xin dắt con trên đường điều răn của Chúa,<note caller="+" style="f"><char style="fr" closed="false">119:35 </char><char style="ft" closed="false">Nt đường điều răn</char></note></para>
  <para style="q2" vid="PSA 119:35">vì tại đó con tìm được hoan lạc.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Xin cho lòng con yêu chuộng chứng ngôn,</para>
  <para style="q2" vid="PSA 119:36">đừng hướng về tham lam ích kỷ.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Xin cho mắt đừng chăm những việc vô nghĩa,</para>
  <para style="q2" vid="PSA 119:37">nhưng con được sống lại<note caller="+" style="f"><char style="fr" closed="false">119:37 </char><char style="ft" closed="false">Ctd làm cho con hồi sinh hoặc xin ban cho con sự sống</char></note> theo lời Chúa.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Xin hoàn thành lời hứa Chúa cho con,</para>
  <para style="q2" vid="PSA 119:38">như Chúa làm cho người kính sợ Ngài.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Cho con thoát sỉ nhục con lo ngại;</para>
  <para style="q2" vid="PSA 119:39">vì luật pháp Chúa thật tuyệt vời.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Con hằng mong mỏi mệnh lệnh Chúa!</para>
  <para style="q2" vid="PSA 119:40">Cho con được sống trong công lý Ngài.<verse eid="PSA 119:40" /></para>
  <para style="qa">6</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Lạy Chúa Hằng Hữu, nguyện tình yêu Ngài đến với con,</para>
  <para style="q2" vid="PSA 119:41">giải cứu con theo lời Chúa hứa.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Khi ấy, con có thể đáp lời bọn người sỉ nhục con,</para>
  <para style="q2" vid="PSA 119:42">chỉ vì con tin vào lời Chúa.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Xin đừng rút lời chân thật khỏi miệng con,</para>
  <para style="q2" vid="PSA 119:43">vì con hy vọng nơi luật Chúa.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Con luôn vâng giữ luật lệ Chúa cho đến đời đời vô cùng.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Nên sẽ bước đi tự do,</para>
  <para style="q2" vid="PSA 119:45">vì đã tìm đến các nguyên tắc của Chúa.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Con sẽ công bố thánh lệnh cho các vua,</para>
  <para style="q2" vid="PSA 119:46">không chút rụt rè hổ thẹn.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Con vui thích vâng theo lệnh Chúa!</para>
  <para style="q2" vid="PSA 119:47">Con yêu chuộng lời Ngài biết bao!<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Con tôn kính, mến yêu mệnh lệnh Chúa.</para>
  <para style="q2" vid="PSA 119:48">Con luôn suy gẫm chỉ thị Ngài.<verse eid="PSA 119:48" /></para>
  <para style="qa">7</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Xin Chúa nhớ lời hứa cùng đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 119:49">vì Chúa đã cho con hy vọng.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Giữa khổ đau, con được an ủi;</para>
  <para style="q2" vid="PSA 119:50">vì lời Chúa hứa làm đời con tươi mới.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Người kiêu ngạo không ngớt chế giễu,</para>
  <para style="q2" vid="PSA 119:51">nhưng con không bỏ luật lệ Chúa.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Con nhớ lời phán của Chúa từ xưa;</para>
  <para style="q2" vid="PSA 119:52">lời ấy an ủi con, lạy Chúa Hằng Hữu.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Thấy người ác phế bỏ luật Thánh,</para>
  <para style="q2" vid="PSA 119:53">lòng con đầy phẫn nộ, bất bình.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Luật lệ Chúa là bài ca của con,</para>
  <para style="q2" vid="PSA 119:54">là nơi con cư trú trong cuộc đời lữ khách.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Đêm thanh vắng, con luôn nhớ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 119:55">mãi suy nghiệm luật pháp Ngài ban.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Con đã tìm được hạnh phước;</para>
  <para style="q2" vid="PSA 119:56">khi nghiêm chỉnh theo mệnh lệnh Ngài.<verse eid="PSA 119:56" /></para>
  <para style="qa">8</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />Chúa Hằng Hữu là cơ nghiệp con!</para>
  <para style="q2" vid="PSA 119:57">Con hứa vâng giữ luật pháp Ngài!<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Con hết lòng nài xin ơn Ngài ban phước.</para>
  <para style="q2" vid="PSA 119:58">Xin thương xót như Chúa đã phán tuyên.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Con tự xét hành vi cử chỉ,</para>
  <para style="q2" vid="PSA 119:59">nguyền làm theo đúng ý thánh Chúa.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Con chẳng muốn trì hoãn,</para>
  <para style="q2" vid="PSA 119:60">nhưng vâng ngay lệnh Ngài truyền ra.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Dù bọn gian ác trói con bằng dây</para>
  <para style="q2" vid="PSA 119:61">con cũng không bỏ luật lệ Chúa.<note caller="+" style="f"><char style="fr" closed="false">119:61 </char><char style="ft" closed="false">Nt nhưng con không quên luật pháp Ngài</char></note><verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Đêm khuya thanh vắng con bừng tỉnh,</para>
  <para style="q2" vid="PSA 119:62">ca ngợi Ngài xét xử công minh.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Con kết bạn với người kính sợ Chúa—</para>
  <para style="q2" vid="PSA 119:63">là những ai vâng giữ nguyên tắc Ngài.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Cả địa cầu ngập tràn tình thương Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 119:64">xin giúp con học điều răn Ngài.<verse eid="PSA 119:64" /></para>
  <para style="qa">9</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Chúa đã hậu đãi đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 119:65">đúng như lời Ngài phán hứa.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Xin dạy con hiểu biết và phán đoán,</para>
  <para style="q2" vid="PSA 119:66">vì con tin các mệnh lệnh của Ngài.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Trước khi hoạn nạn con thường lạc lối;</para>
  <para style="q2" vid="PSA 119:67">nhưng hiện nay con vâng giữ lời Ngài.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Chúa nhân lành chuyên làm việc thiện;</para>
  <para style="q2" vid="PSA 119:68">xin cho con học tập bước theo Ngài.<note caller="+" style="f"><char style="fr" closed="false">119:68 </char><char style="ft" closed="false">Ctd xin dạy con giềng mối định lệ của Ngài</char></note><verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Người vô đạo thêu dệt lời vu cáo,</para>
  <para style="q2" vid="PSA 119:69">nhưng con hết lòng giữ lời Chúa dạy.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Lòng ác họ chai lì và vô cảm,</para>
  <para style="q2" vid="PSA 119:70">còn lòng con vui thích luật Ngài.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Hoạn nạn trở thành lợi ích cho con,</para>
  <para style="q2" vid="PSA 119:71">tạo cho con cơ hội học luật lệ của Ngài.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Luật pháp Chúa dạy<note caller="+" style="f"><char style="fr" closed="false">119:72 </char><char style="ft" closed="false">Nt từ miệng Chúa</char></note> thật là bảo vật,</para>
  <para style="q2" vid="PSA 119:72">còn quý hơn hàng nghìn miếng bạc hay vàng.<verse eid="PSA 119:72" /></para>
  <para style="qa">10</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Tay Chúa đã tạo dựng, uốn nắn con.</para>
  <para style="q2" vid="PSA 119:73">Xin cho con sáng suốt học lời Ngài.<note caller="+" style="f"><char style="fr" closed="false">119:73 </char><char style="ft" closed="false">Nt điều răn</char></note><verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Nguyện những người kính sợ Chúa vui mừng khi thấy con,</para>
  <para style="q2" vid="PSA 119:74">vì con đặt niềm hy vọng nơi lời Chúa.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Lạy Chúa, phán quyết Ngài thật đúng,</para>
  <para style="q2" vid="PSA 119:75">và Ngài thành tín khi sửa phạt con.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Cúi xin Chúa từ ái an ủi con,</para>
  <para style="q2" vid="PSA 119:76">theo lời Ngài đã từng tuyên hứa.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Xin Chúa thương cho con được sống,</para>
  <para style="q2" vid="PSA 119:77">vì con vui thích luật pháp Ngài.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Nguyện người kiêu căng phải hổ thẹn vì họ vô cớ tráo trở lừa gạt con;</para>
  <para style="q2" vid="PSA 119:78">nhưng con sẽ nghiền ngẫm giới luật Ngài.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Xin cho những người kính sợ Chúa,</para>
  <para style="q2" vid="PSA 119:79">đến cùng con để học chứng ngôn.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Xin giúp con yêu mến mệnh lệnh Chúa,</para>
  <para style="q2" vid="PSA 119:80">để con không bao giờ hổ thẹn.<verse eid="PSA 119:80" /></para>
  <para style="qa">11</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Linh hồn con mòn mỏi chờ giải cứu,</para>
  <para style="q2" vid="PSA 119:81">hy vọng giải thoát con là lời Ngài.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Mắt con mờ đi vì trông đợi lời hứa.<note caller="+" style="f"><char style="fr" closed="false">119:82 </char><char style="ft" closed="false">Ctd trông đợi lời Chúa</char></note></para>
  <para style="q2" vid="PSA 119:82">Đến bao giờ Chúa mới an ủi con?<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Dù con như bầu da<note caller="+" style="f"><char style="fr" closed="false">119:83 </char><char style="ft" closed="false">Bầu đựng rượu bằng da</char></note> đóng khói bếp,</para>
  <para style="q2" vid="PSA 119:83">nhưng không bao giờ quên luật Ngài.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Con phải chờ đợi đến bao giờ?</para>
  <para style="q2" vid="PSA 119:84">Ngày nào Chúa xử bọn bức hại con?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Bọn kiêu ngạo đào hầm hại con,</para>
  <para style="q2" vid="PSA 119:85">trái hẳn với luật lệ Chúa.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Toàn bộ điều răn Chúa đều đáng tin cậy.</para>
  <para style="q2" vid="PSA 119:86">Xin cứu con, vì người ta bức hại con vô cớ.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Con gần mất mạng về tay họ,</para>
  <para style="q2" vid="PSA 119:87">nhưng con không từ bỏ luật Ngài.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Xin bảo toàn mạng sống con theo lòng nhân từ Chúa,</para>
  <para style="q2" vid="PSA 119:88">thì con sẽ vâng theo chứng cớ Chúa ban truyền.<verse eid="PSA 119:88" /></para>
  <para style="qa">12</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Lạy Chúa Hằng Hữu, lời Ngài vững lập trên trời,</para>
  <para style="q2" vid="PSA 119:89">muôn đời vĩnh cửu.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Lòng thành tín Chúa trải qua bao thế hệ,</para>
  <para style="q2" vid="PSA 119:90">như địa cầu kiên lập do tay Ngài.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Theo luật Ngài, chúng tồn tại đến ngày nay,</para>
  <para style="q2" vid="PSA 119:91">và tất cả đều phục vụ Chúa.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Nếu con không yêu thích luật lệ Chúa,</para>
  <para style="q2" vid="PSA 119:92">ắt con đã chết mất trong khổ nạn.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Con chẳng bao giờ quên lời Chúa dạy,</para>
  <para style="q2" vid="PSA 119:93">vì Ngài dùng nó hồi sinh con.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Con thuộc về Chúa; xin giải cứu con!</para>
  <para style="q2" vid="PSA 119:94">Vì con phục tùng mệnh lệnh của Ngài.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Bọn gian tà rình chờ tiêu diệt con,</para>
  <para style="q2" vid="PSA 119:95">nhưng con chiêm nghiệm chứng cớ Chúa.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Những gì gọi là trọn vẹn cũng có giới hạn,</para>
  <para style="q2" vid="PSA 119:96">nhưng luật Ngài thật vô hạn, vô biên.<verse eid="PSA 119:96" /></para>
  <para style="qa">13</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Con yêu mến lời Chúa biết bao!</para>
  <para style="q2" vid="PSA 119:97">Trọn ngày con chiêm nghiệm lời ấy.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Mệnh lệnh Chúa làm cho con khôn hơn kẻ nghịch,</para>
  <para style="q2" vid="PSA 119:98">vì ấy là lời mãi mãi hướng dẫn con.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Phải, nhờ chiêm nghiệm lời Chúa,</para>
  <para style="q2" vid="PSA 119:99">con khôn sáng hơn thầy dạy con.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Con hiểu biết hơn bậc lão thành;</para>
  <para style="q2" vid="PSA 119:100">vì theo sát các nguyên tắc Chúa.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Con giữ chân không bước vào đường ác,</para>
  <para style="q2" vid="PSA 119:101">để tuân theo lời thánh của Ngài.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Nhờ Chúa răn dạy con chu đáo,</para>
  <para style="q2" vid="PSA 119:102">con chẳng đi tẻ tách đường ngay.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Lời Chúa ngọt ngào trong miệng con;</para>
  <para style="q2" vid="PSA 119:103">ngọt hơn cả mật ong hảo hạng.<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Nhờ lời Chúa, con thành người thông sáng,</para>
  <para style="q2" vid="PSA 119:104">con ghét cay ghét đắng nẻo gian tà.<verse eid="PSA 119:104" /></para>
  <para style="qa">14</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Lời Chúa là đèn soi bước chân con,</para>
  <para style="q2" vid="PSA 119:105">là ánh sáng cho đường con bước.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Con đã thề nguyền và xác nhận rằng:</para>
  <para style="q2" vid="PSA 119:106">Con sẽ tuân theo luật lệ công chính của Ngài.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Con đau khổ nhiều trong hoạn nạn;</para>
  <para style="q2" vid="PSA 119:107">xin lời Ngài làm sống lại đời con.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Cúi xin Chúa Hằng Hữu nghe lời chúc tụng,</para>
  <para style="q2" vid="PSA 119:108">và dạy con các huấn lệnh của Ngài.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Mạng sống con hằng bị đe dọa,</para>
  <para style="q2" vid="PSA 119:109">nhưng con không quên luật lệ của Chúa.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Bọn ác độc gài bẫy sập con,</para>
  <para style="q2" vid="PSA 119:110">nhưng con không làm sai mệnh lệnh Ngài.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Chứng ngôn Chúa là gia sản muôn đời;</para>
  <para style="q2" vid="PSA 119:111">làm cho lòng con cảm kích hân hoan.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Con quyết tâm thực thi mệnh lệnh Chúa,</para>
  <para style="q2" vid="PSA 119:112">suốt đời con và mãi mãi vô cùng.<verse eid="PSA 119:112" /></para>
  <para style="qa">15</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Những người hai lòng thật đáng ghét,</para>
  <para style="q2" vid="PSA 119:113">riêng con yêu mến luật lệ Ngài.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Chúa là nơi trú ẩn và cái khiên của con;</para>
  <para style="q2" vid="PSA 119:114">lời Chúa truyền hy vọng cho con.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Người ác hiểm, hãy tránh xa ta,</para>
  <para style="q2" vid="PSA 119:115">Để ta giữ các điều răn của Đức Chúa Trời ta.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Xin lời Chúa cho con được sống!</para>
  <para style="q2" vid="PSA 119:116">Xin đừng để con thất vọng não nề.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Xin Chúa nâng đỡ, con sẽ được giải cứu;</para>
  <para style="q2" vid="PSA 119:117">rồi chuyên tâm gìn giữ luật Ngài.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Chúa từ khước những ai tách xa mệnh lệnh Chúa.</para>
  <para style="q2" vid="PSA 119:118">Họ chỉ âm mưu lường gạt mà thôi.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Chúa quét sạch người ác trên trần gian như rác;</para>
  <para style="q2" vid="PSA 119:119">Vì thế con càng mến yêu lời Ngài.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Con run rẩy trong sự kính sợ Chúa;</para>
  <para style="q2" vid="PSA 119:120">án lệnh Ngài làm con kinh hãi.<verse eid="PSA 119:120" /></para>
  <para style="qa">16</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Con làm điều công bằng thiện hảo,</para>
  <para style="q2" vid="PSA 119:121">đừng bỏ con cho quân thù chế nhạo.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Xin đưa tay phù trì đầy tớ Chúa.</para>
  <para style="q2" vid="PSA 119:122">Đừng để cho bọn cường bạo áp bức!<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Con đợi ngày Chúa đến giải vây,</para>
  <para style="q2" vid="PSA 119:123">và mong mỏi chờ ân cứu độ.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Xin lấy lòng nhân từ hà hải,</para>
  <para style="q2" vid="PSA 119:124">dạy dỗ con gìn giữ luật Ngài.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Xin cho đầy tớ Ngài sáng suốt,</para>
  <para style="q2" vid="PSA 119:125">để thấu triệt lời dạy sâu xa.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Lạy Chúa Hằng Hữu, đã đến lúc Ngài ra tay hành động,</para>
  <para style="q2" vid="PSA 119:126">vì nhiều người phá vỡ luật Ngài.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Thật, con yêu quý điều răn của Chúa,</para>
  <para style="q2" vid="PSA 119:127">hơn vàng, ngay cả vàng ròng.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Tất cả nguyên tắc của Chúa là công chính.</para>
  <para style="q2" vid="PSA 119:128">Nên con ghét mọi sai lạc, giả dối.<verse eid="PSA 119:128" /></para>
  <para style="b" />
  <para style="qa">17</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Chứng ngôn Chúa diệu kỳ phong phú.</para>
  <para style="q2" vid="PSA 119:129">Nên con dốc lòng vâng giữ!<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Lối vào lời Chúa đem ánh sáng,</para>
  <para style="q2" vid="PSA 119:130">ban tri thức cho người đơn sơ.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Con mở miệng, sẵn sàng uống cạn,</para>
  <para style="q2" vid="PSA 119:131">những điều răn, mệnh lệnh Chúa ban.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Xin đoái nhìn, rủ lòng thương xót,</para>
  <para style="q2" vid="PSA 119:132">như Ngài thường ưu đãi con dân.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Cho con bước theo lời Chúa,</para>
  <para style="q2" vid="PSA 119:133">đừng để ác tâm ngự trong con.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Xin giải thoát con khỏi người áp bức;</para>
  <para style="q2" vid="PSA 119:134">để con tự do tuân hành thánh chỉ.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Xin chiếu sáng mặt Ngài trên con;</para>
  <para style="q2" vid="PSA 119:135">và giúp con học đòi nguyên tắc Chúa.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Mắt con tuôn lệ như dòng thác</para>
  <para style="q2" vid="PSA 119:136">vì người đời bất chấp luật lệ Ngài.<verse eid="PSA 119:136" /></para>
  <para style="qa">18</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />Lạy Chúa Hằng Hữu, Đấng công chính</para>
  <para style="q2" vid="PSA 119:137">và tuyên phán điều ngay thẳng.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Chứng ngôn Ngài trung thực, công bằng,</para>
  <para style="q2" vid="PSA 119:138">và rất đáng tin cậy.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Lòng nhiệt thành nung đốt tâm can,</para>
  <para style="q2" vid="PSA 119:139">vì kẻ thù con quên lời Chúa.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Lời của Chúa vô cùng tinh luyện;</para>
  <para style="q2" vid="PSA 119:140">nên con yêu mến lời ấy vô ngần.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Thân phận con đáng khinh, hèn kém,</para>
  <para style="q2" vid="PSA 119:141">nhưng lời Ngài, con vẫn nhớ ghi.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Đức công chính Ngài còn mãi mãi,</para>
  <para style="q2" vid="PSA 119:142">luật pháp Ngài là chân lý muôn đời.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Con gặp cảnh hoang mang rối loạn,</para>
  <para style="q2" vid="PSA 119:143">nhưng vẫn vui thích hoài điều răn Chúa ban.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Luật pháp Chúa công minh vĩnh cửu;</para>
  <para style="q2" vid="PSA 119:144">xin cho con hiểu biết để con được sống còn.<verse eid="PSA 119:144" /></para>
  <para style="qa">19</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Con hết lòng kêu lên Chúa, lạy Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 119:145">Con xin vâng theo mệnh lệnh Ngài.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Con kêu cứu, Chúa ơi, xin giải thoát,</para>
  <para style="q2" vid="PSA 119:146">để cho con tiếp tục giữ chứng ngôn.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Dậy trước hừng đông, con cầu cứu,</para>
  <para style="q2" vid="PSA 119:147">vì con hy vọng nơi lời Ngài.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Mắt con không chớp giữa canh khuya,</para>
  <para style="q2" vid="PSA 119:148">để con tỉnh táo suy ngẫm lời Ngài hứa.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Lạy Chúa Hằng Hữu, xin nghe con tùy lượng nhân từ Chúa;</para>
  <para style="q2" vid="PSA 119:149">và cho con hồi sinh nhờ lời sống của Ngài.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Người vô đạo đến gần xông hãm;</para>
  <para style="q2" vid="PSA 119:150">nhưng họ cách xa luật pháp Ngài.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Chúa Hằng Hữu ơi, xin Ngài ở bên con,</para>
  <para style="q2" vid="PSA 119:151">điều răn Ngài hoàn toàn chân thật.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Từ xa xưa, con biết qua chứng ước Chúa,</para>
  <para style="q2" vid="PSA 119:152">rằng luật pháp Ngài lập vững muôn đời.<verse eid="PSA 119:152" /></para>
  <para style="qa">20</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Xin nhìn con trong vòng hoạn nạn,</para>
  <para style="q2" vid="PSA 119:153">giải cứu con vì con giữ luật Ngài.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Xin biện hộ và đưa tay cứu độ!</para>
  <para style="q2" vid="PSA 119:154">Dùng lời Ngài cứu sống tâm linh.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Bọn gian tà đi xa nguồn cứu rỗi,</para>
  <para style="q2" vid="PSA 119:155">không quan tâm đến luật pháp Ngài.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Lòng từ ái Chúa vô cùng vĩ đại;</para>
  <para style="q2" vid="PSA 119:156">xin lời Ngài truyền sức hồi sinh.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Bọn thù nghịch, đông như kiến cỏ,</para>
  <para style="q2" vid="PSA 119:157">nhưng con không nao núng vẫn giữ luật pháp Ngài.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Con đau xót nhìn người gian ác,</para>
  <para style="q2" vid="PSA 119:158">vì họ luôn bất chấp luật lệ Ngài.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Chúa nhìn thấy lòng con yêu mến mệnh lệnh Ngài.</para>
  <para style="q2" vid="PSA 119:159">Xin đoái thương,<note caller="+" style="f"><char style="fr" closed="false">119:159 </char><char style="ft" closed="false">Xin tùy nhân từ</char></note> để con được sống.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Từ khởi thủy, lời Ngài luôn chân thật;</para>
  <para style="q2" vid="PSA 119:160">các phán quyết của Ngài công chính, trường tồn.<verse eid="PSA 119:160" /></para>
  <para style="b" />
  <para style="qa">21</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Quan quyền bức hại con vô cớ,</para>
  <para style="q2" vid="PSA 119:161">nhưng lòng con luôn kính sợ lời Ngài.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Con vui thích trong lời Chúa,</para>
  <para style="q2" vid="PSA 119:162">như một người tìm được kho tàng.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Con ghét tởm những điều dối trá,</para>
  <para style="q2" vid="PSA 119:163">nhưng con yêu luật pháp của Ngài.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Mỗi ngày con ca tụng Chúa bảy lần,</para>
  <para style="q2" vid="PSA 119:164">vì luật lệ của Chúa công chính.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Người yêu luật Chúa được thái an,</para>
  <para style="q2" vid="PSA 119:165">không vấp ngã dù cuộc đời đầy bất trắc.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />Lạy Chúa Hằng Hữu, con hy vọng Ngài giải cứu,</para>
  <para style="q2" vid="PSA 119:166">và thường xuyên nghiêm chỉnh giữ điều răn.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Con vâng theo luật Chúa,</para>
  <para style="q2" vid="PSA 119:167">vì yêu thích vô cùng lời Chúa.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Chúa thấy rõ suốt đường con tiến bước,</para>
  <para style="q2" vid="PSA 119:168">vì con luôn luôn gìn giữ mọi lời vàng.<verse eid="PSA 119:168" /></para>
  <para style="qa">22</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Lạy Chúa Hằng Hữu, xin lắng nghe tiếng con kêu cầu;</para>
  <para style="q2" vid="PSA 119:169">xin cho con thông hiểu như lời Ngài dạy.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Nguyện lời nài xin bay đến tai Ngài;</para>
  <para style="q2" vid="PSA 119:170">xin giải cứu con như lời Ngài hứa.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Môi miệng con tuôn lời ca ngợi,</para>
  <para style="q2" vid="PSA 119:171">khi Ngài dạy con sắc lệnh của Ngài.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Lưỡi con cũng tuyên rao lời Chúa,</para>
  <para style="q2" vid="PSA 119:172">vì các điều răn Chúa rất công bằng.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Xin đưa tay nâng đỡ phù trì,</para>
  <para style="q2" vid="PSA 119:173">vì con đã chọn kỷ cương Ngài.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Lạy Chúa Hằng Hữu, con trông đợi Ngài giải cứu,</para>
  <para style="q2" vid="PSA 119:174">và luật pháp Ngài làm vui thỏa tâm hồn con.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Xin cho con được sống để con hết lòng ngợi tôn Chúa,</para>
  <para style="q2" vid="PSA 119:175">và xin các luật lệ của Ngài giúp đỡ con.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Con lang thang như chiên lạc lối;</para>
  <para style="q2" vid="PSA 119:176">xin Chúa tìm kiếm con về,</para>
  <para style="q2" vid="PSA 119:176">vì con vẫn không quên mệnh lệnh Chúa.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="cl">Thi Thiên 120</para>
  <para style="s1">Cầu Chúa Cứu Khỏi Tay Người Giả Ngụy</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Lúc khốn cùng, tôi kêu cầu Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 120:1">tôi kêu khóc, Ngài đáp lời tôi.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Xin Chúa Hằng Hữu cứu con khỏi môi dối trá</para>
  <para style="q2" vid="PSA 120:2">và khỏi lưỡi lừa gạt.<verse eid="PSA 120:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Này, lưỡi lừa dối, Đức Chúa Trời sẽ làm gì cho ngươi?</para>
  <para style="q2" vid="PSA 120:3">Ngài còn thêm cho ngươi điều gì nữa?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Hẳn là mũi tên nhọn của lính chiến,<note caller="+" style="f"><char style="fr" closed="false">120:4 </char><char style="ft" closed="false">Nt của người mạnh</char></note></para>
  <para style="q2" vid="PSA 120:4">với những viên than hồng từ lá chổi.<note caller="+" style="f"><char style="fr" closed="false">120:4 </char><char style="ft" closed="false">Nt thân cây kim tước</char></note><verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Khốn cho tôi vì ngụ tại Mê-siếc,</para>
  <para style="q2" vid="PSA 120:5">và trú trong lều Kê-đa.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Tôi ở đó quá lâu,</para>
  <para style="q2" vid="PSA 120:6">với những người ghét hòa bình,<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Tôi chuộng hòa bình;</para>
  <para style="q2" vid="PSA 120:7">nhưng khi tôi nói ra, họ lại muốn chiến tranh!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="cl">Thi Thiên 121</para>
  <para style="s1">Chúa Bảo Vệ Dân Chúa</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Tôi ngước nhìn đồi núi—</para>
  <para style="q2" vid="PSA 121:1">ơn cứu giúp đến từ đâu?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Ơn cứu giúp từ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 121:2">Đấng sáng tạo đất trời!<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Chúa không để chân ngươi trơn trợt;</para>
  <para style="q2" vid="PSA 121:3">Đấng canh giữ ngươi không bao giờ ngủ.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Phải, Đấng canh giữ Ít-ra-ên luôn tỉnh thức,</para>
  <para style="q2" vid="PSA 121:4">Ngài không bao giờ ngủ.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Chúa Hằng Hữu là Đấng canh giữ ngươi!</para>
  <para style="q2" vid="PSA 121:5">Chúa Hằng Hữu đứng bên ngươi như chiếc bóng che chở.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Ban ngày, mặt trời sẽ không thiêu đốt ngươi,</para>
  <para style="q2" vid="PSA 121:6">ban đêm ánh trăng cũng không làm hại.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />Chúa Hằng Hữu gìn giữ ngươi khỏi mọi tai họa</para>
  <para style="q2" vid="PSA 121:7">và bảo vệ mạng sống ngươi.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Chúa Hằng Hữu che chở ngươi khi ra khi vào,</para>
  <para style="q2" vid="PSA 121:8">từ nay đến muôn đời.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="cl">Thi Thiên 122</para>
  <para style="s1">Cầu Phước cho Giê-ru-sa-lem</para>
  <para style="d">(Thơ của Đa-vít. Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Tôi vui khi người ta giục giã:</para>
  <para style="q2" vid="PSA 122:1">“Chúng ta cùng đi lên nhà Chúa Hằng Hữu.”<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Hỡi Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 122:2">chúng ta dừng chân tại cửa ngươi.<verse eid="PSA 122:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Thành Giê-ru-sa-lem được xây cất;</para>
  <para style="q2" vid="PSA 122:3">liên kết nhau chặt chẽ vô cùng.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Các đại tộc Ít-ra-ên—con dân Chúa—</para>
  <para style="q2" vid="PSA 122:4">đều lên đây.</para>
  <para style="q1" vid="PSA 122:4">Y theo tục lệ Ít-ra-ên,</para>
  <para style="q2" vid="PSA 122:4">để cảm tạ Danh Chúa Hằng Hữu.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Vì tại đây, ngôi xét xử được thiết lập,</para>
  <para style="q2" vid="PSA 122:5">là ngôi vua nhà Đa-vít.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Hãy cầu hòa bình cho Giê-ru-sa-lem.</para>
  <para style="q2" vid="PSA 122:6">Nguyện ai yêu ngươi sẽ được hưng thịnh.<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Hỡi Giê-ru-sa-lem, nguyện cho hòa bình trong thành</para>
  <para style="q2" vid="PSA 122:7">và thịnh vượng trong lâu đài.<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Vì gia đình và bè bạn tôi, tôi nguyện cầu:</para>
  <para style="q2" vid="PSA 122:8">“Nguyện ngươi được an lạc.”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Vì nhà Chúa Hằng Hữu, Đức Chúa Trời chúng ta,</para>
  <para style="q2" vid="PSA 122:9">Tôi cầu xin phước lành cho ngươi, hỡi Giê-ru-sa-lem.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="cl">Thi Thiên 123</para>
  <para style="s1">Tin Cậy Chúa và Cầu Xin Phù Trợ</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Con ngước mắt lên nhìn Chúa,</para>
  <para style="q2" vid="PSA 123:1">lạy Đức Chúa Trời, Đấng ngự trị trên cao.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Chúng con trông mong Chúa Hằng Hữu, Đức Chúa Trời chúng con thương xót,</para>
  <para style="q2" vid="PSA 123:2">như mắt đầy tớ trông chờ tay chủ, như mắt tớ gái nhìn tay bà chủ.<verse eid="PSA 123:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Xin thương xót chúng con, lạy Chúa Hằng Hữu, xin thương xót,</para>
  <para style="q2" vid="PSA 123:3">vì chúng con bị khinh bỉ quá nhiều.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Chúng con chịu đựng ê chề vì người tự cao chế nhạo,</para>
  <para style="q2" vid="PSA 123:4">và người kiêu ngạo khinh khi.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="cl">Thi Thiên 124</para>
  <para style="s1">Ca Ngợi Chúa Cứu Dân Ra Khỏi Tay Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít. Bài ca lên đền thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Nếu Chúa Hằng Hữu không bênh vực chúng ta, thì thế nào?</para>
  <para style="q2" vid="PSA 124:1">Hỡi Ít-ra-ên hãy lên tiếng:<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />Nếu Chúa Hằng Hữu không bênh vực chúng ta,</para>
  <para style="q2" vid="PSA 124:2">khi người ta dấy nghịch, sẽ ra sao?<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />Hẳn họ đã nuốt sống chúng ta</para>
  <para style="q2" vid="PSA 124:3">trong cơn giận phừng phừng.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Nước hẳn đã tràn ngập;</para>
  <para style="q2" vid="PSA 124:4">dòng nước đã cuốn lấp chúng ta.<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />Phải, thác lũ đã nhận chìm</para>
  <para style="q2" vid="PSA 124:5">sinh mạng chúng ta.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Chúc tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 124:6">vì Ngài không nộp chúng ta làm miếng mồi ngon cho họ!<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Chúng ta đã thoát như chim thoát khỏi bẫy.</para>
  <para style="q2" vid="PSA 124:7">Bẫy gãy tan tành, chúng ta bay thoát!<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Ân cứu giúp đến từ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 124:8">Đấng sáng tạo cả trời và đất.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="cl">Thi Thiên 125</para>
  <para style="s1">Chúa Bảo Vệ Dân Chúa</para>
  <para style="d">(Bài ca lên đền thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Ai tin cậy Chúa Hằng Hữu sẽ giống Núi Si-ôn;</para>
  <para style="q2" vid="PSA 125:1">không dao động, nhưng bất diệt trường tồn.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Núi non bao bọc Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 125:2">như Chúa Hằng Hữu chở che dân Ngài, từ nay cho đến muôn đời.<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Vì người ác không còn cầm quyền<note caller="+" style="f"><char style="fr" closed="false">125:3 </char><char style="ft" closed="false">Nt quyền trượng người ác sẽ không đặt</char></note> trên phần đất người công chính,</para>
  <para style="q2" vid="PSA 125:3">để chúng ta khỏi bị ép buộc nhúng tay vào việc bất lương.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Chúa Hằng Hữu ôi, xin ban phước cho người hiền đức,</para>
  <para style="q2" vid="PSA 125:4">là những người có lòng công chính.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Còn người đi theo đường cong queo, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 125:5">Xin phạt họ chung với những ai làm điều ác.</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q1" vid="PSA 125:5">Nguyện cầu thanh bình cho Ít-ra-ên!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="cl">Thi Thiên 126</para>
  <para style="s1">Cảm Tạ Chúa Dẫn Dân Lưu Đày Hồi Hương</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Khi Chúa Hằng Hữu đem dân lưu đày Si-ôn trở về,</para>
  <para style="q2" vid="PSA 126:1">thật như một giấc mơ!<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Miệng chúng ta đầy tiếng vui cười,</para>
  <para style="q2" vid="PSA 126:2">lưỡi chúng ta vang khúc nhạc mừng vui.</para>
  <para style="q1" vid="PSA 126:2">Người nước ngoài đều nhìn nhận:</para>
  <para style="q2" vid="PSA 126:2">“Chúa Hằng Hữu đã làm những việc vĩ đại cho họ.”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Phải, Chúa Hằng Hữu đã làm những việc vĩ đại cho chúng ta!</para>
  <para style="q2" vid="PSA 126:3">Nên chúng ta vui mừng!<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Chúa Hằng Hữu, xin đưa dẫn dân lưu đày chúng con trở về,</para>
  <para style="q2" vid="PSA 126:4">như các dòng suối làm cho hoang mạc xanh tươi trở lại.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Người gieo với nước mắt</para>
  <para style="q2" vid="PSA 126:5">sẽ gặt trong tiếng cười.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Khi mang hạt giống đi gieo thì đầy nước mắt,</para>
  <para style="q2" vid="PSA 126:6">nhưng lúc gánh lúa về thì đầy tiếng reo vui.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="cl">Thi Thiên 127</para>
  <para style="s1">Hưng Thịnh Do Chúa Ban</para>
  <para style="d">(Thơ của Sa-lô-môn. Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Nếu Chúa Hằng Hữu không xây nhà,</para>
  <para style="q2" vid="PSA 127:1">người xây cất tốn công vô ích.</para>
  <para style="q1" vid="PSA 127:1">Nếu Chúa Hằng Hữu không giữ thành,</para>
  <para style="q2" vid="PSA 127:1">người canh gác thức đêm hoài công.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Thật vô ích cho người thức khuya dậy sớm,</para>
  <para style="q2" vid="PSA 127:2">lao nhọc kiếm ăn;</para>
  <para style="q2" vid="PSA 127:2">trong khi Chúa ban giấc ngủ êm đềm cho người Chúa thương.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Con cái là phần cơ nghiệp Chúa Hằng Hữu cho;</para>
  <para style="q2" vid="PSA 127:3">bông trái của lòng mẹ là phần thưởng.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Con sinh trong tuổi thanh xuân</para>
  <para style="q2" vid="PSA 127:4">như mũi tên trong tay chiến sĩ.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Phước cho người đông con!<note caller="+" style="f"><char style="fr" closed="false">127:5 </char><char style="ft" closed="false">Nt túi đầy tên</char></note></para>
  <para style="q2" vid="PSA 127:5">Vì sẽ không bị thua sút,<note caller="+" style="f"><char style="fr" closed="false">127:5 </char><char style="ft" closed="false">Nt xấu hổ</char></note> khi</para>
  <para style="q2" vid="PSA 127:5">tranh chấp với kẻ thù tại cửa thành.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="cl">Thi Thiên 128</para>
  <para style="s1">Kính Thờ Chúa Được Phước</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Phước cho người kính sợ Chúa Hằng Hữu—</para>
  <para style="q2" vid="PSA 128:1">và vâng giữ đường lối Ngài.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Họ sẽ hưởng kết quả công lao mình.</para>
  <para style="q2" vid="PSA 128:2">Được hạnh phúc, an lành biết bao!<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Vợ đảm đang vui việc gia thất,</para>
  <para style="q2" vid="PSA 128:3">như giàn nho tươi ngọt trong vườn.</para>
  <para style="q1" vid="PSA 128:3">Bên bàn ăn con cái quây quần,</para>
  <para style="q2" vid="PSA 128:3">vươn sức sống như chồi ô-liu, xanh mướt.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Người nào kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 128:4">hẳn được phước dồi dào như thế.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Nguyện từ Si-ôn, Chúa Hằng Hữu tiếp tục ban phước.</para>
  <para style="q2" vid="PSA 128:5">Trọn đời ngươi thấy ân lành từ Giê-ru-sa-lem.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Nguyện ngươi sẽ thấy cháu chắt mình.</para>
  <para style="q2" vid="PSA 128:6">Nguyện cầu bình an cho Giê-ru-sa-lem!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="cl">Thi Thiên 129</para>
  <para style="s1">Xin Chúa Trừ Người Phá Hại Si-ôn</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Khi tôi còn trẻ, nhiều lần họ gây khốn khổ cho tôi.</para>
  <para style="q2" vid="PSA 129:1">Bây giờ, Ít-ra-ên hãy lập lại:<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Khi tôi còn trẻ, nhiều lần họ gây khốn khổ cho tôi,</para>
  <para style="q2" vid="PSA 129:2">nhưng không thắng nổi tôi.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Họ kéo cày trên lưng tôi,</para>
  <para style="q2" vid="PSA 129:3">rạch dài thành luống.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Chúa Hằng Hữu rất công minh;</para>
  <para style="q2" vid="PSA 129:4">Ngài cắt đứt dây trói của người ác.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Nguyện những ai ghen ghét Si-ôn</para>
  <para style="q2" vid="PSA 129:5">phải thất bại xấu hổ.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Nguyện họ như cỏ cây mọc trên mái nhà,</para>
  <para style="q2" vid="PSA 129:6">khô héo trước khi bị nhổ.<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Người gặt cũng như người bó,</para>
  <para style="q2" vid="PSA 129:7">thu hoạch ít ỏi, không đầy bàn tay.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Nguyện người qua lại</para>
  <para style="q2" vid="PSA 129:8">từ chối nói lời chúc phước này:</para>
  <para style="q1" vid="PSA 129:8">“Xin Chúa Hằng Hữu ban phước cho các anh;</para>
  <para style="q2" vid="PSA 129:8">cầu phước lành cho các anh nhân danh Chúa Hằng Hữu.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="cl">Thi Thiên 130</para>
  <para style="s1">Hy Vọng Chúa Thương Xót Tha Tội</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Từ vực thẳm, lạy Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 130:1">con kêu van cứu giúp.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Xin lắng tai nghe, lạy Chúa.</para>
  <para style="q2" vid="PSA 130:2">Xin lưu ý lời con nguyện cầu.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Lạy Chúa Hằng Hữu, nếu Ngài ghi nhớ tội ác chúng con,</para>
  <para style="q2" vid="PSA 130:3">ai có thể đứng nổi trước mặt Ngài?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Nhưng Chúa có lòng thứ tha,</para>
  <para style="q2" vid="PSA 130:4">nên Ngài đáng kính sợ.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Con mong đợi Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 130:5">linh hồn con ngóng trông Ngài.</para>
  <para style="q2" vid="PSA 130:5">Con hy vọng nơi lời hứa Ngài.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Linh hồn con trông mong Chúa</para>
  <para style="q2" vid="PSA 130:6">hơn người gác đêm chờ đợi bình minh.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Hỡi Ít-ra-ên, hãy hy vọng nơi Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 130:7">vì Ngài có lòng nhân từ.</para>
  <para style="q2" vid="PSA 130:7">Ban ân cứu chuộc dồi dào.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Ngài sẽ cứu chuộc Ít-ra-ên,</para>
  <para style="q2" vid="PSA 130:8">khỏi mọi tội lỗi.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="cl">Thi Thiên 131</para>
  <para style="s1">Nhờ Chúa Khác Nào Con Nhờ Mẹ</para>
  <para style="d">(Bài ca lên Đền Thờ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Chúa Hằng Hữu ôi, lòng con không kiêu ngạo;</para>
  <para style="q2" vid="PSA 131:1">mắt con không kiêu hãnh.</para>
  <para style="q1" vid="PSA 131:1">Con không mơ việc cao xa,</para>
  <para style="q2" vid="PSA 131:1">vượt quá tài sức mình.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Con đã làm lắng dịu linh hồn,</para>
  <para style="q2" vid="PSA 131:2">như trẻ thôi bú nằm yên bên mẹ.</para>
  <para style="q2" vid="PSA 131:2">Linh hồn an tĩnh trong con.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Hỡi Ít-ra-ên ơi, hãy hy vọng nơi Chúa Hằng Hữu—</para>
  <para style="q2" vid="PSA 131:3">từ nay đến muôn đời.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="cl">Thi Thiên 132</para>
  <para style="s1">Xin Ban Phước cho Nơi Thánh</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Lạy Chúa Hằng Hữu, xin nhớ đến Đa-vít</para>
  <para style="q2" vid="PSA 132:1">cùng mọi nỗi khốn khổ người chịu.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Người đã thề với Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 132:2">Người đã khấn với Chúa Toàn Năng của Gia-cốp:<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“Con sẽ chẳng vào nhà;</para>
  <para style="q2" vid="PSA 132:3">cũng chẳng lên giường nằm.<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />Không để cho mắt ngủ,</para>
  <para style="q2" vid="PSA 132:4">mí mắt không khép lại<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />cho đến khi tìm được chỗ cho Chúa Hằng Hữu ngự,</para>
  <para style="q2" vid="PSA 132:5">một nơi thánh<note caller="+" style="f"><char style="fr" closed="false">132:5 </char><char style="ft" closed="false">Nt nhà</char></note> cho Chúa Toàn Năng của Gia-cốp.”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />Chúng con nghe Hòm Giao Ước ở Ép-ra-ta,</para>
  <para style="q2" vid="PSA 132:6">và tìm được tại cánh đồng Gia-a.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Chúng con sẽ vào nơi Chúa Hằng Hữu ngự;</para>
  <para style="q2" vid="PSA 132:7">quỳ lạy dưới bệ chân Ngài.<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />Lạy Chúa Hằng Hữu! Xin vào nơi an nghỉ Ngài,</para>
  <para style="q2" vid="PSA 132:8">cùng với Hòm Giao Ước, biểu hiệu quyền năng của Ngài.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Nguyện các thầy tế lễ được khoác áo công chính;</para>
  <para style="q2" vid="PSA 132:9">nguyện dân thánh Chúa reo vui.<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Vì Đa-vít, đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 132:10">xin đừng từ chối người chịu xức dầu của Ngài.<verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />Chúa Hằng Hữu đã thề với Đa-vít,</para>
  <para style="q2" vid="PSA 132:11">hẳn Ngài sẽ không đổi lời:</para>
  <para style="q1" vid="PSA 132:11">“Ta sẽ đặt dòng dõi con</para>
  <para style="q2" vid="PSA 132:11">lên ngôi kế vị.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Nếu con cháu con vâng giữ giao ước Ta</para>
  <para style="q2" vid="PSA 132:12">và luật pháp Ta truyền dạy,</para>
  <para style="q1" vid="PSA 132:12">thì dòng dõi con sẽ ngồi trên ngôi</para>
  <para style="q2" vid="PSA 132:12">vua mãi mãi.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Vì Chúa Hằng Hữu đã chọn Si-ôn;</para>
  <para style="q2" vid="PSA 132:13">Ngài muốn đó là nơi Ngài ngự.<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />Chúa phán: “Đây vĩnh viễn sẽ là nhà Ta,</para>
  <para style="q2" vid="PSA 132:14">Ta ở đây, vì Ta ưa thích.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Ta cho Si-ôn dồi dào thực phẩm;</para>
  <para style="q2" vid="PSA 132:15">Ta sẽ cho người nghèo ăn bánh no nê.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Ta sẽ cho thầy tế lễ mặc áo cứu rỗi;</para>
  <para style="q2" vid="PSA 132:16">những đầy tớ tin kính của nó sẽ cất tiếng reo vui.<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />Ta sẽ cho sừng Đa-vít vươn lên mạnh;</para>
  <para style="q2" vid="PSA 132:17">Ta sửa soạn đèn cho Đấng được xức dầu;<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Ta sẽ cho kẻ thù người áo xống bị nhơ nhuốc,</para>
  <para style="q2" vid="PSA 132:18">còn người thì được đội vương miện vinh quang.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="cl">Thi Thiên 133</para>
  <para style="s1">Sự Hòa Thuận Tốt Đẹp</para>
  <para style="d">(Thơ của Đa-vít. Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Anh em chung sống thuận hòa,</para>
  <para style="q2" vid="PSA 133:1">còn gì tốt đẹp êm đềm hơn!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Thuận hòa quý báu như dầu,</para>
  <para style="q2" vid="PSA 133:2">được rót trên đầu A-rôn</para>
  <para style="q1" vid="PSA 133:2">chảy xuống râu ông</para>
  <para style="q2" vid="PSA 133:2">và thấm ướt vạt áo dài.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Thuận hòa tươi mát như sương,</para>
  <para style="q2" vid="PSA 133:3">trên đỉnh Núi Hẹt-môn,</para>
  <para style="q2" vid="PSA 133:3">rơi xuống đồi núi Si-ôn.</para>
  <para style="q1" vid="PSA 133:3">Vì Chúa Hằng Hữu ban phước,</para>
  <para style="q2" vid="PSA 133:3">vĩnh sinh bất diệt cho Si-ôn.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="cl">Thi Thiên 134</para>
  <para style="s1">Người Canh Nhà Chúa Hãy Ca Ngợi Ngài</para>
  <para style="d">(Bài ca lên Đền Thờ)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Hãy chúc tụng Chúa Hằng Hữu, hỡi các đầy tớ Ngài,</para>
  <para style="q2" vid="PSA 134:1">ban đêm phục vụ trong nhà Chúa Hằng Hữu.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Tại nơi thánh, khá đưa tay cầu nguyện</para>
  <para style="q2" vid="PSA 134:2">và chúc tụng Chúa Hằng Hữu.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Nguyện Chúa Hằng Hữu, Đấng sáng tạo trời đất,</para>
  <para style="q2" vid="PSA 134:3">từ Si-ôn ban phước cho anh em.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="cl">Thi Thiên 135</para>
  <para style="s1">So Sánh Công Trình của Chúa với Thần Tượng Vô Tri</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Hãy ca ngợi Danh Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 135:1">Hãy chúc tôn Ngài, hỡi các đầy tớ của Chúa Hằng Hữu,<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />là những người phục vụ trong nhà Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 135:2">tại hành lang của nhà Đức Chúa Trời.<verse eid="PSA 135:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Hãy ca ngợi Chúa Hằng Hữu, vì Chúa Hằng Hữu là toàn thiện;</para>
  <para style="q2" vid="PSA 135:3">hãy hát tôn vinh Danh Chúa vì Danh Ngài diệu kỳ.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Chúa Hằng Hữu đã chọn Gia-cốp,</para>
  <para style="q2" vid="PSA 135:4">Ngài tuyển Ít-ra-ên làm cơ nghiệp.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Tôi biết Chúa Hằng Hữu vĩ đại—</para>
  <para style="q2" vid="PSA 135:5">Chúa chúng ta lớn hơn mọi thần linh.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Việc đẹp ý Chúa Hằng Hữu, Ngài đều thực hiện,</para>
  <para style="q2" vid="PSA 135:6">tại mặt đất và trên trời cao,</para>
  <para style="q2" vid="PSA 135:6">trong đại dương và dưới vực sâu.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Chúa dẫn hơi nước bay lên từ địa cực.</para>
  <para style="q2" vid="PSA 135:7">Làm chớp nhoáng báo hiệu cơn mưa,</para>
  <para style="q2" vid="PSA 135:7">đem gió lại từ kho chứa của Ngài.<verse eid="PSA 135:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Chúa đánh giết con đầu lòng Ai Cập,</para>
  <para style="q2" vid="PSA 135:8">từ loài người đến loài súc vật,<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Làm nhiều phép lạ, diệu kỳ trong xứ Ai Cập,</para>
  <para style="q2" vid="PSA 135:9">trừng phạt Pha-ra-ôn, và đầy tớ của người.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Ngài đánh hạ các dân tộc lớn</para>
  <para style="q2" vid="PSA 135:10">và giết các vua hùng cường—<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Si-hôn, vua người A-mô-rít,</para>
  <para style="q2" vid="PSA 135:11">Óc, vua Ba-san,</para>
  <para style="q2" vid="PSA 135:11">và tất cả vua xứ Ca-na-an.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Ngài ban xứ họ cho Ít-ra-ên,</para>
  <para style="q2" vid="PSA 135:12">cho dân Ngài làm cơ nghiệp.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Lạy Chúa Hằng Hữu, Danh Ngài luôn tồn tại,</para>
  <para style="q2" vid="PSA 135:13">kỷ niệm Ngài còn mãi đến muôn đời.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Chúa Hằng Hữu sẽ xét xử dân Ngài,</para>
  <para style="q2" vid="PSA 135:14">và rộng lòng xót thương đầy tớ Ngài.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Thần tượng các dân tộc bằng vàng và bạc,</para>
  <para style="q2" vid="PSA 135:15">vật do tay con người tạo ra.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Tượng ấy có miệng nhưng không nói,</para>
  <para style="q2" vid="PSA 135:16">có mắt nhưng không nhìn,<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Có tai nhưng nào biết nghe,</para>
  <para style="q2" vid="PSA 135:17">và mũi chẳng có chút hơi thở.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Người tạo thần tượng và người tin tưởng hắn,</para>
  <para style="q2" vid="PSA 135:18">sẽ trở nên giống như hắn.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Hỡi Ít-ra-ên hãy chúc tụng Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 135:19">Hỡi các thầy tế lễ—con cháu A-rôn—hãy ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Hỡi nhà Lê-vi, hãy tán dương Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 135:20">Hỡi những ai kính sợ Chúa Hằng Hữu hãy chúc tụng Chúa Hằng Hữu!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Chúc tụng Chúa Hằng Hữu từ Si-ôn,</para>
  <para style="q2" vid="PSA 135:21">Ngài ở tại Giê-ru-sa-lem.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="cl">Thi Thiên 136</para>
  <para style="s1">Cảm Tạ Chúa vì Nhân Từ Chúa Còn Đời Đời</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />Hãy cảm tạ Chúa Hằng Hữu vì Ngài là thiện!</para>
  <para style="q2" vid="PSA 136:1">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Hãy cảm tạ Đức Chúa Trời của các thần.</para>
  <para style="q2" vid="PSA 136:2">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Hãy cảm tạ Chúa của các chúa.</para>
  <para style="q2" vid="PSA 136:3">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Chỉ một mình Chúa làm phép lạ vĩ đại.</para>
  <para style="q2" vid="PSA 136:4">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Với óc khôn ngoan, Chúa sáng tạo bầu trời.</para>
  <para style="q2" vid="PSA 136:5">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Chúa trải đất ra bên biển cả.</para>
  <para style="q2" vid="PSA 136:6">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Chúa làm ra các thể sáng vĩ đại.</para>
  <para style="q2" vid="PSA 136:7">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Mặt trời cai quản ban ngày.</para>
  <para style="q2" vid="PSA 136:8">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Mặt trăng cai quản ban đêm.</para>
  <para style="q2" vid="PSA 136:9">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Chúa đánh giết con đầu lòng Ai Cập.</para>
  <para style="q2" vid="PSA 136:10">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Chúa giải thoát dân chúng Ít-ra-ên.</para>
  <para style="q2" vid="PSA 136:11">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Do cánh tay mạnh mẽ quyền năng của Ngài.</para>
  <para style="q2" vid="PSA 136:12">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Chúa chia Biển Đỏ làm đôi.</para>
  <para style="q2" vid="PSA 136:13">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Cho dân chúng Ít-ra-ên đi ngang qua.</para>
  <para style="q2" vid="PSA 136:14">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Xua Pha-ra-ôn và đạo quân xuống Biển Đỏ.</para>
  <para style="q2" vid="PSA 136:15">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Chúa đưa dân Ngài qua hoang mạc.</para>
  <para style="q2" vid="PSA 136:16">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Chúa đánh hạ các vua lớn.</para>
  <para style="q2" vid="PSA 136:17">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Chúa giết các vua danh tiếng.</para>
  <para style="q2" vid="PSA 136:18">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Si-hôn vua người A-mô-rít.</para>
  <para style="q2" vid="PSA 136:19">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Và Óc vua Ba-san.</para>
  <para style="q2" vid="PSA 136:20">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Chúa ban lãnh thổ họ làm cơ nghiệp.</para>
  <para style="q2" vid="PSA 136:21">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Cơ nghiệp cho Ít-ra-ên, đầy tớ Ngài.</para>
  <para style="q2" vid="PSA 136:22">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Chúa nhớ chúng con trong cảnh khốn cùng.</para>
  <para style="q2" vid="PSA 136:23">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Ngài giải cứu chúng con khỏi kẻ thù.</para>
  <para style="q2" vid="PSA 136:24">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Chúa ban lương thực cho mọi sinh vật.</para>
  <para style="q2" vid="PSA 136:25">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Hãy cảm tạ Đức Chúa Trời trên trời.</para>
  <para style="q2" vid="PSA 136:26">Vì lòng nhân từ Ngài tồn tại muôn đời.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="cl">Thi Thiên 137</para>
  <para style="s1">Nỗi Buồn của Người Bị Lưu Đày</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Bên bờ sông Ba-by-lôn, chúng ta ngồi khóc</para>
  <para style="q2" vid="PSA 137:1">khi nhớ đến Si-ôn.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Chúng ta đã treo đàn hạc,</para>
  <para style="q2" vid="PSA 137:2">trên cành liễu ven sông.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Vì những người bắt chúng ta bảo phải ca hát.</para>
  <para style="q2" vid="PSA 137:3">Bọn tra tấn đánh đập chúng ta,</para>
  <para style="q1" vid="PSA 137:3">truyền lệnh bắt hoan ca</para>
  <para style="q2" vid="PSA 137:3">“Hát một ca khúc Si-ôn đi!”<verse eid="PSA 137:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Nhưng làm sao ca hát được bài ca của Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 137:4">trong khi ở nơi đất khách?<verse eid="PSA 137:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Nếu ta quên ngươi, hỡi Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 137:5">nguyện tay ta sẽ mất hết tài năng.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Nguyện lưỡi ta sẽ bất động<note caller="+" style="f"><char style="fr" closed="false">137:6 </char><char style="ft" closed="false">Nt dính nơi khẩu cái</char></note> không còn ca hát nữa.</para>
  <para style="q2" vid="PSA 137:6">Nếu ta không nhớ Giê-ru-sa-lem,</para>
  <para style="q2" vid="PSA 137:6">Không yêu Giê-ru-sa-lem hơn mọi điều vui thú nhất.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Cầu xin Chúa Hằng Hữu, nhớ việc quân Ê-đôm đã làm</para>
  <para style="q2" vid="PSA 137:7">trong ngày Giê-ru-sa-lem thất thủ.</para>
  <para style="q1" vid="PSA 137:7">Chúng reo hò: “Phá hủy!</para>
  <para style="q2" vid="PSA 137:7">San thành bình địa!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Hỡi con gái Ba-by-lôn, các ngươi đã bị định cho diệt vong.</para>
  <para style="q2" vid="PSA 137:8">Phước cho người báo phạt Ba-by-lôn,</para>
  <para style="q2" vid="PSA 137:8">vì những gì các ngươi đã làm cho chúng ta.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Phước cho người bắt hài nhi ngươi</para>
  <para style="q2" vid="PSA 137:9">và đập chúng vào núi đá.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="cl">Thi Thiên 138</para>
  <para style="s1">Cảm Tạ Chúa Nhân Từ và Thành Tín</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Con hết lòng cảm tạ Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 138:1">ca tụng Ngài trước các thần linh.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Hướng về Đền Thờ, con thờ lạy Chúa.</para>
  <para style="q2" vid="PSA 138:2">Nguyện tri ân thành tín, nhân từ</para>
  <para style="q1" vid="PSA 138:2">vì Danh Chúa được đề cao;</para>
  <para style="q2" vid="PSA 138:2">lời Chúa được tôn trọng vô cùng.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Khi con kêu xin, Chúa đáp lời;</para>
  <para style="q2" vid="PSA 138:3">ban sinh lực, phấn khởi tâm linh.<verse eid="PSA 138:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Mọi vua trần gian sẽ cảm tạ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 138:4">vì họ được nghe lời Ngài.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Phải, họ sẽ ca tụng công việc Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 138:5">vì vinh quang Ngài quá rực rỡ.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Dù Chúa Hằng Hữu cao cả, Ngài vẫn đoái thương người hèn mọn,</para>
  <para style="q2" vid="PSA 138:6">nhưng ai kiêu ngạo, Chúa liền tránh xa.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Lúc tai ương dồn dập,</para>
  <para style="q2" vid="PSA 138:7">Chúa sẽ bảo vệ con khỏi kẻ thù giận dữ.</para>
  <para style="q1" vid="PSA 138:7">Chúa đưa tay Ngài ra,</para>
  <para style="q2" vid="PSA 138:7">và quyền năng của tay phải Ngài giải cứu con.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Chúa Hằng Hữu sẽ chu toàn mọi việc cho con—</para>
  <para style="q2" vid="PSA 138:8">vì lòng nhân từ Ngài, lạy Chúa Hằng Hữu, tồn tại muôn đời.</para>
  <para style="q2" vid="PSA 138:8">Xin đừng bỏ công việc của tay Ngài.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="cl">Thi Thiên 139</para>
  <para style="s1">Chúa Toàn Tri và Hiện Diện Mọi Nơi</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Chúa Hằng Hữu ôi, Ngài đã tra xét lòng con</para>
  <para style="q2" vid="PSA 139:1">và biết mọi thứ về con!<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Chúa biết khi con ngồi hay đứng.</para>
  <para style="q2" vid="PSA 139:2">Chúa thấu suốt tư tưởng con từ xa.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Chúa nhìn thấy lối con đi,</para>
  <para style="q2" vid="PSA 139:3">và khi con nằm ngủ.</para>
  <para style="q2" vid="PSA 139:3">Ngài biết rõ mọi việc con làm.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Lời con nói chưa ra khỏi miệng</para>
  <para style="q2" vid="PSA 139:4">Ngài đã biết rồi, lạy Chúa Hằng Hữu.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Chúa che chở phía sau phía trước.</para>
  <para style="q2" vid="PSA 139:5">Bàn tay của Ngài, Ngài đặt trên con.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Tri thức của Ngài, con vô cùng kinh ngạc,</para>
  <para style="q2" vid="PSA 139:6">vì quá cao siêu con không với tới.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Con sẽ đi đâu cho xa Thần Chúa!</para>
  <para style="q2" vid="PSA 139:7">Con sẽ trốn đâu khỏi mặt Ngài?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Nếu con lên trời, Chúa ngự tại đó;</para>
  <para style="q2" vid="PSA 139:8">nếu con xuống âm phủ, Chúa cũng ở đó.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Nếu con chắp cánh hừng đông,</para>
  <para style="q2" vid="PSA 139:9">bay qua tận cùng biển cả,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />Chúa cũng đưa tay ra dẫn dắt,</para>
  <para style="q2" vid="PSA 139:10">tay hữu Chúa vẫn nắm chặt lấy con.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Con có thể xin bóng tối che giấu con</para>
  <para style="q2" vid="PSA 139:11">và ánh sáng chung quanh trở thành đêm tối—<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />nhưng dù trong bóng tối, con cũng không thể giấu con khỏi Ngài.</para>
  <para style="q2" vid="PSA 139:12">Với Chúa, đêm tối cũng sáng như ban ngày.</para>
  <para style="q2" vid="PSA 139:12">Với Chúa đêm tối và ánh sáng đều như nhau.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Chúa tạo nên tâm thần con,</para>
  <para style="q2" vid="PSA 139:13">dệt thành con trong lòng mẹ.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Cảm tạ Chúa đã tạo nên con đáng sợ và lạ lùng!</para>
  <para style="q2" vid="PSA 139:14">Công việc Chúa tuyệt diệu, con hoàn toàn biết rõ.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Xương cốt hình hài con không giấu Chúa được,</para>
  <para style="q2" vid="PSA 139:15">ngay từ khi con được tạo ra nơi kín đáo,</para>
  <para style="q2" vid="PSA 139:15">được dệt thành trong nơi sâu của đất.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Mắt Chúa đã thấy con trước khi con sinh ra.</para>
  <para style="q2" vid="PSA 139:16">Số các ngày định cho đời con Chúa đã ghi rõ</para>
  <para style="q2" vid="PSA 139:16">khi chưa có ngày nào trong các ngày ấy.<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Lạy Đức Chúa Trời, đối với con, tư tưởng của Chúa thật quý báu.</para>
  <para style="q2" vid="PSA 139:17">Không thể nào đếm được!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Con miên man đếm không xuể,</para>
  <para style="q2" vid="PSA 139:18">vì nhiều hơn cát!</para>
  <para style="q1" vid="PSA 139:18">Lúc con tỉnh lại,</para>
  <para style="q2" vid="PSA 139:18">Ngài vẫn ở với con!<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Lạy Đức Chúa Trời, hẳn Chúa sẽ giết người gian ác!</para>
  <para style="q2" vid="PSA 139:19">Bọn khát máu, hãy xa khỏi ta!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Lời quỷ quyệt, họ nhắc đến Chúa;</para>
  <para style="q2" vid="PSA 139:20">kẻ thù Ngài nói lời dối gian.<note caller="+" style="f"><char style="fr" closed="false">139:20 </char><char style="ft" closed="false">Nt lời hư không</char></note><verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Chúa Hằng Hữu ôi, lẽ nào con không ghét người ghét Chúa?</para>
  <para style="q2" vid="PSA 139:21">Lẽ nào con không ghê tởm người chống nghịch Ngài sao?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Con ghét họ thậm tệ,</para>
  <para style="q2" vid="PSA 139:22">vì kẻ thù của Chúa là kẻ thù của con.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Lạy Đức Chúa Trời, xin dò xét và biết lòng con;</para>
  <para style="q2" vid="PSA 139:23">xin thử nghiệm và biết tư tưởng con.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Xem lòng con có đường lối nào tà ác,</para>
  <para style="q2" vid="PSA 139:24">xin dẫn con vào đường lối vĩnh sinh.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="cl">Thi Thiên 140</para>
  <para style="s1">Xin Chúa Phù Hộ Khỏi Người Bức Hại</para>
  <para style="d">(Thơ của Đa-vít, soạn cho nhạc trưởng)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Cúi lạy Chúa Hằng Hữu, xin cứu con khỏi bọn gian ác.</para>
  <para style="q2" vid="PSA 140:1">Xin bảo vệ con khỏi tay bọn bạo tàn,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />là những người mưu toan việc ác</para>
  <para style="q2" vid="PSA 140:2">và hội họp gây chiến mỗi ngày.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Lưỡi họ nhọn như lưỡi rắn;</para>
  <para style="q2" vid="PSA 140:3">nọc rắn độc ẩn dưới môi.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Lạy Chúa Hằng Hữu, xin gìn giữ con khỏi tay người ác.</para>
  <para style="q2" vid="PSA 140:4">Xin bảo vệ con khỏi bọn bạo tàn,</para>
  <para style="q2" vid="PSA 140:4">là những người âm mưu chống lại con.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Bọn kiêu ngạo đặt bẫy bắt con;</para>
  <para style="q2" vid="PSA 140:5">họ giăng dây, căng lưới;</para>
  <para style="q2" vid="PSA 140:5">họ gài bẫy dọc bên đường.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Con thưa với Chúa Hằng Hữu: “Ngài là Đức Chúa Trời con!”</para>
  <para style="q2" vid="PSA 140:6">Xin lắng nghe, ôi Chúa Hằng Hữu, xin thương xót tiếng con kêu cầu!<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Lạy Chúa Hằng Hữu Chí Cao, là năng lực cứu rỗi con,</para>
  <para style="q2" vid="PSA 140:7">Ngài che chở mạng sống con giữa trận mạc.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Lạy Chúa Hằng Hữu, xin đừng cho mưu mô người ác thành tựu.</para>
  <para style="q2" vid="PSA 140:8">Đừng cho họ thỏa mãn ước mơ,</para>
  <para style="q2" vid="PSA 140:8">kẻo họ lên mặt kiêu ngạo.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Nguyện kẻ thù con bị tiêu diệt</para>
  <para style="q2" vid="PSA 140:9">vì mỗi điều ác họ đã làm với con.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Xin cho than hồng rơi trên họ.</para>
  <para style="q2" vid="PSA 140:10">Cho họ bị quăng vào lò lửa,</para>
  <para style="q2" vid="PSA 140:10">hay vào vực thẳm nơi họ không ngóc dậy nữa.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Xin đừng để người nói lời độc hại sống trong đất chúng con.</para>
  <para style="q2" vid="PSA 140:11">Tai ương săn bắt tiêu diệt kẻ hung tàn.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Con biết Chúa Hằng Hữu sẽ biện hộ cho người khốn cùng;</para>
  <para style="q2" vid="PSA 140:12">Ngài bênh vực quyền lợi người nghèo khổ.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Người công chính sẽ cảm tạ Danh Chúa;</para>
  <para style="q2" vid="PSA 140:13">người ngay thẳng sẽ sống trước mặt Ngài.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="cl">Thi Thiên 141</para>
  <para style="s1">Xin Chúa Giữ cho Thánh Sạch Khỏi Tội Ác</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Lạy Chúa Hằng Hữu, con kêu cầu Ngài. Xin mau đến!</para>
  <para style="q2" vid="PSA 141:1">Xin Chúa lắng nghe khi con kêu nài.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Xin cho lời cầu nguyện con bay đến Ngài như khói hương,</para>
  <para style="q2" vid="PSA 141:2">và tay đưa cao xin coi như sinh tế ban chiều.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Xin canh chừng miệng con, lạy Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 141:3">xin giữ gìn môi con.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Xin đừng cho lòng con hướng về điều xấu,</para>
  <para style="q2" vid="PSA 141:4">hay làm việc ác với người bất lương.</para>
  <para style="q1" vid="PSA 141:4">Xin đừng để con ăn thức ngon</para>
  <para style="q2" vid="PSA 141:4">với người làm điều gian trá.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Xin cho người công chính đánh con!</para>
  <para style="q2" vid="PSA 141:5">Vì đó là lòng nhân từ!</para>
  <para style="q1" vid="PSA 141:5">Xin để họ sửa dạy con, vì đó là dầu tốt nhất cho con.</para>
  <para style="q2" vid="PSA 141:5">Dầu ấy sẽ không làm hại đầu con.</para>
  <para style="b" vid="PSA 141:5" />
  <para style="q1" vid="PSA 141:5">Nhưng con vẫn cầu nguyện</para>
  <para style="q2" vid="PSA 141:5">trong khi chịu kỷ luật.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Khi các phán quan của họ bị ném vào tảng đá,</para>
  <para style="q2" vid="PSA 141:6">người ác sẽ nghe lời con và thấy đúng.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Khi người ta cày đất,</para>
  <para style="q2" vid="PSA 141:7">xương người ác sẽ bị phân tán nơi cửa mộ.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Con hướng mắt về Ngài, lạy Chúa Hằng Hữu Chí Cao.</para>
  <para style="q2" vid="PSA 141:8">Chúa là nơi con nương náu; xin đừng để họ giết con.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Xin giữ con khỏi sa bẫy họ gài,</para>
  <para style="q2" vid="PSA 141:9">khỏi cạm bẫy bọn gian manh.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Xin cho người ác mắc vào lưới họ đã giăng,</para>
  <para style="q2" vid="PSA 141:10">riêng con được tránh thoát.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="cl">Thi Thiên 142</para>
  <para style="s1">Cầu Xin Chúa Phù Hộ trong Hoạn Nạn</para>
  <para style="d">(Lời cầu nguyện của Đa-vít trong hang đá. Giáo huấn ca)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Con lớn tiếng kêu xin Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 142:1">con nài xin Chúa Hằng Hữu đoái thương.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Con bộc bạch nỗi niềm trước mặt Chúa,</para>
  <para style="q2" vid="PSA 142:2">trình Ngài cảnh khốn khổ của con.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Khi tinh thần con nao núng,</para>
  <para style="q2" vid="PSA 142:3">Chúa biết đường lối con.</para>
  <para style="q1" vid="PSA 142:3">Trên đường con đang đi tới,</para>
  <para style="q2" vid="PSA 142:3">kẻ thù gài cạm bẫy chờ con.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Con nhìn bên phải và trông chừng,</para>
  <para style="q2" vid="PSA 142:4">nhưng chẳng ai nhìn nhận con.</para>
  <para style="q1" vid="PSA 142:4">Con chẳng còn lối thoát;</para>
  <para style="q2" vid="PSA 142:4">cũng không ai đoái hoài sinh mạng con.<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Con kêu cầu Ngài, lạy Chúa Hằng Hữu.</para>
  <para style="q2" vid="PSA 142:5">Con thưa rằng: “Ngài là nơi con nương tựa.</para>
  <para style="q2" vid="PSA 142:5">Là phần con trong cõi hồng trần.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Xin Chúa lắng nghe tiếng con,</para>
  <para style="q2" vid="PSA 142:6">vì con bị đày đọa khốn khổ.</para>
  <para style="q1" vid="PSA 142:6">Xin cứu con khỏi người bức hại con,</para>
  <para style="q2" vid="PSA 142:6">vì họ mạnh sức hơn con.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Xin đem con khỏi chốn giam cầm,</para>
  <para style="q2" vid="PSA 142:7">để con cảm tạ Chúa.</para>
  <para style="q1" vid="PSA 142:7">Người công chính sẽ đứng quanh con,</para>
  <para style="q2" vid="PSA 142:7">vì Chúa sẽ tưởng thưởng con.”<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="cl">Thi Thiên 143</para>
  <para style="s1">Xin Chúa Cứu Khỏi Kẻ Thù</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Xin nghe con cầu nguyện, lạy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 143:1">xin nghe con khẩn nài!</para>
  <para style="q2" vid="PSA 143:1">Do đức thành tín và công chính, xin đáp lời con.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Xin đừng phán xét đầy tớ Chúa,</para>
  <para style="q2" vid="PSA 143:2">vì chẳng người sống nào là công chính trước mặt Ngài.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Kẻ thù con săn đuổi con.</para>
  <para style="q2" vid="PSA 143:3">Họ đè bẹp con dưới đất,</para>
  <para style="q2" vid="PSA 143:3">bắt con sống trong bóng đêm như xác người nơi cổ mộ.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Tinh thần con nao núng;</para>
  <para style="q2" vid="PSA 143:4">lòng dạ con sầu não.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Con nhớ những ngày xa xưa.</para>
  <para style="q2" vid="PSA 143:5">Hồi tưởng công trình của Chúa</para>
  <para style="q2" vid="PSA 143:5">và suy ngẫm việc tay Ngài làm.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Con đưa tay hướng về Chúa nguyện cầu.</para>
  <para style="q2" vid="PSA 143:6">Lòng con khát khao Ngài như đất khô hạn.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Xin mau đến, lạy Chúa Hằng Hữu, xin đáp lời con,</para>
  <para style="q2" vid="PSA 143:7">vì tâm hồn con tàn tạ.</para>
  <para style="q1" vid="PSA 143:7">Xin đừng tránh mặt con,</para>
  <para style="q2" vid="PSA 143:7">kẻo con như người xuống huyệt sâu.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Buổi sáng, xin cho con nghe giọng nhân từ Chúa,</para>
  <para style="q2" vid="PSA 143:8">vì con tin cậy Ngài.</para>
  <para style="q1" vid="PSA 143:8">Xin cho con biết đường lối phải theo,</para>
  <para style="q2" vid="PSA 143:8">vì con hướng lòng đến Chúa.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Xin Chúa Hằng Hữu giải thoát con khỏi kẻ thù;</para>
  <para style="q2" vid="PSA 143:9">vì con đến ẩn nấp nơi Ngài.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Xin dạy con làm theo ý Chúa,</para>
  <para style="q2" vid="PSA 143:10">vì Ngài là Đức Chúa Trời con.</para>
  <para style="q1" vid="PSA 143:10">Thần Linh Ngài toàn thiện,</para>
  <para style="q2" vid="PSA 143:10">xin dắt con vào lối công chính.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Vì Danh Chúa Hằng Hữu, xin cho con sống.</para>
  <para style="q2" vid="PSA 143:11">Do đức công chính Chúa, xin cứu con khỏi gian nan.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Do lòng nhân từ, xin giết sạch kẻ thù,</para>
  <para style="q2" vid="PSA 143:12">và tiêu diệt người làm con khốn khổ,</para>
  <para style="q2" vid="PSA 143:12">vì con là đầy tớ Ngài.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="cl">Thi Thiên 144</para>
  <para style="s1">Xin Chúa Giải Cứu</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Chúc tụng Chúa Hằng Hữu, Vầng Đá của con.</para>
  <para style="q2" vid="PSA 144:1">Ngài dạy tay con đánh giặc</para>
  <para style="q2" vid="PSA 144:1">tập ngón tay con quen trận mạc.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Chúa là Đấng Nhân Từ và là đồn lũy,</para>
  <para style="q2" vid="PSA 144:2">pháo đài an toàn, Đấng giải cứu.</para>
  <para style="q1" vid="PSA 144:2">Chúa là tấm khiên che chở con, con ẩn nấp nơi Ngài.</para>
  <para style="q2" vid="PSA 144:2">Ngài khiến toàn dân đầu phục con.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />Lạy Chúa Hằng Hữu, loài người là gì mà Chúa lưu ý,</para>
  <para style="q2" vid="PSA 144:3">con loài người là chi mà Chúa yêu mến?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Loài người khác nào hơi thở,</para>
  <para style="q2" vid="PSA 144:4">đời người như bóng bay qua.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Lạy Chúa Hằng Hữu, xin hạ thấp màn trời và bước xuống.</para>
  <para style="q2" vid="PSA 144:5">Ngài đụng đến núi, khói bốc lên.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Xin phát chớp nhoáng cho quân thù tan vỡ!</para>
  <para style="q2" vid="PSA 144:6">Bắn tên cho họ rối loạn!<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Từ trời cao, xin đưa tay cứu con;</para>
  <para style="q2" vid="PSA 144:7">giải thoát con khỏi những dòng nước sâu,</para>
  <para style="q2" vid="PSA 144:7">và khỏi dân các nước.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Miệng họ đầy lời dối gian;</para>
  <para style="q2" vid="PSA 144:8">họ thề nói điều thật, nhưng chỉ toàn lời giả dối.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Lạy Đức Chúa Trời, con sẽ hát bài ca mới cho Chúa!</para>
  <para style="q2" vid="PSA 144:9">Con sẽ ca tụng Chúa với đàn hạc mười dây.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Chúa đã cứu các vua!</para>
  <para style="q2" vid="PSA 144:10">Giải thoát Đa-vít, đầy tớ Chúa khỏi gươm tai hại.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Xin cứu con!</para>
  <para style="q2" vid="PSA 144:11">Xin giải cứu con khỏi tay kẻ thù con.</para>
  <para style="q1" vid="PSA 144:11">Miệng họ đầy lời dối gian;</para>
  <para style="q2" vid="PSA 144:11">họ thề nói điều thật, nhưng chỉ toàn lời giả dối.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Nguyện con trai chúng con sẽ như cây non phát triển mạnh mẽ,</para>
  <para style="q2" vid="PSA 144:12">Nguyện con gái chúng con như đá móng đẽo mài xây cất đền đài.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Nguyện các kho vựa chúng con sẽ đầy tràn</para>
  <para style="q2" vid="PSA 144:13">lương thực đủ loại.</para>
  <para style="q1" vid="PSA 144:13">Nguyện bầy chiên chúng con sinh sản đầy đồng,</para>
  <para style="q2" vid="PSA 144:13">hàng nghìn hàng vạn,<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />và nguyện đàn bò chúng con sinh sôi nẩy nở.</para>
  <para style="q2" vid="PSA 144:14">Nguyện cướp giựt, tranh chấp không xảy ra trong xóm làng.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Phước cho dân tộc sống như thế!</para>
  <para style="q2" vid="PSA 144:15">Phước cho dân tộc có Chúa Hằng Hữu làm Đức Chúa Trời mình.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="cl">Thi Thiên 145</para>
  <para style="s1">Bài Ca Chúa Hằng Hữu</para>
  <para style="d">(Thơ của Đa-vít)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Con sẽ tôn vinh Vua, là Đức Chúa Trời con,</para>
  <para style="q2" vid="PSA 145:1">chúc tụng Danh Ngài mãi mãi.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Con sẽ chúc tụng Chúa mỗi ngày;</para>
  <para style="q2" vid="PSA 145:2">phải, con sẽ ca tụng Ngài mãi mãi.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Chúa Hằng Hữu thật cao cả! Ngài thật đáng tán dương!</para>
  <para style="q2" vid="PSA 145:3">Không ai có thể so sánh sự vĩ đại của Ngài.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Đời này sang đời kia sẽ ca tụng công đức Chúa,</para>
  <para style="q2" vid="PSA 145:4">tuyên dương những việc diệu kỳ.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Con sẽ nói về vinh quang Chúa uy nghi rực rỡ,</para>
  <para style="q2" vid="PSA 145:5">và những việc diệu kỳ.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Người ta sẽ nói về những việc phi thường của Chúa,</para>
  <para style="q2" vid="PSA 145:6">còn con sẽ tuyên dương sự cao cả của Ngài.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Họ sẽ nhắc nhở đức từ ái lớn lao;</para>
  <para style="q2" vid="PSA 145:7">họ sẽ hát khen đức công chính của Chúa.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Chúa Hằng Hữu ban ơn, giàu lòng thương,</para>
  <para style="q2" vid="PSA 145:8">chậm giận và vô cùng nhân từ.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Chúa Hằng Hữu ban phước cho mọi người.</para>
  <para style="q2" vid="PSA 145:9">Ngài nhân từ dịu dàng trong mọi việc.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Các công việc Chúa sẽ cảm tạ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 145:10">và con cái Chúa sẽ chúc tụng Ngài.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Họ sẽ nói về vinh quang vương quốc Chúa;</para>
  <para style="q2" vid="PSA 145:11">họ sẽ nói về năng lực Ngài.<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />Để loài người biết năng lực Chúa,</para>
  <para style="q2" vid="PSA 145:12">và vinh quang uy nghiêm của ngôi nước Ngài.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Vương quốc Chúa tồn tại vĩnh cửu.</para>
  <para style="q2" vid="PSA 145:13">Quyền lực Chúa còn muôn đời.<verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />Chúa Hằng Hữu đỡ người ngã,</para>
  <para style="q2" vid="PSA 145:14">và người khòm xuống được Ngài nâng lên.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Mắt muôn loài trông mong Chúa;</para>
  <para style="q2" vid="PSA 145:15">Chúa ban lương thực đúng kỳ.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Chúa mở rộng tay,</para>
  <para style="q2" vid="PSA 145:16">làm thỏa mãn ước muốn của mọi sinh vật.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />Chúa Hằng Hữu công chính mọi đường,</para>
  <para style="q2" vid="PSA 145:17">Ngài rộng lòng trong mọi việc.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />Chúa Hằng Hữu ở gần người cầu khẩn,</para>
  <para style="q2" vid="PSA 145:18">những người chân thành cầu khẩn Ngài.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Chúa làm cho những người kính sợ Chúa thỏa nguyện;</para>
  <para style="q2" vid="PSA 145:19">Ngài nghe họ kêu xin và giải cứu.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />Chúa Hằng Hữu bảo vệ người yêu mến Ngài,</para>
  <para style="q2" vid="PSA 145:20">nhưng Ngài hủy diệt mọi người ác.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Miệng con sẽ ca tụng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 145:21">mọi tạo vật hãy chúc tụng Danh Thánh Ngài đời đời mãi mãi.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="cl">Thi Thiên 146</para>
  <para style="s1">Cảm Tạ Chúa vì Được Chúa Phù Trợ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Ngợi tôn Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q1" vid="PSA 146:1">Linh hồn con ca tụng Chúa Hằng Hữu.<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Con sẽ ca tụng Chúa trọn đời con,</para>
  <para style="q2" vid="PSA 146:2">Còn sống bao lâu con sẽ tôn vinh Đức Chúa Trời bấy lâu.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Đừng tin tưởng vua chúa hay con loài người,</para>
  <para style="q2" vid="PSA 146:3">vì họ không thể cứu rỗi ai.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Hơi thở dứt, họ trở về cát bụi,</para>
  <para style="q2" vid="PSA 146:4">chính ngày ấy, những kế hoạch của họ tiêu tan.<verse eid="PSA 146:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Phước cho người có Đức Chúa Trời của Gia-cốp giúp đỡ,</para>
  <para style="q2" vid="PSA 146:5">đặt hy vọng nơi Chúa Hằng Hữu, Đức Chúa Trời mình.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Chúa sáng tạo trời và đất,</para>
  <para style="q2" vid="PSA 146:6">biển, và mọi vật trong biển,</para>
  <para style="q2" vid="PSA 146:6">Ngài thành tín muôn đời.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Chúa minh oan người bị áp bức,</para>
  <para style="q2" vid="PSA 146:7">Ngài ban lương thực cho người đói khổ.</para>
  <para style="q2" vid="PSA 146:7">Chúa Hằng Hữu giải thoát người bị giam cầm.<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />Chúa Hằng Hữu mở mắt người mù.</para>
  <para style="q2" vid="PSA 146:8">Chúa Hằng Hữu làm thẳng người cong khom.</para>
  <para style="q2" vid="PSA 146:8">Chúa Hằng Hữu yêu thương người công chính.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Chúa Hằng Hữu bảo vệ khách lạ.</para>
  <para style="q2" vid="PSA 146:9">Ngài cứu trợ người mồ côi và góa bụa,</para>
  <para style="q2" vid="PSA 146:9">nhưng lật đổ đường lối người ác.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Chúa Hằng Hữu cai trị vĩnh viễn,</para>
  <para style="q2" vid="PSA 146:10">Ngài sẽ là Đức Chúa Trời ngươi, Si-ôn hỡi, là Đấng cầm quyền muôn đời.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="cl">Thi Thiên 147</para>
  <para style="s1">Cảm Tạ Chúa vì Giê-ru-sa-lem Được Tái Thiết</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Tán dương Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Chúc tụng Đức Chúa Trời là việc tốt đẹp biết bao!</para>
  <para style="q2" vid="PSA 147:1">Tôn vinh Ngài thật làm vui thích, thỏa lòng!<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Chúa Hằng Hữu thiết lập Giê-ru-sa-lem</para>
  <para style="q2" vid="PSA 147:2">và Ngài tập họp những người lưu đày trở về Ít-ra-ên.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Chúa chữa lành tấm lòng tan vỡ</para>
  <para style="q2" vid="PSA 147:3">và băng bó những vết thương.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Chúa đếm các tinh tú</para>
  <para style="q2" vid="PSA 147:4">và gọi đích danh.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Chúa chúng ta vĩ đại! Quyền năng Ngài cao cả!</para>
  <para style="q2" vid="PSA 147:5">Sự thông sáng của Ngài vô cùng vô tận!<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />Chúa Hằng Hữu nâng cao người khiêm tốn,</para>
  <para style="q2" vid="PSA 147:6">nhưng đánh ngã người ác xuống đất.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Hãy hát cảm tạ Chúa Hằng Hữu;</para>
  <para style="q2" vid="PSA 147:7">hãy dùng đàn hạc mà ca tụng Đức Chúa Trời.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Chúa giăng mây che phủ bầu trời,</para>
  <para style="q2" vid="PSA 147:8">chuẩn bị mưa xuống đất,</para>
  <para style="q2" vid="PSA 147:8">và cho cỏ mọc lên xanh núi đồi.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Chúa ban lương thực cho thú hoang,</para>
  <para style="q2" vid="PSA 147:9">và cho các loài chim quạ.<verse eid="PSA 147:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Chúa không thích sức mạnh của ngựa</para>
  <para style="q2" vid="PSA 147:10">không ưa đôi chân của loài người.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />Nhưng Chúa hài lòng những ai kính sợ Ngài,</para>
  <para style="q2" vid="PSA 147:11">là những người trông cậy lòng nhân từ Ngài.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Hỡi Giê-ru-sa-lem, hãy ngợi tôn Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 147:12">Hỡi Si-ôn, hãy chúc tụng Đức Chúa Trời!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Chúa làm kiên cố then cửa ngươi,</para>
  <para style="q2" vid="PSA 147:13">và ban phước cho con cái ở giữa ngươi.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Chúa ban thanh bình nơi biên cương</para>
  <para style="q2" vid="PSA 147:14">và cho đầy dẫy lúa mì thượng hạng.<verse eid="PSA 147:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Chúa ra lệnh cho cả thế giới—</para>
  <para style="q2" vid="PSA 147:15">lời Ngài loan truyền nhanh chóng!<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Chúa làm tuyết rơi, trắng như lông chiên;</para>
  <para style="q2" vid="PSA 147:16">Ngài rải sương xám như tro.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Chúa ném từng mảng băng giá xuống.</para>
  <para style="q2" vid="PSA 147:17">Ai có thể chịu nổi cái lạnh thấu xương?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Rồi Chúa truyền lệnh, băng tuyết tan ra.</para>
  <para style="q2" vid="PSA 147:18">Ngài sai gió thổi, nước chảy ra thành sông.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Chúa công bố lời Ngài cho Gia-cốp,</para>
  <para style="q2" vid="PSA 147:19">phép tắc và luật lệ cho Ít-ra-ên.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Chúa không làm như thế cho dân tộc nào khác;</para>
  <para style="q2" vid="PSA 147:20">Họ không biết các luật lệ của Ngài.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="cl">Thi Thiên 148</para>
  <para style="s1">Kêu Gọi Muôn Vật Ngợi Tôn Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Tán dương Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Trên thiên cung hãy ca tụng Chúa Hằng Hữu!</para>
  <para style="q2" vid="PSA 148:1">Hãy ngợi tôn Ngài từ trời cao!<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Tất cả thiên sứ, hãy chúc tụng Chúa!</para>
  <para style="q2" vid="PSA 148:2">Tất cả thiên binh, hãy tán dương Ngài!<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Mặt trời và mặt trăng, hãy ngợi khen Chúa!</para>
  <para style="q2" vid="PSA 148:3">Các tinh tú sáng láng, hãy chúc tôn Ngài.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Các tầng trời, hãy ca tụng Chúa!</para>
  <para style="q2" vid="PSA 148:4">Các nguồn nước trên mây, hãy ca tụng Ngài!<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Hỡi các tạo vật, hãy tôn ngợi Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 148:5">vì do lệnh Ngài, tất cả được dựng nên.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Chúa đã thiết lập các tạo vật vững chãi đời đời.</para>
  <para style="q2" vid="PSA 148:6">Sắc luật Ngài không hề đổi thay.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Hãy ngợi tôn Chúa Hằng Hữu</para>
  <para style="q2" vid="PSA 148:7">hỡi các loài dã thú trên đất và dưới vực thẳm,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />lửa và nước đá, hơi nước và tuyết giá,</para>
  <para style="q2" vid="PSA 148:8">lẫn cuồng phong vũ bão đều vâng lệnh Ngài,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />tất cả núi và đồi,</para>
  <para style="q2" vid="PSA 148:9">các loài cây ăn quả và mọi loài bá hương,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />thú rừng và gia súc,</para>
  <para style="q2" vid="PSA 148:10">loài bò sát và chim chóc,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />các vua trần gian và mọi dân tộc,</para>
  <para style="q2" vid="PSA 148:11">mọi vương hầu và phán quan trên địa cầu,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />thanh thiếu niên nam nữ,</para>
  <para style="q2" vid="PSA 148:12">người già cả lẫn trẻ con.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Tất cả hãy tán dương Danh Chúa Hằng Hữu,</para>
  <para style="q2" vid="PSA 148:13">Vì Danh Ngài thật tuyệt diệu;</para>
  <para style="q2" vid="PSA 148:13">vinh quang Ngài hơn cả đất trời!<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Ngài gia tăng sức mạnh<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="ft" closed="false">Nt sừng</char></note> toàn dân,</para>
  <para style="q2" vid="PSA 148:14">để những người trung tín của Ngài ca ngợi Ngài—</para>
  <para style="q2" vid="PSA 148:14">họ là con cháu Ít-ra-ên, là dân tộc thân yêu của Ngài.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="cl">Thi Thiên 149</para>
  <para style="s1">Kêu Gọi Dân Tôn Vinh Chúa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Tán dương Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Hãy hát cho Chúa Hằng Hữu bài ca mới.</para>
  <para style="q2" vid="PSA 149:1">Ca tụng Ngài giữa đại hội đồng dân Chúa.<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Ít-ra-ên hoan hỉ nơi Đấng Sáng Tạo mình.</para>
  <para style="q2" vid="PSA 149:2">Con cái Si-ôn vui mừng vì Vua mình.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Họ chúc tụng Danh Chúa bằng vũ điệu,</para>
  <para style="q2" vid="PSA 149:3">ca ngợi Ngài bằng trống cơm và đàn hạc.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Vì Chúa Hằng Hữu hài lòng con dân Ngài;</para>
  <para style="q2" vid="PSA 149:4">ban ơn cứu vớt cho người khiêm cung.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Người tin kính vui mừng, vinh dự.</para>
  <para style="q2" vid="PSA 149:5">Trổi giọng hoan ca trên giường.<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Hãy dùng môi miệng tung hô Đức Chúa Trời,</para>
  <para style="q2" vid="PSA 149:6">tay cầm gươm hai lưỡi—<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />để báo thù các nước</para>
  <para style="q2" vid="PSA 149:7">và hình phạt các dân tộc,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />dùng xích trói các vua</para>
  <para style="q2" vid="PSA 149:8">và còng tay bọn quý tộc,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />thi hành bản án đã được ghi.</para>
  <para style="q2" vid="PSA 149:9">Đó là vinh quang cho các người thánh của Chúa.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="cl">Thi Thiên 150</para>
  <para style="s1">Ca Ngợi Chúa Bằng Nhạc Khí</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Tán dương Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Hãy ca tụng Đức Chúa Trời trong nơi thánh Ngài;</para>
  <para style="q2" vid="PSA 150:1">ca tụng Chúa trên khung trời uy linh.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Hãy ca tụng Chúa vì các việc kỳ diệu;</para>
  <para style="q2" vid="PSA 150:2">ca tụng Ngài vì lòng cao cả vô biên.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Ca tụng Chúa bằng tiếng kèn rộn rã;</para>
  <para style="q2" vid="PSA 150:3">ca tụng Ngài với đàn lia và đàn hạc.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Ca tụng Chúa bằng trống cơm và điệu vũ,</para>
  <para style="q2" vid="PSA 150:4">ca tụng Ngài với đàn dây và ống tiêu.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Ca tụng Chúa bằng tiếng chập chõa,</para>
  <para style="q2" vid="PSA 150:5">ca tụng Ngài với phèng la vang rền.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Hỡi mọi sinh vật có hơi thở, hãy ca tụng Chúa Hằng Hữu!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Ngợi tôn Chúa Hằng Hữu!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>