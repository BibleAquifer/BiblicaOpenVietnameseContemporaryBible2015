  <para style="h">Châm Ngôn</para>
  <para style="toc1">Châm Ngôn</para>
  <para style="toc2">Châm Ngôn</para>
  <para style="toc3">Châm</para>
  <para style="mt1">Châm Ngôn</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Mục Đích của Châm Ngôn</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Đây là những châm ngôn của Sa-lô-môn, con trai Đa-vít, vua Ít-ra-ên.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Để người ta tìm đến khôn ngoan và tiếp thu lời khuyên dạy,</para>
  <para style="q2" vid="PRO 1:2">cùng phân biện được tri thức.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Để đạt đến một đời sống kỷ luật và cẩn trọng,</para>
  <para style="q2" vid="PRO 1:3">hành động phải lẽ, công bằng, và ngay thẳng.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Để giúp người đơn sơ được sáng suốt,</para>
  <para style="q2" vid="PRO 1:4">và người trẻ tuổi hiểu biết và thận trọng.<verse eid="PRO 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Người khôn học hỏi châm ngôn để thêm khôn.</para>
  <para style="q2" vid="PRO 1:5">Người hiểu biết thấy được đường đi nước bước<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />nếu biết ứng dụng châm ngôn, ngụ ngôn</para>
  <para style="q2" vid="PRO 1:6">dùng những lời khôn ngoan và những câu đố thâm trầm của hiền nhân.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Kính sợ Chúa Hằng Hữu là khởi đầu của mọi tri thức,</para>
  <para style="q2" vid="PRO 1:7">chỉ có người dại mới coi thường khôn ngoan và huấn thị.<verse eid="PRO 1:7" /></para>
  <para style="s1">Lời Khuyên của Người Cha: Tìm Kiếm Sự Khôn Ngoan</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Con ơi, phải nghe lời cha khuyên dạy.</para>
  <para style="q2" vid="PRO 1:8">Đừng bỏ khuôn phép của mẹ con.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Đó là trang sức duyên dáng trên đầu con</para>
  <para style="q2" vid="PRO 1:9">và dây chuyền xinh đẹp nơi cổ con.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Con ơi, khi người tội lỗi quyến rũ,</para>
  <para style="q2" vid="PRO 1:10">con đừng nghe theo!<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Khi họ bảo: “Hãy đến với chúng ta.</para>
  <para style="q2" vid="PRO 1:11">Rình rập và giết người!</para>
  <para style="q2" vid="PRO 1:11">Lén hại người lương thiện vô tội!<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Ta sẽ nuốt sống nó như âm phủ;</para>
  <para style="q2" vid="PRO 1:12">nuốt trọn như người xuống huyệt sâu.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Ta sẽ lấy đủ mọi của báu.</para>
  <para style="q2" vid="PRO 1:13">Chất của cướp đầy nhà.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Bạn sẽ cùng chúng ta rút thăm chia của;</para>
  <para style="q2" vid="PRO 1:14">rồi tất cả đều chung một túi tiền.”<verse eid="PRO 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Thì con ơi, đừng nghe theo họ!</para>
  <para style="q2" vid="PRO 1:15">Chân con phải tránh xa đường họ đi.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Vì họ nhanh chân theo điều ác.</para>
  <para style="q2" vid="PRO 1:16">Vội vàng ra tay đổ máu.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Khi người giăng lưới bắt chim,</para>
  <para style="q2" vid="PRO 1:17">chim khôn bay thoát.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Nhưng bọn người này tự giăng bẫy;</para>
  <para style="q2" vid="PRO 1:18">rồi sa vào bẫy do chính mình giăng ra.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Đó là số phận người ham lợi bất nghĩa;</para>
  <para style="q2" vid="PRO 1:19">lợi ấy sẽ tiêu diệt mạng sống họ.<verse eid="PRO 1:19" /></para>
  <para style="s1">Sự Khôn Ngoan Kêu Lên Ngoài Đường</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Khôn ngoan lên tiếng ngoài đường.</para>
  <para style="q2" vid="PRO 1:20">Loan truyền khắp phố phường.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Kêu gọi nơi công cộng,</para>
  <para style="q2" vid="PRO 1:21">tại cổng thành, trong đô thị:<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Hỡi người khờ dại, đến bao giờ</para>
  <para style="q2" vid="PRO 1:22">ngươi mới thôi chìm đắm u mê?</para>
  <para style="q1" vid="PRO 1:22">Đến khi nào người chế nhạo mới bỏ thói khinh khi?</para>
  <para style="q2" vid="PRO 1:22">Và người dại thù ghét tri thức đến chừng nào?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Hãy đến và nghe ta sửa dạy.</para>
  <para style="q2" vid="PRO 1:23">Ta sẽ ban thần trí khôn ngoan</para>
  <para style="q2" vid="PRO 1:23">để con thông suốt lời ta.<verse eid="PRO 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Nhưng, dù ta kêu gọi, các ngươi vẫn từ nan.</para>
  <para style="q2" vid="PRO 1:24">Ta đưa tay chờ đợi, cũng không ai quan tâm.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Không ai để ý lời ta khuyên răn</para>
  <para style="q2" vid="PRO 1:25">hay chịu nghe lời ta quở trách.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Nên khi các người lâm nạn, ta sẽ cười!</para>
  <para style="q2" vid="PRO 1:26">Và chế giễu khi các người kinh hãi—<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />khi kinh hoàng vụt đến tựa phong ba,</para>
  <para style="q2" vid="PRO 1:27">khi tai ương xâm nhập như bão tố,</para>
  <para style="q2" vid="PRO 1:27">và nguy nan cùng khổ ngập tràn.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Họ sẽ kêu cầu ta, nhưng ta chẳng đáp lời.</para>
  <para style="q2" vid="PRO 1:28">Họ sẽ tìm kiếm ta, nhưng không sao gặp được.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Chính vì họ thù ghét tri thức</para>
  <para style="q2" vid="PRO 1:29">và không chịu kính sợ Chúa Hằng Hữu.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Họ không muốn nghe ta khuyên dạy</para>
  <para style="q2" vid="PRO 1:30">và khinh bỉ mọi lời quở trách.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Vì thế, họ sẽ hứng chịu kết quả công việc mình,</para>
  <para style="q2" vid="PRO 1:31">lãnh trọn quả báo mưu mô mình.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Người ngây thơ chết vì lầm đường lạc lối.</para>
  <para style="q2" vid="PRO 1:32">Người dại dột bị diệt vì tự thị tự mãn.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Nhưng ai nghe ta sẽ sống bình an,</para>
  <para style="q2" vid="PRO 1:33">không lo tai họa.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Ích Lợi của Khôn Ngoan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Con ơi, nếu con nghe lời ta dạy,</para>
  <para style="q2" vid="PRO 2:1">và gìn giữ các mệnh lệnh ta.<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />Lắng tai nghe điều khôn ngoan,</para>
  <para style="q2" vid="PRO 2:2">và hướng lòng về điều thông sáng.<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Nếu con cầu xin sáng suốt,</para>
  <para style="q2" vid="PRO 2:3">và khát khao hiểu biết.<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Nếu con kiếm nó như bạc,</para>
  <para style="q2" vid="PRO 2:4">tìm tòi nó như kho tàng giấu kín.<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />Lúc ấy, con sẽ am hiểu sự kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 2:5">và sẽ tìm được tri thức về Đức Chúa Trời.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Vì Chúa Hằng Hữu ban khôn ngoan!</para>
  <para style="q2" vid="PRO 2:6">Từ miệng Ngài ra điều tri thức và thông sáng.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Chúa dành khôn ngoan thật cho người công chính.</para>
  <para style="q2" vid="PRO 2:7">Ngài là thuẫn cho người làm điều ngay thật.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Ngài bảo vệ con đường của công lý</para>
  <para style="q2" vid="PRO 2:8">và che chở đường lối của các thánh Ngài.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Lúc ấy con sẽ hiểu công chính, công bình, và ngay thẳng,</para>
  <para style="q2" vid="PRO 2:9">con sẽ biết mọi đường lối tốt đẹp.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Khi khôn ngoan vào lòng con,</para>
  <para style="q2" vid="PRO 2:10">tri thức sẽ thỏa mãn tâm hồn.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Tính thận trọng bảo vệ con.</para>
  <para style="q2" vid="PRO 2:11">Thông sáng gìn giữ con luôn.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Khôn ngoan sẽ cứu con khỏi đường tà,</para>
  <para style="q2" vid="PRO 2:12">và khỏi người nói lời gian trá.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Những người bỏ lối ngay thẳng</para>
  <para style="q2" vid="PRO 2:13">mà đi theo đường tối tăm.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Họ vui thích làm điều xấu,</para>
  <para style="q2" vid="PRO 2:14">và ham mê sự đồi trụy của người ác.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Lối họ quanh co,</para>
  <para style="q2" vid="PRO 2:15">và họ lầm lạc trong đường mình.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Khôn ngoan cứu con khỏi dâm phụ,</para>
  <para style="q2" vid="PRO 2:16">khỏi đàn bà ngoại tình với lời quyến rũ.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Ả đã lìa bỏ bạn đời của ả lúc thiếu thời</para>
  <para style="q2" vid="PRO 2:17">và quên lời giao ước thiêng liêng trước Đức Chúa Trời.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Nhà của ả đưa vào cõi chết;</para>
  <para style="q2" vid="PRO 2:18">đường của ả dẫn đến âm ty,<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Ai đến với ả đều không trở về.</para>
  <para style="q2" vid="PRO 2:19">Không ai tìm được nẻo của sự sống.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Khôn ngoan giúp người lương thiện,</para>
  <para style="q2" vid="PRO 2:20">gìn giữ lối người công chính.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Vì người ngay thẳng sẽ sống trong xứ,</para>
  <para style="q2" vid="PRO 2:21">và người trong sạch<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="ft" closed="false">Nt hoàn hảo</char></note> sẽ ở đó luôn.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Nhưng người ác bị dứt khỏi mặt đất,</para>
  <para style="q2" vid="PRO 2:22">người bất trung cũng sẽ bị nhổ đi.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Tin Cậy Chúa Hằng Hữu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Con ơi, đừng quên lời ta dạy.</para>
  <para style="q2" vid="PRO 3:1">Nhưng giữ những mệnh lệnh ta trong lòng con.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Nếu con làm vậy, con sẽ được gia tăng tuổi thọ,</para>
  <para style="q2" vid="PRO 3:2">và cho đời sống con thịnh vượng.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Đừng để nhân từ, chân thật xa lìa con!</para>
  <para style="q2" vid="PRO 3:3">Hãy đeo vào cổ để nhắc nhớ.</para>
  <para style="q2" vid="PRO 3:3">Hãy ghi sâu vào lòng mình.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Như thế, trước mặt Đức Chúa Trời và loài người,</para>
  <para style="q2" vid="PRO 3:4">con được ân huệ và sự hiểu biết chính đáng.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Hãy hết lòng tin cậy Chúa Hằng Hữu;</para>
  <para style="q2" vid="PRO 3:5">đừng nương vào sự hiểu biết của riêng con.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Trong các việc làm của con, hãy cầu xin Ngài,</para>
  <para style="q2" vid="PRO 3:6">và Ngài sẽ hướng dẫn con trong các nẻo con đi.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Đừng khôn ngoan theo mắt mình.</para>
  <para style="q2" vid="PRO 3:7">Hãy kính sợ Chúa Hằng Hữu, xa lánh điều ác.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Như thế, thân xác con sẽ mạnh khỏe</para>
  <para style="q2" vid="PRO 3:8">và xương con được cứng cáp.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Hãy dùng tài sản và hoa lợi đầu mùa</para>
  <para style="q2" vid="PRO 3:9">mà tôn vinh Chúa Hằng Hữu.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Như thế, kho thóc con đầy dẫy,</para>
  <para style="q2" vid="PRO 3:10">thùng chứa rượu mới tràn đầy.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Con ơi, đừng coi thường sự sửa phạt của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 3:11">đừng bực mình khi Ngài trừng trị.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Vì Chúa Hằng Hữu sửa dạy người Ngài yêu,</para>
  <para style="q2" vid="PRO 3:12">như cha đối với con yêu dấu.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Phước cho người tìm được khôn ngoan,</para>
  <para style="q2" vid="PRO 3:13">vì nhận được sự thông sáng.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Vì được nó có ích hơn được bạc,</para>
  <para style="q2" vid="PRO 3:14">và sinh lợi hơn vàng.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Khôn ngoan quý hơn hồng ngọc;</para>
  <para style="q2" vid="PRO 3:15">không có gì con ao ước sánh kịp.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Tay phải của khôn ngoan có trường thọ,</para>
  <para style="q2" vid="PRO 3:16">còn tay trái có giàu sang và vinh dự.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Các đường của khôn ngoan đều thích thú;</para>
  <para style="q2" vid="PRO 3:17">mọi nẻo của nó đều an vui.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Nó là cây vĩnh sinh cho người nắm lấy;</para>
  <para style="q2" vid="PRO 3:18">và hạnh phúc cho ai giữ chặt.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Chúa Hằng Hữu do khôn ngoan sáng tạo đất;</para>
  <para style="q2" vid="PRO 3:19">và do thông sáng thiết lập trời.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Do tri thức Ngài, biển sâu mở toang,</para>
  <para style="q2" vid="PRO 3:20">và mây đọng thành sương.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Con ơi, hãy giữ khôn ngoan thật và thận trọng.</para>
  <para style="q2" vid="PRO 3:21">Đừng để nó xa tầm mắt con.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Nó là sức sống trong tâm hồn,</para>
  <para style="q2" vid="PRO 3:22">là trang sức duyên dáng nơi cổ con.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Nhờ đó, con tiến bước an toàn,</para>
  <para style="q2" vid="PRO 3:23">chân con không vấp ngã.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Khi nằm, con không phải lo lắng,</para>
  <para style="q2" vid="PRO 3:24">vừa ngã lưng, con đã ngon giấc.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Khi thấy người ác gặp tai họa hay hủy diệt bất ngờ,</para>
  <para style="q2" vid="PRO 3:25">con không hoang mang lo sợ,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />vì Chúa Hằng Hữu là Đấng con tin cậy.</para>
  <para style="q2" vid="PRO 3:26">Ngài sẽ giữ chân con khỏi cạm bẫy.<verse eid="PRO 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Đừng từ chối làm lành cho người xứng đáng</para>
  <para style="q2" vid="PRO 3:27">khi con có năng lực làm việc ấy.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Nếu hiện tại con có thể giúp người láng giềng, thì đừng nói:</para>
  <para style="q2" vid="PRO 3:28">“Ngày mai hãy trở lại, tôi sẽ giúp anh.”<verse eid="PRO 3:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Đừng mưu đồ ám hại láng giềng,</para>
  <para style="q2" vid="PRO 3:29">vì họ vẫn có lòng tin cậy nơi con.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Đừng vô cớ cáo tội ai,</para>
  <para style="q2" vid="PRO 3:30">khi người ấy không gây cho con thiệt hại.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Đừng thèm muốn địa vị người dữ dằn,</para>
  <para style="q2" vid="PRO 3:31">cũng đừng bước theo con đường họ đi.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Vì Chúa Hằng Hữu ghét người hư hoại,</para>
  <para style="q2" vid="PRO 3:32">nhưng thổ lộ tâm tình với ai ngay lành.<verse eid="PRO 3:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Chúa Hằng Hữu nguyền rủa nhà của người ác,</para>
  <para style="q2" vid="PRO 3:33">nhưng đổ phước lành trên nhà người công chính.<verse eid="PRO 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Chúa Hằng Hữu cười chê người kiêu căng báng bổ,</para>
  <para style="q2" vid="PRO 3:34">nhưng ban ơn phước trên người khiêm nhu.<verse eid="PRO 3:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Vinh dự là gia tài Chúa dành cho người khôn,</para>
  <para style="q2" vid="PRO 3:35">còn xấu hổ nhuốc nhơ là phần của người dại dột.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Lời Khuyên Khôn Ngoan của Người Cha</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Con ơi, hãy nghe cha khuyên dạy.</para>
  <para style="q2" vid="PRO 4:1">Lắng tai để có sự hiểu biết,<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />vì ta cho con bài học tốt.</para>
  <para style="q2" vid="PRO 4:2">Đừng bỏ phép tắc của ta.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Vì ta cũng vậy, vốn là con của cha ta,</para>
  <para style="q2" vid="PRO 4:3">là đứa con một yêu quý của mẹ ta.<verse eid="PRO 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Cha ta cũng dạy ta rằng:</para>
  <para style="q2" vid="PRO 4:4">“Lòng con ghi tạc lời ta.</para>
  <para style="q2" vid="PRO 4:4">Giữ gìn mệnh lệnh ta và sống.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Tìm cầu khôn ngoan và thông sáng.</para>
  <para style="q2" vid="PRO 4:5">Đừng từ khước, đừng xây bỏ lời ta,<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Đừng lìa bỏ sự khôn ngoan, vì nó sẽ bảo vệ con.</para>
  <para style="q2" vid="PRO 4:6">Hãy yêu mến sự khôn ngoan, vì nó sẽ gìn giữ con.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Khôn ngoan là cần yếu, hãy tìm cầu sự khôn ngoan!</para>
  <para style="q2" vid="PRO 4:7">Tận dụng khả năng cho được thông sáng.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Nếu tôn trọng sự khôn ngoan, nó sẽ đưa con lên cao.</para>
  <para style="q2" vid="PRO 4:8">Nắm giữ sự khôn ngoan, nó sẽ đem cho con vinh dự.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Nó sẽ ban vòng hoa xinh đẹp trên đầu con;</para>
  <para style="q2" vid="PRO 4:9">và đội cho con vương miện vinh quang.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Con ơi, hãy nghe và tiếp nhận lời ta,</para>
  <para style="q2" vid="PRO 4:10">thì con sẽ sống thêm được nhiều năm.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Ta đã dạy con biết đường khôn ngoan</para>
  <para style="q2" vid="PRO 4:11">và dẫn con theo lối ngay thẳng.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Khi con đi, con sẽ không bị vướng chân;</para>
  <para style="q2" vid="PRO 4:12">lúc con chạy, con sẽ không vấp ngã.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Hãy nắm chặt lời khuyên dạy; đừng bỏ qua điều ta dạy.</para>
  <para style="q2" vid="PRO 4:13">Phải nắm giữ, vì là chìa khóa của đời sống con.<verse eid="PRO 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Đừng bước vào đường người ác,</para>
  <para style="q2" vid="PRO 4:14">và đừng theo lối bọn gian manh.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Phải tránh xa; đừng bước ngang qua.</para>
  <para style="q2" vid="PRO 4:15">Phải quay lưng, thẳng bước mà đi.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Khi chưa làm ác, họ không thể chợp mắt.</para>
  <para style="q2" vid="PRO 4:16">Họ cố thức để gây vấp ngã cho người.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Họ ăn bánh gian ác</para>
  <para style="q2" vid="PRO 4:17">và uống rượu bạo tàn!<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Nhưng đường người công chính càng thêm sáng sủa,</para>
  <para style="q2" vid="PRO 4:18">rực rỡ như mặt trời lúc giữa trưa.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Đường người ác ngập tràn bóng tối.</para>
  <para style="q2" vid="PRO 4:19">Họ vấp ngã cũng chẳng biết vì đâu.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Con ơi, lưu ý lời ta dạy.</para>
  <para style="q2" vid="PRO 4:20">Lắng tai nghe lời ta giải bày.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Đừng để lời ta xa tầm mắt con.</para>
  <para style="q2" vid="PRO 4:21">Nhưng phải giữ chặt trong tâm hồn.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Vì lời ta đem sinh lực cho ai tìm được nó,</para>
  <para style="q2" vid="PRO 4:22">và chữa lành cho toàn thân họ.<verse eid="PRO 4:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Phải lo giữ tấm lòng con trước hết,</para>
  <para style="q2" vid="PRO 4:23">vì là nguồn nước sống tuôn tràn.<verse eid="PRO 4:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Con hãy tránh xa miệng lưỡi dối trá;</para>
  <para style="q2" vid="PRO 4:24">và bỏ cách xa con môi gian tà.<verse eid="PRO 4:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Mắt con phải nhìn thẳng,</para>
  <para style="q2" vid="PRO 4:25">và hướng tầm nhìn về phía trước mặt con.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Nếu con thận trọng mọi đường lối;</para>
  <para style="q2" vid="PRO 4:26">thì bước chân con sẽ vững vàng.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Đừng quay sang phải hay trái;</para>
  <para style="q2" vid="PRO 4:27">phải giữ chân con khỏi chỗ gian tà.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Khuyên Tránh Những Dâm Phụ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Con ơi, để ý nghe lời khôn ngoan ta;</para>
  <para style="q2" vid="PRO 5:1">lắng nghe cẩn thận những tư tưởng sáng suốt của ta.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Để con e dè thận trọng,</para>
  <para style="q2" vid="PRO 5:2">và môi con đọng lời tri thức.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Vì môi dâm phụ ngọt như mật ong,</para>
  <para style="q2" vid="PRO 5:3">miệng lưỡi nó trơn tru hơn dầu.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Nhưng về sau nó đắng như ngải cứu,</para>
  <para style="q2" vid="PRO 5:4">nguy hiểm như gươm hai lưỡi.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Chân nó đưa xuống âm ty;</para>
  <para style="q2" vid="PRO 5:5">bước nó dẫn vào mộ địa.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Nó không nghĩ đến con đường sống.</para>
  <para style="q2" vid="PRO 5:6">Lối nó cong queo, nhưng nó không hay biết.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Vậy, hỡi các con, hãy nghe ta.</para>
  <para style="q2" vid="PRO 5:7">Đừng bỏ qua lời ta khuyên dạy:<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Hãy tránh dâm phụ thật xa!</para>
  <para style="q2" vid="PRO 5:8">Đừng đến gần cửa nhà nó.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Kẻo con sẽ trao cả thanh danh cho người khác,</para>
  <para style="q2" vid="PRO 5:9">và năm tuổi con vào tay bọn bạo tàn.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Kẻo người lạ no nê tài sản con,</para>
  <para style="q2" vid="PRO 5:10">và công lao con làm giàu cho người khác.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Kẻo đến cuối cùng của đời con, con than van rên rỉ</para>
  <para style="q2" vid="PRO 5:11">khi thịt xương con bị tiêu mòn.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Con sẽ nói: “Sao ta coi khinh sự khuyên răn!</para>
  <para style="q2" vid="PRO 5:12">Và xem thường sự sửa phạt!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Sao ta không chịu vâng lời thầy?</para>
  <para style="q2" vid="PRO 5:13">Không lắng tai nghe người dạy dỗ ta?<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Hầu như ta bị mọi tai ương,</para>
  <para style="q2" vid="PRO 5:14">giữa cộng đồng và hội chúng.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Hãy uống nước nơi bể con chứa—</para>
  <para style="q2" vid="PRO 5:15">nước chảy trong giếng của con,<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Lẽ nào dòng suối con để chảy tràn trên đường phố?</para>
  <para style="q2" vid="PRO 5:16">Những dòng nước con tuôn ra nơi công cộng đông người?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Nước ấy là của riêng con.</para>
  <para style="q2" vid="PRO 5:17">Đừng chia sớt cho người lạ.<verse eid="PRO 5:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Nguyện suối nước của con được hưởng phước.</para>
  <para style="q2" vid="PRO 5:18">Con hãy vui với vợ cưới lúc thanh xuân.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Nàng như nai tơ dễ thương, hươu con duyên dáng.</para>
  <para style="q2" vid="PRO 5:19">Ngực nàng làm con mãn nguyện luôn luôn,</para>
  <para style="q2" vid="PRO 5:19">Tình yêu nàng, con đắm say mãi mãi.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Con ơi, sao dại dột mê dâm phụ,</para>
  <para style="q2" vid="PRO 5:20">sao con ôm ấp người nữ xa lạ?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Vì đường lối con người, Chúa Hằng Hữu đều thấy rõ,</para>
  <para style="q2" vid="PRO 5:21">Ngài xem xét mọi hướng người đi.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Người ác sẽ bị chính việc ác mình sập bẫy;</para>
  <para style="q2" vid="PRO 5:22">họ sẽ bị tội lỗi mình trói buộc.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Hắn sẽ chết vì không nghe răn dạy;</para>
  <para style="q2" vid="PRO 5:23">hắn sẽ bị lầm lạc vì quá điên rồ.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Những Bài Học cho Cuộc Sống Hằng Ngày</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Con ơi, nếu con bảo lãnh bạn sơ giao,</para>
  <para style="q2" vid="PRO 6:1">hay đưa tay cam kết với người lạ mặt.<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Nếu con vướng mắc lời thề,</para>
  <para style="q2" vid="PRO 6:2">bị miệng lưỡi con ràng buộc—<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />hãy nghe lời ta khuyên và tự cứu mình,</para>
  <para style="q2" vid="PRO 6:3">vì con đã rơi vào tay của bạn con.</para>
  <para style="q1" vid="PRO 6:3">Hãy hạ mình xuống;</para>
  <para style="q2" vid="PRO 6:3">đi xin họ hủy lời cam kết.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Đừng trì hoãn; con phải đi ngay!</para>
  <para style="q2" vid="PRO 6:4">Không được nghỉ ngơi cho đến khi xong việc.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Phải lo giải thoát lấy thân, như nai thoát tay thợ săn,</para>
  <para style="q2" vid="PRO 6:5">như chim thoát bẫy.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Này người lười biếng, hãy quan sát sinh hoạt loài kiến.</para>
  <para style="q2" vid="PRO 6:6">Hãy rút tỉa bài học để khôn ngoan!<verse eid="PRO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 6:7" />Tuy không có thủ lãnh,</para>
  <para style="q2" vid="PRO 6:7">quan chức, hay người cai trị,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />nhưng mùa hè, chúng biết dự trữ lương thực,</para>
  <para style="q2" vid="PRO 6:8">mùa gặt chúng biết gom góp thóc lúa.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Nhưng người lười biếng kia, còn ngủ mãi sao?</para>
  <para style="q2" vid="PRO 6:9">Đến bao giờ mới thức giấc?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Ngủ một chút, mơ màng thêm một chút,</para>
  <para style="q2" vid="PRO 6:10">khoanh tay nghỉ một chút nữa thôi—<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />cảnh nghèo đến như kẻ trộm;</para>
  <para style="q2" vid="PRO 6:11">bạo tàn, đột ngột như phường cướp tấn công.<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Bọn vô lại độc ác thích điều gì?</para>
  <para style="q2" vid="PRO 6:12">Họ không ngớt nói lời dối trá,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />nháy mắt, khều chân</para>
  <para style="q2" vid="PRO 6:13">hay tay ngầm ra dấu.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Lòng đầy gian tà, mưu toan điều ác,</para>
  <para style="q2" vid="PRO 6:14">xui cạnh tranh, bất hòa.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Nhưng họ sẽ bị tai họa bất ngờ,</para>
  <para style="q2" vid="PRO 6:15">bị diệt không phương cứu thoát.<verse eid="PRO 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Sáu điều Chúa Hằng Hữu ghét—</para>
  <para style="q2" vid="PRO 6:16">hay bảy điều làm Ngài gớm ghê:<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />Mắt kiêu căng,</para>
  <para style="q2" vid="PRO 6:17">lưỡi gian dối,</para>
  <para style="q2" vid="PRO 6:17">bàn tay đẫm máu vô tội,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />lòng mưu toan những việc hung tàn,</para>
  <para style="q2" vid="PRO 6:18">chân phóng nhanh đến nơi tội ác,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />làm chứng gian khai mang hại người,</para>
  <para style="q2" vid="PRO 6:19">xúi giục anh chị em tranh chấp.<verse eid="PRO 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Con ơi, phải nghe lời cha khuyên dạy,</para>
  <para style="q2" vid="PRO 6:20">và đừng bỏ khuôn phép mẹ con.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Phải luôn luôn ghi lòng tạc dạ.</para>
  <para style="q2" vid="PRO 6:21">Đeo những lời ấy vào cổ con.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Nó sẽ dẫn dắt con khi đi.</para>
  <para style="q2" vid="PRO 6:22">Gìn giữ con lúc ngủ.</para>
  <para style="q2" vid="PRO 6:22">Trò chuyện khi con thức dậy.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Vì sự khuyên dạy là ngọn đèn,</para>
  <para style="q2" vid="PRO 6:23">khuôn phép là ánh sáng;</para>
  <para style="q1" vid="PRO 6:23">Quở trách khuyên dạy</para>
  <para style="q2" vid="PRO 6:23">là vạch đường sống cho con.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Gìn giữ con khỏi đàn bà tội lỗi,</para>
  <para style="q2" vid="PRO 6:24">khỏi lưỡi dụ dỗ của dâm phụ.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Lòng con đừng thèm muốn nhan sắc nó.</para>
  <para style="q2" vid="PRO 6:25">Chớ để khóe mắt nó chinh phục con.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Mê kỹ nữ thì sẽ lâm cảnh vong gia bại sản,<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">Nt chỉ còn một mẩu bánh</char></note></para>
  <para style="q2" vid="PRO 6:26">lấy vợ người thì mất cả hồn linh.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Có ai mang lửa trong lòng,</para>
  <para style="q2" vid="PRO 6:27">mà áo quần không bốc cháy?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Có ai bước trên than hồng,</para>
  <para style="q2" vid="PRO 6:28">mà khỏi bị phỏng chân chăng?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Ai ngoại tình với vợ người cũng vậy.</para>
  <para style="q2" vid="PRO 6:29">Người đụng đến nàng hẳn không tránh khỏi hình phạt.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Người ta có thể khoan hồng cho kẻ trộm,</para>
  <para style="q2" vid="PRO 6:30">vì hắn phạm tội ăn cắp do đói.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Nhưng nếu bị bắt nó phải bồi thường gấp bảy lần,</para>
  <para style="q2" vid="PRO 6:31">phải lấy hết tài vật trong nhà để trang trải.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Nhưng người phạm tội ngoại tình thật ngu dại,</para>
  <para style="q2" vid="PRO 6:32">vì tự hủy diệt chính mình.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Danh liệt, thân bại.</para>
  <para style="q2" vid="PRO 6:33">Hổ thẹn nhục nhã suốt đời.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Người chồng sẽ ghen tuông giận dữ,</para>
  <para style="q2" vid="PRO 6:34">báo thù chẳng chút nương tay.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Anh ta không nhận tiền chuộc lỗi,</para>
  <para style="q2" vid="PRO 6:35">dù con nộp bao nhiêu cũng không bằng lòng.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Lời Khuyên Tránh Cám Dỗ về Ngoại Tình</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Con ơi, hãy giữ lời ta;</para>
  <para style="q2" vid="PRO 7:1">phải chôn sâu vào lòng.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Vâng giữ mệnh lệnh ta và sống!</para>
  <para style="q2" vid="PRO 7:2">Coi khuôn phép ta như con ngươi của mắt con.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Buộc chặt nó nơi ngón tay để nhắc nhớ.</para>
  <para style="q2" vid="PRO 7:3">Khắc ghi nó vào bia lòng con.<verse eid="PRO 7:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Phải thương yêu đức khôn ngoan như chị em mình;</para>
  <para style="q2" vid="PRO 7:4">Gọi thông sáng là người bà con.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Để con tránh được sự cám dỗ của dâm phụ,</para>
  <para style="q2" vid="PRO 7:5">khỏi sự quyến rũ của vợ người khác.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Vì một hôm ở trong nhà,</para>
  <para style="q2" vid="PRO 7:6">ta nhìn qua song cửa,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />thấy trong bọn ngây thơ,</para>
  <para style="q2" vid="PRO 7:7">trong nhóm trai trẻ, có một người thiếu suy xét.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Hắn đi ngang đường gần khu dâm phụ ở,</para>
  <para style="q2" vid="PRO 7:8">rồi tiến về hướng nhà dâm phụ,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Nhằm lúc hoàng hôn tối trời,</para>
  <para style="q2" vid="PRO 7:9">giữa đêm hôm khuya khoắt.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Kìa, dâm phụ ra đón chào,</para>
  <para style="q2" vid="PRO 7:10">trang điểm lố lăng, mưu mô quỷ quyệt.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Tính tình ngang bướng, nói năng sỗ sàng;</para>
  <para style="q2" vid="PRO 7:11">đôi chân không chịu ở yên trong nhà.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Cứ thả lang thang ngoài hè phố,</para>
  <para style="q2" vid="PRO 7:12">rình rập đợi chờ ở các góc đường.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Người đàn bà ôm hắn mà hôn,</para>
  <para style="q2" vid="PRO 7:13">mặt người trơ trẽn dụ dỗ:<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Em vừa dâng lễ cầu an</para>
  <para style="q2" vid="PRO 7:14">và đã trả xong các lời thề nguyện.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Anh là người mà em tìm kiếm!</para>
  <para style="q2" vid="PRO 7:15">Em ra đây tìm và gặp được anh!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Em đã trải mền Ai Cập</para>
  <para style="q2" vid="PRO 7:16">màu sặc sỡ lên giường.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Và rắc một dược, lô hội, và nhục quế</para>
  <para style="q2" vid="PRO 7:17">để xông thơm cho giường mình.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Hãy đến, chúng ta cùng tận hưởng khoái lạc yêu đương.</para>
  <para style="q2" vid="PRO 7:18">Cùng vui thú ái ân đến sáng,<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />vì chồng em vắng nhà.</para>
  <para style="q2" vid="PRO 7:19">Anh ấy đã lên đường đi xa.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Người mang theo rất nhiều tiền bạc,</para>
  <para style="q2" vid="PRO 7:20">đến cuối tháng mới trở về.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Dùng lời đường mật, nàng quyến rũ,</para>
  <para style="q2" vid="PRO 7:21">với miệng môi dua nịnh, nàng khiến hắn xiêu lòng.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Lập tức hắn đi theo nàng,</para>
  <para style="q2" vid="PRO 7:22">như trâu bò đến lò sát sinh.</para>
  <para style="q2" vid="PRO 7:22">Như con nai chui đầu vào thòng lọng,<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />cho đến chừng mũi tên xuyên vào tim.</para>
  <para style="q2" vid="PRO 7:23">Hắn như chim bay mau vào lưới,</para>
  <para style="q2" vid="PRO 7:23">không ngờ đó là cạm bẫy sập bắt linh hồn mình.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Thế thì, con ơi, phải lắng tai,</para>
  <para style="q2" vid="PRO 7:24">chăm chú nghe lời ta dạy bảo.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Đừng để lòng con bị mê hoặc bởi người đàn bà ấy.</para>
  <para style="q2" vid="PRO 7:25">Hãy tránh xa, đừng lại gần đường nó đi.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Vì nó đã đánh gục nhiều người;</para>
  <para style="q2" vid="PRO 7:26">vô số người trở thành nạn nhân của nó.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Nhà nó là đường đi địa ngục.</para>
  <para style="q2" vid="PRO 7:27">Phòng nó dẫn xuống chốn tử vong.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Tiếng của Sự Người Khôn Ngoan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Hãy lắng nghe tiếng Khôn Ngoan kêu gọi!</para>
  <para style="q2" vid="PRO 8:1">Lắng nghe sự thông sáng lên tiếng!<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Sự khôn ngoan ở trên các đỉnh cao,</para>
  <para style="q2" vid="PRO 8:2">nơi các góc đường, và tại các giao lộ.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Nơi cổng thành, đường vào đô thị,</para>
  <para style="q2" vid="PRO 8:3">bên thềm cửa, khôn ngoan kêu lớn tiếng:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Ta gọi ngươi, tất cả các ngươi!</para>
  <para style="q2" vid="PRO 8:4">Ta gọi toàn thể loài người.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Người đơn sơ nên hiểu lẽ khôn ngoan.</para>
  <para style="q2" vid="PRO 8:5">Người dại phải có tâm sáng suốt.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Hãy lắng nghe! Ta có điều quan trọng nói với ngươi.</para>
  <para style="q2" vid="PRO 8:6">Mọi điều ta nói là lẽ phải,<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />miệng ta truyền chân lý,</para>
  <para style="q2" vid="PRO 8:7">môi ta ghét gian tà.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Mọi lời ta đều ngay thật.</para>
  <para style="q2" vid="PRO 8:8">Không có chút gian dối;<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Người thông sáng hiểu ra ngay,</para>
  <para style="q2" vid="PRO 8:9">người tri thức chấp nhận liền.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Đón nhận kiến thức, khuyên dạy ta,</para>
  <para style="q2" vid="PRO 8:10">quý cho con hơn bắt được bạc vàng.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Vì khôn ngoan quý hơn hồng ngọc.</para>
  <para style="q2" vid="PRO 8:11">Không bảo vật nào có thể sánh với nó.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Ta, Khôn Ngoan, đi chung với trí phán đoán.</para>
  <para style="q2" vid="PRO 8:12">Ta biết sự tri thức và thận trọng.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Kính sợ Chúa Hằng Hữu thì ghét điều ác.</para>
  <para style="q2" vid="PRO 8:13">Vì thế, ta ghét kiêu căng và ngạo ngược,</para>
  <para style="q2" vid="PRO 8:13">lối ác và miệng gian tà.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Mưu lược và khôn khéo thuộc về ta.</para>
  <para style="q2" vid="PRO 8:14">Ta thông sáng và đầy năng lực.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Nhờ ta mà các vua cầm quyền,</para>
  <para style="q2" vid="PRO 8:15">và những người cai trị ban sắc lệnh công bằng.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Nhờ ta, nhà cầm quyền chăn dân,</para>
  <para style="q2" vid="PRO 8:16">và các quý tộc xét xử công chính.<verse eid="PRO 8:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Ta yêu những người yêu ta.</para>
  <para style="q2" vid="PRO 8:17">Ai sớm tìm kiếm ta hẳn sẽ gặp.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Ta có giàu sang và tôn trọng,</para>
  <para style="q2" vid="PRO 8:18">công chính, và thịnh vượng lâu dài.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Bông trái ta quý hơn vàng mười,</para>
  <para style="q2" vid="PRO 8:19">hoa lợi ta hơn bạc vàng nguyên chất.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ta bước đi trong công chính,</para>
  <para style="q2" vid="PRO 8:20">trên đường nẻo công bình.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Ta cho người yêu ta hưởng giàu sang.</para>
  <para style="q2" vid="PRO 8:21">Ta sẽ cho kho báu người luôn đầy dẫy.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Chúa Hằng Hữu đã có ta từ buổi ban đầu,</para>
  <para style="q2" vid="PRO 8:22">trước cả khi khai thiên lập địa.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Ta hiện hữu, đời đời trong quá khứ,</para>
  <para style="q2" vid="PRO 8:23">từ ban đầu, khi chưa có địa cầu.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Ta hiện hữu khi chưa có đại dương vực thẳm,</para>
  <para style="q2" vid="PRO 8:24">nước chưa tuôn từ nguồn suối mạch sông.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Trước khi núi non được hình thành,</para>
  <para style="q2" vid="PRO 8:25">đồi cao góp mặt, thì đã có ta—<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />trước khi Chúa dựng trời xanh và đồng ruộng</para>
  <para style="q2" vid="PRO 8:26">cùng cao nguyên trùng điệp.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Ta đã hiện diện, khi Chúa dựng trời xanh,</para>
  <para style="q2" vid="PRO 8:27">khi Ngài đặt vòng tròn trên mặt biển.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Ta hiện diện khi Ngài giăng mây trời,</para>
  <para style="q2" vid="PRO 8:28">đặt nguồn nước lớn dưới vực đại dương,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Ta hiện diện khi Ngài định giới ranh biển cả,</para>
  <para style="q2" vid="PRO 8:29">ban lệnh cho nước không được tràn khỏi bờ.</para>
  <para style="q2" vid="PRO 8:29">Và khi Ngài dựng nền của đất,<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />ta đã hiện diện bên Ngài, làm thợ cả.</para>
  <para style="q2" vid="PRO 8:30">Với Chúa, ta là niềm vui hằng ngày,</para>
  <para style="q2" vid="PRO 8:30">ta luôn hân hoan trước mặt Chúa.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Vui mừng trong thế giới địa đàng,</para>
  <para style="q2" vid="PRO 8:31">với loài người, ta thích thú vô cùng.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Cho nên các con hãy nghe ta,</para>
  <para style="q2" vid="PRO 8:32">phước cho ai theo đường lối ta.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Chịu dạy dỗ, sống khôn ngoan.</para>
  <para style="q2" vid="PRO 8:33">Đừng từ chối lời giáo huấn.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Phước cho người nghe lời ta,</para>
  <para style="q2" vid="PRO 8:34">ngày ngày trông ngoài cổng,</para>
  <para style="q2" vid="PRO 8:34">chờ đợi trước cửa nhà!<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Vì ai tìm ta thì được sự sống,</para>
  <para style="q2" vid="PRO 8:35">và hưởng ân huệ Chúa Hằng Hữu.<verse eid="PRO 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="PRO 8:36" />Ai xúc phạm ta là tự hủy mình.</para>
  <para style="p" vid="PRO 8:36">Người ghét ta là yêu sự chết.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Khôn ngoan xây cất nhà mình;</para>
  <para style="q2" vid="PRO 9:1">chạm bảy cột trụ.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Giết chiên bò, pha rượu nho,</para>
  <para style="q2" vid="PRO 9:2">chuẩn bị dọn tiệc lớn.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Khôn ngoan sai tớ gái mời mọi người đến dự.</para>
  <para style="q2" vid="PRO 9:3">Từ các nơi cao của thành, sự khôn ngoan kêu gọi.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />“Hãy đến cùng ta,” khôn ngoan mời người đơn sơ.</para>
  <para style="q2" vid="PRO 9:4">Và nhắn với người ngu muội rằng:<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />“Cứ đến ăn bánh,</para>
  <para style="q2" vid="PRO 9:5">và uống rượu ta pha.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Bỏ đường lối dại khờ, thì con sẽ được sống;</para>
  <para style="q2" vid="PRO 9:6">và bước đi trên đường thông sáng.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Ai quở người chế nhạo sẽ bị nhục nhã.</para>
  <para style="q2" vid="PRO 9:7">Ai trách người độc ác sẽ mang nhuốc nhơ.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Đừng quở người chế nhạo;</para>
  <para style="q2" vid="PRO 9:8">vì họ sẽ ghét con.</para>
  <para style="q1" vid="PRO 9:8">Nhưng khiển trách người khôn ngoan,</para>
  <para style="q2" vid="PRO 9:8">thì con sẽ được yêu kính.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Hướng dẫn người khôn,</para>
  <para style="q2" vid="PRO 9:9">họ sẽ thêm khôn.</para>
  <para style="q1" vid="PRO 9:9">Dạy bảo người ngay,</para>
  <para style="q2" vid="PRO 9:9">họ sẽ thêm hiểu biết.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Kính sợ Chúa Hằng Hữu là khởi đầu sự khôn ngoan.</para>
  <para style="q2" vid="PRO 9:10">Hiểu biết Đấng Thánh, ấy cội nguồn tri thức.<verse eid="PRO 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Nhờ sự khôn ngoan, ngày con thêm nhiều</para>
  <para style="q2" vid="PRO 9:11">và tuổi đời con gia tăng.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Nếu khôn ngoan, chính con được nhờ.</para>
  <para style="q2" vid="PRO 9:12">Còn chế nhạo, riêng con gánh chịu.<verse eid="PRO 9:12" /></para>
  <para style="s1">Tiếng Gọi của Sự Điên Dại</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Đàn bà điên dại ăn nói sỗ sàng.</para>
  <para style="q2" vid="PRO 9:13">Thiếu suy nghĩ và không hiểu biết.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Nó ngồi trước cửa nhà,</para>
  <para style="q2" vid="PRO 9:14">tại nơi góc đường đô thị.<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Kêu gọi khách bộ hành,</para>
  <para style="q2" vid="PRO 9:15">đang bận rộn qua lại.<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />“Hãy đến với tôi,” nó mời người đơn sơ.</para>
  <para style="q2" vid="PRO 9:16">Và bảo người thiếu suy xét:<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />“Nước uống trộm thật ngọt ngào,</para>
  <para style="q2" vid="PRO 9:17">bánh ăn vụng thật ngon thay!”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Người ấy chẳng biết nhà nó là mồ chôn người chết.</para>
  <para style="q2" vid="PRO 9:18">Và khách nó mời đều ở nơi vực thẳm âm ty.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Các Châm Ngôn của Sa-lô-môn</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Đây là các châm ngôn của Sa-lô-môn:</para>
  <para style="q1" vid="PRO 10:1">Con khôn ngoan làm cha vui thỏa;</para>
  <para style="q2" vid="PRO 10:1">con khờ dại khiến mẹ buồn đau.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Của phi nghĩa chẳng ích lợi gì,</para>
  <para style="q2" vid="PRO 10:2">nhưng đức công chính cứu người thoát chết.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Chúa Hằng Hữu không để người công chính đói khổ,</para>
  <para style="q2" vid="PRO 10:3">nhưng Ngài khước từ ước vọng người ác.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Tay lười biếng suốt đời nghèo khó;</para>
  <para style="q2" vid="PRO 10:4">tay siêng năng giàu có không xa.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Con khôn thu lúa tháng hè,</para>
  <para style="q2" vid="PRO 10:5">con lười nằm ngủ ngày mùa nhục thay.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Phước lành trên đầu người công chính;</para>
  <para style="q2" vid="PRO 10:6">còn miệng ác nhân đầy dẫy bạo tàn.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Kỷ niệm tin kính, nguồn hạnh phước,</para>
  <para style="q2" vid="PRO 10:7">tên tuổi kẻ ác chóng tàn phai.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Người khôn ngoan vui nghe mệnh lệnh,</para>
  <para style="q2" vid="PRO 10:8">người dại miệng hay bị ngã đau.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Ai liêm chính vững vàng tiến bước,</para>
  <para style="q2" vid="PRO 10:9">đứa gian tham bại lộ có ngày.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Người châm biếm<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">Nt nheo mắt</char></note> ưa gây phiền muộn,</para>
  <para style="q2" vid="PRO 10:10">người dại miệng hay bị ngã đau.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Miệng người công chính như nguồn sống;</para>
  <para style="q2" vid="PRO 10:11">còn miệng ác nhân giấu diếm bạo tàn.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Tính ganh ghét phát sinh tranh chấp,</para>
  <para style="q2" vid="PRO 10:12">lòng yêu thương che đậy tội lỗi.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Khôn ngoan ra từ môi người thông sáng,</para>
  <para style="q2" vid="PRO 10:13">roi vọt giáng trên lưng người u mê.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Người khôn ngoan trau dồi trí thức,</para>
  <para style="q2" vid="PRO 10:14">nhưng miệng ngu dại đem hủy diệt đến gần.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Tiền của là sức mạnh người giàu có,</para>
  <para style="q2" vid="PRO 10:15">nghèo nàn là thảm cảnh người lầm than<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Người thiện sử dụng tiền lương nuôi dưỡng sự sống,</para>
  <para style="q2" vid="PRO 10:16">người ác xài phí lợi tức gây ra tội lỗi.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Vâng lời khuyên dạy đi đường sống,</para>
  <para style="q2" vid="PRO 10:17">chối bỏ khuyên răn bước lạc lầm.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ai nuôi dưỡng lòng ganh ghét có môi giả dối;</para>
  <para style="q2" vid="PRO 10:18">buông lời phỉ báng là người điên rồ.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Nói năng nhiều, vi phạm càng lắm.</para>
  <para style="q2" vid="PRO 10:19">Cầm giữ miệng lưỡi, ấy người khôn ngoan.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Lưỡi người công chính như bạc quý;</para>
  <para style="q2" vid="PRO 10:20">Tâm kẻ tiểu nhân rẻ hơn bèo.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Môi người công chính nuôi dưỡng nhiều người,</para>
  <para style="q2" vid="PRO 10:21">nhưng người dại ngã chết vì thiếu suy xét.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Hạnh phước Chúa Hằng Hữu cho ta giàu có,</para>
  <para style="q2" vid="PRO 10:22">và đuổi xa những nỗi ưu phiền.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Người rồ dại tìm vui trong việc ác,</para>
  <para style="q2" vid="PRO 10:23">người thông sáng khoái lạc với khôn ngoan.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Người ác ghét của nào bị trao của ấy;</para>
  <para style="q2" vid="PRO 10:24">người tin kính nhận lấy điều mình ước ao.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Bão thổi qua, ác nhân tan tác,</para>
  <para style="q2" vid="PRO 10:25">người lành tin kính vững mạnh đời đời.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Người biếng nhác nhọc lòng khổ chủ,</para>
  <para style="q2" vid="PRO 10:26">như ăn phải giấm, như dầm khói cay.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Kính sợ Chúa: Ngài gia tăng tuổi thọ,</para>
  <para style="q2" vid="PRO 10:27">đời ác nhân bị rút ngắn đi.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Ước vọng tin kính, niềm vui lớn,</para>
  <para style="q2" vid="PRO 10:28">hoài bão ác nhân sớm tàn phai.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Đường lối Chúa Hằng Hữu là pháo đài cho người trong sạch,</para>
  <para style="q2" vid="PRO 10:29">nhưng là chỗ diệt vong cho người làm ác.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Người công chính trường tồn bất diệt,</para>
  <para style="q2" vid="PRO 10:30">nhưng người ác không còn đất dung thân.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Miệng người công chính nở hoa khôn,</para>
  <para style="q2" vid="PRO 10:31">còn lưỡi người dối gian bị cắt mất.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Môi công chính nói lời chính đáng,</para>
  <para style="q2" vid="PRO 10:32">miệng ác nhân cứ mãi gian tà.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Chúa Hằng Hữu ghê tởm chiếc cân gian,</para>
  <para style="q2" vid="PRO 11:1">nhưng hài lòng với quả cân đúng.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Kiêu ngạo đến trước, nhục nhã theo sau,</para>
  <para style="q2" vid="PRO 11:2">nhưng ai khiêm tốn mới là khôn ngoan.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Lòng trung chính dẫn đưa người ngay thẳng;</para>
  <para style="q2" vid="PRO 11:3">tính gian tà tiêu diệt người phản lừa.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Của cải ích gì trong ngày phán xét,</para>
  <para style="q2" vid="PRO 11:4">công chính cứu người thoát tử vong.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Đức công chính đưa đường người toàn thiện;</para>
  <para style="q2" vid="PRO 11:5">kẻ dữ suy vong vì tội ác mình.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Đức công chính cứu người ngay thẳng;</para>
  <para style="q2" vid="PRO 11:6">Lòng tham lam của kẻ gian đánh bẫy họ.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Người ác chết, mộng ước nó suy tàn,</para>
  <para style="q2" vid="PRO 11:7">hy vọng người gian cũng tiêu tan.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Người công chính được thoát khỏi tai nạn,</para>
  <para style="q2" vid="PRO 11:8">tai nạn giáng trên người gian tà.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Miệng gian hiểm phá hoại đồng loại,</para>
  <para style="q2" vid="PRO 11:9">nhờ tri thức, người ngay thoát hiểm.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Người hiền thành công, cả thành vui vẻ;</para>
  <para style="q2" vid="PRO 11:10">người ác bại vong, dân chúng hoan hô.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Thành hưng thịnh nhờ phước người hiền,</para>
  <para style="q2" vid="PRO 11:11">thành sụp đổ do miệng kẻ ác.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Người thiếu suy xét khinh chê bạn hữu;</para>
  <para style="q2" vid="PRO 11:12">người thông sáng kín miệng không nói năng.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Đứa mách lẻo rêu rao điều kín giấu,</para>
  <para style="q2" vid="PRO 11:13">người tín trung giữ kín chuyện riêng tư.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Lãnh đạo kém, dân tình khốn khổ;</para>
  <para style="q2" vid="PRO 11:14">mưu sĩ tài, làng nước an ninh.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Bảo lãnh người lạ thường mang họa;</para>
  <para style="q2" vid="PRO 11:15">còn ai từ chối được yên thân.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Đàn bà mềm mỏng được tôn trọng,</para>
  <para style="q2" vid="PRO 11:16">đàn ông hung bạo chỉ được tài sản.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Người nhân ái được ban phước,</para>
  <para style="q2" vid="PRO 11:17">quân ác ôn tự hại lấy thân.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Đứa gian ác lãnh đồng lương hư ảo,</para>
  <para style="q2" vid="PRO 11:18">người thẳng ngay hưởng bổng lộc lâu bền.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Tìm nhân đức là vào nẻo sống;</para>
  <para style="q2" vid="PRO 11:19">đeo đuổi tội khiên sẽ mạng vong.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Chúa Hằng Hữu ghét người có tâm địa gian tà,</para>
  <para style="q2" vid="PRO 11:20">nhưng ưa thích người đi đường ngay thẳng.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Người ác chắc chắn lãnh lấy hình phạt,</para>
  <para style="q2" vid="PRO 11:21">con cháu người lành thế nào cũng nạn khỏi tai qua.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Người phụ nữ đẹp nhưng không thận trọng</para>
  <para style="q2" vid="PRO 11:22">giống vòng vàng đeo nơi mũi heo.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Ước mong của người công chính đưa đến điều thiện,</para>
  <para style="q2" vid="PRO 11:23">còn hy vọng của kẻ ác đem lại cơn thịnh nộ.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Người rộng rãi lại thu hoạch nhiều,</para>
  <para style="q2" vid="PRO 11:24">người keo kiệt lại gặp túng quẫn.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Người hào phóng sẽ thịnh vượng;</para>
  <para style="q2" vid="PRO 11:25">ai rộng rãi với người, chính mình sẽ hưởng phước.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Ai đầu cơ trục lợi sẽ bị dân chúng nguyền rủa,</para>
  <para style="q2" vid="PRO 11:26">nhưng ai buôn bán lương thiện sẽ được tiếng khen.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Người tìm thiện sẽ gặp phước lành;</para>
  <para style="q2" vid="PRO 11:27">người kiếm ác gặp ác chẳng sai!<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Tin cậy tiền của sẽ suy bại!</para>
  <para style="q2" vid="PRO 11:28">Tin cậy Đức Chúa Trời sẽ như cây tốt tươi.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Ai làm gia đình xáo trộn chỉ còn hai bàn tay trắng.<note caller="+" style="f"><char style="fr" closed="false">11:29 </char><char style="ft" closed="false">Nt thừa hưởng gió</char></note></para>
  <para style="q2" vid="PRO 11:29">Người điên dại sẽ làm tôi mọi người khôn ngoan.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Ai kính sợ Chúa trồng cây sự sống;</para>
  <para style="q2" vid="PRO 11:30">ai khôn ngoan chinh phục nhiều linh hồn.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Chúa ban thưởng người công chính ngay trên trần thế,</para>
  <para style="q2" vid="PRO 11:31">còn người gian ác bị hình phạt nhãn tiền.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Ai yêu kỷ luật yêu tri thức;</para>
  <para style="q2" vid="PRO 12:1">ai ghét sửa dạy là người ngây ngô.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Chúa Hằng Hữu ban phước cho người ngay thẳng,</para>
  <para style="q2" vid="PRO 12:2">nhưng đoán phạt người mưu đồ việc ác.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Gian ác không đem lại hạnh phước bền lâu,</para>
  <para style="q2" vid="PRO 12:3">nhưng người công chính sẽ đâm rễ vững vàng.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Vợ hiền đức là mão miện cho chồng,</para>
  <para style="q2" vid="PRO 12:4">vợ gây xấu hổ làm chồng tàn cốt mục xương.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Người công chính giữ tâm tư hướng thiện;</para>
  <para style="q2" vid="PRO 12:5">người ác gian nghĩ mưu kế gạt lừa.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Lời người ác như cạm bẫy hại người,</para>
  <para style="q2" vid="PRO 12:6">miệng người lành mở con đường giải thoát.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Người ác bị lật đổ và tiêu tan,</para>
  <para style="q2" vid="PRO 12:7">nhà người công chính luôn đứng vững vàng.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Càng khôn càng được tiếng khen,</para>
  <para style="q2" vid="PRO 12:8">người gian phải nhận lấy lời gièm chê.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Thà vô danh mà có người hầu người hạ,</para>
  <para style="q2" vid="PRO 12:9">còn hơn vênh váo tự tôn mà thiếu thức ăn.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Người lành chăm lo cho gia súc mình,</para>
  <para style="q2" vid="PRO 12:10">còn người ác dù tỏ ra yêu thương vẫn là ác.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Ai cày sâu cuốc bẩm thu hoạch nhiều hoa lợi,</para>
  <para style="q2" vid="PRO 12:11">ai đuổi theo ảo mộng là người thiếu suy xét.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Người gian muốn đoạt cả vật đã chia cho đồng bọn,</para>
  <para style="q2" vid="PRO 12:12">còn người công chính chỉ muốn giúp đỡ lẫn nhau.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Người ác bị lời dối trá mình sập bẫy,</para>
  <para style="q2" vid="PRO 12:13">người thiện nhờ ngay thật mà được thoát nguy.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Miệng nói thật tạo ra nhiều phước hạnh,</para>
  <para style="q2" vid="PRO 12:14">tay siêng năng đem lại lắm thỏa lòng.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Người dại tự cho đường lối mình công chính,<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Tự cho đường mình là đúng</char></note></para>
  <para style="q2" vid="PRO 12:15">nhưng người khôn biết lắng nghe lời khuyên dạy.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Người dại để lộ lòng giận dữ,</para>
  <para style="q2" vid="PRO 12:16">người khôn giữ được bình tĩnh dù bị sỉ nhục.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Nhân chứng thật nói ra lời ngay thẳng;</para>
  <para style="q2" vid="PRO 12:17">nhân chứng gian chỉ lừa gạt mưu đồ.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Lời khinh suất đâm chém như gươm bén,</para>
  <para style="q2" vid="PRO 12:18">lưỡi khôn ngoan chữa trị giống thuốc hay.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Môi chân thật sẽ lưu truyền mãi mãi,</para>
  <para style="q2" vid="PRO 12:19">lưỡi điêu ngoa phút chốc đã qua rồi.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Lòng dạ người mưu ác chứa đầy lừa dối;</para>
  <para style="q2" vid="PRO 12:20">tâm can người giải hòa tràn ngập vui tươi.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Hoạn nạn lánh xa người công chính,</para>
  <para style="q2" vid="PRO 12:21">tai vạ tìm đến người gian tà.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Chúa Hằng Hữu ghê tởm môi gian trá,</para>
  <para style="q2" vid="PRO 12:22">người thành thật luôn được Chúa mến yêu.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Người khôn chẳng khoe khoang tri thức,</para>
  <para style="q2" vid="PRO 12:23">người khờ thường bộc lộ dại dột.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Tay siêng năng sẽ nắm quyền cai trị,</para>
  <para style="q2" vid="PRO 12:24">tay biếng lười sẽ chịu cảnh tôi đòi.<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="ft" closed="false">Phải phục dịch</char></note><verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Lòng lo lắng làm người nản chí;</para>
  <para style="q2" vid="PRO 12:25">lời nói lành phấn chấn tâm can.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Người công chính cậy bạn làm cố vấn;</para>
  <para style="q2" vid="PRO 12:26">người gian tà tự chọn nẻo hư vong.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Người làm biếng không nấu nướng thịt mình săn được,</para>
  <para style="q2" vid="PRO 12:27">nhưng tính siêng năng là gia tài quý báu của một người.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Đường công chính dẫn đến chốn vĩnh sinh,</para>
  <para style="q2" vid="PRO 12:28">trên đường ấy tử thần không ló dạng.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Con khôn ngoan để ý nghe cha khuyên dạy,</para>
  <para style="q2" vid="PRO 13:1">đứa nhạo cười bỏ lời khiển trách ngoài tai.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Người lành thắng kiện nhờ nói năng dè dặt,</para>
  <para style="q2" vid="PRO 13:2">người ác chỉ ước ao toàn chuyện bạo tàn.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Người tự chủ biết hãm cầm miệng lưỡi;</para>
  <para style="q2" vid="PRO 13:3">người hở môi gặt lấy thất bại hoài.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Người làm biếng mong muốn mà chẳng được,</para>
  <para style="q2" vid="PRO 13:4">người siêng năng ước gì có nấy.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Người công chính ghét những gì không ngay thật,</para>
  <para style="q2" vid="PRO 13:5">người ác ôn dối trá rồi gặt nhuốc nhơ.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Đức công chính bảo vệ người ngay thẳng,</para>
  <para style="q2" vid="PRO 13:6">tội lỗi luôn tiêu diệt bọn tà tâm.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Có người tỏ vẻ giàu mà chẳng có chi;</para>
  <para style="q2" vid="PRO 13:7">có người làm bộ nghèo mà giàu nứt vách.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Người giàu mới có tiền chuộc mạng,</para>
  <para style="q2" vid="PRO 13:8">còn người nghèo đâu sợ ai bắt cóc.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Đèn người lành sáng choang,</para>
  <para style="q2" vid="PRO 13:9">đèn người ác tắt ngấm.<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Tính kiêu căng chỉ sinh ra tranh chấp;</para>
  <para style="q2" vid="PRO 13:10">nhưng ai khiêm tốn phục thiện mới là khôn ngoan.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Của phi nghĩa sớm tan biến;</para>
  <para style="q2" vid="PRO 13:11">tiền mồ hôi nước mắt mới còn bền lâu.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Hy vọng trì hoãn khiến lòng đau ê ẩm,</para>
  <para style="q2" vid="PRO 13:12">mộng được thành làm phấn chấn tâm can.<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="ft" closed="false">Như cây sự sống</char></note><verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Người coi thường khuyên dạy, lãnh hậu họa chẳng sai;</para>
  <para style="q2" vid="PRO 13:13">người tôn trọng mệnh lệnh nhận phần thưởng chắc chắn.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Lời dạy của người khôn như nguồn sự sống;</para>
  <para style="q2" vid="PRO 13:14">hướng dẫn người nghe thoát cạm bẫy tử thần.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Lương tri đem lại lòng mến phục;</para>
  <para style="q2" vid="PRO 13:15">nhưng đường xảo trá dẫy đầy gian nan.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Người khôn<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">Người thận trọng</char></note> suy tính kỹ càng;</para>
  <para style="q2" vid="PRO 13:16">người dại hấp tấp tỏ mình ngây ngô.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Sứ giả gian ác ngã vào tội ác,</para>
  <para style="q2" vid="PRO 13:17">khâm sai trung tín đem lại chữa lành.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Khước từ kỷ luật gây ra bần cùng nhục nhã;</para>
  <para style="q2" vid="PRO 13:18">ai đón nhận khiển trách sẽ thấy ngày quang vinh.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Ước muốn thành công làm linh hồn khoan khoái,</para>
  <para style="q2" vid="PRO 13:19">vì vậy, người ác bám chặt lấy ước muốn lầm sai.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Gần đèn thì sáng, gần người khôn trở nên khôn;</para>
  <para style="q2" vid="PRO 13:20">gần mực thì đen, gần người dại phải mang họa.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Tai họa đuổi theo người gian ác,</para>
  <para style="q2" vid="PRO 13:21">phước hạnh bám sát người thiện lành.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Của cải người lành để lại cho con cháu hưởng,</para>
  <para style="q2" vid="PRO 13:22">gia tài người ác dành cho người công chính dùng.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Ruộng người nghèo có thể sản xuất nhiều hoa lợi,</para>
  <para style="q2" vid="PRO 13:23">nhưng ăn ở bất lương sẽ thành công dã tràng.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Ai kiêng roi vọt ghét con trai mình,</para>
  <para style="q2" vid="PRO 13:24">người biết thương con không quên sửa trị nó.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Người công chính ăn thì được ấm lòng,</para>
  <para style="q2" vid="PRO 13:25">người gian tà ăn mà vẫn đói meo.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Người nữ khôn ngoan xây dựng cửa nhà,</para>
  <para style="q2" vid="PRO 14:1">đàn bà khờ dại vung tay hủy phá.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Ai đi đường ngay thẳng kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 14:2">ai theo nẻo cong quẹo ghét bỏ Ngài.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Miệng người ngu là con roi quất vào lưng nó,</para>
  <para style="q2" vid="PRO 14:3">nhưng người khôn dùng môi bảo vệ mình.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Chuồng không bò, máng cỏ vắng tanh,</para>
  <para style="q2" vid="PRO 14:4">có bò cày ruộng mới sinh hoa lợi.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Nhân chứng đáng tin không hề dối trá;</para>
  <para style="q2" vid="PRO 14:5">nhân chứng gian tà nói chuyện điêu ngoa.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Người nhạo báng kiếm khôn ngoan mà chẳng gặp,</para>
  <para style="q2" vid="PRO 14:6">người sáng suốt tiếp nhận tri thức cách dễ dàng.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Nếu muốn được nghe dạy bảo,</para>
  <para style="q2" vid="PRO 14:7">hãy lánh xa người dại khờ.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Cái khôn của người thận trọng là tính toan đường lối,</para>
  <para style="q2" vid="PRO 14:8">cái dại của người ngây ngô là tự dối lòng mình.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Người điên dại nhạo cười tội lỗi,</para>
  <para style="q2" vid="PRO 14:9">nhưng người ngay được Chúa ban ơn.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Chỉ lòng mới thấu rõ nỗi cay đắng con tim,</para>
  <para style="q2" vid="PRO 14:10">niềm vui tận thâm tâm, ai người chia sẻ được.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Nhà người ác sẽ bị tiêu diệt,</para>
  <para style="q2" vid="PRO 14:11">lều người ngay sẽ được dựng cao.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Con đường bạn chọn có vẻ phải,</para>
  <para style="q2" vid="PRO 14:12">nhưng cuối nẻo đường là hố diệt vong.<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Miệng cười lòng vẫn tái tê,</para>
  <para style="q2" vid="PRO 14:13">nụ cười tắt ngấm, lòng sầu mênh mang.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Lòng vô tín lãnh hậu quả đau thương;</para>
  <para style="q2" vid="PRO 14:14">tâm trong sạch nhận phần thưởng xứng đáng.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Người ngây ngô tin hết mọi điều!</para>
  <para style="q2" vid="PRO 14:15">Người thận trọng dè dặt từng đường đi nước bước.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Người khôn kính Chúa, lánh tội;</para>
  <para style="q2" vid="PRO 14:16">người dại mù quáng làm liều.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Người nóng tính hành động điên rồ,</para>
  <para style="q2" vid="PRO 14:17">người mưu đồ việc ác chẳng được ai ưa.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Người ngây ngô khoác áo dại khờ,</para>
  <para style="q2" vid="PRO 14:18">người thận trọng đội vòng hoa tri thức.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Người ác phải quỵ lụy trước người lành;</para>
  <para style="q2" vid="PRO 14:19">người dữ phải chầu chực trước nhà người công chính.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Vì nghèo mà hàng xóm cũng lánh xa,</para>
  <para style="q2" vid="PRO 14:20">nhờ giàu nên nhiều bạn bè tìm đến.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ai khinh bỉ người láng giềng là mắc tội;</para>
  <para style="q2" vid="PRO 14:21">ai thương xót người khốn khổ được nhiều phước.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Người mưu gian đi con đường lầm lạc;</para>
  <para style="q2" vid="PRO 14:22">người hướng thiện hưởng tình thương và trung tín.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Siêng năng làm việc đem lại nhiều lợi lộc,</para>
  <para style="q2" vid="PRO 14:23">chỉ nói suông dẫn đến cảnh nghèo hèn!<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Người khôn được ca tụng vì khôn ngoan;</para>
  <para style="q2" vid="PRO 14:24">người dại bị khinh bỉ bởi điên cuồng.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Nhân chứng chân thật cứu người thoát chết,</para>
  <para style="q2" vid="PRO 14:25">nhân chứng giả dối âm mưu lừa gạt.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Người kính sợ Chúa Hằng Hữu tìm được thành lũy;</para>
  <para style="q2" vid="PRO 14:26">Ngài là nơi ẩn trú an toàn cho con cái Ngài.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Kính sợ Chúa Hằng Hữu là nguồn sự sống;</para>
  <para style="q2" vid="PRO 14:27">giải cứu con người thoát bẫy tử vong.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Dân số càng đông là vinh quang của vua;</para>
  <para style="q2" vid="PRO 14:28">dân số giảm dần, quan chức cũng suy vong.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Người kiên nhẫn tỏ mình thông sáng;</para>
  <para style="q2" vid="PRO 14:29">người mau giận lộ bản chất dại dột.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Tâm thanh thản đem sinh lực vào thể xác;</para>
  <para style="q2" vid="PRO 14:30">lòng ghen tuôn làm xương mục cốt tàn.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Ai ức hiếp người nghèo là nguyền rủa Đấng Tạo Hóa,</para>
  <para style="q2" vid="PRO 14:31">ai nâng đỡ người cùng túng là tôn vinh Ngài.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Tai họa đến, người ác bị sụp đổ vì hành vi gian trá,</para>
  <para style="q2" vid="PRO 14:32">dù khi hấp hối, người công chính vẫn còn chỗ cậy trông.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Khôn ngoan nằm sẵn trong lòng người sáng suốt;</para>
  <para style="q2" vid="PRO 14:33">điều người điên dại giấu rồi cũng lộ ra.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Đức công chính làm cho quốc gia được tán tụng,</para>
  <para style="q2" vid="PRO 14:34">nhưng tội lỗi đem lại sỉ nhục cho toàn dân.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Nhà vua dành ân huệ cho quần thần thông sáng,</para>
  <para style="q2" vid="PRO 14:35">nhưng trút thịnh nộ trên bầy tôi ương ngạnh.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Đối đáp êm dịu làm nguôi cơn giận,</para>
  <para style="q2" vid="PRO 15:1">trả lời xẳng xớm như lửa thêm dầu.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Lưỡi người khôn truyền thông tri thức,</para>
  <para style="q2" vid="PRO 15:2">miệng người dại tuôn chảy điên rồ.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Mắt Chúa Hằng Hữu ở khắp mọi nơi,</para>
  <para style="q2" vid="PRO 15:3">xét xem người ác lẫn người thiện lành.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Lưỡi hiền lành là cây sự sống;</para>
  <para style="q2" vid="PRO 15:4">lưỡi gian ngoa phá hại tâm linh.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Con cãi lời cha là con ngu dại;</para>
  <para style="q2" vid="PRO 15:5">con nghe sửa dạy mới là con ngoan.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Nhà người công chính là kho tàng quý giá,</para>
  <para style="q2" vid="PRO 15:6">lợi tức người gian tà đem lại đủ thứ rối ren.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Môi người khôn truyền rao tri thức;</para>
  <para style="q2" vid="PRO 15:7">lòng người dại thì chẳng được gì.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Tế lễ người ác là vật Chúa Hằng Hữu chán ghét,</para>
  <para style="q2" vid="PRO 15:8">nhưng lời người ngay cầu nguyện được Chúa hài lòng.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Đường người ác bị Chúa Hằng Hữu chán ghét,</para>
  <para style="q2" vid="PRO 15:9">nhưng người theo đường công chính được Chúa yêu thương.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Bỏ đường chính bị cực hình chắc chắn,</para>
  <para style="q2" vid="PRO 15:10">ghét khuyên răn bị tiêu diệt chẳng sai.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Âm Phủ và Hỏa Ngục, Chúa Hằng Hữu còn thấy suốt.</para>
  <para style="q2" vid="PRO 15:11">Huống hồ chi lòng dạ loài người!<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Người nhạo báng không đến gần người khôn,</para>
  <para style="q2" vid="PRO 15:12">vì sợ phải nghe lời quở trách.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Lòng khoái lạc làm mặt mày vui vẻ;</para>
  <para style="q2" vid="PRO 15:13">dạ ưu phiền làm héo hắt tâm linh.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Lòng thông sáng đi tìm tri thức,</para>
  <para style="q2" vid="PRO 15:14">miệng người ngu ăn nói điên rồ.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Lòng ưu sầu thấy ngày nào cũng ngày hoạn nạn;</para>
  <para style="q2" vid="PRO 15:15">lòng vui mừng lúc nào cũng yến tiệc liên miên.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Thà ít của mà kính sợ Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 15:16">hơn là có nhiều tài sản mà bối rối cặp theo.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Thà một bát rau mà yêu thương nhau,</para>
  <para style="q2" vid="PRO 15:17">hơn là ăn thịt bò với lòng ganh ghét.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Người nóng tính thường gây xung đột;</para>
  <para style="q2" vid="PRO 15:18">người ôn hòa dàn xếp đôi bên.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Đường người biếng nhác như có rào gai ngăn chặn,</para>
  <para style="q2" vid="PRO 15:19">đường người ngay lành luôn quang đãng hanh thông.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Con khôn vui lòng cha;</para>
  <para style="q2" vid="PRO 15:20">con ngu khinh dể mẹ.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Người dại dột cho u mê là hay;</para>
  <para style="q2" vid="PRO 15:21">nhưng người khôn lúc nào cũng chọn đường ngay.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Kế hoạch thất bại, vì không có người tính kế;</para>
  <para style="q2" vid="PRO 15:22">kế hoạch thành công, nhờ có mưu sĩ tài cao.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Lời khéo đáp khiến lòng vui vẻ;</para>
  <para style="q2" vid="PRO 15:23">lời đúng lúc quý giá biết bao!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Đường sống của người khôn dẫn lên cao;</para>
  <para style="q2" vid="PRO 15:24">lánh xa âm phủ ở dưới thấp.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Chúa Hằng Hữu phá nhà người kiêu ngạo,</para>
  <para style="q2" vid="PRO 15:25">nhưng Ngài giữ vững ranh giới người góa bụa.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Chúa Hằng Hữu ghê tởm mưu gian ác,</para>
  <para style="q2" vid="PRO 15:26">nhưng lời trong sạch được Chúa hài lòng.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Người tham lợi đem rối rắm vào nhà,</para>
  <para style="q2" vid="PRO 15:27">người khước từ hối lộ được sống an vui.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Người công chính lựa câu đối đáp cách thận trọng;</para>
  <para style="q2" vid="PRO 15:28">người gian tà thốt lời độc địa không đắn đo.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Chúa Hằng Hữu lánh xa người mưu ác,</para>
  <para style="q2" vid="PRO 15:29">nhưng nghe người công chính cầu xin.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Mắt thấy cảnh đẹp khiến lòng vui vẻ;</para>
  <para style="q2" vid="PRO 15:30">tai nghe tin lành xương cốt nở nang.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Ai chịu nghe phê bình xây dựng,</para>
  <para style="q2" vid="PRO 15:31">sẽ ở giữa đám người khôn ngoan.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Ai khước từ khuyên răn, ghét chính linh hồn mình;</para>
  <para style="q2" vid="PRO 15:32">người nghe lời sửa dạy sẽ trở nên thông sáng.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Kính sợ Chúa Hằng Hữu thật là khôn ngoan,</para>
  <para style="q2" vid="PRO 15:33">đức tính khiêm nhu mang lại vinh dự.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Lòng người nghĩ lắm mưu hay,</para>
  <para style="q2" vid="PRO 16:1">nhưng thành hay bại đều do tay Chúa Hằng Hữu.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Người tự thấy công việc mình toàn hảo,</para>
  <para style="q2" vid="PRO 16:2">nhưng Chúa Hằng Hữu biết rõ động cơ.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Hãy phó thác công việc con cho Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 16:3">chương trình con sẽ được thành công.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Chúa Hằng Hữu tạo mỗi loài đều có mục đích,</para>
  <para style="q2" vid="PRO 16:4">người ác, Ngài dành cho ngày đoán phạt.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Người kiêu căng bị Chúa Hằng Hữu kinh tởm;</para>
  <para style="q2" vid="PRO 16:5">dù chạy đi đâu cũng chẳng thoát lưới trời.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Nhân ái chân thật phủ che tội lỗi.</para>
  <para style="q2" vid="PRO 16:6">Nhờ kính sợ Chúa Hằng Hữu mà bỏ lối ác gian.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Khi ai sống đẹp lòng Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 16:7">dù kẻ thù cũng sẽ hòa thuận với người.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Thà nghèo mà công bằng liêm chính,</para>
  <para style="q2" vid="PRO 16:8">còn hơn bất công, thất đức để làm giàu.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Con người dùng trí vạch đường đi,</para>
  <para style="q2" vid="PRO 16:9">nhưng Chúa dìu dắt từng li từng tí.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Vua đưa ra những lời phán quyết;</para>
  <para style="q2" vid="PRO 16:10">vua không bao giờ xử đoán bất công.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Chúa Hằng Hữu sắp đặt các loại cân công bình chính xác;</para>
  <para style="q2" vid="PRO 16:11">mọi quả cân trong bao là công việc của tay Ngài.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Vua làm ác bị người phỉ nhổ,</para>
  <para style="q2" vid="PRO 16:12">đức công minh củng cố ngai vàng.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Lời người công chính là niềm vui của các vua;</para>
  <para style="q2" vid="PRO 16:13">vua biệt đãi những người nói năng ngay thẳng.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Vua giận dữ là có người mất mạng;</para>
  <para style="q2" vid="PRO 16:14">nhưng người khôn làm cơn giận tiêu tan.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Vua tươi tắn, mặt chiếu ra sự sống;</para>
  <para style="q2" vid="PRO 16:15">người ban ơn như mưa móc mùa xuân.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Tìm được khôn ngoan còn quý hơn vàng,</para>
  <para style="q2" vid="PRO 16:16">thu thập tri thức còn hơn gom góp bạc!<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Con đường công chính đi xa hố gian tà;</para>
  <para style="q2" vid="PRO 16:17">ai giữ đường ngay thẳng là bảo toàn sinh mạng.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Kiêu ngạo dẫn đường cho diệt vong,</para>
  <para style="q2" vid="PRO 16:18">tự tôn đi trước sự vấp ngã.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Thà khiêm nhượng ở với người nghèo,</para>
  <para style="q2" vid="PRO 16:19">còn hơn chia của với người kiêu căng.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Ai giữ chính đạo sẽ thành công;</para>
  <para style="q2" vid="PRO 16:20">ơn phước thuộc người trông cậy Chúa.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Người khôn ngoan thận trọng hiểu sâu biết rộng,</para>
  <para style="q2" vid="PRO 16:21">ăn nói ngọt ngào càng thuyết phục nhiều người.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Túi khôn là nguồn sống của người thông sáng,</para>
  <para style="q2" vid="PRO 16:22">còn điên rồ là hình phạt của người dại khờ.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Người khôn thận trọng trong lời nói;</para>
  <para style="q2" vid="PRO 16:23">điều gì đưa ra cũng chứa đựng sự hiểu biết.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Lời nói ân hậu giống như mật ong—</para>
  <para style="q2" vid="PRO 16:24">ngọt ngào cổ họng, bổ dưỡng tâm thân.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Con đường bạn chọn có vẻ phải,</para>
  <para style="q2" vid="PRO 16:25">nhưng cuối nẻo đường là hố diệt vong.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Bụng cồn cào thúc đẩy nhân công làm việc;</para>
  <para style="q2" vid="PRO 16:26">miệng đói meo thúc đẩy họ kiếm miếng ăn.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Người vô đạo cưu mang tội ác;</para>
  <para style="q2" vid="PRO 16:27">nói những lời như châm lửa đốt nhà.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Người tà vạy gieo mầm xung đột;</para>
  <para style="q2" vid="PRO 16:28">người rỉ tai chia rẽ bạn thân.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Người hung dữ quyến dụ láng giềng,</para>
  <para style="q2" vid="PRO 16:29">lôi kéo họ vào đường bất chính.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Người chớp mắt lòng mưu toan việc ác;</para>
  <para style="q2" vid="PRO 16:30">người mím môi bụng chất chứa gian tà.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Tóc bạc là vương miện vinh quang,</para>
  <para style="q2" vid="PRO 16:31">của con người theo đường công chính.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Người chậm giận thắng hơn dũng sĩ;</para>
  <para style="q2" vid="PRO 16:32">ai biết tự chủ thắng hơn người chiếm thành.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Loài người rút thăm cầu may,</para>
  <para style="q2" vid="PRO 16:33">nhưng quyết định đến từ Chúa Hằng Hữu.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Thà một miếng bánh khô mà thuận thảo,</para>
  <para style="q2" vid="PRO 17:1">còn hơn nhà đầy thịt tế lễ mà xung đột.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Chủ để nô lệ khôn ngoan quản trị đứa con ngỗ nghịch<note caller="+" style="f"><char style="fr" closed="false">17:2 </char><char style="ft" closed="false">Nt con gây điều sỉ nhục</char></note></para>
  <para style="q2" vid="PRO 17:2">cho nó đồng hưởng gia tài giữa các anh em.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Lửa dùng thử bạc, thử vàng,</para>
  <para style="q2" vid="PRO 17:3">Chúa Hằng Hữu thử lòng người.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Người làm ác thích nghe lời phỉnh dối;</para>
  <para style="q2" vid="PRO 17:4">người giả trá mê theo lời xảo quyệt.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Ai chế giễu người nghèo, xúc phạm Đấng Tạo Hóa;</para>
  <para style="q2" vid="PRO 17:5">ai vui mừng thấy người bị nạn sẽ bị hình phạt.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Cháu chắt là vương miện của người già;</para>
  <para style="q2" vid="PRO 17:6">tổ phụ là vinh dự cho con cháu.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Lời trang nhã không xứng người ngu;</para>
  <para style="q2" vid="PRO 17:7">bậc lãnh tụ không nói câu xảo trá.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Của hối lộ như cái bùa trong tay người cầu cạnh;</para>
  <para style="q2" vid="PRO 17:8">đi đến đâu hắn cũng được thành công!<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Bỏ qua lỗi cho nhau đem lại tình yêu mến,</para>
  <para style="q2" vid="PRO 17:9">nhắc lại mãi lỗi lầm làm phân rẽ bạn bè.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Một lời quở trách thức tỉnh người khôn,</para>
  <para style="q2" vid="PRO 17:10">hơn cả trăm roi đánh người ngu muội.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Người hung ác chỉ thích nổi loạn,</para>
  <para style="q2" vid="PRO 17:11">sứ giả bạo tàn sẽ đi dẹp nó.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Thà đương đầu với gấu cái mất con,</para>
  <para style="q2" vid="PRO 17:12">còn hơn gặp người dại nổi khùng.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Người nỡ lấy ác báo thiện,</para>
  <para style="q2" vid="PRO 17:13">chẳng hề thoát hậu quả khốc hại.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Tranh chấp khởi đầu như khơi nguồn nước chảy,</para>
  <para style="q2" vid="PRO 17:14">thà nên dứt lời trước khi cãi lộn.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Tha cho người có tội và lên án người vô tội—</para>
  <para style="q2" vid="PRO 17:15">cả hai đều ghê tởm trước mặt Chúa Hằng Hữu.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Người khờ ôm bạc đi học khôn,</para>
  <para style="q2" vid="PRO 17:16">lòng không chuyên, bạc cũng vô hiệu.<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Tình thân hữu bền chặt mãi mãi,</para>
  <para style="q2" vid="PRO 17:17">nghĩa anh em quý lúc khổ nguy.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Người dại dột bảo lãnh vội vàng,</para>
  <para style="q2" vid="PRO 17:18">đem ách giữa đàng mang vào cổ.<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">Ctd trở thành người bảo lãnh khi có mặt bạn hữu</char></note><verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ai ưa tranh cạnh chuốc điều tội ác;</para>
  <para style="q2" vid="PRO 17:19">phô trương cửa đẹp rước họa vô nhà.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Lòng xảo trá không hề thành đạt;</para>
  <para style="q2" vid="PRO 17:20">lưỡi gian ngoa rước lấy họa tai.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Con khờ khạo làm cha phiền lụy;</para>
  <para style="q2" vid="PRO 17:21">người ưu sầu, vì con cái khùng điên.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Niềm vui thỏa như thang thuốc bổ,</para>
  <para style="q2" vid="PRO 17:22">nỗi thảm sầu phá hoại tủy xương.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Người tham nhũng nhận hối lộ vụng trộm,</para>
  <para style="q2" vid="PRO 17:23">làm cán cân công lý lệch nghiêng.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Người khôn sáng đeo đuổi khôn ngoan,</para>
  <para style="q2" vid="PRO 17:24">mắt người dại nhìn chân trời góc bể.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Con khờ dại làm buồn lòng cha</para>
  <para style="q2" vid="PRO 17:25">và gây đắng cay cho mẹ đã sinh nó.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Phạt vạ người vô tội và trừng phạt viên chức thanh liêm,</para>
  <para style="q2" vid="PRO 17:26">cả hai đều không đúng.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Người khôn ngoan thường ít lời;</para>
  <para style="q2" vid="PRO 17:27">người thông sáng biết tự chủ.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Biết im lặng, dại cũng thành khôn;</para>
  <para style="q2" vid="PRO 17:28">biết kiềm chế miệng lưỡi được xem là sáng suốt.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Người sống tách biệt theo đường vị kỷ</para>
  <para style="q2" vid="PRO 18:1">Chẳng buồn nghe lý luận khôn ngoan.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Người điên dại không nghe lời tri thức;</para>
  <para style="q2" vid="PRO 18:2">nhưng rêu rao ý kiến điên rồ.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Tội ác cùng đi với khinh rẻ,</para>
  <para style="q2" vid="PRO 18:3">sỉ nhục đồng hành với nhuốc nhơ.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Lời từ miệng người, như nước vực sâu;</para>
  <para style="q2" vid="PRO 18:4">nhưng nguồn khôn ngoan là suối tuôn tràn.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Vị nể người ác là điều chẳng phải,</para>
  <para style="q2" vid="PRO 18:5">khước từ công lý với người vô tội là đại bất công.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Lời người dại tạo nên tranh chấp;</para>
  <para style="q2" vid="PRO 18:6">khiến người ta lấy cớ đánh mình.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Miệng ngu muội làm mình thất bại,</para>
  <para style="q2" vid="PRO 18:7">đôi môi thành cạm bẫy linh hồn.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Lời rỉ tai như của ngon vật lạ,</para>
  <para style="q2" vid="PRO 18:8">nuốt vào, thỏa lòng mát dạ.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Làm việc mà cứ biếng nhác,</para>
  <para style="q2" vid="PRO 18:9">là anh em của người phá hoại.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Danh Chúa Hằng Hữu là pháo đài kiên cố;</para>
  <para style="q2" vid="PRO 18:10">người công chính đến được nơi trú ẩn an toàn.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Người giàu coi tài sản là thành kiên cố;</para>
  <para style="q2" vid="PRO 18:11">như tường thành không thể vượt qua.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Tự cao dẫn đến suy bại;</para>
  <para style="q2" vid="PRO 18:12">khiêm nhường đem lại tôn trọng.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Đáp lời mà chẳng chịu nghe,</para>
  <para style="q2" vid="PRO 18:13">là mang sỉ nhục, để cho chúng cười.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Bệnh thuyên giảm nhờ tinh thần phấn khởi,</para>
  <para style="q2" vid="PRO 18:14">xuống tinh thần, thân thể hết cậy trông.<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Lòng người thận trọng đón nhận tri thức.</para>
  <para style="q2" vid="PRO 18:15">Tai người khôn ngoan tìm kiếm hiểu biết.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Tặng phẩm có tác dụng dọn đường mở lối;</para>
  <para style="q2" vid="PRO 18:16">dẫn đưa người đến trước mặt yếu nhân.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Nghe một bên chỉ thấy vài khía cạnh—</para>
  <para style="q2" vid="PRO 18:17">nghe cả hai mới biết trọn vấn đề.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Bắt thăm hòa giải đôi đường;</para>
  <para style="q2" vid="PRO 18:18">hai bên quyền thế không còn chống nhau.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Đánh chiếm pháo đài còn dễ hơn lấy lòng anh em bị xúc phạm.</para>
  <para style="q2" vid="PRO 18:19">Vì mối giận như cửa khóa then gài.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Bông trái của miệng làm dạ dày no đủ;</para>
  <para style="q2" vid="PRO 18:20">hoa lợi của môi làm thỏa thích tâm can.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Quyền sống chết nằm nơi cái lưỡi;</para>
  <para style="q2" vid="PRO 18:21">ai nuông chiều, lãnh hậu quả tày đình.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Ai tìm được vợ là tìm ra phước hạnh,</para>
  <para style="q2" vid="PRO 18:22">và hưởng ân lành của Chúa ban.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Người nghèo xin rủ lòng thương;</para>
  <para style="q2" vid="PRO 18:23">người giàu hách dịch nói năng phũ phàng.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Nhiều bè bạn có thể là điều tai hại,</para>
  <para style="q2" vid="PRO 18:24">nhưng có một bạn chí thân hơn cả anh em ruột.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Thà nghèo mà sống đời thanh bạch,</para>
  <para style="q2" vid="PRO 19:1">còn hơn giàu lại sống cách bất lương.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Hăng say mà vô ý thức;</para>
  <para style="q2" vid="PRO 19:2">cũng hỏng việc như người quá vội vàng.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Đường lối người hư hỏng bởi sự ngu dại mình,</para>
  <para style="q2" vid="PRO 19:3">nhưng nó lại u mê oán hận Chúa Hằng Hữu.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Khi giàu có thu hút nhiều bè bạn;</para>
  <para style="q2" vid="PRO 19:4">lúc khốn cùng, bạn thân cũng lánh xa.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Nhân chứng gian chắc chắn mang hình phạt,</para>
  <para style="q2" vid="PRO 19:5">người dối gạt không sao thoát lưới trời.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Bậc cao quý được lắm người cầu cạnh;</para>
  <para style="q2" vid="PRO 19:6">ai cũng ưa làm bạn với người hay ban tặng.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Khi nghèo ngặt, ruột thịt còn xa lánh;</para>
  <para style="q2" vid="PRO 19:7">Huống hồ chi là bè bạn thân sơ!</para>
  <para style="q1" vid="PRO 19:7">Muốn xin họ rủ chút lòng thương,</para>
  <para style="q2" vid="PRO 19:7">họ tránh đâu mất, tìm hoài không ra.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Người khôn ngoan yêu mến linh hồn mình;</para>
  <para style="q2" vid="PRO 19:8">người thông sáng tìm được nhiều phước hạnh.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Nhân chứng gian lãnh hình phạt chắc chắn,</para>
  <para style="q2" vid="PRO 19:9">người dối trá bị tiêu diệt chẳng sai.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Người ngu dại sống giàu sang không thích hợp</para>
  <para style="q2" vid="PRO 19:10">khác nào nô lệ cại trị các hoàng tử!<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Người khôn ngoan kiềm hãm cơn giận dữ;</para>
  <para style="q2" vid="PRO 19:11">người khoan dung<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">Không bắt lỗi</char></note> thường được tiếng ngợi khen.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Khi giận dữ, vua nạt nộ như sư tử rống,</para>
  <para style="q2" vid="PRO 19:12">còn ân huệ vua đổ như sương móc trên đồng xanh.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Con ngỗ nghịch là tai họa cho cha;</para>
  <para style="q2" vid="PRO 19:13">vợ mè nheo như nhà dột cho chồng.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Tài sản do cha ông để lại,</para>
  <para style="q2" vid="PRO 19:14">nhưng vợ hiền, Chúa Hằng Hữu ban cho.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Vì làm biếng mà người ta mê ngủ,</para>
  <para style="q2" vid="PRO 19:15">người lười nhác sẽ bị đói khát.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Ai giữ điều răn, giữ lấy linh hồn mình;</para>
  <para style="q2" vid="PRO 19:16">ai bỏ đường Chúa chọn lấy cảnh diệt vong.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Ai giúp người nghèo, tức cho Chúa Hằng Hữu vay mượn—</para>
  <para style="q2" vid="PRO 19:17">và được Ngài ban thưởng chẳng sai!<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Sửa dạy con khi còn hy vọng.</para>
  <para style="q2" vid="PRO 19:18">Đừng để con sa chốn diệt vong.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Người nóng tính sẽ mang hậu họa.</para>
  <para style="q2" vid="PRO 19:19">Ai giúp người, còn phải giúp kiên trì.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Biết nghe lời khuyên răn chỉ giáo,</para>
  <para style="q2" vid="PRO 19:20">sẽ khôn ngoan suốt cả cuộc đời.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Lòng con người lo bày mưu tính kế,</para>
  <para style="q2" vid="PRO 19:21">nhưng Chúa Hằng Hữu định thành bại của người.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Nhân hậu khiến mọi người mến phục.</para>
  <para style="q2" vid="PRO 19:22">Thà chịu nghèo còn hơn sống gian ngoa.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Kính sợ Chúa Hằng Hữu là nguồn sự sống,</para>
  <para style="q2" vid="PRO 19:23">làm thỏa lòng và ngăn cản họa tai.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Người biếng nhác đặt tay mình vào đĩa,</para>
  <para style="q2" vid="PRO 19:24">nhưng rồi thôi, không đưa lên miệng mình.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Trừng phạt người nhạo báng, người chân chất sẽ học khôn;</para>
  <para style="q2" vid="PRO 19:25">trách cứ người thông sáng, sự thông sáng người gia tăng.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Hành hung cha và xô đuổi mẹ,</para>
  <para style="q2" vid="PRO 19:26">gây xấu hổ và sỉ nhục gia đình.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Con ơi, chớ nên nghe tà thuyết,</para>
  <para style="q2" vid="PRO 19:27">để con không lạc lối lầm đường.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Nhân chứng gian nhạo cười công lý;</para>
  <para style="q2" vid="PRO 19:28">miệng ác nhân ăn nuốt tội ô.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Hình phạt để dành cho người nhạo báng,</para>
  <para style="q2" vid="PRO 19:29">roi vọt sắm sẵn cho người khùng điên.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Rượu xúi người nhạo báng, thức uống say gây tiếng ồn.</para>
  <para style="q2" vid="PRO 20:1">Ai để rượu hành là người mất khôn.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Vua thịnh nộ như sư tử rống;</para>
  <para style="q2" vid="PRO 20:2">làm vua giận là hại chính mình!<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Tránh được tranh cạnh là điều vinh dự;</para>
  <para style="q2" vid="PRO 20:3">chỉ dại dột mới sinh sự cãi nhau.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Người lười biếng không cày lúc mùa đông,</para>
  <para style="q2" vid="PRO 20:4">đến mùa gặt đi xin, chẳng được gì.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Mưu kế lòng người như giếng nước sâu,</para>
  <para style="q2" vid="PRO 20:5">người thông sáng chỉ việc múc lấy.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Bao nhiêu người khoe nhân khoe nghĩa,</para>
  <para style="q2" vid="PRO 20:6">nhưng kiếm đâu ra một người trung thành.<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Một người ngay có lòng chân thật;</para>
  <para style="q2" vid="PRO 20:7">để lại phước lành cho cháu cho con.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Vua ngồi xử đoán, mắt tinh vi,</para>
  <para style="q2" vid="PRO 20:8">phân biệt sàng sảy điều gian ác.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Ai dám bảo: “Tôi có lòng trong sạch,</para>
  <para style="q2" vid="PRO 20:9">lương tâm tôi đã tẩy sạch tội rồi”?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Người dùng cân lường gian trá—</para>
  <para style="q2" vid="PRO 20:10">bị Chúa Hằng Hữu miệt khinh.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Dù còn niên thiếu, tính tình đã bộc lộ,</para>
  <para style="q2" vid="PRO 20:11">qua hành vi, biết nó thật hay không.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Tai để nghe và mắt nhìn thấy—</para>
  <para style="q2" vid="PRO 20:12">ấy là quà Chúa Hằng Hữu ban cho.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Mê ngủ quá, con sẽ nên nghèo khó.</para>
  <para style="q2" vid="PRO 20:13">Siêng năng lên, con sẽ được no nê.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Người mua luôn miệng chê: “Xấu, Xấu!”</para>
  <para style="q2" vid="PRO 20:14">Trên đường về lại tự khen mình.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Vàng bạc ngọc ngà không khó kiếm,</para>
  <para style="q2" vid="PRO 20:15">nhưng lời khôn ngoan quý giá biết bao.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Phải nắm áo hắn vì hắn bảo lãnh cho người không quen,</para>
  <para style="q2" vid="PRO 20:16">Hãy giữ vật làm tin vì hắn bảo lãnh cho đàn bà xa lạ.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Bánh gian lận mới ăn thì ngon ngọt,</para>
  <para style="q2" vid="PRO 20:17">nhưng vào miệng rồi, thành sỏi đá chai khô.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Chỉ nhờ hội bàn mới thành kế hoạch;</para>
  <para style="q2" vid="PRO 20:18">khi có cao kiến mới động binh đao.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Người mách lẻo tiết lộ điều bí mật,</para>
  <para style="q2" vid="PRO 20:19">con đừng nên giao dịch với người hở môi.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Ngọn đèn của người chửi cha mắng mẹ,</para>
  <para style="q2" vid="PRO 20:20">phụt tắt đi giữa đêm tối âm u.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Gia tài hưởng hấp tấp,</para>
  <para style="q2" vid="PRO 20:21">phước hạnh chẳng bền lâu.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Đừng vội nói: “Thù tôi, tôi trả.”</para>
  <para style="q2" vid="PRO 20:22">Nhưng hãy chờ Chúa Hằng Hữu giải cứu cho.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Trái cân non, chiếc cân giả,</para>
  <para style="q2" vid="PRO 20:23">cả hai đều bị Chúa Hằng Hữu ghét bỏ.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Chúa Hằng Hữu dẫn đưa từng bước một,</para>
  <para style="q2" vid="PRO 20:24">là người trần, ai hiểu được đường mình?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Khấn nguyện với Đức Chúa Trời mà không suy xét</para>
  <para style="q2" vid="PRO 20:25">là cạm bẫy cho chính mình.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Vua khôn ngoan áp dụng trọng hình,</para>
  <para style="q2" vid="PRO 20:26">tẩy thanh phường gian tà.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Tâm linh con người là ngọn đèn của Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 20:27">soi thấu đến những nơi sâu kín trong lòng.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Chỉ có lòng bác ái, chân thành, độ lượng,</para>
  <para style="q2" vid="PRO 20:28">mới bảo đảm được ngôi nước quân vương.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Trai tráng nhờ sức mạnh được vẻ vang;</para>
  <para style="q2" vid="PRO 20:29">bậc lão thành vinh quang vì tóc bạc.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Những thương tích làm sạch điều ác,</para>
  <para style="q2" vid="PRO 20:30">còn roi vọt làm tinh khiết tấm lòng.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Lòng vua như nước trong tay Chúa Hằng Hữu;</para>
  <para style="q2" vid="PRO 21:1">Ngài nghiêng tay bên nào, nước chảy về bên ấy.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Xét việc làm, tự cho ta phải,</para>
  <para style="q2" vid="PRO 21:2">nhưng Chúa Hằng Hữu xét lòng dạ ta.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Chúa Hằng Hữu muốn ta chính trực, công bằng,</para>
  <para style="q2" vid="PRO 21:3">hơn là đem tế lễ hằng dâng.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Lòng tự đại, mắt kiêu cường,</para>
  <para style="q2" vid="PRO 21:4">cũng là tội lỗi như phường bất lương.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Trù liệu và chăm chỉ thì no nê thịnh vượng;</para>
  <para style="q2" vid="PRO 21:5">bất cẩn vội vàng, thì nghèo đói đương nhiên.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Gia tài xây dựng bằng lưỡi dối trá,</para>
  <para style="q2" vid="PRO 21:6">như hơi nước mau tan, như cạm bẫy tử thần.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Bọn bất lương chối việc công bằng,</para>
  <para style="q2" vid="PRO 21:7">lòng gian tà cuốn đùa chúng đi.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Đường lối người phạm tội là quanh co;</para>
  <para style="q2" vid="PRO 21:8">việc làm người chân thật là ngay thẳng.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Thà ở nơi góc mái nhà,</para>
  <para style="q2" vid="PRO 21:9">còn hơn ở chung nhà với đàn bà hay sinh sự.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Người dữ chuyên làm ác,</para>
  <para style="q2" vid="PRO 21:10">dù láng giềng, nó chẳng thương xót.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Khi người nhạo báng bị hình phạt, người dại trở thành khôn ngoan;</para>
  <para style="q2" vid="PRO 21:11">lúc người khôn được giáo huấn, tri thức người càng tăng.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Đấng Công Chính quan sát nhà người ác,</para>
  <para style="q2" vid="PRO 21:12">Ngài ném người ác vào tai họa.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Bịt tai khi người nghèo khổ kêu ca,</para>
  <para style="q2" vid="PRO 21:13">lúc ta gào khóc gào, nào ai đoái hoài.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Quà biếu âm thầm làm nguôi cơn giận;</para>
  <para style="q2" vid="PRO 21:14">hối lộ kín giấu khiến thịnh nộ tan.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Công lý đem vui mừng cho người lành,</para>
  <para style="q2" vid="PRO 21:15">nhưng gây khiếp sợ cho người ác.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Người từ bỏ lương tri,</para>
  <para style="q2" vid="PRO 21:16">sẽ rơi vào cõi chết.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Vui chơi khiến con nghèo nàn;</para>
  <para style="q2" vid="PRO 21:17">rượu chè xa xỉ không đưa đến giàu có.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Người ác lãnh tai nạn thay cho người lành,</para>
  <para style="q2" vid="PRO 21:18">người bất nghĩa lãnh tai nạn thay cho người ngay thẳng.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Thà ở nơi hoang mạc,</para>
  <para style="q2" vid="PRO 21:19">còn hơn ở chung nhà đàn bà rầy rà, nóng nảy.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Trong tay người khôn, tài sản còn lại,</para>
  <para style="q2" vid="PRO 21:20">người dại hễ có là ăn tiêu hết ngay.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Hãy công bằng và nhân từ,</para>
  <para style="q2" vid="PRO 21:21">con sẽ được trường sinh, công lý, và danh dự.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Người khôn tấn công thành trì người mạnh,</para>
  <para style="q2" vid="PRO 21:22">triệt hạ pháo đài phòng thủ đối phương.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ai kiểm soát miệng, cầm giữ lưỡi,</para>
  <para style="q2" vid="PRO 21:23">là người giữ mình thoát khỏi rối reng.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Người nhạo báng luôn kiêu căng, xấc xược;</para>
  <para style="q2" vid="PRO 21:24">thái độ lúc nào cũng hợm hĩnh khinh khi.<verse eid="PRO 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 21:25" />Dục vọng của người lười biếng sẽ giết chết nó,</para>
  <para style="q2" vid="PRO 21:25">vì đôi tay của nó không chịu làm việc.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Người gian tham suốt ngày thèm thuồng</para>
  <para style="q2" vid="PRO 21:26">nhưng người công chính chia sẻ rời rộng.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Của lễ người ác đã là điều đáng ghét;</para>
  <para style="q2" vid="PRO 21:27">tà tâm nó còn ghê tởm đến đâu!<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Lời chứng dối tự nó triệt tiêu,</para>
  <para style="q2" vid="PRO 21:28">ai nghe theo sẽ bị hủy diệt đời đời!<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Người ác làm cho mặt mày chai đá,</para>
  <para style="q2" vid="PRO 21:29">người công chính làm cho đường lối mình vững chãi luôn.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Chẳng ai chống lại được Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 21:30">dù khôn ngoan hay thông sáng, dù thương nghị mưu kế.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Người ta chuẩn bị ngựa cho ngày chinh chiến,</para>
  <para style="q2" vid="PRO 21:31">nhưng chiến thắng thuộc về Chúa Hằng Hữu.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Danh thơm tiếng tốt hơn giàu có;</para>
  <para style="q2" vid="PRO 22:1">còn ân huệ quý hơn bạc vàng.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Chúa Hằng Hữu tạo nên người nghèo lẫn người giàu,</para>
  <para style="q2" vid="PRO 22:2">dưới mắt Ngài, họ chẳng khác gì nhau.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Người khôn tránh né nguy nan.</para>
  <para style="q2" vid="PRO 22:3">Người dại đâm đầu hướng tới họa tai.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ai kính sợ Chúa Hằng Hữu và khiêm nhường</para>
  <para style="q2" vid="PRO 22:4">được hưởng danh dự, công lý, và trường thọ.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Trên đường người gian tà đầy gai góc và cạm bẫy;</para>
  <para style="q2" vid="PRO 22:5">người muốn giữ hồn mình phải tránh cho xa.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Dạy trẻ thơ nẻo chính đường ngay,</para>
  <para style="q2" vid="PRO 22:6">cho dù đến già, nó chẳng đổi thay.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Giàu cai trị nghèo,</para>
  <para style="q2" vid="PRO 22:7">người vay làm nô lệ cho người cho vay.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Người gieo bất công sẽ gặt tai họa,</para>
  <para style="q2" vid="PRO 22:8">cây gậy thịnh nộ của nó chắc sẽ tiêu tan.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Ai rộng lòng nuôi dưỡng người cơ cực</para>
  <para style="q2" vid="PRO 22:9">sẽ luôn hưởng được nhiều phước dồi dào.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Đuổi người kiêu cường đi, xung đột sẽ dứt.</para>
  <para style="q2" vid="PRO 22:10">Cũng không còn những tiếng cãi cọ xấu xa.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Lòng trong sạch, môi thanh nhã,</para>
  <para style="q2" vid="PRO 22:11">đức tính ấy, làm bạn của vua.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Chúa Hằng Hữu bảo vệ người thông sáng,</para>
  <para style="q2" vid="PRO 22:12">người dối gian bị Chúa tảo trừ.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Người lười nói: “Sư tử ngoài kia!</para>
  <para style="q2" vid="PRO 22:13">Nếu ra ngoài, ta sẽ bị giết!”<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Miệng dâm phụ là cái hố sâu;</para>
  <para style="q2" vid="PRO 22:14">chôn vùi người Chúa Hằng Hữu nguyền rủa.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Nghiêm trị, răn dạy trẻ thơ,</para>
  <para style="q2" vid="PRO 22:15">giải thoát lòng chúng khỏi điều khờ dại.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Làm giàu bằng cách bóc lột người nghèo hay bằng hối lộ,</para>
  <para style="q2" vid="PRO 22:16">đều đưa đến túng thiếu cơ hàn.<verse eid="PRO 22:16" /></para>
  <para style="s1">Lời Nói của Người Khôn Ngoan</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Con lắng tai nghe lời khôn sáng;</para>
  <para style="q2" vid="PRO 22:17">mở lòng con đón nhận tri thức ta.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Con sẽ vui thích khi giữ nó trong lòng,</para>
  <para style="q2" vid="PRO 22:18">và tập trung nó trên đôi môi con.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Ngày nay ta đã dạy cho con biết điều đó,</para>
  <para style="q2" vid="PRO 22:19">để con đặt hết niềm tin vào Chúa Hằng Hữu.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Ta há chẳng viết cho con ba mươi lần,</para>
  <para style="q2" vid="PRO 22:20">trình bày lời khuyên dạy và tri thức.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Để con tiếp nhận lời chân thật,</para>
  <para style="q2" vid="PRO 22:21">và đem lời đó về cho người sai phái con.<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Đừng bóc lột người nghèo vì họ túng quẫn,</para>
  <para style="q2" vid="PRO 22:22">cũng đừng áp bức người khốn khổ nơi tòa.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Vì Chúa Hằng Hữu sẽ đứng ra bênh vực.</para>
  <para style="q2" vid="PRO 22:23">Ngài sẽ diệt trừ những ai ức hiếp họ.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Thấy ai giận, con đừng phụ họa,</para>
  <para style="q2" vid="PRO 22:24">khi người nổi nóng, con đừng tiếp tay,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />để con khỏi học tính nóng nảy</para>
  <para style="q2" vid="PRO 22:25">và làm hại cho linh hồn con.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Chớ như người ra tay bảo đảm</para>
  <para style="q2" vid="PRO 22:26">hoặc bảo lãnh nợ cho ai.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Vì nếu con không có gì để trả</para>
  <para style="q2" vid="PRO 22:27">thì chủ nợ sẽ xiết cả đến cái giường của con.<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Chớ dời ranh giới cũ</para>
  <para style="q2" vid="PRO 22:28">do tổ phụ thiết lập.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Con có thấy người nào cần mẫn trong việc mình không?</para>
  <para style="q2" vid="PRO 22:29">Người ấy sẽ phục vụ trước các vua,</para>
  <para style="q2" vid="PRO 22:29">chứ không phải trước người tầm thường đâu.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Khi con ngồi ăn uống với người quyền thế,</para>
  <para style="q2" vid="PRO 23:1">hãy để ý cẩn thận người ngồi trước mặt con.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Nếu con ham ăn,</para>
  <para style="q2" vid="PRO 23:2">hãy để con dao nơi họng con.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Chớ thèm các món cao lương mỹ vị,</para>
  <para style="q2" vid="PRO 23:3">vì của ngon rượu ngọt là cạm bẫy giăng.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Đừng nhọc công khổ trí làm giàu.</para>
  <para style="q2" vid="PRO 23:4">Hãy sáng suốt khôn ngoan biết lúc phải dừng lại.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Con có liếc mắt nhìn sự giàu sang,</para>
  <para style="q2" vid="PRO 23:5">thì giàu có phù du hết rất mau,</para>
  <para style="q2" vid="PRO 23:5">như đại bàng vỗ cánh bay mất.<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Chớ ăn của người có lòng keo kiệt;</para>
  <para style="q2" vid="PRO 23:6">cũng đừng thèm cao lương mỹ vị họ mời.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Miệng mời nhưng lòng họ chẳng muốn con ăn,</para>
  <para style="q2" vid="PRO 23:7">điều họ nghĩ mới chính thật con người của họ.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Con sẽ phải nôn hết món ăn ra,</para>
  <para style="q2" vid="PRO 23:8">và phí cả lời khen tặng con đã nói.<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Đừng tốn công nói với người dại,</para>
  <para style="q2" vid="PRO 23:9">vì hắn sẽ khinh thường lời khôn ngoan của con.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Chớ dời ranh giới cũ;</para>
  <para style="q2" vid="PRO 23:10">và đừng chiếm đoạt đất người mồ côi.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Vì Đấng Cứu Chuộc họ là Đấng năng quyền;</para>
  <para style="q2" vid="PRO 23:11">sẽ bênh vực họ và khép tội con.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Chuyên lòng tiếp nhận dạy dỗ;</para>
  <para style="q2" vid="PRO 23:12">lắng tai đón nghe tri thức.<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Đừng bỏ qua việc sửa dạy con cái.</para>
  <para style="q2" vid="PRO 23:13">Roi vọt không làm nó chết đâu.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Người dùng roi sửa dạy con,</para>
  <para style="q2" vid="PRO 23:14">là cứu linh hồn nó khỏi hư vong.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Con ơi, nếu lòng con khôn ngoan,</para>
  <para style="q2" vid="PRO 23:15">thì chính lòng ta cũng vui mừng;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Phải, lòng dạ ta sẽ mừng rỡ,</para>
  <para style="q2" vid="PRO 23:16">khi miệng con nói điều ngay thẳng.<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Chớ hiềm tị vì người gian được may mắn,</para>
  <para style="q2" vid="PRO 23:17">nhưng đem lòng kính sợ Chúa Hằng Hữu ngày đêm.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Tương lai con sẽ trong sáng;</para>
  <para style="q2" vid="PRO 23:18">hy vọng thành đạt là điều chắc chắn.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Con ơi, hãy lắng nghe và trở nên khôn ngoan:</para>
  <para style="q2" vid="PRO 23:19">Hãy hướng lòng con vào đường chính đáng.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Chớ kết bạn với người nghiện rượu,</para>
  <para style="q2" vid="PRO 23:20">hoặc với người ham ăn,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />vì tương lai họ khó khăn, cơ hàn,</para>
  <para style="q2" vid="PRO 23:21">và người mê ngủ sẽ rách rưới tơi bời.<verse eid="PRO 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Lắng tai nghe lời khuyên dạy của cha,</para>
  <para style="q2" vid="PRO 23:22">khi mẹ yếu già, con chớ khinh khi.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Phải mua chân lý và đừng bao giờ bán nó;</para>
  <para style="q2" vid="PRO 23:23">cũng đừng bán khôn ngoan, học thức, và lương tri.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Có con ngay lành, lòng cha mừng rỡ.</para>
  <para style="q2" vid="PRO 23:24">Có con khôn ngoan, vui lòng hớn hở.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Nguyện cha và mẹ con vui mừng!</para>
  <para style="q2" vid="PRO 23:25">Nguyện người sinh ra con được rạng rỡ vui mừng.<verse eid="PRO 23:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Con hãy dâng lòng con cho cha.</para>
  <para style="q2" vid="PRO 23:26">Để mắt con chăm chú đường lối cha.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Vì gái điếm là hố sâu,</para>
  <para style="q2" vid="PRO 23:27">dâm phụ là giếng thẳm.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Nó rình rập mồi ngon,</para>
  <para style="q2" vid="PRO 23:28">gây cho số người bất nghĩa gia tăng.<verse eid="PRO 23:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Ai phiền muộn? Ai đau khổ?</para>
  <para style="q2" vid="PRO 23:29">Ai tranh cạnh? Ai thở than?</para>
  <para style="q2" vid="PRO 23:29">Mắt đỏ ngầu, mình thương tích?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Đó là người chè chén, la cà,</para>
  <para style="q2" vid="PRO 23:30">nhấm nháp các thứ rượu pha.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Chớ mê mẩn nhìn ly rượu hồng, nó đỏ đẹp thật,</para>
  <para style="q2" vid="PRO 23:31">nó óng ánh làm sao; tuôn chảy dễ dàng.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Nhưng rồi ra con sẽ bị rượu cắn như rắn;</para>
  <para style="q2" vid="PRO 23:32">nọc độc nó như rắn lục.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Mắt con sẽ thấy những điều kỳ lạ,</para>
  <para style="q2" vid="PRO 23:33">và lòng con đầy dẫy điều xấu xa.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Con sẽ như người đi giữa biển cả,</para>
  <para style="q2" vid="PRO 23:34">dập dồi như thể leo lên cột buồm.<verse eid="PRO 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 23:35" />Con nói: “Họ đánh tôi, nhưng sao tôi chẳng đau.</para>
  <para style="q1" vid="PRO 23:35">Tôi không cảm biết khi bị họ đánh.</para>
  <para style="q2" vid="PRO 23:35">Bao giờ tôi tỉnh lại đây</para>
  <para style="q2" vid="PRO 23:35">để tôi còn tìm uống nữa?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Chớ ganh tị người ác,</para>
  <para style="q2" vid="PRO 24:1">cũng đừng mong kết bạn với họ.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Vì lòng chúng đầy âm mưu bạo tàn,</para>
  <para style="q2" vid="PRO 24:2">môi nói ra toàn lời nguy hại.<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Nhà cửa xây trên nền khôn ngoan</para>
  <para style="q2" vid="PRO 24:3">và được vững vàng do hiểu biết.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Do tri thức các phòng</para>
  <para style="q2" vid="PRO 24:4">được đầy vật quý hiếm.<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Người khôn ngoan là người có sức lớn,</para>
  <para style="q2" vid="PRO 24:5">người tri thức lại càng thêm năng lực.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Đánh giặc phải nhờ mưu khôn ngoan;</para>
  <para style="q2" vid="PRO 24:6">muốn chiến thắng, cần nhiều mưu sĩ.<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Với người dại, khôn ngoan là điều cao xa quá.</para>
  <para style="q2" vid="PRO 24:7">Nơi cổng thành, nó chẳng dám hé miệng ra.<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ai mưu tính điều ác,</para>
  <para style="q2" vid="PRO 24:8">sẽ nổi danh là người gian xảo.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Âm mưu của người dại là tội lỗi;</para>
  <para style="q2" vid="PRO 24:9">người nhạo báng bị người ta ghê tởm.<verse eid="PRO 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Chỉ người yếu hèn</para>
  <para style="q2" vid="PRO 24:10">mới sờn lòng trong ngày hoạn nạn.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Hãy cứu người bị đưa đến cõi chết;</para>
  <para style="q2" vid="PRO 24:11">hãy ngăn bước người lảo đảo đi đến chỗ tử vong.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Đừng tự nói: “Chúng tôi chẳng biết chuyện gì cả.”</para>
  <para style="q2" vid="PRO 24:12">Vì Đức Chúa Trời hiểu rõ lòng người, và Ngài nhìn thấy.</para>
  <para style="q2" vid="PRO 24:12">Đấng canh giữ mạng sống con biết rõ con đã biết.</para>
  <para style="q2" vid="PRO 24:12">Ngài sẽ báo trả mỗi người tùy việc họ đã làm.<verse eid="PRO 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Con ơi, hãy ăn mật ong vì nó tốt,</para>
  <para style="q2" vid="PRO 24:13">mật của tàn ong ngon ngọt cho miệng con.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Cũng hãy biết rằng khôn ngoan ngọt ngào cho linh hồn con.</para>
  <para style="q2" vid="PRO 24:14">Nếu con tìm được khôn ngoan, con sẽ tràn đầy hy vọng,</para>
  <para style="q2" vid="PRO 24:14">và hy vọng của con sẽ không bị cắt đứt.<verse eid="PRO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15" />Đừng rình rập nhà người công chính,</para>
  <para style="q2" vid="PRO 24:15">cũng đừng cướp phá nơi ở của người,<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Vì người công chính vẫn đứng dậy, dù bị ngã bảy lần.</para>
  <para style="q2" vid="PRO 24:16">Nhưng chỉ một tai vạ, người ác đã bại liệt ngay.<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Khi kẻ địch sa cơ, con chớ mừng;</para>
  <para style="q2" vid="PRO 24:17">khi nó ngã, lòng con đừng hớn hở.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Kẻo e Chúa Hằng Hữu không bằng lòng</para>
  <para style="q2" vid="PRO 24:18">và ngưng ra tay trừng phạt nó chăng.<verse eid="PRO 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Chớ nóng lòng vì công việc người ác,</para>
  <para style="q2" vid="PRO 24:19">đừng ganh tị khi người dữ thành đạt.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Đời người ác không có tương lai;</para>
  <para style="q2" vid="PRO 24:20">đèn người dữ nay mai sẽ tắt.<verse eid="PRO 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Con ơi, phải kính sợ Chúa và tôn trọng vua.</para>
  <para style="q2" vid="PRO 24:21">Đừng liên kết với bọn người phản loạn,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />vì họa tai sẽ đến bất ngờ.</para>
  <para style="q2" vid="PRO 24:22">Ai lường được hình phạt của Chúa Hằng Hữu và vua?<verse eid="PRO 24:22" /></para>
  <para style="s1">Một Vài Châm Ngôn Khác</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Đây là lời của người khôn ngoan:</para>
  <para style="q1" vid="PRO 24:23">Khi xét xử, đừng thiên vị ai cả.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ai tuyên bố với người ác rằng “Anh vô tội,”</para>
  <para style="q2" vid="PRO 24:24">sẽ bị mọi người nguyền rủa không thôi.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Ai trách phạt người ác, sẽ được mọi người ưa thích;</para>
  <para style="q2" vid="PRO 24:25">và tràn đầy phước hạnh.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Lời nói thẳng</para>
  <para style="q2" vid="PRO 24:26">xuất phát từ tình thương.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Lo làm ăn trong ngoài chu tất,</para>
  <para style="q2" vid="PRO 24:27">rồi hãy tính đến việc cất nhà.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Đừng vô cớ làm chứng hại láng giềng;</para>
  <para style="q2" vid="PRO 24:28">môi miệng con đừng thốt ra lời dối trá.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Chớ nói: “Tôi báo trả lại điều nó làm cho tôi!</para>
  <para style="q2" vid="PRO 24:29">Tôi chỉ tốt với người tốt với tôi thôi!”<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Ta có qua ruộng một người kém siêng năng,</para>
  <para style="q2" vid="PRO 24:30">và vườn nho của người ngu dại.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Cỏ mọc um tùm, gai phủ giăng.</para>
  <para style="q2" vid="PRO 24:31">Rào dậu điêu tàn nghiêng ngửa đổ.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Quan sát cảnh ấy, ta để ý,</para>
  <para style="q2" vid="PRO 24:32">suy xét, và học được rằng:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Ngủ một chút, mơ màng thêm một chút,</para>
  <para style="q2" vid="PRO 24:33">khoanh tay nghỉ một chút nữa thôi—<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />cảnh nghèo đến như kẻ trộm;</para>
  <para style="q2" vid="PRO 24:34">bạo tàn, đột ngột như phường cướp tấn công.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Những Châm Ngôn Khác của Sa-lô-môn</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Sau đây là những châm ngôn của Sa-lô-môn, do triều thần của Vua Ê-xê-chia, nước Giu-đa sưu tầm và sao chép:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Vinh quang của Đức Chúa Trời là giữ kín một điều gì,</para>
  <para style="q2" vid="PRO 25:2">tìm tòi, khám phá là vinh quang của các vua.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Không ai biết trời cao, đất thấp bao nhiêu,</para>
  <para style="q2" vid="PRO 25:3">lòng vua chúa cũng khó dò như vậy!<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Khi khử sạch cáu cặn khỏi bạc,</para>
  <para style="q2" vid="PRO 25:4">con có vật liệu để chế tạo vật quý.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Khi trừ diệt người xấu trước mặt vua,</para>
  <para style="q2" vid="PRO 25:5">ngôi nước ngươi sẽ vững mạnh nhờ công lý.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Trước mặt vua, con chớ phô trương,</para>
  <para style="q2" vid="PRO 25:6">cũng đừng tranh địa vị với hàng cao trọng,<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Thà ngồi thấp, rồi được nhấc lên cao,</para>
  <para style="q2" vid="PRO 25:7">còn hơn bị hạ trước bao nhiêu người.<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Đừng hấp tấp kiện thưa ai cả,</para>
  <para style="q2" vid="PRO 25:8">vì biết đâu con phải bị thua.</para>
  <para style="q2" vid="PRO 25:8">Khi danh dự tổn thương, con sẽ làm gì?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Tốt hơn cả là hai bên ngồi đối chất,</para>
  <para style="q2" vid="PRO 25:9">nhưng đừng tiết lộ điều gì cho người khác,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Kẻo đối phương nghe được, lên án con nói xấu,</para>
  <para style="q2" vid="PRO 25:10">và con không thể rút lại được lời mình.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Lời bàn đúng lúc,</para>
  <para style="q2" vid="PRO 25:11">chẳng khác gì trái táo vàng trên đĩa bạc.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Nghe lời chỉ trích của người khôn ngoan,</para>
  <para style="q2" vid="PRO 25:12">là giá trị hơn đeo nữ trang bằng vàng.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Một sứ giả trung tín làm thỏa dạ chủ mình.</para>
  <para style="q2" vid="PRO 25:13">Như tuyết mát lạnh giữa mùa gặt với nắng hè gay gắt.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Hứa cho, nhưng chẳng giữ lời,</para>
  <para style="q2" vid="PRO 25:14">giống như có mây, có gió, rồi lại chẳng mưa.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Lòng kiên nhẫn thắng hơn cường lực,</para>
  <para style="q2" vid="PRO 25:15">lưỡi dịu dàng bẻ gãy cả xương.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Con có thích mật ong?</para>
  <para style="q2" vid="PRO 25:16">Cũng đừng ăn nhiều quá, kẻo con phải mửa ra!<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Chớ đến nhà láng giềng thường quá,</para>
  <para style="q2" vid="PRO 25:17">e nhàm mặt, người sẽ chán ghét con.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Lời chứng gian vô cùng hiểm nguy,</para>
  <para style="q2" vid="PRO 25:18">hại người chẳng khác nào gươm, tên, và dùi cui.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Đặt lòng tin vào một người không đáng tin cậy,</para>
  <para style="q2" vid="PRO 25:19">chẳng khác gì nhai với răng bị gãy, hay đi với chân khập khiễng.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Hát xướng trước người đang âu sầu buồn bã,</para>
  <para style="q2" vid="PRO 25:20">cũng như lột áo người ngày đông tháng giá,</para>
  <para style="q2" vid="PRO 25:20">như đổ giấm vào vết thương.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Đói cho ăn, khát cho uống,</para>
  <para style="q2" vid="PRO 25:21">săn sóc kẻ thù, cho nước họ uống.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Làm như vậy con sẽ chất than lửa đỏ trên đầu họ,</para>
  <para style="q2" vid="PRO 25:22">và Chúa Hằng Hữu sẽ thưởng cho con.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Gió bấc đem mưa,</para>
  <para style="q2" vid="PRO 25:23">nói hành sinh giận.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Thà ở nơi góc mái nhà,</para>
  <para style="q2" vid="PRO 25:24">còn hơn ở chung nhà với đàn bà hay sinh sự.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Được tin lành từ xứ xa đưa vào,</para>
  <para style="q2" vid="PRO 25:25">như được nước mát lúc khát khao.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Người công chính ngã quỵ trước người gian ác,</para>
  <para style="q2" vid="PRO 25:26">sẽ như suối nước bị dấy đục một nguồn nước bị hư.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Ăn nhiều mật có hại,</para>
  <para style="q2" vid="PRO 25:27">tìm vinh quang cá nhân quá cũng không tốt.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Ai không chế ngự lòng mình, chẳng lo tự chủ,</para>
  <para style="q2" vid="PRO 25:28">như thành bỏ ngỏ không có tường.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Vinh dự đến với người khờ dại,</para>
  <para style="q2" vid="PRO 26:1">cũng hiếm như mưa ngày mùa, như tuyết tháng hạ.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Lời nguyền rủa vô cớ chẳng tới đâu,</para>
  <para style="q2" vid="PRO 26:2">như chim sẻ bay đi, chim én liệng lại.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Roi dành cho ngựa, cương cho lừa,</para>
  <para style="q2" vid="PRO 26:3">đòn vọt cho lưng đứa ngu si.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Đừng đối đáp người khờ dại như sự khờ dại của nó,</para>
  <para style="q2" vid="PRO 26:4">kẻo con cũng giống như nó.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Phải dùng lý luận ngớ ngẩn đáp người khờ dại,</para>
  <para style="q2" vid="PRO 26:5">để nó đừng thấy như là nó khôn.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Dùng một đần truyền tin tức,</para>
  <para style="q2" vid="PRO 26:6">chẳng khác gì tự đầu độc, tự chặt chân.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Châm ngôn trong miệng người khờ dại,</para>
  <para style="q2" vid="PRO 26:7">khác nào chân bại trong thân thể người què.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Ca tụng người khờ dại</para>
  <para style="q2" vid="PRO 26:8">như cột đá vào ná.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Châm ngôn trong miệng người ngu dại,</para>
  <para style="q2" vid="PRO 26:9">như cành gai trong tay người say.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Mướn người dại, người lang thang làm lụng,</para>
  <para style="q2" vid="PRO 26:10">họ sẽ như người cầm cung bắn phá tứ tung.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Người ngu lặp lại điều khờ dại nó đã trót làm,</para>
  <para style="q2" vid="PRO 26:11">như chó mửa ra rồi liếm lại.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Một người tự phụ cho mình là khôn,</para>
  <para style="q2" vid="PRO 26:12">còn tệ hại hơn một người đần độn.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Người lười biếng nói rằng: “Có con sư tử ngoài đường!</para>
  <para style="q2" vid="PRO 26:13">Một con sư tử gầm thét ngoài phố!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Cửa xoay trên bản lề thể nào,</para>
  <para style="q2" vid="PRO 26:14">người lười biếng cũng xoay trở trên giường thể ấy.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Người biếng nhác đặt tay mình vào đĩa,</para>
  <para style="q2" vid="PRO 26:15">nhưng rồi thôi, không đưa lên miệng mình.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Tuy nhiên, hắn tự cho rằng mình khôn ngoan</para>
  <para style="q2" vid="PRO 26:16">hơn bảy người thông sáng khác.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Người đi ngoài đường thấy đám cãi nhau,</para>
  <para style="q2" vid="PRO 26:17">vô cớ mà can thiệp, khác nào kéo tai con chó vậy.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Người nào lừa gạt bạn mình</para>
  <para style="q2" vid="PRO 26:18">rồi nói rằng: “Tôi chỉ đùa thôi.”<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />Cũng như người điên ném than lửa,</para>
  <para style="q2" vid="PRO 26:19">bắn tên gây chết chóc.<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Không có lửa nếu không củi, không dầu,</para>
  <para style="q2" vid="PRO 26:20">không bất bình nếu không nói hành, nói xấu.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Người nhanh giận nhạy chuyện rầy rà,</para>
  <para style="q2" vid="PRO 26:21">như than, như củi, mau cháy bùng ra.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Lời rỉ tai như của ngon vật lạ,</para>
  <para style="q2" vid="PRO 26:22">nuốt vào, thỏa lòng mát dạ.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Lời hoa mỹ che đậy lòng độc ác,</para>
  <para style="q2" vid="PRO 26:23">như lớp men bóng bẩy bao ngoài bình đất rẻ tiền.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24" />Người quỷ quyệt dùng lời xảo trá,</para>
  <para style="q2" vid="PRO 26:24">nhưng trong lòng chất chứa gian manh.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Khi nó nói lời dịu ngọt đừng tin,</para>
  <para style="q2" vid="PRO 26:25">vì lòng nó chứa bảy điều gớm ghiếc.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Chúng nói nhân nói nghĩa đủ điều,</para>
  <para style="q2" vid="PRO 26:26">nhưng bộ mặt thật sẽ phô bày nơi công chúng.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Ai gài bẫy sẽ rơi vào bẫy,</para>
  <para style="q2" vid="PRO 26:27">lăn đá hại người, lại bị đá đè nát thân.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Nói dối, nói nịnh người nó chẳng thương,</para>
  <para style="q2" vid="PRO 26:28">gây nên tai hại khôn lường?<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Chớ khoe khoang về ngày mai,</para>
  <para style="q2" vid="PRO 27:1">vì con đâu biết được việc gì sẽ xảy ra trong tương lai.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Hãy để người khác khen con, miệng con chẳng nên làm;</para>
  <para style="q2" vid="PRO 27:2">hãy để người ngoài khen, môi con đừng làm thế.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Đá thì nặng và cát cũng nặng,</para>
  <para style="q2" vid="PRO 27:3">nhưng cơn nóng giận của người dại nặng hơn cả đá và cát.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Sự phẫn nộ thật độc ác, cơn giận thật bạo tàn,</para>
  <para style="q2" vid="PRO 27:4">nhưng sự ghen tương còn nguy hiểm bội phần.<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Ra mặt quở trách tỏ tường</para>
  <para style="q2" vid="PRO 27:5">hơn là yêu thương lặng lẽ.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Thương tổn do bạn gây ra, ấy là bởi lòng thành;</para>
  <para style="q2" vid="PRO 27:6">còn đáng tin hơn vô số cái hôn của kẻ thù.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Khi no, chê cả mật,</para>
  <para style="q2" vid="PRO 27:7">lúc đói, đắng hóa ngọt.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Người lưu lạc xa quê hương,</para>
  <para style="q2" vid="PRO 27:8">giống như chim lạc bầy bay xa tổ.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Dầu và thuốc thơm làm khoan khoái tâm hồn,</para>
  <para style="q2" vid="PRO 27:9">lời khuyên ngọt ngào của bằng hữu cũng êm dịu dường ấy.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Chớ từ bỏ bạn—dù bạn mình hoặc bạn của cha. </para>
  <para style="q2" vid="PRO 27:10">Lúc hoạn nạn, đừng lo đi kiếm anh em họ hàng.</para>
  <para style="q2" vid="PRO 27:10">Vì láng giềng gần hơn họ hàng ở xa.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Con ơi, hãy khôn ngoan, và làm cho lòng cha sung sướng.</para>
  <para style="q2" vid="PRO 27:11">Vì khi đó cha có thể đáp lại những lời chỉ trích xem thường.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Người khôn tránh né nguy nan.</para>
  <para style="q2" vid="PRO 27:12">Người dại đâm đầu hướng tới tai họa.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Phải nắm lấy áo ai bảo lãnh cho người không quen.</para>
  <para style="q2" vid="PRO 27:13">Giữ vật làm tin của hắn vì hắn bảo lãnh cho người đàn bà xa lạ.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Lớn tiếng chúc phước người hàng xóm lúc sáng sớm,</para>
  <para style="q2" vid="PRO 27:14">họ sẽ xem câu chúc đó như lời nguyền rủa.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Nhà dột trong ngày mưa tháng gió</para>
  <para style="q2" vid="PRO 27:15">cũng làm khổ như người đàn bà cãi cọ.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Bịt miệng nàng, khác chi đưa tay cản gió</para>
  <para style="q2" vid="PRO 27:16">hay ngửa tay đựng dầu.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Sắt mài sắt,</para>
  <para style="q2" vid="PRO 27:17">bạn rèn bạn.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Săn sóc cây vả sẽ được ăn quả;</para>
  <para style="q2" vid="PRO 27:18">phục vụ hết lòng, chủ sẽ thưởng công.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Nước phản chiếu khuôn mặt,</para>
  <para style="q2" vid="PRO 27:19">tấm lòng biểu lộ chân tướng con người.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Mắt đầy tham vọng, chẳng bao giờ chán;</para>
  <para style="q2" vid="PRO 27:20">âm ty nuốt người không hề thỏa mãn.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Lửa dùng thử bạc, thử vàng,</para>
  <para style="q2" vid="PRO 27:21">lời khen thử con người.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Dùng chày giã người dại như giã thóc,</para>
  <para style="q2" vid="PRO 27:22">cũng không làm tróc ngu si của nó.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Hãy biết rõ tình trạng bầy chiên của con,</para>
  <para style="q2" vid="PRO 27:23">và phải chịu khó chăm nom đàn súc vật,<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />vì giàu có chóng qua,</para>
  <para style="q2" vid="PRO 27:24">và mão miện chẳng trường tồn.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Khi cỏ khô đã cắt và cỏ non lại mọc,</para>
  <para style="q2" vid="PRO 27:25">và cỏ xanh trên đồi núi được gom về,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />thì chiên cung cấp cho con quần áo che thân,</para>
  <para style="q2" vid="PRO 27:26">và dê sẽ giúp con tiền mua đất ruộng.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Sữa dê sẽ dồi dào để nuôi con, nuôi cả gia đình</para>
  <para style="q2" vid="PRO 27:27">và luôn cả các tớ gái con nữa.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Dù không người đuổi, người ác cắm đầu chạy,</para>
  <para style="q2" vid="PRO 28:1">còn người ngay như sư tử can trường.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Khi đất nước loạn lạc, sẽ có nhiều quan chức.</para>
  <para style="q2" vid="PRO 28:2">Nhưng nhờ một người hiểu biết và sáng suốt, nước bền vững dài lâu.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Quan chức bóc lột người nghèo nàn,</para>
  <para style="q2" vid="PRO 28:3">khác nào mưa lụt quét sạch mùa màng.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Người bỏ pháp luật đề cao tội ác;</para>
  <para style="q2" vid="PRO 28:4">người giữ pháp luật chống lại người gian.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Người ác chẳng lưu tâm đến công lý,</para>
  <para style="q2" vid="PRO 28:5">người tôn thờ Chúa Hằng Hữu biết rõ công lý là gì.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Thà nghèo mà ngay thật,</para>
  <para style="q2" vid="PRO 28:6">còn hơn giàu mà bất chính.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Con khôn ngoan tôn trọng luật pháp;</para>
  <para style="q2" vid="PRO 28:7">đứa kết bạn côn đồ, gây nhục cho cha.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Tài sản của người cho vay nặng lãi</para>
  <para style="q2" vid="PRO 28:8">lại rơi vào tay người biết thương hại người nghèo.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Người coi thường, xây tai không nghe luật lệ,</para>
  <para style="q2" vid="PRO 28:9">lời cầu nguyện người sẽ chẳng được nghe.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Ai quyến rũ người lành làm ác,</para>
  <para style="q2" vid="PRO 28:10">sẽ rơi vào bẫy chính mình đã giăng,</para>
  <para style="q2" vid="PRO 28:10">còn người ngay lành vẫn hưởng phước lạc.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Người giàu thường tự thấy mình khôn ngoan,</para>
  <para style="q2" vid="PRO 28:11">nhưng người nghèo sáng dạ nhìn suốt thực hư.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Khi người liêm chính nắm quyền, mọi người đều hân hoan.</para>
  <para style="q2" vid="PRO 28:12">Khi người ác nổi dậy, ai nấy lo ẩn trốn.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Người che giấu lỗi mình sẽ không được may mắn</para>
  <para style="q2" vid="PRO 28:13">nhưng nếu thú nhận và từ bỏ tội, sẽ tìm được xót thương.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Người kính sợ Chúa luôn hưởng hạnh phước,</para>
  <para style="q2" vid="PRO 28:14">người rắn lòng bất chính thường bị họa tai.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Người ác cai trị làm dân nghèo khốn khổ,</para>
  <para style="q2" vid="PRO 28:15">như bị gấu đuổi, như sư tử vồ.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Một cai quản ngu dốt lo bóc lột dân mình,</para>
  <para style="q2" vid="PRO 28:16">một lãnh tụ muốn tồn tại phải liêm chính.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Kẻ sát nhân luôn bị lương tâm dày vò, chạy trốn nơi vực thẳm.</para>
  <para style="q2" vid="PRO 28:17">Đừng ai ngăn nó!<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Người ngay được cứu khỏi tai vạ,</para>
  <para style="q2" vid="PRO 28:18">còn người gian tà phải bị sa ngã.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Ai cày sâu cuốc bẩm thu hoạch nhiều hoa lợi,</para>
  <para style="q2" vid="PRO 28:19">ai đuổi theo ảo mộng, đói nghèo xác xơ.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Người trung tín hưởng nhiều phước hạnh,</para>
  <para style="q2" vid="PRO 28:20">vội lo làm giàu, hình phạt chẳng thoát đâu.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Thiên vị là xấu, bất kể lý do gì,</para>
  <para style="q2" vid="PRO 28:21">có người chỉ vì một miếng bánh mà thiên vị.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Người tham lam chạy theo của cải làm giàu,</para>
  <para style="q2" vid="PRO 28:22">chẳng ngờ nghèo khó bất chợt theo sau.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Đến cuối cùng, người ta sẽ phân định</para>
  <para style="q2" vid="PRO 28:23">và biết ơn người nói thẳng hơn là dua nịnh.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ăn cắp cha mẹ mà nói: “Đâu tội vạ gì,”</para>
  <para style="q2" vid="PRO 28:24">chẳng khác đồng lõa với người phá hại.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Kiêu căng gây tranh cạnh,</para>
  <para style="q2" vid="PRO 28:25">tin cậy Chúa Hằng Hữu sẽ được hưng thịnh.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Người ngu xuẩn tự thị tự mãn,</para>
  <para style="q2" vid="PRO 28:26">ai khôn sáng mới được an toàn.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Người phân phát tài sản cho người nghèo chẳng hề thiếu thốn,</para>
  <para style="q2" vid="PRO 28:27">nhưng miệng đời nguyền rủa người nhắm mắt làm ngơ.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Khi người ác cầm quyền, người lành ẩn tránh.</para>
  <para style="q2" vid="PRO 28:28">Khi người ác suy đồi, người lành gia tăng.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Người cứng lòng cứng cổ trước lời răn dạy</para>
  <para style="q2" vid="PRO 29:1">sẽ suy sụp thình lình không phương chữa chạy.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Người liêm chính cai trị, dân chúng hân hoan.</para>
  <para style="q2" vid="PRO 29:2">Nhưng người ác nắm quyền, dân chúng lầm than.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Con khôn ngoan khiến cha vui lòng,</para>
  <para style="q2" vid="PRO 29:3">người nuôi gái điếm phá hoại gia phong.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Vua công minh, nước cường thịnh,</para>
  <para style="q2" vid="PRO 29:4">vua tham nhũng, nước mạt vận.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ai nịnh bợ hàng xóm láng giềng,</para>
  <para style="q2" vid="PRO 29:5">là giăng lưới dưới chân.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Người ác bị tội mình sập bẫy,</para>
  <para style="q2" vid="PRO 29:6">nhưng người ngay ca hát vui mừng.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Người ngay tôn trọng quyền lợi của người nghèo khó;</para>
  <para style="q2" vid="PRO 29:7">còn người ác chẳng biết đến quyền lợi đó.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Người kiêu cường khua mép làm cả thành náo động xôn xao,</para>
  <para style="q2" vid="PRO 29:8">người khôn ngoan làm lắng dịu cơn thịnh nộ cuồng bạo.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Người khôn chẳng cần tranh luận với kẻ dại dột,</para>
  <para style="q2" vid="PRO 29:9">vì nó sẽ nổi giận, hoặc cười ngạo nghễ không thôi.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Người trọn vẹn bị bọn khát máu ghen ghét,</para>
  <para style="q2" vid="PRO 29:10">nhưng được người công chính quý chuộng.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Người dại để cơn giận mình bùng nổ,</para>
  <para style="q2" vid="PRO 29:11">nhưng người khôn chế ngự nó.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Nếu vua nghe lời giả dối, dối gạt,</para>
  <para style="q2" vid="PRO 29:12">bầy tôi người chỉ là phường gian ác.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Người nghèo và người giàu đều giống nhau ở điểm này:</para>
  <para style="q2" vid="PRO 29:13">Chúa Hằng Hữu cho ánh sáng để thấy.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Vua nào xử công minh cho người nghèo nàn,</para>
  <para style="q2" vid="PRO 29:14">sẽ được tồn tại với năm tháng.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Giáo huấn, đòn vọt rèn luyện trẻ thơ,</para>
  <para style="q2" vid="PRO 29:15">đứa trẻ phóng túng làm nhục mẹ nó.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Số người ác càng nhiều, tội phạm càng gia tăng,</para>
  <para style="q2" vid="PRO 29:16">nhưng người công chính sẽ chứng kiến cảnh chúng suy tàn.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Muốn hưởng hạnh phước và tâm hồn được an tịnh,</para>
  <para style="q2" vid="PRO 29:17">hãy sửa phạt con mình.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Nước nào không được Chúa hướng dẫn sẽ bị xáo trộn.</para>
  <para style="q2" vid="PRO 29:18">Quốc gia nào theo luật lệ Chúa, hạnh phước trường tồn.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Lời nói suông không đủ điều khiển người giúp việc,</para>
  <para style="q2" vid="PRO 29:19">vì dù hiểu biết, chưa chắc họ đã lưu tâm.<verse eid="PRO 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 29:20" />Con có thấy người nói quá hấp tấp?</para>
  <para style="q1" vid="PRO 29:20">Người ngu đần còn khá hơn người nói hấp tấp.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Nếu nuông chiều người giúp việc từ thuở bé,</para>
  <para style="q2" vid="PRO 29:21">lớn lên nó sẽ đòi được kể như người thừa kế.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Người dễ giận suốt ngày gây gổ;</para>
  <para style="q2" vid="PRO 29:22">người nóng tính lầm lỗi liên miên.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Tính kiêu căng đưa người xuống dốc,</para>
  <para style="q2" vid="PRO 29:23">lòng khiêm tốn đem lại vinh dự.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Người đồng lõa với kẻ trộm, là gây hại cho bản thân.</para>
  <para style="q2" vid="PRO 29:24">Dù đã thề trước tòa, mà ngậm miệng không tố giác,<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Lo sợ người phàm là một cạm bẫy,</para>
  <para style="q2" vid="PRO 29:25">tin cậy Chúa sẽ được an toàn.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Muốn công lý, cầu xin Chúa Hằng Hữu,</para>
  <para style="q2" vid="PRO 29:26">đừng mong tìm ân huệ của hoàng gia.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Người ngay ghét việc gian tà;</para>
  <para style="q2" vid="PRO 29:27">người gian ghen ghét việc làm của người ngay.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Lời của A-gu-ra</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Lời của A-gu-ra, con trai Gia-kê, nói với Y-thi-ên và U-can:<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Tôi là người ngu dốt nhất,</para>
  <para style="q2" vid="PRO 30:2">và cũng không hiểu biết như người thường.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Tôi chưa được học sự khôn ngoan,</para>
  <para style="q2" vid="PRO 30:3">cũng không có sự hiểu biết về Đấng Thánh.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Ai đã lên trời, rồi xuống đất?</para>
  <para style="q2" vid="PRO 30:4">Ai đã góp gió trong tay, bọc biển trong áo, tạo nên vũ trụ?</para>
  <para style="q2" vid="PRO 30:4">Đấng ấy là Ai? Và Con Trai Ngài tên gì?</para>
  <para style="q2" vid="PRO 30:4">Xin nói giúp tôi, nếu ngươi biết!<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Mọi lời của Đức Chúa Trời đều tinh luyện;</para>
  <para style="q2" vid="PRO 30:5">Ngài là tấm khiên bảo vệ người nương cậy Ngài.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Đừng thêm gì vào lời của Ngài, kẻo Ngài bắt tội,</para>
  <para style="q2" vid="PRO 30:6">vì người thêm thắt là người nói dối.<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Đức Chúa Trời ôi, trước khi con chết,</para>
  <para style="q2" vid="PRO 30:7">xin cho con hai điều:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Giúp con khỏi dối trá, giả hình.</para>
  <para style="q2" vid="PRO 30:8">Đừng để con nghèo khổ, cũng đừng cho con giàu có.</para>
  <para style="q2" vid="PRO 30:8">Xin cho con lương thực vừa đủ cần dùng.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Nếu giàu có dư dật, con sẽ khước từ Chúa và hỏi: “Chúa Hằng Hữu là ai?”</para>
  <para style="q2" vid="PRO 30:9">Nếu nghèo khổ, con sẽ trộm cắp, làm ô nhơ Danh Đức Chúa Trời.<verse eid="PRO 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Chớ vu khống người đầy tớ với chủ,</para>
  <para style="q2" vid="PRO 30:10">người sẽ nguyền rủa con vì lỗi con tạo lấy.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Có người rủa cha,</para>
  <para style="q2" vid="PRO 30:11">và không chúc phước cho mẹ.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Có người tự thấy mình trong trắng,</para>
  <para style="q2" vid="PRO 30:12">nhưng chưa được rửa sạch ô uế.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Có người đôi mắt kiêu căng,</para>
  <para style="q2" vid="PRO 30:13">với cái nhìn khinh người.<verse eid="PRO 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 30:14" />Có người răng sắc như gươm,</para>
  <para style="q2" vid="PRO 30:14">hàm răng như dao cạo.</para>
  <para style="q1" vid="PRO 30:14">Họ nhai ngấu nghiến người nghèo,</para>
  <para style="q2" vid="PRO 30:14">ăn nuốt người thiếu thốn.<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Con đỉa có hai miệng hút,</para>
  <para style="q2" vid="PRO 30:15">chúng kêu gào “Hãy cho, Hãy cho!”</para>
  <para style="q1" vid="PRO 30:15">Có ba vật chẳng hề thỏa mãn,</para>
  <para style="q2" vid="PRO 30:15">và bốn loài không biết nói “Đủ rồi!”<verse eid="PRO 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 30:16" />Âm phủ,</para>
  <para style="q2" vid="PRO 30:16">lòng dạ son sẻ,</para>
  <para style="q2" vid="PRO 30:16">đất không bao giờ đủ nước,</para>
  <para style="q2" vid="PRO 30:16">và ngọn lửa hừng.<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Mắt của người chế nhạo cha, khinh bỉ mẹ,</para>
  <para style="q2" vid="PRO 30:17">sẽ bị quạ móc đi và phụng hoàng nuốt sống.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Có ba điều quá lạ lùng—</para>
  <para style="q2" vid="PRO 30:18">không, bốn việc dị kỳ tôi không hiểu thấu:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Đường đại bàng bay trên không,</para>
  <para style="q2" vid="PRO 30:19">lối rắn bò trên đá,</para>
  <para style="q1" vid="PRO 30:19">đường tàu chạy trên biển,</para>
  <para style="q2" vid="PRO 30:19">và đường tình ái giữa nam nữ.<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Còn thêm một điều nữa: Người đàn bà ngoại tình,</para>
  <para style="q2" vid="PRO 30:20">phạm tội xong, chùi miệng nói: “Tôi có làm gì đâu.”<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Có ba điều làm đất rung chuyển—</para>
  <para style="q2" vid="PRO 30:21">không, bốn việc khiến đất không chịu nổi:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Người nô lệ làm vua,</para>
  <para style="q2" vid="PRO 30:22">người ngu xuẩn no đầy, thịnh vượng,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />người đàn bà ghen ghét lấy được chồng,</para>
  <para style="q2" vid="PRO 30:23">đứa tớ gái lên làm bà chủ.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Có bốn loài vật tuy nhỏ bé</para>
  <para style="q2" vid="PRO 30:24">nhưng lại khôn ngoan lạ đời:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Con kiến là loài yếu ớt,</para>
  <para style="q2" vid="PRO 30:25">dự trữ thực phẩm suốt mùa hạ.<verse eid="PRO 30:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 30:26" />Con chồn ít năng lực,</para>
  <para style="q2" vid="PRO 30:26">nhưng lại biết ẩn mình trong hốc đá.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Con châu chấu tuy không có vua,</para>
  <para style="q2" vid="PRO 30:27">nhưng chúng bay thành đội ngũ.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Con thằn lằn mà người ta lấy tay bắt được,</para>
  <para style="q2" vid="PRO 30:28">lại ở trong cung vua.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Có ba dã thú dáng đi hùng dũng đẹp đẽ—</para>
  <para style="q2" vid="PRO 30:29">không, bốn loài có nước bước oai phong lẫm liệt:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Con sư tử, chúa sơn lâm, chẳng lùi bước trước loài nào cả,<verse eid="PRO 30:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="PRO 30:31" />con công,</para>
  <para style="q2" vid="PRO 30:31">con dê đực,</para>
  <para style="q2" vid="PRO 30:31">và vị vua khi đi duyệt binh.<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Nếu con vì ngu dại mà tự kiêu hoặc mưu đồ việc ác,</para>
  <para style="q2" vid="PRO 30:32">phải biết xấu hổ, lấy tay che miệng lại.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Đánh sữa ra bơ</para>
  <para style="q2" vid="PRO 30:33">và đấm mũi gây chảy máu,</para>
  <para style="q2" vid="PRO 30:33">cũng vậy, chọc giận sinh cãi nhau.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Lời của Vua Lê-mu-ên</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 31:1" />Châm ngôn của Vua Lê-mu-ên, do</para>
  <para style="q2" vid="PRO 31:1">mẹ vua truyền lại.<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Con ơi! Đứa con mà lòng dạ mẹ đã cưu mang,</para>
  <para style="q2" vid="PRO 31:2">đứa con mà mẹ đã khấn hứa,<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />đừng vì đàn bà mà tiêu hao năng lực,</para>
  <para style="q2" vid="PRO 31:3">đừng theo vết xe đổ của các vua chúa.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Lê-mu-ên, con ơi, vua chúa không nên ham rượu.</para>
  <para style="q2" vid="PRO 31:4">Các quan chức đừng đam mê thức uống có men.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Uống vào, con sẽ quên hết luật lệ,</para>
  <para style="q2" vid="PRO 31:5">xâm phạm quyền lợi, công lý của người cùng khổ.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Hãy đem chất men cho người hấp hối</para>
  <para style="q2" vid="PRO 31:6">và đem rượu cho người có tâm hồn sầu thảm.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Họ uống cho quên đi nỗi khổ,</para>
  <para style="q2" vid="PRO 31:7">và cũng chẳng bận tâm đến mọi mối sầu.<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Hãy lên tiếng bênh vực người cô thế;</para>
  <para style="q2" vid="PRO 31:8">và biện hộ cho quyền lợi của người bất hạnh.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Con hãy phán xét công minh,</para>
  <para style="q2" vid="PRO 31:9">bảo đảm công lý cho người nghèo yếu.<verse eid="PRO 31:9" /></para>
  <para style="s1">Người Vợ Tài Đức</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Một người vợ hiền đức, ai có thể tìm được?</para>
  <para style="q2" vid="PRO 31:10">Giá trị nàng còn quý hơn châu ngọc.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Nàng được chồng tín nhiệm,</para>
  <para style="q2" vid="PRO 31:11">và thu hoa lợi không thiếu thốn.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Nàng chẳng làm thương tổn,</para>
  <para style="q2" vid="PRO 31:12">nhưng suốt đời đem hạnh phước cho chồng.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Nàng bận bịu quay sợi,</para>
  <para style="q2" vid="PRO 31:13">dệt dạ và vải gai.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Nàng giống như con tàu</para>
  <para style="q2" vid="PRO 31:14">chở thực phẩm về từ xa.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Thức giấc khi trời chưa sáng,</para>
  <para style="q2" vid="PRO 31:15">nàng sửa soạn thức ăn cho gia đình,</para>
  <para style="q2" vid="PRO 31:15">sắp đặt công việc cho các tớ gái.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Nàng lưu ý một thửa ruộng và mua nó,</para>
  <para style="q2" vid="PRO 31:16">với lợi tức làm ra, nàng lập một vườn nho.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Nàng đảm đang, chịu khó,</para>
  <para style="q2" vid="PRO 31:17">và hết sức làm công việc gia đình.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Thức làm việc đến khuya;</para>
  <para style="q2" vid="PRO 31:18">theo dõi giá hàng hóa, để mua bán kịp thời.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Nàng tra tay vào guồng kéo sợi,</para>
  <para style="q2" vid="PRO 31:19">nàng cần cù kéo chỉ dệt tơ.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Nàng đưa tay giúp người khốn khó,</para>
  <para style="q2" vid="PRO 31:20">rộng rãi chăm lo, giúp đỡ người nghèo.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Không sợ gia đình gặp tuyết giá,</para>
  <para style="q2" vid="PRO 31:21">vì sắm sẵn áo ấm bằng dạ.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Nàng dệt lấy chăn mền,</para>
  <para style="q2" vid="PRO 31:22">áo xống nàng bằng vải gai mịn.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Chồng nàng được nổi danh,</para>
  <para style="q2" vid="PRO 31:23">thuộc hàng nhân vật cao cấp trong xứ.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Nàng sản xuất áo quần,</para>
  <para style="q2" vid="PRO 31:24">đem bán cho con buôn.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Là người có nghị lực và duyên dáng,</para>
  <para style="q2" vid="PRO 31:25">nàng hớn hở nhìn vào tương lai tươi sáng.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Nàng ăn nói khôn ngoan,</para>
  <para style="q2" vid="PRO 31:26">lấy nhân từ làm kim chỉ nam.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Nàng chăm sóc mọi việc trong nhà,</para>
  <para style="q2" vid="PRO 31:27">không bao giờ biếng nhác.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Con cái chúc nàng hạnh phước.</para>
  <para style="q2" vid="PRO 31:28">Chồng nàng tấm tắc ngợi khen:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Có nhiều phụ nữ tài đức,</para>
  <para style="q2" vid="PRO 31:29">nhưng nàng trỗi hơn tất cả.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Duyên dáng thường giả trá, sắc đẹp cũng tàn phai;</para>
  <para style="q2" vid="PRO 31:30">nhưng ai kính sợ Chúa Hằng Hữu sẽ được ngợi ca mãi.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Cùng được hưởng thành quả của công việc do tay mình làm ra.</para>
  <para style="q2" vid="PRO 31:31">Nàng đáng được ca ngợi giữa nơi công cộng.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>